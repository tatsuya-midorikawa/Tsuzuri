record Axis {
    position: f64,
    velocity: f64,
}

def step :: f64 -> f64 -> f64 -> f64 -> Axis
fn step position velocity dt extent = {
    let _ = assert(extent >= 1.0 && extent <= 1_000_000.0);
    let _ = assert(position >= 0.0 && position <= extent);
    let _ = assert(abs(velocity) <= 1_000_000.0 && dt >= 0.0 && dt <= 1.0);
    let period = extent * 2.0;
    let unfolded = position + velocity * dt;
    let raw_phase = unfolded - floor(unfolded / period) * period;
    let phase = if raw_phase < 0.0 || raw_phase >= period { 0.0 } else { raw_phase };
    let next_position = if phase <= extent { phase } else { period - phase };
    let next_velocity = if phase == 0.0 {
        abs(velocity)
    } else if phase == extent {
        -abs(velocity)
    } else if phase < extent {
        velocity
    } else {
        -velocity
    };
    Axis { position: next_position, velocity: next_velocity }
}

export def next_position :: f64 -> f64 -> f64 -> f64 -> f64
fn next_position position velocity dt extent =
    (step position velocity dt extent).position

export def next_velocity :: f64 -> f64 -> f64 -> f64 -> f64
fn next_velocity position velocity dt extent =
    (step position velocity dt extent).velocity
