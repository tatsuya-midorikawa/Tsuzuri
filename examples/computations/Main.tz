def divide :: i64 -> i64 -> Result<i64, i64>
fn divide value divisor =
    if divisor == 0 then Error divisor
    else Ok (value / divisor)

let answer = Result {
    let! first = divide 84 2
    let! second = divide 0 1
    return first + second
}

match answer with
| Ok value -> value
| Error _ -> -1
