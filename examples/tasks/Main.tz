def rec sum_squares :: i64 -> i64 -> i64 -> i64
fn rec sum_squares first last total =
    if first >= last { total }
    else { sum_squares (first + 1) last (total + first * first) }

let computation = task {
    let jobs = new [Task<i64>](4, chunk -> task {
        return sum_squares (chunk * 1000) ((chunk + 1) * 1000) 0
    })
    let! totals = Task.parallel jobs
    return totals[0] + totals[1] + totals[2] + totals[3]
}

Task.run computation
