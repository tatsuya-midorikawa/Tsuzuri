def increment :: 'a -> 'a = \value -> value + 1
def add :: 'a -> 'a -> 'a = \a b -> a + b
def triple :: 'a -> 'a = \value -> value * 3

def map :: ('a -> 'b) -> ['a] -> ['b] = \f values ->
    new ['b](values.length, i -> f values[i])

def rec fold :: ('b -> 'a -> 'b) -> ['a] -> i64 -> 'b -> 'b = \f values index total ->
    if index == values.length {
        total
    } else {
        fold f values (index + 1) (f total values[index])
    }

export def transform :: i64 -> i64 -> i64 -> i64 -> i64 = \a b c d -> {
    let increment_all = map increment;
    let values = increment_all [a, b, c, d];
    let sum = fold add values 0;
    sum 0 |> triple
}

def main :: i64 = transform 1 2 3 4
