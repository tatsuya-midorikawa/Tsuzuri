// PM03: the longest string of a WebAssembly module. The heap of a wasm32 module refuses a block above 16,777,184 bytes
// (the default of --wasm-max-memory), which is 8,388,592 UTF-16 units. A Latin-1 string is refused at the same length,
// so the exports trap in TSUZURI_STRINGS=utf16 and compact at the same lengths and return the same values below them.
// tests/compact_strings.mjs builds this project in both forms.

export def doubled :: own i64 -> i64
fn doubled n =
    let first = String.repeat n (ref "a")
    let second = String.repeat n (ref "b")
    let both = first + second
    both.length

export def joined :: own i64 -> i64
fn joined n =
    let first = String.repeat n (ref "a")
    let second = String.repeat n (ref "b")
    let parts = [first, second]
    let all = String.join (ref "") (ref parts)
    all.length

// One string that grows by pieces of 1,000 units: the heap extends it in place, so a Latin-1 string of 9,000,000 units
// takes 9 MB and fits the heap, and only the limit on its UTF-16 size makes the forms trap at the same length.
export def grown :: own i64 -> i64
fn grown units =
    let piece = String.repeat 1000 (ref "a")
    let mut text = ""
    let mut count = 0
    while count < units / 1000 do
        text = text + clone_string (ref piece)
        count = count + 1
    text.length
