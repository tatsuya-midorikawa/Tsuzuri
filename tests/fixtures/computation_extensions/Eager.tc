def Return :: own 'a -> Maybe<'a>
fn Return value = Maybe.Some value

def Bind :: own Maybe<'a> -> own ('a -> Maybe<'b>) -> Maybe<'b>
fn Bind value next = Maybe.Bind value next

def MergeSources :: own Maybe<'a> -> own Maybe<'b> -> Maybe<('a * 'b)>
fn MergeSources left right = Maybe.MergeSources left right
