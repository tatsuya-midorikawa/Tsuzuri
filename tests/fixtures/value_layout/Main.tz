// PM01 value layout. The stored width of a union tag, the storage of a union payload, the niche
// encodings of options, and the field order of records must not change what a program computes.
// Every export returns a checksum that tests/features.mjs derives without the compiler.

// 256 cases: the largest union whose tags (0..255) fit one byte.
union Narrow =
    | A0 | A1 | A2 | A3 | A4 | A5 | A6 | A7 | A8 | A9 | A10 | A11 | A12 | A13 | A14 | A15
    | A16 | A17 | A18 | A19 | A20 | A21 | A22 | A23 | A24 | A25 | A26 | A27 | A28 | A29 | A30 | A31
    | A32 | A33 | A34 | A35 | A36 | A37 | A38 | A39 | A40 | A41 | A42 | A43 | A44 | A45 | A46 | A47
    | A48 | A49 | A50 | A51 | A52 | A53 | A54 | A55 | A56 | A57 | A58 | A59 | A60 | A61 | A62 | A63
    | A64 | A65 | A66 | A67 | A68 | A69 | A70 | A71 | A72 | A73 | A74 | A75 | A76 | A77 | A78 | A79
    | A80 | A81 | A82 | A83 | A84 | A85 | A86 | A87 | A88 | A89 | A90 | A91 | A92 | A93 | A94 | A95
    | A96 | A97 | A98 | A99 | A100 | A101 | A102 | A103 | A104 | A105 | A106 | A107 | A108 | A109 | A110 | A111
    | A112 | A113 | A114 | A115 | A116 | A117 | A118 | A119 | A120 | A121 | A122 | A123 | A124 | A125 | A126 | A127
    | A128 | A129 | A130 | A131 | A132 | A133 | A134 | A135 | A136 | A137 | A138 | A139 | A140 | A141 | A142 | A143
    | A144 | A145 | A146 | A147 | A148 | A149 | A150 | A151 | A152 | A153 | A154 | A155 | A156 | A157 | A158 | A159
    | A160 | A161 | A162 | A163 | A164 | A165 | A166 | A167 | A168 | A169 | A170 | A171 | A172 | A173 | A174 | A175
    | A176 | A177 | A178 | A179 | A180 | A181 | A182 | A183 | A184 | A185 | A186 | A187 | A188 | A189 | A190 | A191
    | A192 | A193 | A194 | A195 | A196 | A197 | A198 | A199 | A200 | A201 | A202 | A203 | A204 | A205 | A206 | A207
    | A208 | A209 | A210 | A211 | A212 | A213 | A214 | A215 | A216 | A217 | A218 | A219 | A220 | A221 | A222 | A223
    | A224 | A225 | A226 | A227 | A228 | A229 | A230 | A231 | A232 | A233 | A234 | A235 | A236 | A237 | A238 | A239
    | A240 | A241 | A242 | A243 | A244 | A245 | A246 | A247 | A248 | A249 | A250 | A251 | A252 | A253 | A254 | A255
    deriving (Eq, Hash)

// 160 cases: a one-byte tag whose values above 127 must not be taken as negative. This is the
// largest size that still derives Ord.
union Mid =
    | M0 | M1 | M2 | M3 | M4 | M5 | M6 | M7 | M8 | M9 | M10 | M11 | M12 | M13 | M14 | M15
    | M16 | M17 | M18 | M19 | M20 | M21 | M22 | M23 | M24 | M25 | M26 | M27 | M28 | M29 | M30 | M31
    | M32 | M33 | M34 | M35 | M36 | M37 | M38 | M39 | M40 | M41 | M42 | M43 | M44 | M45 | M46 | M47
    | M48 | M49 | M50 | M51 | M52 | M53 | M54 | M55 | M56 | M57 | M58 | M59 | M60 | M61 | M62 | M63
    | M64 | M65 | M66 | M67 | M68 | M69 | M70 | M71 | M72 | M73 | M74 | M75 | M76 | M77 | M78 | M79
    | M80 | M81 | M82 | M83 | M84 | M85 | M86 | M87 | M88 | M89 | M90 | M91 | M92 | M93 | M94 | M95
    | M96 | M97 | M98 | M99 | M100 | M101 | M102 | M103 | M104 | M105 | M106 | M107 | M108 | M109 | M110 | M111
    | M112 | M113 | M114 | M115 | M116 | M117 | M118 | M119 | M120 | M121 | M122 | M123 | M124 | M125 | M126 | M127
    | M128 | M129 | M130 | M131 | M132 | M133 | M134 | M135 | M136 | M137 | M138 | M139 | M140 | M141 | M142 | M143
    | M144 | M145 | M146 | M147 | M148 | M149 | M150 | M151 | M152 | M153 | M154 | M155 | M156 | M157 | M158 | M159
    deriving (Eq, Ord, Hash)

// 257 cases: the smallest union that needs a two-byte tag.
union Wide =
    | B0 | B1 | B2 | B3 | B4 | B5 | B6 | B7 | B8 | B9 | B10 | B11 | B12 | B13 | B14 | B15
    | B16 | B17 | B18 | B19 | B20 | B21 | B22 | B23 | B24 | B25 | B26 | B27 | B28 | B29 | B30 | B31
    | B32 | B33 | B34 | B35 | B36 | B37 | B38 | B39 | B40 | B41 | B42 | B43 | B44 | B45 | B46 | B47
    | B48 | B49 | B50 | B51 | B52 | B53 | B54 | B55 | B56 | B57 | B58 | B59 | B60 | B61 | B62 | B63
    | B64 | B65 | B66 | B67 | B68 | B69 | B70 | B71 | B72 | B73 | B74 | B75 | B76 | B77 | B78 | B79
    | B80 | B81 | B82 | B83 | B84 | B85 | B86 | B87 | B88 | B89 | B90 | B91 | B92 | B93 | B94 | B95
    | B96 | B97 | B98 | B99 | B100 | B101 | B102 | B103 | B104 | B105 | B106 | B107 | B108 | B109 | B110 | B111
    | B112 | B113 | B114 | B115 | B116 | B117 | B118 | B119 | B120 | B121 | B122 | B123 | B124 | B125 | B126 | B127
    | B128 | B129 | B130 | B131 | B132 | B133 | B134 | B135 | B136 | B137 | B138 | B139 | B140 | B141 | B142 | B143
    | B144 | B145 | B146 | B147 | B148 | B149 | B150 | B151 | B152 | B153 | B154 | B155 | B156 | B157 | B158 | B159
    | B160 | B161 | B162 | B163 | B164 | B165 | B166 | B167 | B168 | B169 | B170 | B171 | B172 | B173 | B174 | B175
    | B176 | B177 | B178 | B179 | B180 | B181 | B182 | B183 | B184 | B185 | B186 | B187 | B188 | B189 | B190 | B191
    | B192 | B193 | B194 | B195 | B196 | B197 | B198 | B199 | B200 | B201 | B202 | B203 | B204 | B205 | B206 | B207
    | B208 | B209 | B210 | B211 | B212 | B213 | B214 | B215 | B216 | B217 | B218 | B219 | B220 | B221 | B222 | B223
    | B224 | B225 | B226 | B227 | B228 | B229 | B230 | B231 | B232 | B233 | B234 | B235 | B236 | B237 | B238 | B239
    | B240 | B241 | B242 | B243 | B244 | B245 | B246 | B247 | B248 | B249 | B250 | B251 | B252 | B253 | B254 | B255
    | B256
    deriving (Eq, Hash)

// 257 cases with payloads of different LLVM types: a two-byte tag in front of a shared payload area.
union Big =
    | G0 of i64 | G1 of f64 | G2 of string
    | G3 | G4 | G5 | G6 | G7 | G8 | G9 | G10 | G11 | G12 | G13 | G14 | G15 | G16 | G17 | G18
    | G19 | G20 | G21 | G22 | G23 | G24 | G25 | G26 | G27 | G28 | G29 | G30 | G31 | G32 | G33 | G34
    | G35 | G36 | G37 | G38 | G39 | G40 | G41 | G42 | G43 | G44 | G45 | G46 | G47 | G48 | G49 | G50
    | G51 | G52 | G53 | G54 | G55 | G56 | G57 | G58 | G59 | G60 | G61 | G62 | G63 | G64 | G65 | G66
    | G67 | G68 | G69 | G70 | G71 | G72 | G73 | G74 | G75 | G76 | G77 | G78 | G79 | G80 | G81 | G82
    | G83 | G84 | G85 | G86 | G87 | G88 | G89 | G90 | G91 | G92 | G93 | G94 | G95 | G96 | G97 | G98
    | G99 | G100 | G101 | G102 | G103 | G104 | G105 | G106 | G107 | G108 | G109 | G110 | G111 | G112 | G113 | G114
    | G115 | G116 | G117 | G118 | G119 | G120 | G121 | G122 | G123 | G124 | G125 | G126 | G127 | G128 | G129 | G130
    | G131 | G132 | G133 | G134 | G135 | G136 | G137 | G138 | G139 | G140 | G141 | G142 | G143 | G144 | G145 | G146
    | G147 | G148 | G149 | G150 | G151 | G152 | G153 | G154 | G155 | G156 | G157 | G158 | G159 | G160 | G161 | G162
    | G163 | G164 | G165 | G166 | G167 | G168 | G169 | G170 | G171 | G172 | G173 | G174 | G175 | G176 | G177 | G178
    | G179 | G180 | G181 | G182 | G183 | G184 | G185 | G186 | G187 | G188 | G189 | G190 | G191 | G192 | G193 | G194
    | G195 | G196 | G197 | G198 | G199 | G200 | G201 | G202 | G203 | G204 | G205 | G206 | G207 | G208 | G209 | G210
    | G211 | G212 | G213 | G214 | G215 | G216 | G217 | G218 | G219 | G220 | G221 | G222 | G223 | G224 | G225 | G226
    | G227 | G228 | G229 | G230 | G231 | G232 | G233 | G234 | G235 | G236 | G237 | G238 | G239 | G240 | G241 | G242
    | G243 | G244 | G245 | G246 | G247 | G248 | G249 | G250 | G251 | G252 | G253 | G254 | G255 | G256
    deriving (Eq, Hash)

// The cases that sit at the edges of the tag widths; every other index gives the first case.
def narrow_pick :: i64 -> Narrow
fn narrow_pick k =
    if k == 255 then A255 elif k == 254 then A254 elif k == 128 then A128 elif k == 127 then A127 elif k == 1 then A1 else A0

def narrow_code :: Narrow -> i64
fn narrow_code value =
    match value with
    | A255 -> 255
    | A254 -> 254
    | A128 -> 128
    | A127 -> 127
    | A1 -> 1
    | A0 -> 0
    | _ -> -1

def wide_pick :: i64 -> Wide
fn wide_pick k =
    if k == 256 then B256 elif k == 255 then B255 elif k == 128 then B128 elif k == 1 then B1 else B0

def mid_pick :: i64 -> Mid
fn mid_pick k =
    if k == 159 then M159 elif k == 128 then M128 elif k == 127 then M127 elif k == 1 then M1 else M0

def wide_code :: Wide -> i64
fn wide_code value =
    match value with
    | B256 -> 256
    | B255 -> 255
    | B128 -> 128
    | B1 -> 1
    | B0 -> 0
    | _ -> -1

def big_pick :: i64 -> Big
fn big_pick k =
    if k == 0 then G0 41
    elif k == 1 then G1 2.5
    elif k == 2 then G2 ("own" + "ed")
    elif k == 256 then G256
    elif k == 255 then G255
    else G3

def big_code :: ref Big -> i64
fn big_code value =
    match value with
    | G0 n -> n
    | G1 x -> to_int (x * 2.0)
    | G2 text -> text.length
    | G256 -> 256
    | G255 -> 255
    | _ -> 3

export def narrow :: i64 -> i64
fn narrow k = narrow_code (narrow_pick k)

export def wide :: i64 -> i64
fn wide k = wide_code (wide_pick k)

export def big :: i64 -> i64
fn big k =
    let value = big_pick k
    big_code (ref value)

// Ord compares tags as numbers, never as signed bytes: M159 is greater than M127.
export def mid_order :: i64 -> i64 -> i64
fn mid_order a b =
    let x = mid_pick a
    let y = mid_pick b
    (if x < y then 1 else 0) + (if x == y then 2 else 0) + (if x > y then 4 else 0)

export def narrow_equal :: i64 -> i64 -> i64
fn narrow_equal a b = if narrow_pick a == narrow_pick b then 1 else 0

export def wide_equal :: i64 -> i64 -> i64
fn wide_equal a b = if wide_pick a == wide_pick b then 1 else 0

export def big_equal :: i64 -> i64 -> i64
fn big_equal a b = if big_pick a == big_pick b then 1 else 0

// A hash mixes the case index, not the stored tag.
export def narrow_hash :: i64 -> i64
fn narrow_hash k =
    let value = narrow_pick k
    Hash.hash (ref value) as i64

export def wide_hash :: i64 -> i64
fn wide_hash k =
    let value = wide_pick k
    Hash.hash (ref value) as i64

export def big_hash :: i64 -> i64
fn big_hash k =
    let value = big_pick k
    Hash.hash (ref value) as i64

export def narrow_array :: i64 -> i64
fn narrow_array count =
    let items = new [Narrow](count, i -> narrow_pick (i % 256))
    let mut total = 0
    for item in items do
        total = total + narrow_code item
    total

export def wide_array :: i64 -> i64
fn wide_array count =
    let items = new [Wide](count, i -> wide_pick (i % 257))
    let mut total = 0
    for item in items do
        total = total + wide_code item
    total

// Owned payloads next to a two-byte tag: every string is dropped exactly once.
export def big_array :: i64 -> i64
fn big_array count =
    let items = new [Big](count, i -> big_pick (i % 257))
    let mut total = 0
    for item in items do
        total = total + big_code (ref item)
    total

// The payload area of a union whose cases have payloads of different LLVM types is aligned to the
// largest payload alignment: 8 for Shape and Rich, 1 for Small, 16 for Wideness, and the cap of 16
// for Lanes, whose 256-bit payload is stored with a 16-byte alignment.
union Shape = Circle of f64 | Rect of f64 * f64 | Blank

union Small = Flag of bool | Code of i8 | Nothing

union Wideness = Huge of i128 | Little of i8 | Missing

union Rich = Name of string | Count of i64 | Pair of i64 * bool | Nada

union Nested = Inner of Shape | Outer of Small | Void

union Lanes = Four of f32x4 | Eight of f32x8 | Scalar of i8 | Absent

def shape_value :: i64 -> Shape
fn shape_value i =
    if i % 3 == 0 then Circle ((i + 1) as f64) elif i % 3 == 1 then Rect (i as f64, 2.0) else Blank

def shape_area :: ref Shape -> i64
fn shape_area shape =
    match shape with
    | Circle r -> (r * r) as i64
    | Rect (w, h) -> (w * h) as i64
    | Blank -> -1

export def shapes :: i64 -> i64
fn shapes count =
    let items = new [Shape](count, i -> shape_value i)
    let mut total = 0
    for item in items do
        total = total + shape_area (ref item)
    total

def small_value :: i64 -> Small
fn small_value i =
    if i % 3 == 0 then Flag (i % 2 == 0) elif i % 3 == 1 then Code (i as i8) else Nothing

def small_code :: ref Small -> i64
fn small_code value =
    match value with
    | Flag b -> if b then 1 else 0
    | Code c -> c as i64
    | Nothing -> 7

export def smalls :: i64 -> i64
fn smalls count =
    let items = new [Small](count, i -> small_value i)
    let mut total = 0
    for item in items do
        total = total + small_code (ref item)
    total

def wideness_value :: i64 -> Wideness
fn wideness_value i =
    if i % 3 == 0 then Huge ((i as i128) <<< 72) elif i % 3 == 1 then Little (i as i8) else Missing

def wideness_code :: ref Wideness -> i64
fn wideness_code value =
    match value with
    | Huge v -> ((v >>> 72) as i64) + 1000
    | Little c -> c as i64
    | Missing -> -5

export def wideness :: i64 -> i64
fn wideness count =
    let items = new [Wideness](count, i -> wideness_value i)
    let mut total = 0
    for item in items do
        total = total + wideness_code (ref item)
    total

def rich_value :: i64 -> Rich
fn rich_value i =
    if i % 4 == 0 then Name ("n" + to_string i) elif i % 4 == 1 then Count i elif i % 4 == 2 then Pair (i, i % 2 == 0) else Nada

def rich_code :: ref Rich -> i64
fn rich_code value =
    match value with
    | Name text -> text.length
    | Count n -> n
    | Pair (n, b) -> if b then n + 1 else n
    | Nada -> -3

export def riches :: i64 -> i64
fn riches count =
    let items = new [Rich](count, i -> rich_value i)
    let mut total = 0
    for item in items do
        total = total + rich_code (ref item)
    total

def nested_value :: i64 -> Nested
fn nested_value i =
    if i % 3 == 0 then Inner (shape_value i) elif i % 3 == 1 then Outer (small_value i) else Void

def nested_code :: ref Nested -> i64
fn nested_code value =
    match value with
    | Inner shape -> shape_area (ref shape)
    | Outer small -> small_code (ref small)
    | Void -> 11

export def nesteds :: i64 -> i64
fn nesteds count =
    let items = new [Nested](count, i -> nested_value i)
    let mut total = 0
    for item in items do
        total = total + nested_code (ref item)
    total

def lanes_value :: i64 -> Lanes
fn lanes_value i =
    if i % 4 == 0 then Four (Simd.splat 1.5) elif i % 4 == 1 then Eight (Simd.splat 0.5) elif i % 4 == 2 then Scalar (i as i8) else Absent

def lanes_code :: ref Lanes -> i64
fn lanes_code value =
    match value with
    | Four v -> Simd.sum_lanes v as i64
    | Eight v -> Simd.sum_lanes v as i64
    | Scalar c -> c as i64
    | Absent -> -1

// A 48-byte element is 16-aligned but not 32-aligned, so a vector payload must be accessed with
// the 16-byte alignment that its slot has.
export def lanes :: i64 -> i64
fn lanes count =
    let items = new [Lanes](count, i -> lanes_value i)
    let mut total = 0
    for item in items do
        total = total + lanes_code (ref item)
    total

// An option-like union with a string or array payload stores no tag: a negative length is the
// nullary case, whichever case it is. Moving the payload out, assigning over the value, and
// dropping all follow the same rules as for a tagged union.
union Alias = NoAlias | Spelled of string

union Label = Named of string | Anonymous

record Holder { id: i64, name: Maybe<string>, tags: Maybe<[string]> }

def alias_value :: i64 -> Alias
fn alias_value i = if i % 3 == 0 then Spelled ("t" + to_string i) else NoAlias

def alias_length :: ref Alias -> i64
fn alias_length alias =
    match alias with
    | Spelled text -> text.length
    | NoAlias -> -1

export def names :: i64 -> i64
fn names count =
    let items = new [Alias](count, i -> alias_value i)
    let mut total = 0
    for item in items do
        total = total + alias_length (ref item)
    total

def label_value :: i64 -> Label
fn label_value i = if i % 2 == 0 then Named ("L" + to_string i) else Anonymous

def label_length :: ref Label -> i64
fn label_length label =
    match label with
    | Named text -> text.length
    | Anonymous -> -1

export def labels :: i64 -> i64
fn labels count =
    let items = new [Label](count, i -> label_value i)
    let mut total = 0
    for item in items do
        total = total + label_length (ref item)
    total

def text_option :: i64 -> Maybe<string>
fn text_option i = if i % 4 == 0 then Some ("s" + to_string i) else None

def text_option_length :: ref Maybe<string> -> i64
fn text_option_length option =
    match option with
    | Some text -> text.length
    | None -> -2

export def text_options :: i64 -> i64
fn text_options count =
    let items = new [Maybe<string>](count, i -> text_option i)
    let mut total = 0
    for item in items do
        total = total + text_option_length (ref item)
    total

def numbers_option :: i64 -> Maybe<[i64]>
fn numbers_option i = if i % 3 == 1 then Some (new [i64](i % 5, j -> j + i)) else None

def numbers_code :: ref Maybe<[i64]> -> i64
fn numbers_code option =
    match option with
    | Some numbers -> numbers.length * 1000 + (if numbers.length > 0 then numbers[0] else 0)
    | None -> -3

export def number_options :: i64 -> i64
fn number_options count =
    let items = new [Maybe<[i64]>](count, i -> numbers_option i)
    let mut total = 0
    for item in items do
        total = total + numbers_code (ref item)
    total

def words_option :: i64 -> Maybe<[string]>
fn words_option i = if i % 2 == 0 then Some (new [string](i % 4, j -> "w" + to_string j)) else None

def words_code :: ref Maybe<[string]> -> i64
fn words_code option =
    match option with
    | Some words -> words.length
    | None -> -4

export def word_options :: i64 -> i64
fn word_options count =
    let items = new [Maybe<[string]>](count, i -> words_option i)
    let mut total = 0
    for item in items do
        total = total + words_code (ref item)
    total

// The payload moves out of the option, which is dropped with its storage cleared.
export def consume :: i64 -> i64
fn consume count =
    let mut total = 0
    let mut i = 0
    while i < count do
        let option = text_option i
        let text = match option with | Some value -> value | None -> "none"
        total = total + text.length
        i = i + 1
    total

export def combinators :: i64 -> i64
fn combinators i =
    let first = Maybe.map (\s -> s + "!") (text_option i)
    let second = Maybe.bind (\s -> if s.length > 3 then Some (s + "?") else None) first
    let third = Maybe.filter (\s -> s.length > 4) second
    let fourth = Maybe.or_else (\() -> Some "fallback") third
    (Maybe.default_value "none" fourth).length

// Each assignment drops the value that it replaces.
export def reassign :: i64 -> i64
fn reassign count =
    let mut slot: Maybe<string> = None
    let mut total = 0
    let mut i = 0
    while i < count do
        slot = text_option (i * 4 + i % 2)
        total = total + text_option_length (ref slot)
        i = i + 1
    total

def holder_value :: i64 -> Holder
fn holder_value i =
    Holder { id: i, name: text_option i, tags: if i % 5 == 0 then Some (new [string](2, _j -> "g")) else None }

export def holders :: i64 -> i64
fn holders count =
    let items = new [Holder](count, i -> holder_value i)
    let mut total = 0
    for item in items do
        total = total + item.id + text_option_length (ref item.name) + words_code (ref item.tags)
    total

def nested_option :: i64 -> Maybe<Maybe<string>>
fn nested_option i =
    if i % 3 == 0 then None elif i % 3 == 1 then Some None else Some (Some ("n" + to_string i))

def nested_length :: ref Maybe<Maybe<string>> -> i64
fn nested_length option =
    match option with
    | None -> -1
    | Some inner ->
        match inner with
        | None -> -2
        | Some text -> text.length

export def nested_options :: i64 -> i64
fn nested_options count =
    let items = new [Maybe<Maybe<string>>](count, i -> nested_option i)
    let mut total = 0
    for item in items do
        total = total + nested_length (ref item)
    total

// A finished sequence is `Seq.empty` and an exhausted step is `None`, however the layout encodes them.
export def sequences :: i64 -> i64
fn sequences n =
    let mapped = Seq.map (\s -> s + "!") (Seq.once ("seq" + to_string n))
    let items = Seq.to_array mapped
    let empty: Seq<string> = Seq.empty()
    let none_items = Seq.to_array empty
    items.length * 100 + items[0].length + none_items.length

export def captured :: i64 -> i64
fn captured i =
    let option = text_option i
    let probe = \() -> text_option_length (ref option)
    probe () + probe ()

export def tasked :: i64 -> i64
fn tasked i =
    let result = Task.run (task { return text_option i })
    text_option_length (ref result)

// An option of a reference is the pointer itself on a native target, with the null pointer for
// `None`, and a tag and a pointer on WebAssembly. A result does not depend on which.
export def references :: i64 -> i64
fn references count =
    let values = new [i64](count, i -> (i * 7) % 11)
    let smallest = if count == 0 then Maybe.None else Maybe.Some (Array.minr (ref values))
    let found = Array.try_findr (\x -> deref x > 5) (ref values)
    let missing = Array.try_findr (\x -> deref x > 100) (ref values)
    (match smallest with | Some v -> deref v | None -> -1) + (match found with | Some v -> deref v * 100 | None -> -2) + (match missing with | Some v -> deref v * 10000 | None -> -3)

export def word_references :: i64 -> i64
fn word_references count =
    let words = new [string](count, i -> "w" + to_string i)
    let long = Array.try_findr (\word -> word.length > 3) (ref words)
    match long with
    | Some word -> word.length * 1000 + count
    | None -> -1

// The derived Eq, Ord, Hash and Display of a union that has no tag: the case index, not the bytes of the value,
// decides the order and the hash, and the payload follows it.
union Tagline = Hushed | Words of string deriving (Eq, Ord, Hash, Display)

def tagline :: i64 -> Tagline
fn tagline i = if i % 3 == 0 then Hushed else Words ("t" + to_string i)

def flags :: Ord<'a> => 'a -> 'a -> i64
fn flags left right =
    (if left == right then 1 else 0) + (if left != right then 2 else 0) +
    (if left < right then 4 else 0) + (if left <= right then 8 else 0) +
    (if left > right then 16 else 0) + (if left >= right then 32 else 0)

export def tagline_flags :: i64 -> i64 -> i64
fn tagline_flags left right = flags (tagline left) (tagline right)

export def tagline_hash :: i64 -> i64
fn tagline_hash i = Hash.hash (ref (tagline i)) as i64

export def tagline_display :: i64 -> i64
fn tagline_display i =
    let text = Display.display (ref (tagline i))
    Hash.hash (ref text) as i64
