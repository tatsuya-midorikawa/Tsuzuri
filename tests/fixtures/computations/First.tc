def Return :: own 'a -> 'a
fn Return value = value

def Yield :: own 'a -> 'a
fn Yield value = value

def Delay :: own (unit -> 'a) -> (unit -> 'a)
fn Delay body = body

def Run :: own (unit -> 'a) -> 'a
fn Run body = body ()

def Combine :: own 'a -> own (unit -> 'a) -> 'a
fn Combine first rest = first
