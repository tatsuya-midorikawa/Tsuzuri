def Return :: own i64 -> i64
fn Return value = value

def Delay :: own (unit -> i64) -> (unit -> i64)
fn Delay body = body

def Run :: own (unit -> i64) -> i64
fn Run body = body ()

def While :: own (unit -> bool) -> own (unit -> i64) -> i64
fn While guard body = if guard () { body () } else { 0 }
