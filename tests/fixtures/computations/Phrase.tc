def Return :: own string -> string
fn Return value = value

def ReturnFrom :: own string -> string
fn ReturnFrom value = value

def Yield :: own string -> string
fn Yield value = value

def YieldFrom :: own string -> string
fn YieldFrom value = value

def Bind :: own string -> own (string -> string) -> string
fn Bind value next = next value

def Zero :: string
fn Zero = ""

def Combine :: own string -> own string -> string
fn Combine first rest = first + rest
