record Deferred { invoke: unit -> i64 }

def Return :: own i64 -> i64
fn Return value = value

def ReturnFrom :: own i64 -> i64
fn ReturnFrom value = value

def Yield :: own i64 -> i64
fn Yield value = value

def YieldFrom :: own i64 -> i64
fn YieldFrom value = value

def Bind :: own 'a -> own ('a -> i64) -> i64
fn Bind value next = next value

def Zero :: i64
fn Zero = 0

def Delay :: own (unit -> i64) -> Deferred
fn Delay body = Deferred { invoke: body }

def Run :: own Deferred -> i64
fn Run body = body.invoke ()

def Combine :: own i64 -> own Deferred -> i64
fn Combine first rest = first + rest.invoke ()

def rec fold :: ref [i64] -> own (i64 -> i64) -> own i64 -> own i64 -> i64
fn rec fold values body index total =
    if index == values.length { total }
    else { fold values body (index + 1) (total + body values[index]) }

def For :: own [i64] -> own (i64 -> i64) -> i64
fn For values body = fold (ref values) body 0 0

def rec While :: own (unit -> bool) -> own Deferred -> i64
fn rec While guard body =
    if guard () { body.invoke () + While guard body }
    else { 0 }
