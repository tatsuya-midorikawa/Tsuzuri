    checksum (slice -> (Array.sum slice) as i64) (ref values)

export def sum_i64u :: i64 -> i64
fn sum_i64u pattern =
    let values: [i64u] = data pattern 64 false
    checksum (slice -> (Array.sum slice) as i64) (ref values)

export def min_i8 :: i64 -> i64
fn min_i8 pattern =
    let values: [i8] = data pattern 8 true
    checksum (slice -> (best true slice) as i64) (ref values)

export def min_i16 :: i64 -> i64
fn min_i16 pattern =
    let values: [i16] = data pattern 16 true
    checksum (slice -> (best true slice) as i64) (ref values)

