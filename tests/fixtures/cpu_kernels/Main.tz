def lcg_data :: i64 -> [i32]
fn lcg_data length = Array.init length (index -> (next (index + 1)) as i32)

def total :: Numeric<'a> => ref ['a] -> 'a
fn total values = Array.sum values

/// The four call forms of F08's example share the same specialized Array.sum.
export def forms :: i64
fn forms =
    let values = lcg_data 1000
    let f = Array.sum
    let a = Array.sum (ref values)
    let b = total (ref values)
    let c = f (ref values)
    let d = Array.sum (ref values[3..997])
    (a as i64) + (b as i64) + (c as i64) + (d as i64)
