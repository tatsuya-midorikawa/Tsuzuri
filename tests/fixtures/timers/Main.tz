// TZ05: the timers of Time, Timer and Ticker. A check of time looks at order and at "not early"
// only, never at an upper bound. Every export ends its boundary, which stops the timers it made.

// The ticket's example: nobody sends on `never`, so the deadline's arm is chosen.
export def after_is_a_timeout :: i64 -> i64
fn after_is_a_timeout milliseconds =
    let never: Channel<i64> = Channel.make 0
    let deadline = Time.after (milliseconds * Time.millisecond())
    select
    | recv _ from never -> 0
    | recv _ from deadline -> 1

// The time that a timer fired now sends: a time of the clock of the sleeps.
def now :: unit -> i64
fn now _ =
    let fired = Time.after 0
    match Channel.recv fired with
    | Maybe.Some time -> time
    | Maybe.None -> 0

// Three tzroutines sleep 20, 40 and 60 ms and send their number when they woke no earlier than
// that (100 when early): all three arrive, in whatever order the scheduler gives (6).
export def sleeps_are_not_early :: i64
fn sleeps_are_not_early =
    let arrivals: Channel<i64> = Channel.make 3
    for number in 1 ..= 3 do
        let out = Channel.share arrivals
        let nap = (number as i64) * 20 * Time.millisecond()
        tzroutine {
            let start = now ()
            Time.sleep nap
            Channel.send out (if now () - start >= nap then number as i64 else 100)
        }
    let mut total = 0i64
    for _ in 1 ..= 3 do
        total = total + (match Channel.recv arrivals with
            | Maybe.Some number -> number
            | Maybe.None -> 0)
    total

// A watcher sees a sleeper asleep (1): while the sleeper sleeps, the watcher runs (with one P too),
// which a sleep that held its thread would not let it. The sleeper waits for the watcher to start,
// and the watcher yields until the sleeper has woken.
export def sleep_does_not_block_others :: i64
fn sleep_does_not_block_others =
    let state = Arc.new (Atomic.create 0i64)
    let ready: Channel<unit> = Channel.make 0
    let reports: Channel<i64> = Channel.make 1
    let sleeper_state = Arc.share (ref state)
    let start = Channel.share ready
    tzroutine {
        let _go = Channel.recv start
        Atomic.store (Arc.get (ref sleeper_state)) 1
        Time.sleep (100 * Time.millisecond())
        Atomic.store (Arc.get (ref sleeper_state)) 2
    }
    let watcher_state = Arc.share (ref state)
    let go = Channel.share ready
    let report = Channel.share reports
    tzroutine {
        Channel.send go ()
        let mut seen = 0i64
        let mut current = Atomic.load (Arc.get (ref watcher_state))
        while current != 2 do
            if current == 1 then seen = 1
            Routine.yield ()
            current = Atomic.load (Arc.get (ref watcher_state))
        Channel.send report seen
    }
    match Channel.recv reports with
    | Maybe.Some seen -> seen
    | Maybe.None -> 0

// Timer.stop and Timer.reset: stop a pending timer (true), stop it again (false), reset the
// stopped one (false), receive its time, stop the fired one (false): 1, 0, 0, 1, 0.
export def timer_stop_reset :: i64
fn timer_stop_reset =
    let timer = Timer.create Time.hour()
    let fired = Timer.channel timer
    let digit = \flag -> if flag then 1i64 else 0i64
    let first = digit (Timer.stop timer)
    let second = digit (Timer.stop timer)
    let third = digit (Timer.reset timer (2 * Time.millisecond()))
    let fourth = match Channel.recv fired with
        | Maybe.Some _ -> 1i64
        | Maybe.None -> 0i64
    let fifth = digit (Timer.stop timer)
    first * 10000 + second * 1000 + third * 100 + fourth * 10 + fifth

// A ticker received five times and stopped sends nothing more, and keeps nothing it sent before.
export def ticker_five :: i64
fn ticker_five =
    let ticker = Ticker.create (2 * Time.millisecond())
    let ticks = Ticker.channel ticker
    let mut count = 0i64
    let mut last = 0i64
    for _ in 1 ..= 5 do
        match Channel.recv ticks with
        | Maybe.Some time ->
            if time > last then count = count + 1
            last = time
        | Maybe.None -> ()
    Ticker.stop ticker
    Time.sleep (30 * Time.millisecond())
    match Channel.try_recv ticks with
    | Channel.Empty -> count
    | _ -> -1

// Time.tick's channel dropped while it ticks: the boundary still frees everything (live == 0).
export def tick_dropped :: i64
fn tick_dropped =
    let ticks = Time.tick Time.millisecond()
    let mut seen = 0i64
    for _ in 1 ..= 2 do
        match Channel.recv ticks with
        | Maybe.Some _ -> seen = seen + 1
        | Maybe.None -> ()
    seen

// after_func calls the function once on another tzroutine, which tells the caller.
export def after_func_runs :: i64
fn after_func_runs =
    let called: Channel<i64> = Channel.make 1
    let signal = Channel.share called
    let _timer = Time.after_func (2 * Time.millisecond()) (Owned.function (\() -> Channel.send signal (Routine.count () - 1)))
    match Channel.recv called with
    | Maybe.Some others -> if others >= 1 then 1 else 0
    | Maybe.None -> 0

// A stopped after_func's function is dropped without a call when its Timer goes.
record Witness { counter: Arc<Atomic<i64>> }
instance Drop<Witness> {
    fn drop witness =
        let _previous = Atomic.fetch_add (Arc.get (ref witness.counter)) 1i64
}

export def after_func_stopped :: i64
fn after_func_stopped =
    let drops = Arc.new (Atomic.create 0i64)
    let witness = Witness { counter: Arc.share (ref drops) }
    let calls = Arc.new (Atomic.create 0i64)
    let mine = Arc.share (ref calls)
    let timer = Time.after_func Time.hour() (Owned.function (\() -> {
        let _keep = Atomic.load (Arc.get (ref witness.counter));
        let _call = Atomic.fetch_add (Arc.get (ref mine)) 1i64;
        ()
    }))
    let stopped = Timer.stop timer
    let _late = Timer.stop timer
    Owned.drop timer
    let dropped = Atomic.load (Arc.get (ref drops))
    let called = Atomic.load (Arc.get (ref calls))
    if stopped && dropped == 1i64 && called == 0i64 then 1 else 0

// Timers an hour away when the export ends: the boundary stops them without waiting and frees
// their channels (live == 0); the function of the after_func is dropped.
export def pending_at_exit :: i64
fn pending_at_exit =
    let _after = Time.after Time.hour()
    let _ticks = Time.tick Time.hour()
    let timer = Timer.create Time.hour()
    let _ticker_channel = Timer.channel timer
    let _ticker = Ticker.create Time.hour()
    let _func = Time.after_func Time.hour() (Owned.function (\() -> ()))
    tzroutine {
        let _inner = Time.after Time.hour()
    }
    1
