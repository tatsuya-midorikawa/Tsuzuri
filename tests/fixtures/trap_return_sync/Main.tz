// A trap inside Mutex.with_lock under --trap-mode return (F10): the boundary that catches it releases
// the lock and the thread forgets it, so the call after it and the children that wait for the lock go on.
export def lock_trap :: i64 -> i64
fn lock_trap divisor =
    let cell = Mutex.create 100i64
    Mutex.with_lock (ref cell) (value -> {
        deref value = deref value / divisor;
        deref value
    })

export def lock_after :: i64
fn lock_after =
    let cell = Mutex.create 5i64
    Mutex.with_lock (ref cell) (value -> deref value + 1)

// Every child adds to one total under the lock; the child `bad` traps while it holds the lock, and
// the children that wait for it must not wait for ever.
export def group_lock_trap :: i64 -> i64 -> i64
fn group_lock_trap count bad =
    let total = Mutex.create 0i64
    let results = Task.scope (ref total) count (shared -> index -> Mutex.with_lock shared (value -> {
        deref value = deref value + 100 / (if index == bad then 0 else 1);
        index
    }))
    Mutex.into_inner total + Array.sum (ref results)

// A nested lock is refused through the ordinary trap, which the boundary reports as well.
export def nested_lock :: i64
fn nested_lock =
    let outer = Mutex.create 1i64
    let inner = Mutex.create 2i64
    let inner_borrow = ref inner
    Mutex.with_lock (ref outer) (_value -> Mutex.with_lock inner_borrow (other -> deref other))

export def start_inside :: i64
fn start_inside =
    let outer = Mutex.create 1i64
    let unit_value = 0i64
    Mutex.with_lock (ref outer) (_value -> Array.sum (ref (Task.scope (ref unit_value) 3 (_shared -> index -> index))))

export def lock_again :: i64
fn lock_again =
    let cell = Mutex.create 41i64
    Mutex.with_lock (ref cell) (value -> deref value + 1)

// Channels under --trap-mode return (F10 Phase 2). A deadlock is a trap like any other: the verdict
// wakes every waiter with the failure, the group completes, and the boundary reports the trap and frees
// what the call allocated, the channels included. The pool and the thread are usable afterwards.
def produce :: Channel.Sender<i64> -> i64 -> Task<i64>
fn produce sender count = task {
    let mut index = 0
    while index < count do
        let _sent = Channel.send (ref sender) (index + 1)
        index = index + 1
    return count
}

def drain :: ref Channel.Receiver<i64> -> i64
fn drain receiver =
    let mut sum = 0
    let mut open = true
    while open do
        match Channel.recv receiver with
        | Maybe.Some value -> sum = sum + value
        | Maybe.None -> open = false
    sum

def consume :: Channel.Receiver<i64> -> Task<i64>
fn consume receiver = task { return drain (ref receiver) }

def quick :: i64 -> Task<i64>
fn quick value = task { return value }

// Room for every item, so the producer never waits and any pool size completes.
export def channel_ok :: i64 -> i64
fn channel_ok count =
    match Channel.bounded count with
    | (sender, receiver) ->
        let results = Task.run (Task.parallel [produce sender count, consume receiver])
        results[1]

// The sender stays with the caller, so the consumer waits for the end of a channel that nothing can
// close; the other task is done, and every thread waits: the verdict.
export def channel_deadlock :: i64
fn channel_deadlock =
    match Channel.bounded 2 with
    | (sender, receiver) ->
        let results = Task.run (Task.parallel [consume receiver, quick 7])
        Owned.drop sender
        results[0] + results[1]

def produce_then_divide :: Channel.Sender<i64> -> i64 -> i64 -> Task<i64>
fn produce_then_divide sender count divisor = task {
    let mut index = 0
    while index < count do
        let _sent = Channel.send (ref sender) (index + 1)
        index = index + 1
    return 100 / divisor
}

// The producer traps after it sent everything and before its sender is dropped, so the consumer
// waits for a close that never comes. The trap of the producer, the lower item, is the call's.
export def channel_producer_trap :: i64 -> i64 -> i64
fn channel_producer_trap count divisor =
    match Channel.bounded count with
    | (sender, receiver) ->
        let results = Task.run (Task.parallel [produce_then_divide sender count divisor, consume receiver])
        results[1]

// A channel operation inside a critical section is refused, and the lock is released by the boundary.
export def channel_in_lock :: i64
fn channel_in_lock =
    match Channel.bounded 2 with
    | (sender, receiver) ->
        let lock = Mutex.create 0i64
        let borrowed = ref sender
        let held = Mutex.with_lock (ref lock) (_value -> match Channel.send borrowed 1 with | Result.Ok _unit -> 1 | Result.Error _item -> 0)
        held + (match Channel.recv (ref receiver) with | Maybe.Some value -> value | Maybe.None -> 0)
