// A trap inside Mutex.with_lock under --trap-mode return (F10): the boundary that catches it releases
// the lock and the thread forgets it, so the call after it and the items that take the lock go on.
export def lock_trap :: own i64 -> i64
fn lock_trap divisor =
    let cell = Mutex.create 100i64
    Mutex.with_lock (ref cell) (\value -> {
        deref value = deref value / divisor;
        deref value
    })

export def lock_after :: i64
fn lock_after =
    let cell = Mutex.create 5i64
    Mutex.with_lock (ref cell) (\value -> deref value + 1)

// Every item of a Parallel adds to one total under the lock; the item `bad` traps while it holds the
// lock. Inside the boundary Parallel runs every item on the calling thread in index order (TZ12), so
// the trap leaves the lock held by that thread, and the boundary releases it.
export def group_lock_trap :: own i64 -> own i64 -> i64
fn group_lock_trap count bad =
    let total = Arc.new (Mutex.create 0i64)
    let shared = Arc.share (ref total)
    let results = Parallel.init count (\index -> Mutex.with_lock (Arc.get (ref shared)) (\value -> {
        deref value = deref value + 100 / (if index == bad then 0 else 1);
        index
    }))
    Mutex.with_lock (Arc.get (ref total)) (\value -> deref value) + Array.sum (ref results)

// A lock taken again by the thread that holds it is refused through the ordinary trap, which the
// boundary reports as well.
export def nested_lock :: i64
fn nested_lock =
    let cell = Mutex.create 1i64
    let borrowed = ref cell
    Mutex.with_lock borrowed (\_value -> Mutex.with_lock borrowed (\other -> deref other))

// Parallel inside a lock runs (TZ12: the lock is the G's, and inside the boundary the items run on
// the thread that holds it).
export def start_inside :: i64
fn start_inside =
    let outer = Mutex.create 1i64
    Mutex.with_lock (ref outer) (\_value -> Array.sum (ref (Parallel.init 3 (\index -> index))))

export def lock_again :: i64
fn lock_again =
    let cell = Mutex.create 41i64
    Mutex.with_lock (ref cell) (\value -> deref value + 1)

// Channels under --trap-mode return (F10 Phase 2, TZ12). The calling thread waits on the tzroutine
// scheduler; a wait that nothing can end is a deadlock, which the verdict turns into a trap of the call,
// and the boundary frees what the call allocated, the channels included. The thread is usable afterwards.
def produce :: own DataChannel.Sender<i64> -> own i64 -> i64
fn produce sender count =
    let mut index = 0
    while index < count do
        let _sent = DataChannel.send (ref sender) (index + 1)
        index = index + 1
    count

def drain :: ref DataChannel.Receiver<i64> -> i64
fn drain receiver =
    let mut sum = 0
    let mut open = true
    while open do
        match DataChannel.recv receiver with
        | Maybe.Some value -> sum = sum + value
        | Maybe.None -> open = false
    sum

// Room for every item, so the producer never waits; its sender is dropped when it returns, so the
// drain ends.
export def channel_ok :: own i64 -> i64
fn channel_ok count =
    match DataChannel.bounded count with
    | (sender, receiver) ->
        let _produced = produce sender count
        drain (ref receiver)

// The sender stays with the caller, so the drain waits for the end of a channel that nothing can
// close: the verdict.
export def channel_deadlock :: i64
fn channel_deadlock =
    match DataChannel.bounded 2 with
    | (sender, receiver) ->
        let sum = drain (ref receiver)
        Owned.drop sender
        sum + 7

def produce_then_divide :: own DataChannel.Sender<i64> -> own i64 -> own i64 -> i64
fn produce_then_divide sender count divisor =
    let mut index = 0
    while index < count do
        let _sent = DataChannel.send (ref sender) (index + 1)
        index = index + 1
    100 / divisor

// The producer traps after it sent everything and before its sender is dropped, with the items still
// in the channel: the trap of the call is the division, not a deadlock.
export def channel_producer_trap :: own i64 -> own i64 -> i64
fn channel_producer_trap count divisor =
    match DataChannel.bounded count with
    | (sender, receiver) ->
        let _produced = produce_then_divide sender count divisor
        drain (ref receiver)

// A send that can never complete inside a critical section (TZ12: a wait inside a lock is allowed):
// the thread waits while it holds the lock, the verdict traps the call, and the boundary releases the lock.
export def channel_in_lock :: i64
fn channel_in_lock =
    match DataChannel.bounded 1 with
    | (sender, receiver) ->
        let lock = Mutex.create 0i64
        let borrowed = ref sender
        let held = Mutex.with_lock (ref lock) (\_value -> {
            let _first = DataChannel.send borrowed 1;
            match DataChannel.send borrowed 2 with | Result.Ok _unit -> 1 | Result.Error _item -> 0
        })
        held + (match DataChannel.recv (ref receiver) with | Maybe.Some value -> value | Maybe.None -> 0)
