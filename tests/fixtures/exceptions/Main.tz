// Checked arithmetic, try/with/finally, `**`, bigint, composition, and the
// literal forms of _specs, on native and WASM at -O0 and -O3.

def checked_add_work :: i64 -> i64 -> Result<i64, Exception> = \a b ->
    try
        @checked a + b
    with
    | e is OverflowException -> e

export def checked_add :: i64 -> i64 -> i64
fn checked_add a b =
    match checked_add_work a b with
    | Ok value -> value
    | Error _ -> -1

export def checked_mul_i32 :: i64 -> i64 -> i64
fn checked_mul_i32 a b =
    let left = a as i32
    let right = b as i32
    let result = try @checked left * right with | e -> e
    match result with
    | Ok value -> value as i64
    | Error _ -> -1

export def checked_neg :: i64 -> i64
fn checked_neg a =
    match try (@checked -a) with | e -> e with
    | Ok value -> value
    | Error _ -> -1

export def checked_power :: i64 -> i64 -> i64
fn checked_power base exponent =
    match try (@checked base ** exponent) with | e -> e with
    | Ok value -> value
    | Error _ -> -1

export def checked_power_u8 :: i64 -> i64 -> i64
fn checked_power_u8 base exponent =
    let narrow = base as i8u
    match try (@checked narrow ** (exponent as i8u)) with | e -> e with
    | Ok value -> value as i64
    | Error _ -> -1

export def power_wrap :: i64 -> i64 -> i64
fn power_wrap base exponent = base ** exponent

export def power_i16 :: i64 -> i64 -> i64
fn power_i16 base exponent = ((base as i16) ** (exponent as i16)) as i64

export def float_power :: f64 -> f64 -> f64
fn float_power base exponent = base ** exponent

export def float_power_f32 :: f64 -> f64 -> f64
fn float_power_f32 base exponent = ((base as f32) ** (exponent as f32)) as f64

/// The finally block runs on every path; an exception no arm matches
/// propagates to the outer `try` after the inner `finally`.
export def nested_finally :: i64 -> i64
fn nested_finally value =
    let mut ran = 0
    let outer =
        try
            let inner =
                try
                    @checked value * value
                with
                | e when value < 0 -> e
                finally
                    ran = ran + 1
            match inner with
            | Ok square -> square
            | Error _ -> -2
        with
        | e is OverflowException -> e
        finally
            ran = ran + 10
    match outer with
    | Ok result -> result * 100 + ran
    | Error _ -> -100 + ran

/// A `finally` that raises leaves its `try`: the result it was holding is
/// dropped, and an exception that was leaving is replaced.
export def finally_raises :: i64 -> i64
fn finally_raises value =
    let outer =
        try
            let inner =
                try
                    let square = @checked value * value
                    "owned " + to_string square
                with
                | e when value < 0 -> e
                finally
                    ignore (@checked value * 4611686018427387904)
            match inner with
            | Ok text -> text.length
            | Error _ -> -1
        with
        | e is OverflowException -> e
    match outer with
    | Ok length -> length
    | Error _ -> -2

/// Owned values that a raise leaves are dropped exactly once.
export def loop_strings :: i64 -> i64
fn loop_strings count =
    let mut caught = 0
    let mut total = 0
    for index in 0 .. count - 1 do
        let label = to_string index
        let result =
            try
                let text = label + "-" + to_string index
                let limit = @checked 9223372036854775800 + index
                text.length + limit % 2
            with
            | e -> e
        match result with
        | Ok length -> total = total + length
        | Error _ -> caught = caught + 1
    total * 1000 + caught

export def uncaught :: i64 -> i64
fn uncaught value = @checked value + 1

def checked_entry :: i32 -> i32 -> Result<i32, 'E>
    @'E : Err = \x y ->
    try
        @checked
        let result = x + y
        result
    with
    | e is OverflowException -> e

export def checked_message :: i64 -> i64
fn checked_message value =
    match checked_entry (value as i32) 1i32 with
    | Ok result -> result as i64
    | Error e -> (Err.msg (ref e)).length

export def bigint_digits :: i64 -> i64
fn bigint_digits exponent =
    let power = 2I ** BigInt.of_i64 exponent
    (to_string power).length

export def bigint_mod :: i64 -> i64 -> i64
fn bigint_mod high low =
    let value = BigInt.of_i64 high * 100000000000000000000I + BigInt.of_i64 low
    let modulus: bigint = 1000000007
    match BigInt.to_i64 (ref (value % modulus)) with
    | Some result -> result
    | None -> -1

export def bigint_division :: i64 -> i64 -> i64
fn bigint_division dividend divisor =
    let quotient = BigInt.of_i64 dividend / BigInt.of_i64 divisor
    let remainder = BigInt.of_i64 dividend % BigInt.of_i64 divisor
    match (BigInt.to_i64 (ref quotient), BigInt.to_i64 (ref remainder)) with
    | (Some q, Some r) -> q * 1000 + r
    | _ -> 0

export def bigint_compare :: i64 -> i64 -> i64
fn bigint_compare left right =
    let a = BigInt.of_i64 left - 99999999999999999999I
    let b = BigInt.of_i64 right - 99999999999999999999I
    if a < b then -1 else if a == b then 0 else 1

export def compose :: i64 -> i64
fn compose value =
    let forward = (\x -> x + 1) >> (\x -> x * 2)
    let backward = (\x -> x + 1) << (\x -> x * 2)
    forward value * 1000 + backward value

export def logic :: i64 -> i64 -> i64
fn logic first second =
    let left = first != 0
    let right = second != 0
    let negated = not left
    let piped = right |> not
    ignore (to_string left)
    (if negated then 1 else 0) + (if piped then 10 else 0) + (if not (left && right) then 100 else 0)

export def bits :: i64 -> i64 -> i64
fn bits value shift =
    ((value &&& 0xFF) ||| (value ^^^ shift)) + (~~~value) + (value <<< shift) + (value >>> shift) + Bits.ushr value shift

export def suffixes :: i64
fn suffixes =
    let small = 100y
    let byte = 200uy
    let short = -300s
    let word = 400us
    let unsigned = 500u
    let long = 6000000000l
    let ulong = 7ul
    let wide = 8L
    let uwide = 9UL
    let half = 1.5hf
    let single = 2.5f
    let quad = 3.5F
    let decimal = 0.25m
    let integers = (small as i64) + (byte as i64) + (short as i64) + (word as i64) + (unsigned as i64) + long + (ulong as i64)
    let floats = (half as f64) + (single as f64) + (quad as f64) + (decimal as f64)
    integers + (wide as i64) + (uwide as i64) + floats as i64

export def bytes :: i64
fn bytes =
    let letter = 'A'B
    let text = "hi"B
    let scalars = u8"é!"B
    (letter as i64) * 1000000 + (text[0] as i64) * 1000 + (text[1] as i64) + scalars.length * 100000000

export def default_literals :: i64
fn default_literals =
    let small = 2147483647
    let wrapped = small + 1
    let r: f64 = 2
    let square = r ** 2
    (wrapped as i64) + (square as i64)

export def pipeline :: i64 -> i64
fn pipeline count =
    let double = \value -> value * 2
    let values = Array.init count (\index -> index)
    let total = values |> Array.map double |> Array.sum
    let folded = Array.fold (\state value -> state * 3 + value) 0 (ref values)
    let backward = Array.fold_back (\value state -> state * 3 + value) (ref values) 0
    total * 1000000 + (values |> (Array.map double >> Array.sum)) + folded % 1000 + backward % 7
