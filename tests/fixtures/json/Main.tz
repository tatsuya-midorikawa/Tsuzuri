record Point { x: i64, y: f64 } deriving (Encode, Decode)
union Shape = Circle of f64 | Rect of f64 * f64 | Empty deriving (Encode, Decode)
record Scene { name: string, points: [Point], shapes: Vec<Shape>, note: Maybe<string> } deriving (Encode, Decode)

def fnv :: ref utf8string -> i64
fn fnv text =
    let mut hash = 14695981039346656037i64u
    for byte in text do hash = (hash ^^^ (byte as i64u)) * 1099511628211i64u
    hash as i64

def kind_number :: ref Json.ErrorKind -> i64
fn kind_number kind =
    match kind with
    | Json.Syntax -> 1
    | Json.UnexpectedEnd -> 2
    | Json.InvalidEscape -> 3
    | Json.ControlCharacter -> 4
    | Json.DuplicateKey _ -> 5
    | Json.TooDeep -> 6
    | Json.TooLarge -> 7
    | Json.NonFinite -> 8
    | Json.NumberRange -> 9
    | Json.ExpectedType _ -> 10
    | Json.MissingField _ -> 11
    | Json.UnknownCase _ -> 12
    | Json.LoneSurrogate -> 13
    | Json.InvalidUtf8 -> 14
    | Json.Unsupported _ -> 15

/// The error kind times 2^40 plus its offset.
def error_status :: ref Json.Error -> i64
fn error_status error = kind_number (ref error.kind) * 1099511627776 + error.offset

/// -1 for success, or `error_status` of the error.
def status :: Result<'a, Json.Error> -> i64
fn status result =
    match result with
    | Ok _ -> -1
    | Error error -> error_status (ref error)

/// The FNV-1a hash of the UTF-8 text of the error, or 0 for success.
def message :: Result<'a, Json.Error> -> i64
fn message result =
    match result with
    | Ok _ -> 0
    | Error error ->
        let text = Utf8String.from_string (ref (Display.display (ref error)))
        fnv (ref text)

def text_hash :: Result<utf8string, Json.Error> -> i64
fn text_hash result =
    match result with
    | Ok text -> fnv (ref text)
    | Error error -> error_status (ref error)

def scene :: unit -> Scene
fn scene _unit =
    let shapes = Vec.push (Vec.push (Vec.push (Vec.empty()) (Circle 2.0)) (Rect (1.0, 2.5))) Empty
    Scene { name: "a", points: [Point { x: 1, y: 0.5 }], shapes: shapes, note: None }

export def scene_hash :: i64
fn scene_hash =
    let value = scene ()
    text_hash (Json.serialize (ref value))

export def scene_round_trip :: bool
fn scene_round_trip =
    let value = scene ()
    let text = Result.get (Json.serialize (ref value))
    let back: Result<Scene, Json.Error> = Json.deserialize (ref text)
    match back with
    | Ok copy ->
        let again = Result.get (Json.serialize (ref copy))
        again == text && copy.name == "a" && copy.points[0].x == 1 && copy.points[0].y == 0.5 && Vec.length (ref copy.shapes) == 3
    | Error _ -> false

/// `[` n times and `]` n times.
export def nesting :: i64 -> i64
fn nesting count =
    let mut bytes = Vec.with_capacity (count * 2)
    for _index in 1 .. count do bytes = Vec.push bytes 91ubyte
    for _index in 1 .. count do bytes = Vec.push bytes 93ubyte
    let text = Maybe.get (Utf8String.from_bytes (Vec.to_array bytes))
    status (Json.parse (ref text))

/// `{"a":` n times, `1`, and `}` n times.
export def object_nesting :: i64 -> i64
fn object_nesting count =
    let mut bytes = Vec.with_capacity (count * 6 + 1)
    for _index in 1 .. count do
        bytes = Vec.push (Vec.push (Vec.push (Vec.push (Vec.push bytes 123ubyte) 34ubyte) 97ubyte) 34ubyte) 58ubyte
    bytes = Vec.push bytes 49ubyte
    for _index in 1 .. count do bytes = Vec.push bytes 125ubyte
    let text = Maybe.get (Utf8String.from_bytes (Vec.to_array bytes))
    status (Json.parse (ref text))

/// An input of 64 MiB + 1 bytes is refused before it is read.
export def too_large :: i64
fn too_large =
    let mut bytes = Vec.with_capacity 67108865
    for _index in 1 .. 67108865 do bytes = Vec.push bytes 32ubyte
    let text = Maybe.get (Utf8String.from_bytes (Vec.to_array bytes))
    status (Json.parse (ref text))

def number_text :: i64 -> utf8string
fn number_text case =
    match case with
    | 0 -> u8"0.1"
    | 1 -> u8"-0"
    | 2 -> u8"5e-324"
    | 3 -> u8"1.7976931348623157e308"
    | 4 -> u8"-1e-400"
    | 5 -> u8"1.000000059604644775390625000000001"
    | 6 -> u8"123456789012345678901234567890"
    | 7 -> u8"1e400"
    | 8 -> u8"-0.0e-0"
    | _ -> u8"2.2250738585072011e-308"

/// The f64 that `Json.to_f64` reads from case `case`, or NaN on failure.
export def number_value :: i64 -> f64
fn number_value case =
    let text = number_text case
    let numeral = Maybe.get (Json.numeral (ref text))
    match Json.to_f64 (ref numeral) with
    | Ok value -> value
    | Error _ -> 0.0 / 0.0

/// 1 or -1 by the sign bit of `number_value case`.
export def number_sign :: i64 -> f64
fn number_sign case = Math.copysign 1.0 (number_value case)

export def number_status :: i64 -> i64
fn number_status case =
    let text = number_text case
    let numeral = Maybe.get (Json.numeral (ref text))
    status (Json.to_f64 (ref numeral))

/// The f32 that `Decode` reads, rounded once from the text.
export def float32_value :: i64 -> f64
fn float32_value case =
    let text = number_text case
    let decoded: Result<f32, Json.Error> = Json.deserialize (ref text)
    match decoded with
    | Ok value -> value as f64
    | Error _ -> 0.0 / 0.0

def as_i64 :: utf8string -> i64
fn as_i64 text =
    let decoded: Result<i64, Json.Error> = Json.deserialize (ref text)
    status decoded

def as_i64u :: utf8string -> i64
fn as_i64u text =
    let decoded: Result<i64u, Json.Error> = Json.deserialize (ref text)
    match decoded with
    | Ok value -> if value == 18446744073709551615i64u then -2 else -1
    | Error error -> error_status (ref error)

def as_i8 :: utf8string -> i64
fn as_i8 text =
    let decoded: Result<i8, Json.Error> = Json.deserialize (ref text)
    match decoded with
    | Ok value -> value as i64
    | Error error -> error_status (ref error)

def as_i128u :: utf8string -> i64
fn as_i128u text =
    let decoded: Result<i128u, Json.Error> = Json.deserialize (ref text)
    match decoded with
    | Ok value -> (value % 1000000007i128u) as i64
    | Error error -> error_status (ref error)

export def integer_status :: i64 -> i64
fn integer_status case =
    match case with
    | 0 -> as_i64 u8"9223372036854775807"
    | 1 -> as_i64 u8"9223372036854775808"
    | 2 -> as_i64 u8"1.0"
    | 3 -> as_i64u u8"18446744073709551615"
    | 4 -> as_i64 u8"-9223372036854775808"
    | 5 -> as_i64u u8"-0"
    | 6 -> as_i64u u8"-1"
    | 7 -> as_i64 u8"1e2"
    | 8 -> as_i128u u8"340282366920938463463374607431768211455"
    | 9 -> as_i64 u8"\"5\""
    | 10 -> as_i8 u8"128"
    | 11 -> as_i8 u8"-128"
    | _ -> as_i64 u8" -00"

def field_text :: i64 -> utf8string
fn field_text case =
    match case with
    | 0 -> u8"{\"x\":1}"
    | 1 -> u8"{\"x\":1,\"y\":2,\"z\":3}"
    | 2 -> u8"{\"x\":1.5,\"y\":2}"
    | 3 -> u8"{\"x\":1,\"y\":null}"
    | 4 -> u8"[1,2]"
    | 5 -> u8"{\"Square\":1}"
    | 6 -> u8"\"Circle\""
    | 7 -> u8"\"Empty\""
    | 8 -> u8"{\"Empty\":1}"
    | 9 -> u8"{\"Circle\":1,\"Rect\":2}"
    | 10 -> u8"5"
    | 11 -> u8"{\"Rect\":[1]}"
    | 12 -> u8"{\"Rect\":[1,2]}"
    | 13 -> u8"[1,2,]"
    | 14 -> u8"{\"a\":1,\"a\":2}"
    | 15 -> u8"01"
    | _ -> u8"{\"x\":1,\"y\":2,\"x\":3}"

def as_point :: utf8string -> Result<Point, Json.Error>
fn as_point text = Json.deserialize (ref text)

def as_shape :: utf8string -> Result<Shape, Json.Error>
fn as_shape text = Json.deserialize (ref text)

/// Decoding rules of derived records and unions, as status codes.
export def field_rules :: i64 -> i64
fn field_rules case =
    let text = field_text case
    if case < 5 || case >= 13 then status (as_point text) else status (as_shape text)

/// The FNV-1a hash of the error message of `field_rules case`.
export def field_messages :: i64 -> i64
fn field_messages case =
    let text = field_text case
    if case < 5 || case >= 13 then message (as_point text) else message (as_shape text)

export def text_rules :: i64 -> i64
fn text_rules case =
    match case with
    | 0 -> text_hash (Json.serialize (ref "\uD800"))
    | 1 ->
        let decoded: Result<utf8string, Json.Error> = Json.deserialize (ref u8"\"\\ud800\"")
        status decoded
    | 2 -> status (Json.encode (ref (0.0 / 0.0)))
    | 3 -> status (Json.encode (ref (1.0f32 / 0.0f32)))
    | 4 ->
        let decoded: Result<utf8string, Json.Error> = Json.deserialize (ref u8"\"\\ud83d\\ude00\"")
        match decoded with
        | Ok text -> fnv (ref text)
        | Error error -> error_status (ref error)
    | 5 -> text_hash (Json.serialize (ref "\u2028\u007f/\"\\\uD83D\uDE00\uDC00"))
    | 6 ->
        let units = new [i16u](32, \index -> index as i16u)
        text_hash (Json.serialize (ref (String.from_code_units units)))
    | 7 -> text_hash (Json.serialize (ref (-0.0)))
    | 8 -> text_hash (Json.serialize (ref 10000000.0))
    | 9 -> text_hash (Json.serialize (ref 0.1f32))
    | 10 -> text_hash (Json.serialize (ref [Some 1i8, None]))
    | 11 ->
        let pair: (Maybe<Maybe<i64>> * Maybe<Maybe<i64>> * [|i64|]) = (Some (Some 1), Some None, [|2, 3|])
        text_hash (Json.serialize (ref pair))
    | _ -> text_hash (Json.serialize (ref (-170141183460469231731687303715884105728i128, 340282366920938463463374607431768211455i128u, true, u8"é")))

union Color = Red | Green | Blue deriving (Encode, Decode, Eq, Ord, Hash)

def map_text :: Result<Map<i64, string>, Json.Error> -> i64
fn map_text result =
    match result with
    | Ok map -> text_hash (Json.serialize (ref map))
    | Error error -> error_status (ref error)

/// Maps, sets, and the other numeric types (D08 Phase 2).
export def container_hash :: i64 -> i64
fn container_hash case =
    match case with
    | 0 ->
        let names = Map.insert (Map.insert Map.empty() "b" 2) "a" 1
        text_hash (Json.serialize (ref names))
    | 1 ->
        let numbers = Map.insert (Map.insert Map.empty() 10 "x") 2 "y"
        text_hash (Json.serialize (ref numbers))
    | 2 ->
        let empty: Map<i64, string> = Map.empty()
        text_hash (Json.serialize (ref empty))
    | 3 ->
        let table = HashMap.insert (HashMap.insert (HashMap.insert HashMap.empty() "z" 1) "a" 2) "z" 3
        text_hash (Json.serialize (ref table))
    | 4 ->
        let colors = HashMap.insert (HashMap.insert HashMap.empty() Blue 1.5f16) Red 65504.0f16
        text_hash (Json.serialize (ref colors))
    | 5 ->
        let set = Set.insert (Set.insert Set.empty() 2.50m) 1.0m
        text_hash (Json.serialize (ref set))
    | 6 ->
        let set = HashSet.insert (HashSet.insert (HashSet.insert HashSet.empty() 3) 1) 3
        text_hash (Json.serialize (ref set))
    | 7 -> text_hash (Json.serialize (ref (0.5f16, 0.1f16, 1e300F, (1.10hm, -0.0M))))
    | 8 ->
        let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref u8"[1, 2, 2]")
        status decoded
    | 9 ->
        let decoded: Result<Map<string, i64>, Json.Error> = Json.deserialize (ref u8"{\"a\":1}")
        match decoded with
        | Ok map -> text_hash (Json.serialize (ref map))
        | Error error -> error_status (ref error)
    | 10 -> map_text (Json.deserialize (ref u8"[[1,\"a\"],[2]]"))
    | 11 -> map_text (Json.deserialize (ref u8"5"))
    | 12 -> map_text (Json.deserialize (ref u8"[[2,\"b\"],[1,\"a\"]]"))
    | 13 ->
        let decoded: Result<f16, Json.Error> = Json.deserialize (ref u8"65520")
        status decoded
    | 14 ->
        let decoded: Result<d32, Json.Error> = Json.deserialize (ref u8"1.234567890")
        match decoded with
        | Ok value -> text_hash (Json.serialize (ref value))
        | Error error -> error_status (ref error)
    | 15 -> status (Json.encode (ref (0.0m / 0.0m)))
    | 16 ->
        let decoded: Result<HashMap<Color, i64>, Json.Error> = Json.deserialize (ref u8"{\"Blue\":1,\"Red\":2}")
        match decoded with
        | Ok map -> text_hash (Json.serialize (ref map))
        | Error error -> error_status (ref error)
    | _ -> map_text (Json.deserialize (ref u8"{\"1\":\"a\"}"))

/// The integers from `count - 1` down to 0.
def descending_keys :: i64 -> Vec<i64>
fn descending_keys count =
    let mut keys = Vec.with_capacity count
    for index in 1 .. count do keys = Vec.push keys (count - index)
    keys

/// "k" and `number` in five digits.
def key_name :: i64 -> string
fn key_name number =
    let mut digits = to_string number
    while String.length (ref digits) < 5 do digits = "0" + digits
    "k" + digits

/// The JSON object of `count` members whose keys descend: `key_name n` and `n` from `count - 1` to 0.
def descending_object :: i64 -> utf8string
fn descending_object count =
    let mut members = Vec.with_capacity count
    for index in 1 .. count do
        let number = count - index
        members = Vec.push members (key_name number, Result.get (Json.encode (ref number)))
    let object = Json.Object (Vec.to_array members)
    Json.to_utf8string (ref object)

/// `count` entries whose keys descend: inserting them into the sorted `Map` or `Set` one by one in
/// document order would shift every entry (quadratic time). The number of entries when they come
/// out as the keys 0, 1, ... in order (and, for maps, with their values), or the error status.
export def descending :: i64 -> i64 -> i64
fn descending case count =
    match case with
    | 0 ->
        let keys = descending_keys count
        let text = Result.get (Json.serialize (ref keys))
        let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref text)
        match decoded with
        | Ok set -> Set.fold (\position key -> if position >= 0 && deref key == position then position + 1 else -1) 0 (ref set)
        | Error error -> error_status (ref error)
    | 1 ->
        let mut pairs = Vec.with_capacity count
        for index in 1 .. count do pairs = Vec.push pairs (count - index, (count - index) * 3)
        let text = Result.get (Json.serialize (ref pairs))
        let decoded: Result<Map<i64, i64>, Json.Error> = Json.deserialize (ref text)
        match decoded with
        | Ok map -> Map.fold (\position key item -> if position >= 0 && deref key == position && deref item == position * 3 then position + 1 else -1) 0 (ref map)
        | Error error -> error_status (ref error)
    | _ ->
        let text = descending_object count
        let decoded: Result<Map<string, i64>, Json.Error> = Json.deserialize (ref text)
        match decoded with
        | Ok map -> Map.fold (\position key item -> if position >= 0 && deref key == key_name position && deref item == position then position + 1 else -1) 0 (ref map)
        | Error error -> error_status (ref error)

/// `count` keys in a scrambled order, `(index * 7919) % count`, except that the element `count / 2`
/// repeats the key of the element `count / 3` and the last element repeats the first (0).
def scattered :: i64 -> Vec<i64>
fn scattered count =
    let mut keys = Vec.with_capacity count
    for index in 0 .. (count - 1) do
        let source = if index == count - 1 then 0 elif index == count / 2 then count / 3 else index
        keys = Vec.push keys ((source * 7919) % count)
    keys

def unit_of :: Result<'a, Json.Error> -> Result<unit, Json.Error>
fn unit_of result =
    match result with
    | Ok _ -> Ok ()
    | Error error -> Error error

/// A key decoded from the digits of a JSON string, so that "3" and "03" are the same key.
record Digits { value: i64 } deriving (Eq, Ord)

instance Decode<Digits> {
    fn decode value =
        let number: Maybe<i64> = match value with
            | Json.Text text -> Parse.parse text
            | _ -> None
        match number with
        | Some digits -> Ok (Digits { value: digits })
        | None -> Error (Json.Error { kind: Json.ExpectedType "digits", offset: -1 })
}

def duplicate_result :: i64 -> Result<unit, Json.Error>
fn duplicate_result case =
    match case with
    | 0 ->
        let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref u8"[9, 1, 9, 5, 1]")
        unit_of decoded
    | 1 ->
        let decoded: Result<Set<f64>, Json.Error> = Json.deserialize (ref u8"[2.0, 1, 2, 1.0]")
        unit_of decoded
    | 2 ->
        let decoded: Result<Map<i64, string>, Json.Error> = Json.deserialize (ref u8"[[3,\"a\"],[1,\"b\"],[2,\"c\"],[1,\"d\"],[3,\"e\"]]")
        unit_of decoded
    | 3 ->
        let decoded: Result<Map<f64, i64>, Json.Error> = Json.deserialize (ref u8"[[10,1],[2,2],[1e1,3],[2.0,4]]")
        unit_of decoded
    | 4 ->
        let decoded: Result<Map<Digits, i64>, Json.Error> = Json.deserialize (ref u8"{\"3\":0,\"1\":1,\"03\":2,\"001\":3}")
        unit_of decoded
    | 5 ->
        let decoded: Result<Set<Color>, Json.Error> = Json.deserialize (ref u8"[\"Red\",\"Blue\",\"Green\",\"Blue\",\"Red\"]")
        unit_of decoded
    | 6 ->
        let decoded: Result<HashMap<i64, i64>, Json.Error> = Json.deserialize (ref u8"[[4,0],[8,1],[8,2],[4,3]]")
        unit_of decoded
    | 7 ->
        let decoded: Result<Map<i64, i64>, Json.Error> = Json.deserialize (ref u8"[[5,0],[5,1],[[1],2]]")
        unit_of decoded
    | 8 ->
        let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref u8"[3,2,1,0]")
        unit_of decoded
    | 9 ->
        let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref u8"[]")
        unit_of decoded
    | _ ->
        let decoded: Result<Map<i64, i64>, Json.Error> = Json.deserialize (ref u8"{}")
        unit_of decoded

/// Keys repeated in a random order: the error names the entry at the smallest document index whose
/// key repeats an earlier key (the error of inserting in document order), with the text it has there.
export def duplicate_status :: i64 -> i64
fn duplicate_status case = status (duplicate_result case)

export def duplicate_message :: i64 -> i64
fn duplicate_message case = message (duplicate_result case)

/// The FNV-1a hash of the error of decoding `scattered count` as a set.
export def scattered_message :: i64 -> i64
fn scattered_message count =
    let keys = scattered count
    let text = Result.get (Json.serialize (ref keys))
    let decoded: Result<Set<i64>, Json.Error> = Json.deserialize (ref text)
    message decoded

record User { @json "user_id" id: i64, @json "display name" name: string, email: Maybe<string> } deriving (Encode, Decode)
union Change =
    | @json "created" Created of User
    | @json "deleted" Deleted of i64
    | Reset
    deriving (Encode, Decode)

def as_changes :: utf8string -> Result<[Change], Json.Error>
fn as_changes text = Json.deserialize (ref text)

/// `@json` names of fields and cases (D08 Phase 2).
export def renamed :: i64 -> i64
fn renamed case =
    match case with
    | 0 ->
        let changes = [Created (User { id: 7, name: "Ann", email: None }), Deleted 7, Reset]
        text_hash (Json.serialize (ref changes))
    | 1 ->
        match as_changes u8"[{\"created\":{\"user_id\":1,\"display name\":\"B\"}},\"Reset\"]" with
        | Ok changes -> text_hash (Json.serialize (ref changes))
        | Error error -> error_status (ref error)
    | 2 -> status (as_changes u8"[{\"Created\":{\"user_id\":1,\"display name\":\"B\"}}]")
    | _ -> status (as_changes u8"[{\"created\":{\"id\":1,\"display name\":\"B\"}}]")

export def renamed_message :: i64
fn renamed_message = message (as_changes u8"[{\"created\":{\"id\":1,\"display name\":\"B\"}}]")

/// Pretty printing like `JSON.stringify(value, null, indent)`.
export def pretty :: i64 -> i64
fn pretty indent =
    let text = u8"{\"a\":[1,{\"b\":[]},{}],\"c\":\"d\",\"e\":{\"f\":null}}"
    let value = Result.get (Json.parse (ref text))
    let indented = Json.to_utf8string_pretty (ref value) indent
    fnv (ref indented)

def write_all :: unit -> Result<utf8string, Json.Error>
fn write_all _unit = Result {
    let! w0 = Json.open_object (Json.writer ())
    let! w1 = Json.write_key w0 (ref "a")
    let! w2 = Json.open_array w1
    let! w3 = Json.write_null w2
    let! w4 = Json.write_bool w3 true
    let! w5 = Json.write_number w4 (ref (Maybe.get (Json.numeral (ref u8"1.50"))))
    let! w6 = Json.write_json w5 (ref (Json.Object [("x", Json.Items [])]))
    let! w7 = Json.close_array w6
    let! w8 = Json.write_key w7 (ref "b\n")
    let! w9 = Json.write_text w8 (ref "x\"y\uD800")
    let! w10 = Json.close_object w9
    return! Json.finish w10
}

def write_bad :: i64 -> Result<utf8string, Json.Error>
fn write_bad case =
    match case with
    | 0 -> Result {
            let! w0 = Json.open_object (Json.writer ())
            let! w1 = Json.write_null w0
            return! Json.finish w1
        }
    | 1 -> Result {
            let! w0 = Json.open_array (Json.writer ())
            let! w1 = Json.write_key w0 (ref "k")
            return! Json.finish w1
        }
    | 2 -> Result {
            let! w0 = Json.open_array (Json.writer ())
            let! w1 = Json.write_null w0
            return! Json.finish w1
        }
    | 3 -> Result {
            let! w0 = Json.write_null (Json.writer ())
            let! w1 = Json.write_null w0
            return! Json.finish w1
        }
    | 4 -> Result {
            let! w0 = Json.open_array (Json.writer ())
            let! w1 = Json.close_object w0
            return! Json.finish w1
        }
    | 5 -> Json.finish (Json.writer ())
    | 6 -> Result {
            let! w0 = Json.open_object (Json.writer ())
            let! w1 = Json.write_key w0 (ref "k")
            let! w2 = Json.close_object w1
            return! Json.finish w2
        }
    | _ -> Result {
            let! w0 = Json.write_number (Json.writer ()) (ref (Json.Numeral { text: u8"01" }))
            return! Json.finish w0
        }

/// The incremental writer: a valid sequence, and misuses as status codes.
export def writer_check :: i64 -> i64
fn writer_check case = if case < 0 then text_hash (write_all ()) else text_hash (write_bad case)

def event_text :: ref utf8string -> ref Json.Event -> string
fn event_text text event =
    match event with
    | Json.ObjectStart -> "{"
    | Json.ObjectEnd -> "}"
    | Json.ArrayStart -> "["
    | Json.ArrayEnd -> "]"
    | Json.KeyToken token -> "K" + Result.get (Json.token_text text token) + (if token.escaped then "!" else "") + (if Json.token_matches text token (ref "a") then "=a" else "")
    | Json.TextToken token -> "S" + Result.get (Json.token_text text token) + (if token.escaped then "!" else "")
    | Json.NumberToken token ->
        let numeral = Result.get (Json.token_numeral text token)
        "N" + String.from_utf8 (ref numeral.text) + "@" + to_string token.start
    | Json.BoolToken flag -> if flag then "T" else "F"
    | Json.NullToken -> "Z"
    | Json.EndOfInput -> "$"

/// The events of the pull parser joined with spaces, then `|` and the error status if it fails.
def events :: utf8string -> string
fn events text =
    let mut out = ""
    let mut state = Json.reader (ref text)
    let mut going = true
    while going do
        match state with
        | Error error ->
            out = out + "|" + to_string (error_status (ref error))
            going = false
            state = Error error
        | Ok reader ->
            match Json.next (ref text) reader with
            | Ok (event, after) ->
                out = out + " " + event_text (ref text) (ref event)
                if event == Json.EndOfInput then going = false
                state = Ok after
            | Error error ->
                out = out + "|" + to_string (error_status (ref error))
                going = false
                state = Error error
    out

def stream_text :: i64 -> utf8string
fn stream_text case =
    match case with
    | 0 -> u8" {\"a\": [1, \"x\\u0041\", true, null, {}], \"b\": {\"c\": -2.5e3}} "
    | 1 -> u8"{\"a\":1,\"a\":[1,]}"
    | 2 -> u8"[1, 2"
    | 3 -> u8"{\"k\":1, \"k\":2}"
    | 4 -> u8"[] x"
    | 5 -> u8"\"\\u00e9t\\u00e9\""
    | 6 -> u8"{\"a\":{\"b\":1,\"b\":2},\"a\":3}"
    | _ -> u8"[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[["

/// The FNV-1a hash of the event text of the pull parser for case `case`.
export def stream_events :: i64 -> i64
fn stream_events case =
    let text = Utf8String.from_string (ref (events (stream_text case)))
    fnv (ref text)
