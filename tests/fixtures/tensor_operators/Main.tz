// NC19: 43 Tensor operator extension instances (View/Tensor/Scalar +, -, *, /, %, **, unary -),
// broadcasting, negative strides, empty tensors, integer `/` and `%` sign rules, and allocation parity.

private def fold_i64 :: own Tensor<i64> -> i64 = \t ->
    let arr = Tensor.to_array t
    let mut acc: i64 = 0
    for v in arr do
        acc = acc * 37 + v
    acc

private def fold_f64_scaled :: own Tensor<f64> -> i64 = \t ->
    let arr = Tensor.to_array t
    let mut acc: i64 = 0
    for v in arr do
        acc = acc * 37 + ((v * 100.0) as i64)
    acc

// Specification §7 examples (`ref a[1..] - ref a[..^1]`, `2.0 * x + 1.0`, `x - 1`, `x ** 2`, broadcast, `-view`)
export def spec_examples_f64 :: i64
fn spec_examples_f64 =
    let a = Tensor.of_array [5] [10.0, 20.0, 30.0, 40.0, 50.0]
    let d = ref a[1..] - ref a[..^1]
    let d_legacy = ref a[[Slice.from 1]] - ref a[[Slice.until (-1)]]
    assert (d == d_legacy)
    let x = Tensor.of_array [3] [0.5, 1.5, 2.5]
    let y = 2.0 * x + 1.0
    let z = x - 1
    let p = x ** 2
    fold_f64_scaled d + fold_f64_scaled y + fold_f64_scaled z + fold_f64_scaled p

export def spec_broadcast_and_neg_i64 :: i64
fn spec_broadcast_and_neg_i64 =
    let t = Tensor.init [2, 3] (\i -> i)
    let row = Tensor.init [3] (\i -> (i + 1) * 10)
    let s = t + Tensor.view (ref row)
    let n = -(Tensor.view (ref row))
    let col = Tensor.of_array [2, 1] [100, 200]
    let r13 = Tensor.of_array [1, 3] [1, 2, 3]
    let grid = Tensor.view (ref col) + Tensor.view (ref r13)
    let s0 = Tensor.of_array [] [5]
    let with_0d = Tensor.view (ref grid) * Tensor.view (ref s0)
    fold_i64 s + fold_i64 n + fold_i64 with_0d

// All 7 binary shapes across +, -, *, /, %, ** and unary Neg<View>
export def all_43_forms_i64 :: i64
fn all_43_forms_i64 =
    let t = Tensor.of_array [3] [12, 20, 30]
    let u = Tensor.of_array [3] [3, 4, 5]
    let vt = Tensor.view (ref t)
    let vu = Tensor.view (ref u)

    // Add (7)
    let a1 = vt + vu
    let a2 = t + vu
    let a3 = vt + u
    let a4 = 2 + t
    let a5 = t + 2
    let a6 = 2 + vt
    let a7 = vt + 2
    assert (a1 == a2 && a2 == a3 && a4 == a5 && a5 == a6 && a6 == a7)

    // Sub (7, non-commutative!)
    let s1 = vt - vu
    let s2 = t - vu
    let s3 = vt - u
    let s4 = 100 - t
    let s5 = t - 100
    let s6 = 100 - vt
    let s7 = vt - 100
    assert (s1 == s2 && s2 == s3 && s4 == s6 && s5 == s7)

    // Mul (7)
    let m1 = vt * vu
    let m2 = t * vu
    let m3 = vt * u
    let m4 = 3 * t
    let m5 = t * 3
    let m6 = 3 * vt
    let m7 = vt * 3
    assert (m1 == m2 && m2 == m3 && m4 == m5 && m5 == m6 && m6 == m7)

    // Div (7, non-commutative!)
    let d1 = vt / vu
    let d2 = t / vu
    let d3 = vt / u
    let d4 = 120 / t
    let d5 = t / 2
    let d6 = 120 / vt
    let d7 = vt / 2
    assert (d1 == d2 && d2 == d3 && d4 == d6 && d5 == d7)

    // Rem (7, non-commutative!)
    let r1 = vt % vu
    let r2 = t % vu
    let r3 = vt % u
    let r4 = 100 % t
    let r5 = t % 7
    let r6 = 100 % vt
    let r7 = vt % 7
    assert (r1 == r2 && r2 == r3 && r4 == r6 && r5 == r7)

    // Pow (7, non-commutative!)
    let p_base = Tensor.of_array [3] [2, 3, 4]
    let p_exp = Tensor.of_array [3] [3, 2, 1]
    let vb = Tensor.view (ref p_base)
    let ve = Tensor.view (ref p_exp)
    let p1 = vb ** ve
    let p2 = p_base ** ve
    let p3 = vb ** p_exp
    let p4 = 2 ** p_exp
    let p5 = p_base ** 2
    let p6 = 2 ** ve
    let p7 = vb ** 2
    assert (p1 == p2 && p2 == p3 && p4 == p6 && p5 == p7)

    // Neg<View> (1)
    let neg_v = -vt

    (fold_i64 a1 + fold_i64 a4 + fold_i64 s1 + fold_i64 s4 + fold_i64 s5
        + fold_i64 m1 + fold_i64 m4 + fold_i64 d1 + fold_i64 d4 + fold_i64 d5
        + fold_i64 r1 + fold_i64 r4 + fold_i64 r5 + fold_i64 p1 + fold_i64 p4 + fold_i64 p5
        + fold_i64 neg_v)

// Negative stride (`Slice.rev()` / `.. -1 ..`), empty tensors, and Tsuzuri truncating `/` & `%` signs
export def negative_stride_empty_and_signed_div_rem :: i64
fn negative_stride_empty_and_signed_div_rem =
    let a = Tensor.of_array [4] [10, 20, 30, 40]
    let rev = ref a[[Slice.rev()]]
    let diff = rev - Tensor.view (ref a)

    let empty: Tensor<i64> = Tensor.zeros [0, 3]
    let empty_out = (2 * empty) + (Tensor.view (ref empty) - 5)
    let empty_view = Tensor.view (ref empty_out)
    let empty_sh = Tensor.shape (ref empty_view)
    assert (empty_sh[0] == 0 && empty_sh[1] == 3)

    let negs = Tensor.of_array [4] [-7, -7, 7, 7]
    let divs = Tensor.of_array [4] [2, -2, -2, 2]
    let q = Tensor.view (ref negs) / Tensor.view (ref divs)
    let rm = Tensor.view (ref negs) % Tensor.view (ref divs)
    let q_s = negs / 2
    let rm_s = negs % 2
    fold_i64 diff + fold_i64 q + fold_i64 rm + fold_i64 q_s + fold_i64 rm_s

// Traps: shape mismatch (`assertion failed`) and integer division by zero (`division by zero`)
export def trap_shape_mismatch :: i64 -> i64 = \n ->
    let a = Tensor.of_array [3] [1, 2, 3]
    let b = Tensor.init [n] (\i -> i)
    fold_i64 (Tensor.view (ref a) - Tensor.view (ref b))

export def trap_scalar_div_zero :: i64 -> i64 = \z ->
    let a = Tensor.of_array [2] [10, 20]
    fold_i64 (a / z)
