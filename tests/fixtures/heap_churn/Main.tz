// The WASM heap under a bounded live set (tests/features.mjs, suite heap_churn). Every round allocates a temporary array of
// 2.4 MB or 0.3 MB, then a 6-element array that is kept (it goes into a Vec), and frees the temporary when the round ends:
// the temporary is a hole that the kept array pins. At most 3 MB are live at a time, so the program must run any number of
// rounds in a heap of 16 MiB. A heap that serves every small request from its end whenever the first hole is large, and so
// leaves one more hole behind every second round, is full after a hundred rounds and fails after a few thousand.
// The result is the sum of the last element of each temporary plus the length of the Vec: 1800 * 299999 + 1800 * 37499 + 3600
// for 3600 rounds, in general `rounds * 168750` for an even `rounds`.
export def churn :: i64 -> i64
fn churn rounds =
    let mut kept: Vec<[i64]> = Vec.empty()
    let mut total = 0
    let mut index = 0
    while index < rounds do
        let count = if index % 2 == 0 then 300000 else 37500
        let scratch = new [i64](count, k -> k)
        let node = new [i64](6, k -> k)
        kept = Vec.push kept node
        total = total + scratch[count - 1]
        index = index + 1
    total + Vec.length (ref kept)

// The steady churn of benchmarks/heap/Main.tz (its reference is benchmarks/heap/reference.mjs): `slots` arrays of 1 to
// `spread` elements, then `rounds` times a random slot gets a new array of a random size. The live data are 3 MB or less and
// the blocks are freed in no order, so merging leaves free blocks of 64 KiB and more that no request comes near; the heap must
// not keep them for large requests that never come and grow to its limit around them. The result is `i64`, wrapped.
def step :: i64u -> i64u
fn step state = (state ^ (state >>> 13)) * 6364136223846793005 + 1442695040888963407

def block :: i64u -> i64 -> [i64u]
fn block salt count = new [i64u](count, \index -> salt + (index as i64u))

export def steady_churn :: i64 -> i64 -> i64 -> i64u -> i64
fn steady_churn slots rounds spread seed =
    let mut state = seed
    let mut values: Vec<[i64u]> = Vec.with_capacity slots
    for _index in 0 .. (slots - 1) do
        state = step state
        values = Vec.push values (block state (1 + ((state >>> 40) as i64) % spread))
    for _round in 0 .. (rounds - 1) do
        state = step state
        let slot = ((state >>> 33) as i64) % slots
        values = Vec.set values slot (block state (1 + ((state >>> 20) as i64) % spread))
    let mut total = 0i64u
    for index in 0 .. (slots - 1) do
        let row = Vec.at (ref values) index
        total = total * 31 + row[0] + row[row.length - 1] + (row.length as i64u)
    total as i64
