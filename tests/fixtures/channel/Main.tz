// TZ03: Go's channel between tzroutines. Every export receives what it computes on the calling
// thread, so the result never depends on the schedule; an export also waits for its tzroutines.

// `n` round trips on an unbuffered channel: a tzroutine adds 1 to each value and sends it back.
export def ping_pong :: i64 -> i64
fn ping_pong n =
    let requests: Channel<i64> = Channel.make 0
    let replies: Channel<i64> = Channel.make 0
    let server_requests = Channel.share requests
    let server_replies = Channel.share replies
    tzroutine {
        for value in server_requests do
            Channel.send server_replies (value + 1)
    }
    let mut value = 0i64
    for _round in 0 ..< n do
        Channel.send requests value
        value = match Channel.recv replies with
            | Maybe.Some next -> next
            | Maybe.None -> -1
    Channel.close requests
    value

// Generate, double and sum in three tzroutines joined by unbuffered channels.
export def pipeline :: i64 -> i64
fn pipeline n =
    let numbers: Channel<i64> = Channel.make 0
    let doubled: Channel<i64> = Channel.make 0
    let source = Channel.share numbers
    tzroutine {
        for i in 1 ..= n do
            Channel.send source i
        Channel.close source
    }
    let inputs = Channel.share numbers
    let outputs = Channel.share doubled
    tzroutine {
        for value in inputs do
            Channel.send outputs (value * 2)
        Channel.close outputs
    }
    let mut sum = 0i64
    for value in doubled do
        sum = sum + value
    sum

// 8 senders of 1000 items each; a closer closes the items once the 8 have said they are done.
export def fan_in :: i64
fn fan_in =
    let items: Channel<i64> = Channel.make 0
    let done: Channel<unit> = Channel.make 8
    for _sender in 0 ..< 8 do
        let out = Channel.share items
        let finished = Channel.share done
        tzroutine {
            for i in 1 ..= 1000 do
                Channel.send out (i as i64)
            Channel.send finished ()
        }
    let closing = Channel.share items
    let finishes = Channel.share done
    tzroutine {
        for _sender in 0 ..< 8 do
            let _signal = Channel.recv finishes
        Channel.close closing
    }
    let mut sum = 0i64
    for value in items do
        sum = sum + value
    sum

// One channel of capacity 16 read by 4 receivers with `for`: each item reaches one of them.
export def fan_out :: i64
fn fan_out =
    let jobs: Channel<i64> = Channel.make 16
    let results: Channel<i64> = Channel.make 0
    for _worker in 0 ..< 4 do
        let inbox = Channel.share jobs
        let outbox = Channel.share results
        tzroutine {
            let mut count = 0i64
            let mut sum = 0i64
            for job in inbox do
                count = count + 1
                sum = sum + job
            Channel.send outbox (count * 1000000 + sum)
        }
    let feed = Channel.share jobs
    tzroutine {
        for i in 1 ..= 1000 do
            Channel.send feed (i as i64)
        Channel.close feed
    }
    let mut total = 0i64
    for _worker in 0 ..< 4 do
        total = total + (match Channel.recv results with
            | Maybe.Some value -> value
            | Maybe.None -> 0)
    total

// `string` and `[i64]` items; the channels are dropped with items in them.
export def owned_items :: i64
fn owned_items =
    let texts: Channel<string> = Channel.make 4
    let arrays: Channel<[i64]> = Channel.make 4
    let text_out = Channel.share texts
    let array_out = Channel.share arrays
    tzroutine {
        Channel.send text_out "alpha"
        Channel.send text_out "beta"
        Channel.send text_out "gamma"
        Channel.send array_out [1, 2, 3]
        Channel.send array_out [4, 5]
    }
    let first = match Channel.recv texts with
        | Maybe.Some text -> String.length text
        | Maybe.None -> 0
    let numbers = match Channel.recv arrays with
        | Maybe.Some values -> Array.length (ref values)
        | Maybe.None -> 0
    first * 10 + numbers

// `break` and `continue` in `for x in ch`, and the channel stays usable after the loop.
export def for_break :: i64
fn for_break =
    let values: Channel<i64> = Channel.make 0
    let out = Channel.share values
    tzroutine {
        for i in 1 ..= 10 do
            Channel.send out (i as i64)
        Channel.close out
    }
    let mut picked = 0i64
    for value in values do
        if value % 2 == 0 then
            continue
        if value > 7 then
            break
        picked = picked + value
    let mut rest = 0i64
    for value in values do
        rest = rest + value
    picked * 100 + rest

// 100 signals on a channel of unit.
export def unit_channel :: i64
fn unit_channel =
    let signals: Channel<unit> = Channel.make 0
    let out = Channel.share signals
    tzroutine {
        for _i in 0 ..< 100 do
            Channel.send out ()
        Channel.close out
    }
    let mut count = 0i64
    for _signal in signals do
        count = count + 1
    count

// Both channels in one program: a tzroutine and a task relay from Channels to one DataChannel.
// DataChannel's waits stay in the task runtime until TZ12, which does not see tzroutines, so the
// DataChannel always has room and main takes only items that are in it already.
export def both_kinds :: i64
fn both_kinds =
    let source: Channel<i64> = Channel.make 0
    let finished: Channel<unit> = Channel.make 1
    match DataChannel.bounded 8 with
    | (sender, receiver) ->
        let relay = DataChannel.clone_sender (ref sender)
        let inbox = Channel.share source
        let done = Channel.share finished
        tzroutine {
            for value in inbox do
                let _sent = DataChannel.send (ref relay) (value * 3)
            Channel.send done ()
        }
        for i in 1 ..= 4 do
            Channel.send source (i as i64)
        Channel.close source
        let _signal = Channel.recv finished
        let second: Channel<i64> = Channel.make 0
        let feed = Channel.share second
        let drain = Channel.share second
        let send_all = task {
            for i in 5 ..= 8 do
                Channel.send feed (i as i64)
            Channel.close feed
            return 0i64
        }
        let forward = task {
            for value in drain do
                let _sent = DataChannel.send (ref sender) (value * 5)
            return 0i64
        }
        let _joined = Task.run (Task.parallel [send_all, forward])
        let mut sum = 0i64
        for _i in 0 ..< 8 do
            sum = sum + (match DataChannel.recv (ref receiver) with
                | Maybe.Some value -> value
                | Maybe.None -> 0)
        sum

// Two tasks of Task.parallel hand values over an unbuffered channel (pseudo-G waits).
export def task_worker :: i64
fn task_worker =
    let shared: Channel<i64> = Channel.make 0
    let producer = Channel.share shared
    let consumer = Channel.share shared
    let send_all = task {
        for i in 1 ..= 100 do
            Channel.send producer (i as i64)
        Channel.close producer
        return 0i64
    }
    let receive_all = task {
        let mut sum = 0i64
        for value in consumer do
            sum = sum + value
        return sum
    }
    let results = Task.run (Task.parallel [receive_all, send_all])
    results[0]

// A tzroutine that joins two tasks talking over a channel: the join gives its P away.
export def routine_tasks :: i64
fn routine_tasks =
    let answers: Channel<i64> = Channel.make 1
    let answer = Channel.share answers
    tzroutine {
        let shared: Channel<i64> = Channel.make 0
        let producer = Channel.share shared
        let consumer = Channel.share shared
        let send_all = task {
            for i in 1 ..= 50 do
                Channel.send producer (i as i64)
            Channel.close producer
            return 0i64
        }
        let receive_all = task {
            let mut sum = 0i64
            for value in consumer do
                sum = sum + value
            return sum
        }
        let results = Task.run (Task.parallel [send_all, receive_all])
        Channel.send answer results[1]
    }
    match Channel.recv answers with
    | Maybe.Some value -> value
    | Maybe.None -> -1

// A send on a closed channel and a second close trap; so does a wait that nobody can end.
export def send_closed :: i64
fn send_closed =
    let values: Channel<i64> = Channel.make 1
    Channel.close values
    Channel.send values 1
    0

export def close_twice :: i64
fn close_twice =
    let values: Channel<i64> = Channel.make 1
    Channel.close values
    Channel.close values
    0

export def recv_deadlock :: i64
fn recv_deadlock =
    let values: Channel<i64> = Channel.make 0
    match Channel.recv values with
    | Maybe.Some value -> value
    | Maybe.None -> 0
