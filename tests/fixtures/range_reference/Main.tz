// --- List, Vec, string, utf8string: item_from_end ---

export def list_item_from_end_i32 :: i64 -> i64 -> i64 = \n k ->
    let xs = List.init n (\i -> (i + 1) * 10)
    xs[^(k as i32)]

export def list_item_from_end_i64 :: i64 -> i64 -> i64 = \n k ->
    let xs = List.init n (\i -> (i + 1) * 10)
    xs[^k]

export def list_item_from_end_i64u :: i64 -> i64 -> i64 = \n k ->
    let xs = List.init n (\i -> (i + 1) * 10)
    xs[^(k as i64u)]

export def list_item_from_end_i128 :: i64 -> i64 -> i64 -> i64 = \n khi klo ->
    let xs = List.init n (\i -> (i + 1) * 10)
    xs[^(pack128 khi klo)]

private def make_vec :: i64 -> Vec<i64> = \n ->
    let mut xs: Vec<i64> = Vec.empty()
    for i in 0 ..< n do
        Vec.push ((i + 1) * 10) xs
    xs

export def vec_item_from_end_i32 :: i64 -> i64 -> i64 = \n k ->
    let xs = make_vec n
    xs[^(k as i32)]

export def vec_item_from_end_i64 :: i64 -> i64 -> i64 = \n k ->
    let xs = make_vec n
    xs[^k]

export def vec_item_from_end_i64u :: i64 -> i64 -> i64 = \n k ->
    let xs = make_vec n
    xs[^(k as i64u)]

export def vec_item_from_end_i128 :: i64 -> i64 -> i64 -> i64 = \n khi klo ->
    let xs = make_vec n
    xs[^(pack128 khi klo)]

private def make_str :: i64 -> string = \n ->
    if n == 0 then "" elif n == 1 then "A" else "ABCDE"

private def make_utf8 :: i64 -> utf8string = \n ->
    if n == 0 then u8"" elif n == 1 then u8"A" else u8"ABCDE"

export def string_item_from_end_i32 :: i64 -> i64 -> i64 = \n k ->
    let s = make_str n
    ((s[^(k as i32)] as i64) - 64) * 10

export def string_item_from_end_i64 :: i64 -> i64 -> i64 = \n k ->
    let s = make_str n
    ((s[^k] as i64) - 64) * 10

