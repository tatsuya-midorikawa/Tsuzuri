// NC17: Edition 2028 inclusive range family and `^k` from-end positions across i32, i64, i64u, i128.

private def fold_slice :: ref [i64] -> i64 = \part ->
    let mut t: i64 = 0
    for v in part do
        t = t * 31 + v
    t

private def make_array :: i64 -> [i64] = \n ->
    new [i64](n, \i -> (i + 1) * 10)

private def pack128 :: i64 -> i64 -> i128 = \hi lo ->
    ((hi as i128) <<< 64) ||| ((lo as i64u) as i128)

// --- Array slices & item_from_end: i32 ---

export def array_closed_i32 :: i64 -> i64 -> i64 -> i64 = \n a b ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) .. (b as i32)])

export def array_open_i32 :: i64 -> i64 -> i64 -> i64 = \n a b ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) ..< (b as i32)])

export def array_open_closed_i32 :: i64 -> i64 -> i64 -> i64 = \n a b ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) <.. (b as i32)])

export def array_open_open_i32 :: i64 -> i64 -> i64 -> i64 = \n a b ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) <..< (b as i32)])

export def array_to_i32 :: i64 -> i64 -> i64 = \n b ->
    let xs = make_array n
    fold_slice (ref xs[.. (b as i32)])

export def array_to_open_i32 :: i64 -> i64 -> i64 = \n b ->
    let xs = make_array n
    fold_slice (ref xs[..< (b as i32)])

export def array_from_i32 :: i64 -> i64 -> i64 = \n a ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) ..])

export def array_from_open_i32 :: i64 -> i64 -> i64 = \n a ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) <..])

export def array_drop_end_i32 :: i64 -> i64 -> i64 = \n b ->
    let xs = make_array n
    fold_slice (ref xs[.. ^(b as i32)])

export def array_from_end_start_i32 :: i64 -> i64 -> i64 = \n a ->
    let xs = make_array n
    fold_slice (ref xs[^(a as i32) ..])

export def array_from_end_start_open_i32 :: i64 -> i64 -> i64 = \n a ->
    let xs = make_array n
    fold_slice (ref xs[^(a as i32) <..])

export def array_between_from_end_i32 :: i64 -> i64 -> i64 -> i64 = \n a b ->
    let xs = make_array n
    fold_slice (ref xs[(a as i32) .. ^(b as i32)])

export def array_until_from_end_i32 :: i64 -> i64 -> i64 = \n b ->
    let xs = make_array n
    fold_slice (ref xs[..< ^(b as i32)])

export def array_item_from_end_i32 :: i64 -> i64 -> i64 = \n k ->
    let xs = make_array n
    xs[^(k as i32)]

