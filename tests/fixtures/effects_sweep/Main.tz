/// A20 appendix F.4: the public std functions that no other program of the corpus instantiates,
/// so that `tests/effects_alloc_conservative.rs` compares the effect rule with their IR too. The
/// program only has to build; `main` runs none of it.

export def io_actions :: i64 -> i64 = \_n ->
    let _a = Array.random_choice [1, 2, 3]
    let _b = Array.random_choices 2 [1, 2, 3]
    let _c = Array.random_sample 2 [1, 2, 3]
    let _d = Array.random_shuffle [1, 2, 3]
    let _e = Array.random_shuffle_in_place [1, 2, 3]
    let _f = List.random_choice [|1, 2, 3|]
    let _g = List.random_choices 2 [|1, 2, 3|]
    let _h = List.random_sample 2 [|1, 2, 3|]
    let _i = List.random_shuffle [|1, 2, 3|]
    let _j = Dir.create "d"
    let _k = Dir.list "d"
    let _l = Dir.remove "d"
    let _m = Dir.walk "d"
    let _n = Env.args ()
    let _o = Env.current_dir ()
    let _p = Env.var "HOME"
    let _q = File.append_text "f" "x"
    let _r = File.link_metadata "f"
    let _s = File.metadata "f"
    let _t = File.read_bytes "f"
    let _u = File.read_text "f"
    let _v = File.remove "f"
    let _w = File.write_bytes "f" [1i8u]
    let _x = File.write_text "f" "x"
    let _y = File.with_open "f" File.Mode.Read (\handle -> File.read handle 4)
    let _z = File.with_open "f" File.Mode.Write (\handle -> File.write handle [1i8u])
    let _aa = File.with_open "f" File.Mode.Write (\handle -> File.flush handle)
    let _ab = File.with_open "f" File.Mode.Read (\handle -> File.close handle)
    let _ac = Random.bytes 4
    let _ad = Random.next_u64 ()
    let _ae = Time.monotonic_ns ()
    let _af = Time.sleep_ms 1
    let _ag = Time.unix_ns ()
    let _ticker = Ticker.create 1
    let _reset = Ticker.reset (ref _ticker) 1
    let _map: SyncMap<i64, i64> = SyncMap.create ()
    let _key = 1
    let _stored = SyncMap.load_or_store (ref _map) 1 2
    let _read = SyncMap.with_value (ref _map) (ref _key) (\value -> deref value)
    let _visited = SyncMap.for_each (ref _map) (\_k _v -> ())
    let _ah: IO<HashMap<i64, i64>> = HashMap.randomized ()
    let _ai: IO<Result<HashMap<i64, i64>, Os.Error>> = HashMap.try_randomized ()
    let _aj: IO<HashSet<i64>> = HashSet.randomized ()
    let _ak: IO<Result<HashSet<i64>, Os.Error>> = HashSet.try_randomized ()
    let _al = IO.write_err 1
    let _am = IO.write_errln 1
    let _an = IO.try_write_err 1
    let _ao = IO.try_write_errln 1
    let _ap = IO.writeln 1
    let _aq = IO.Combine (IO.writeln 1) (IO.Return 2)
    let _ar = IO.For [1, 2] (\x -> IO.writeln x)
    let _as = IO.MergeSources (IO.Return 1) (IO.Return 2)
    let _at = IO.ReturnFrom (IO.Return 1)
    let _au = IO.While (\() -> false) (IO.writeln 1)
    let _av = IO.Using (\k -> k 1) (\x -> IO.Return (x + 1))
    let _zs = ZString.of "hi"
    let _zstr = match _zs with | Result.Ok z -> ZString.to_string (ref z) | Result.Error _ -> ""
    let _zu = ZUtf8String.of u8"hi"
    let _zustr = match _zu with | Result.Ok z -> ZUtf8String.to_utf8string (ref z) | Result.Error _ -> u8""
    let _osv = Env.os_version ()
    let _c0 = Complex.of 3.0 4.0
    let _c1 = Complex.from_real 2.0
    let _c2 = Complex.from_imag 1.0
    let _c3 = Complex.polar 2.0 0.5
    let _c4 = Complex.add _c0 _c1
    let _c5 = Complex.sub _c4 _c2
    let _c6 = Complex.mul _c5 _c3
    let _c7 = Complex.div _c6 _c0
    let _c8 = Complex.neg _c7
    let _c9 = Complex.scale 2.0 _c8
    let _c10 = Complex.conj _c9
    let _c11 = Complex.sqrt _c0
    let _c12 = Complex.exp _c1
    let _c13 = Complex.log _c0
    let _c14 = Complex.pow _c0 _c1
    let _c15 = Complex.sin _c0
    let _c16 = Complex.cos _c0
    let _c17 = Complex.tan _c0
    let _c18 = Complex.sinh _c0
    let _c19 = Complex.cosh _c0
    let _c20 = Complex.tanh _c0
    let _c_vals = Complex.real _c0 + Complex.imag _c0 + Complex.abs _c0 + Complex.norm_sq _c0 + Complex.arg _c0
    let _c_flags = Complex.is_nan _c0 || Complex.is_infinite _c0 || Complex.is_finite _c0
    let _c_consts: Complex<f64> = Complex.zero () + Complex.one () + Complex.i ()
    let _c_disp = $"{_c0}"
    let _ = (_c10, _c11, _c12, _c13, _c14, _c15, _c16, _c17, _c18, _c19, _c20, _c_vals, _c_flags, _c_consts, _c_disp)
    0

export def pure_values :: i64 -> i64 = \_n ->
    let map: HashMap<i64, i64> = HashMap.empty()
    let set: HashSet<i64> = HashSet.with_capacity 4
    let ordered: Set<i64> = Set.empty()
    let pairs = HashMap.to_array (ref map)
    let values = HashMap.values (ref map)
    let names = Path.join "a" "b.txt"
    let parent = Path.parent (ref names)
    let file = Path.file_name (ref names)
    let extension = Path.extension (ref names)
    let text: utf8string = u8"  abc  "
    let left = Utf8String.trim_start (ref text)
    let right = Utf8String.trim_end (ref text)
    let part = Utf8String.sub 1 2 (ref text)
    let part16 = String.sub 1 2 "abcdef"
    let decoded = Os.decode [97i8u]
    let split = Os.split_names (ref [97i8u, 0i8u])
    let version = Unicode.version ()
    let maybe = Maybe.ReturnFrom (Maybe.Some 1)
    let flags = (if HashMap.is_empty (ref map) then 1 else 0) + (if HashSet.is_empty (ref set) then 1 else 0) + (if Set.is_empty (ref ordered) then 1 else 0)
    let found = [parent, file, extension]
    let mut count = 0
    for name in found do
        count = count + (match name with
            | Maybe.Some _ -> 1
            | Maybe.None -> 0)
    let lengths = left.length + right.length + version.length
    let more = (match part with
        | Maybe.Some _ -> 1
        | Maybe.None -> 0) + (match part16 with
        | Maybe.Some _ -> 1
        | Maybe.None -> 0) + (match maybe with
        | Maybe.Some value -> value
        | Maybe.None -> 0) + (match decoded with
        | Result.Ok _ -> 1
        | Result.Error _ -> 0) + (match split with
        | Result.Ok _ -> 1
        | Result.Error _ -> 0)
    flags + pairs.length + values.length + count + lengths + more
export def devices :: i64 -> i64 = \_n ->
    match Gpu.request Gpu.Backend.CpuReference with
    | Result.Ok device ->
        let mode = Gpu.backend (ref device)
        let last = Gpu.last_backend ()
        let buffer = Gpu.from_array (ref device) (ref [1i32, 2i32, 3i32])
        let doubled = Gpu.map (ref device) (\x -> x * 2i32) buffer
        let relaxed = Gpu.map_relaxed (ref device) (\x -> x + 1i32) doubled
        let made = Gpu.init (ref device) 3 (\i -> i)
        let loose = Gpu.init_relaxed (ref device) 3 (\i -> i)
        let total = (Gpu.to_array relaxed).length + (Gpu.to_array made).length + (Gpu.to_array loose).length
        total + (match (mode, last) with
            | (Gpu.Backend.CpuReference, _) -> 1
            | _ -> 0)
    | Result.Error _ -> 0

export def json_values :: i64 -> i64 = \_n ->
    match Json.parse (ref u8"[1, 2]") with
    | Result.Ok value ->
        let decoded: Result<[i64], Json.Error> = Json.decode (ref value)
        let pretty = Json.serialize_pretty 2 (ref [1, 2])
        let number = Json.to_i64 (ref Json.Numeral { text: u8"7" })
        (match decoded with
            | Result.Ok items -> items.length
            | Result.Error _ -> 0) + (match pretty with
            | Result.Ok text -> text.length
            | Result.Error _ -> 0) + (match number with
            | Result.Ok n -> n
            | Result.Error _ -> 0)
    | Result.Error _ -> 0

export def sockets :: i64 -> i64 = \_n ->
    match Net.parse_address "127.0.0.1:0" with
    | Maybe.Some address ->
        let _c = Net.with_listener address (\listener -> Net.with_accepted listener Maybe.None (\_stream -> IO.Return 1))
        1
    | Maybe.None -> 0

export def errors :: i64 -> i64 = \_n ->
    let error = Os.Error { kind: Os.ErrorKind.NotFound, code: 2i32 }
    (Os.message (ref error)).length

export def tensors :: i64 -> i64 = \_n ->
    let tensor = Tensor.of_array [2, 2] [1, 2, 3, 4]
    let view = Tensor.view (ref tensor)
    let cloned = Tensor.clone (ref tensor)
    let _c = Tensor.clone_view (ref view)
    let _ac = Tensor.as_contiguous (ref view)
    let _af = Tensor.as_fortran (ref view)
    let _fs = Tensor.fortran_strides [2, 2]
    let _ast = Tensor.astype (\x -> x as f64) (ref view)
    let _str = Tensor.strided 0 [2, 2] [2, 1] (Tensor.as_array (ref cloned))
    let _fc = Tensor.is_c_contiguous (ref view) && Tensor.is_f_contiguous (ref view)
    let mut buf = [1, 2, 3, 4]
    let mut m = Tensor.borrow_mut [2, 2] (ref mut buf)
    let _mc = Tensor.is_contiguous_mut (ref m)
    let _ms = Tensor.as_slice_mut (ref mut m)
    Tensor.write [0, 0] 9 (ref mut m)
    Tensor.fill 1 (ref mut m)
    Tensor.copy_from (ref view) (ref mut m)
    Tensor.map_in_place (\x -> x + 1) (ref mut m)
    let _p = Tensor.permute_mut [1, 0] (ref mut m)
    let _ia = Tensor.index_axis_mut 0 0 (ref mut m)
    let _nm = Tensor.narrow_mut 0 0 1 (ref mut m)
    let _sm = Tensor.sub_mut [0, 0] [1, 1] (ref mut m)
    let _st = Tensor.step_mut 0 1 (ref mut m)
    let _fl = Tensor.flip_mut 0 (ref mut m)
    let _fr = Tensor.freeze (ref m)
    let upd = Tensor.update (\w -> Tensor.fill 2 w) cloned
    let _bs = Tensor.broadcast_shape [1, 2] [2, 1]
    let _bt = Tensor.broadcast_to [2, 2] (ref view)
    let _bp = Tensor.broadcast_pair (ref view) (ref view)
    let upd_views = [Tensor.view (ref upd)]
    let _ba = Tensor.broadcast_arrays (ref upd_views)
    let _z: Tensor<i64> = Tensor.zeros [2]
    let _o: Tensor<i64> = Tensor.ones [2]
    let _f = Tensor.full 1 [2]
    let _zl: Tensor<i64> = Tensor.zeros_like (ref view)
    let _ol: Tensor<i64> = Tensor.ones_like (ref view)
    let _flk = Tensor.full_like 1 (ref view)
    let _sc = Tensor.scalar 1
    let _ai = Tensor.arange_i64 0 2 1
    let _af6 = Tensor.arange_f64 0.0 1.0 0.5
    let _af3 = Tensor.arange_f32 0.0f32 1.0f32 0.5f32
    let _ls = Tensor.linspace 0.0 1.0 3
    let _lso = Tensor.linspace_open 0.0 1.0 3
    let _lgs = Tensor.logspace 0.0 1.0 3 10.0
    let _gms = Tensor.geomspace 1.0 10.0 3
    let _ey: Tensor<i64> = Tensor.eye 2 2 0
    let _id: Tensor<i64> = Tensor.identity 2
    let zv = Tensor.view (ref _z)
    let ov = Tensor.view (ref _o)
    let _dg = Tensor.diag 0 (ref zv)
    let _dgn = Tensor.diagonal 0 (ref view)
    let _dgf = Tensor.diag_flat 0 (ref view)
    let _tr: Tensor<i64> = Tensor.tri 2 2 0
    let _tl = Tensor.tril 0 (ref view)
    let _tu = Tensor.triu 0 (ref view)
    let _mij = Tensor.meshgrid_ij (ref zv) (ref ov)
    let _mxy = Tensor.meshgrid (ref zv) (ref ov)
    let _fv = Tensor.format_view (ref view)
    let all_ax = Slice.all()
    let _sl = Tensor.slice [Slice.all(), Slice.at 0, Slice.range 0 1, Slice.from 0, Slice.until 1, Slice.step 0 1 1, Slice.every 1, Slice.rev(), Slice.new_axis()] (ref view)
    let _sr = Slice.resolve 4 (ref all_ax)
    let _srest = Slice.rest()
    let sel_all = Slice.Sel.Whole
    let _srsel = Slice.resolve_sel 4 (ref sel_all)
    let mat = Matrix.of_array 2 2 [1, 2, 3, 4]
    let mv = MatrixView.of_matrix (ref mat)
    let _msl = MatrixView.slice (ref all_ax) (ref all_ax) mv
    // NC05 shape ops, concat/split, masking & fancy indexing
    let _na = Tensor.normalize_axis (-1) 2
    let _ri = Tensor.reshape_infer [-1, 2] (Tensor.clone (ref tensor))
    let _tr2 = Tensor.try_reshape [-1, 2] (Tensor.clone (ref tensor))
    let _tp = Tensor.transpose (ref view)
    let _sw = Tensor.swapaxes 0 1 (ref view)
    let _mv = Tensor.moveaxis 0 1 (ref view)
    let _sq = Tensor.squeeze (ref view)
    let ed = Tensor.expand_dims 0 (ref view)
    let _sqa = Tensor.squeeze_axis 0 (ref ed)
    let _a1 = Tensor.atleast_1d (ref view)
    let _a2 = Tensor.atleast_2d (ref view)
    let _a3 = Tensor.atleast_3d (ref view)
    let _fl2 = Tensor.flip (ref view)
    let _fla = Tensor.flip_axis 0 (ref view)
    let _flr = Tensor.fliplr (ref view)
    let _flu = Tensor.flipud (ref view)
    let _r90 = Tensor.rot90 1 (ref view)
    let _rv = Tensor.ravel_view (ref view)
    let _flt = Tensor.flatten (ref view)
    let _rl = Tensor.roll 0 1 (ref view)
    let _tl2 = Tensor.tile [1, 2] (ref view)
    let _rp = Tensor.repeat 0 2 (ref view)
    let _pd = Tensor.pad [(1, 1), (0, 0)] (Tensor.PadMode.Constant 0) (ref view)
    let _cc = Tensor.concatenate 0 (ref upd_views)
    let _sk = Tensor.stack 0 (ref upd_views)
    let _vs = Tensor.vstack (ref upd_views)
    let _hs = Tensor.hstack (ref upd_views)
    let _ds = Tensor.dstack (ref upd_views)
    let _cs = Tensor.column_stack (ref upd_views)
    let _sp = Tensor.split 0 2 (ref view)
    let _spa = Tensor.split_at 0 [1] (ref view)
    let _asp = Tensor.array_split 0 2 (ref view)
    let _hsp = Tensor.hsplit 2 (ref view)
    let _vsp = Tensor.vsplit 2 (ref view)
    let t3 = Tensor.init [1, 1, 2] (\i -> i)
    let v3 = Tensor.view (ref t3)
    let _dsp = Tensor.dsplit 2 (ref v3)
    let bmask = Tensor.of_array [2, 2] [true, false, false, true]
    let bmv = Tensor.view (ref bmask)
    let _mk = Tensor.mask (ref bmv) (ref view)
    let _cm = Tensor.compress 0 [true, false] (ref view)
    let _nz = Tensor.nonzero (ref view)
    let _aw = Tensor.argwhere (ref view)
    let _fnz = Tensor.flatnonzero (ref view)
    Tensor.put_mask (ref bmv) 0 (ref mut m)
    let _ws = Tensor.where_select (ref bmv) (ref view) (ref view)
    let _wsc = Tensor.where_scalar 1 0 (ref bmv)
    let _cl = Tensor.clip 0 10 (ref view)
    let idx1 = Tensor.of_array [2] [1, 0]
    let idx1v = Tensor.view (ref idx1)
    let _tk = Tensor.take 0 (ref idx1v) (ref view)
    let idx2 = Tensor.of_array [2, 1] [0, 1]
    let idx2v = Tensor.view (ref idx2)
    let _tka = Tensor.take_along_axis 1 (ref idx2v) (ref view)
    let vals2 = Tensor.of_array [2, 1] [7, 8]
    let vals2v = Tensor.view (ref vals2)
    Tensor.put_along_axis 1 (ref idx2v) (ref vals2v) (ref mut m)
    // NC06: ufuncs, broadcasting, _into, _in_place, comparisons, math, Complex, Matrix ops, operators
    let _msub = Matrix.sub (ref mat) (ref mat)
    let _mhad = Matrix.hadamard (ref mat) (ref mat)
    let _mscl = Matrix.scale 2 (ref mat)
    let _mi = Tensor.map_into (\x -> x + 1) (ref view) (ref mut m)
    let _m2 = Tensor.map2 (\x y -> x + y) (ref view) (ref view)
    let _m2i = Tensor.map2_into (\x y -> x + y) (ref view) (ref view) (ref mut m)
    let _m3 = Tensor.map3 (\x y z -> x + y + z) (ref view) (ref view) (ref view)
    let _m3i = Tensor.map3_into (\x y z -> x + y + z) (ref view) (ref view) (ref view) (ref mut m)
    let _m2ip = Tensor.map2_in_place (\x y -> x + y) (ref view) (ref mut m)
    let _add = Tensor.add (ref view) (ref view)
    let _sub = Tensor.sub (ref view) (ref view)
    let _mul = Tensor.mul (ref view) (ref view)
    let _div = Tensor.div (ref view) (ref view)
    let _rem = Tensor.rem (ref view) (ref view)
    let _pow = Tensor.pow (ref view) (ref view)
    let _fd = Tensor.floor_divide (ref view) (ref view)
    let _fm = Tensor.floor_mod (ref view) (ref view)
    let _dm = Tensor.divmod (ref view) (ref view)
    let tf = Tensor.of_array [2, 2] [0.5, 0.25, 0.75, 1.0]
    let tfv = Tensor.view (ref tf)
    let mut fbuf = [0.0, 0.0, 0.0, 0.0]
    let mut mf = Tensor.borrow_mut [2, 2] (ref mut fbuf)
    let _fdf = Tensor.floor_divide_float (ref tfv) (ref tfv)
    let _fmf = Tensor.floor_mod_float (ref tfv) (ref tfv)
    let _dmf = Tensor.divmod_float (ref tfv) (ref tfv)
    let _fmd = Tensor.fmod (ref tfv) (ref tfv)
    let _irem = Tensor.ieee_remainder (ref tfv) (ref tfv)
    let _mx = Tensor.maximum (ref view) (ref view)
    let _mn = Tensor.minimum (ref view) (ref view)
    let _fmx = Tensor.fmax (ref tfv) (ref tfv)
    let _fmn = Tensor.fmin (ref tfv) (ref tfv)
    let _at2 = Tensor.atan2 (ref tfv) (ref tfv)
    let _hyp = Tensor.hypot (ref tfv) (ref tfv)
    let _cps = Tensor.copysign (ref tfv) (ref tfv)
    let _lae = Tensor.logaddexp (ref tfv) (ref tfv)
    let _lae2 = Tensor.logaddexp2 (ref tfv) (ref tfv)
    let _fma = Tensor.fma (ref tfv) (ref tfv) (ref tfv)
    let _band = Tensor.bit_and (ref view) (ref view)
    let _bor = Tensor.bit_or (ref view) (ref view)
    let _bxor = Tensor.bit_xor (ref view) (ref view)
    let _bnot = Tensor.bit_not (ref view)
    let _bshl = Tensor.shl (ref view) (ref view)
    let _bshr = Tensor.shr (ref view) (ref view)
    let _land = Tensor.logical_and (ref bmv) (ref bmv)
    let _lor = Tensor.logical_or (ref bmv) (ref bmv)
    let _lxor = Tensor.logical_xor (ref bmv) (ref bmv)
    let _lnot = Tensor.logical_not (ref bmv)
    let _as1 = Tensor.add_scalar 1 (ref view)
    let _as2 = Tensor.radd_scalar 1 (ref view)
    let _ss1 = Tensor.sub_scalar 1 (ref view)
    let _ss2 = Tensor.rsub_scalar 1 (ref view)
    let _ms1 = Tensor.mul_scalar 2 (ref view)
    let _ms2 = Tensor.scale 2 (ref view)
    let _ds1 = Tensor.div_scalar 1 (ref view)
    let _ds2 = Tensor.rdiv_scalar 10 (ref view)
    let _rs1 = Tensor.rem_scalar 2 (ref view)
    let _rs2 = Tensor.rrem_scalar 10 (ref view)
    let _ps1 = Tensor.pow_scalar 2 (ref view)
    let _ps2 = Tensor.rpow_scalar 2 (ref view)
    let _ai2 = Tensor.add_into (ref view) (ref view) (ref mut m)
    let _si2 = Tensor.sub_into (ref view) (ref view) (ref mut m)
    let _mi2 = Tensor.mul_into (ref view) (ref view) (ref mut m)
    let _di2 = Tensor.div_into (ref view) (ref view) (ref mut m)
    let _sci = Tensor.scale_into 2 (ref view) (ref mut m)
    let _mai = Tensor.mul_add_into (ref view) (ref view) (ref view) (ref mut m)
    let _fmi = Tensor.fma_into (ref tfv) (ref tfv) (ref tfv) (ref mut mf)
    let _aip = Tensor.add_in_place (ref view) (ref mut m)
    let _sip = Tensor.sub_in_place (ref view) (ref mut m)
    let _mip = Tensor.mul_in_place (ref view) (ref mut m)
    let _dip = Tensor.div_in_place (ref view) (ref mut m)
    let _rip = Tensor.rem_in_place (ref view) (ref mut m)
    Tensor.add_scalar_in_place 1 (ref mut m)
    Tensor.sub_scalar_in_place 1 (ref mut m)
    Tensor.mul_scalar_in_place 2 (ref mut m)
    Tensor.div_scalar_in_place 2 (ref mut m)
    Tensor.rem_scalar_in_place 3 (ref mut m)
    let _neg = Tensor.neg (ref view)
    let _negi = Tensor.neg_into (ref view) (ref mut m)
    let _abs = Tensor.abs (ref view)
    let _absi = Tensor.abs_into (ref view) (ref mut m)
    let _sqt = Tensor.sqrt (ref tfv)
    let _sqti = Tensor.sqrt_into (ref tfv) (ref mut mf)
    let _cbt = Tensor.cbrt (ref tfv)
    let _sqr = Tensor.square (ref view)
    let _rcp = Tensor.reciprocal (ref tfv)
    let _flr = Tensor.floor (ref tfv)
    let _cel = Tensor.ceil (ref tfv)
    let _trc = Tensor.trunc (ref tfv)
    let _rnd = Tensor.round (ref tfv)
    let _rnde = Tensor.round_even (ref tfv)
    let _sgn = Tensor.sign (ref view)
    let _umath = (Tensor.sin (ref tfv), Tensor.cos (ref tfv), Tensor.tan (ref tfv), Tensor.asin (ref tfv), Tensor.acos (ref tfv), Tensor.atan (ref tfv))
    let _uhyp = (Tensor.sinh (ref tfv), Tensor.cosh (ref tfv), Tensor.tanh (ref tfv), Tensor.asinh (ref tfv), Tensor.acosh (ref tfv), Tensor.atanh (ref tfv))
    let _uexp = (Tensor.exp (ref tfv), Tensor.exp_into (ref tfv) (ref mut mf), Tensor.exp2 (ref tfv), Tensor.expm1 (ref tfv), Tensor.log (ref tfv), Tensor.log_into (ref tfv) (ref mut mf), Tensor.log2 (ref tfv), Tensor.log10 (ref tfv), Tensor.log1p (ref tfv), Tensor.sinc (ref tfv), Tensor.degrees (ref tfv), Tensor.radians (ref tfv))
    let tc = Tensor.of_array [2] [Complex.of 1.0 2.0, Complex.of 3.0 (-4.0)]
    let tcv = Tensor.view (ref tc)
    let _ucplx = (Tensor.real (ref tcv), Tensor.imag (ref tcv), Tensor.conj (ref tcv), Tensor.angle (ref tcv))
    let _uspec = (Tensor.is_nan (ref tfv), Tensor.is_infinite (ref tfv), Tensor.is_finite (ref tfv), Tensor.signbit (ref tfv), Tensor.nan_to_num 0.0 1.0 (-1.0) (ref tfv))
    let _ecmp = (Tensor.elem_eq (ref view) (ref view), Tensor.elem_ne (ref view) (ref view), Tensor.elem_lt (ref view) (ref view), Tensor.elem_le (ref view) (ref view), Tensor.elem_gt (ref view) (ref view), Tensor.elem_ge (ref view) (ref view))
    let _scmp = (Tensor.eq_scalar 1 (ref view), Tensor.ne_scalar 1 (ref view), Tensor.lt_scalar 1 (ref view), Tensor.le_scalar 1 (ref view), Tensor.gt_scalar 1 (ref view), Tensor.ge_scalar 1 (ref view))
    let _clos = (Tensor.isclose 1e-5 1e-8 false (ref tfv) (ref tfv), Tensor.allclose 1e-5 1e-8 false (ref tfv) (ref tfv), Tensor.array_equal (ref view) (ref view), Tensor.array_equiv (ref view) (ref view))
    let _outr = Tensor.outer_with (\x y -> x * y) (ref idx1v) (ref idx1v)
    let _accm = Tensor.accumulate (\x y -> x + y) 0 (ref view)
