private record Token { value: i64, label: string }

private def make :: own i64 -> Token
fn make value = Token { value: value, label: "secret" }

private def weight :: own Token -> i64
fn weight token = token.value + token.label.length

private def (|Small|_|) :: own i64 -> bool
fn (|Small|_|) n = n < 10

def rec reveal :: own i64 -> i64
private def and hide :: own i64 -> i64
fn rec reveal n =
    match n with
    | Small -> weight (make n)
    | _ -> hide (n - 1)
and hide n = if n < 40 then reveal n else n + 1
