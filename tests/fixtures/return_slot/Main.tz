// PR03 F1': a function that returns a union through one return slot when every exit may leave through it,
// and the functions that keep their plain `ret`s. Each export reduces its union result to an i64.
union Color = Red | Green | Blue
record Cell { left: Maybe<i64>, right: Maybe<i64> }

// Exits that construct the result.
def make :: own i64 -> Maybe<i64>
fn make n = if n > 0 then Some (n * 2) else None

export def slot_make :: own i64 -> i64
fn slot_make n = Maybe.default_value (-1) (make n)

def pick :: own i64 -> Result<i64, string>
fn pick n =
    match n with
    | 0 -> Error "zero"
    | _ -> Ok (n * 2)

export def slot_pick :: own i64 -> i64
fn slot_pick n =
    match pick n with
    | Ok value -> value
    | Error text -> text.length

// Payloads of different LLVM types, one of them an owned string.
def explain :: own i64 -> Result<i64, string>
fn explain n =
    if n > 0 then Ok n
    elif n == 0 then Error "zero"
    else Error ("negative " + to_string (-n))

export def slot_explain :: own i64 -> i64
fn slot_explain n =
    match explain n with
    | Ok value -> value
    | Error text -> text.length

def label :: own i64 -> Maybe<string>
fn label n = if n > 0 then Some ("item " + to_string n) else None

export def slot_label :: own i64 -> i64
fn slot_label n =
    match label n with
    | Some text -> text.length
    | None -> -1

// One exit moves a local out, the other drops it at the end of the scope.
def scratch :: own i64 -> Result<i64, string>
fn scratch n =
    let text = "scratch " + to_string n
    if n > 0 then Ok text.length else Error text

export def slot_scratch :: own i64 -> i64
fn slot_scratch n =
    match scratch n with
    | Ok value -> value
    | Error text -> text.length

// Two exits and a self tail call: the slot and the loop's back edge live in one function.
def rec find :: own i64 -> own i64 -> Maybe<i64>
fn rec find n limit =
    if n > 1000 then None
    elif n * n > limit then Some n
    else find (n + 1) limit

export def slot_find :: own i64 -> own i64 -> i64
fn slot_find start limit = Maybe.default_value (-1) (find start limit)

// Exits that call a function or run a pipeline keep their plain `ret`s; exits that read a field or a parameter share the slot.
def wrap :: own i64 -> Maybe<i64>
fn wrap n = if n > 100 then make n else None

export def slot_wrap :: own i64 -> i64
fn slot_wrap n = Maybe.default_value (-1) (wrap n)

def piped :: own i64 -> Maybe<i64>
fn piped n = if n > 100 then n |> make else None

export def slot_piped :: own i64 -> i64
fn slot_piped n = Maybe.default_value (-1) (piped n)

// A field of a call's result, or of a local that holds one, may hold the call too and keeps the plain `ret`s.
record Holder { value: Maybe<i64> }

def holder :: own i64 -> Holder
fn holder n = Holder { value: make n }

def read_call :: own i64 -> Maybe<i64>
fn read_call n = if n > 100 then (holder n).value else None

export def slot_read_call :: own i64 -> i64
fn slot_read_call n = Maybe.default_value (-1) (read_call n)

def read_local :: own i64 -> Maybe<i64>
fn read_local n = if n > 100 then { let h = holder n; h.value } else None

export def slot_read_local :: own i64 -> i64
fn slot_read_local n = Maybe.default_value (-1) (read_local n)

def choose :: own i64 -> own Cell -> Maybe<i64>
fn choose n cell = if n > 0 then cell.left else cell.right

export def slot_field :: own i64 -> i64
fn slot_field n = Maybe.default_value (-1) (choose n (Cell { left: Some n, right: None }))

def keep :: own i64 -> own Maybe<i64> -> Maybe<i64>
fn keep n found = if n > 0 then found else None

export def slot_local :: own i64 -> i64
fn slot_local n = Maybe.default_value (-1) (keep n (Some (n + 100)))

// The standard Maybe builder, which expands to Bind and BindReturn workers.
export def slot_let_chain :: own i64 -> i64
fn slot_let_chain offset =
    Maybe.default_value (-1) (Maybe { let! x = Some 20; let! y = Some (x + offset); return x + y })

// A function in a recursion cycle, a continuation, an unknown callee, a local that holds a call and a callee that
// receives the closure of its recursion keep their plain `ret`s.
def hold :: own i64 -> Maybe<i64>
fn hold n = if n > 0 then { let r = make n; r } else None

export def slot_hold :: own i64 -> i64
fn slot_hold n = Maybe.default_value (-1) (hold n)

def guard :: own i64 -> own (i64 -> Maybe<i64>) -> Maybe<i64>
fn guard n k = if n < 0 then None else Maybe.bind k (Some (n - 1))

def rec descend :: own i64 -> Maybe<i64>
fn rec descend n =
    if n == 0 then Some 7
    else guard n (\m -> descend m)

export def slot_descend :: own i64 -> i64
fn slot_descend n = Maybe.default_value (-1) (descend n)

def rec even_m :: own i64 -> Maybe<i64> = \n -> if n == 0 then Some 1 else odd_m (n - 1)
and odd_m :: own i64 -> Maybe<i64> = \n -> if n == 0 then None else even_m (n - 1)

export def slot_parity :: own i64 -> i64
fn slot_parity n = Maybe.default_value 0 (even_m n)

def rec count_down :: own i64 -> Maybe<i64>
fn rec count_down n =
    if n == 0 then Some 7
    else Maybe.bind (\m -> count_down m) (Some (n - 1))

export def slot_count_down :: own i64 -> i64
fn slot_count_down n = Maybe.default_value (-1) (count_down n)

def rec nest :: own i64 -> Maybe<i64>
fn rec nest n =
    if n == 0 then Some 0
    else Maybe.map (\v -> v + 1) (nest (n - 1))

export def slot_nested :: own i64 -> i64
fn slot_nested n = Maybe.default_value (-1) (nest n)

def apply_to :: own (i64 -> Maybe<i64>) -> own i64 -> Maybe<i64>
fn apply_to f x = if x < 0 then None else f x

export def slot_apply :: own i64 -> i64
fn slot_apply n = Maybe.default_value (-1) (apply_to make n)

// A result that is a bare tag is not an aggregate and keeps its `ret`s.
def color :: own i64 -> Color
fn color n = if n == 0 then Red elif n == 1 then Green else Blue

export def slot_color :: own i64 -> i64
fn slot_color n =
    match color n with
    | Red -> 10
    | Green -> 20
    | Blue -> 30
