// B09: local `let rec` functions and `and` groups.

// A tail call of the function itself is a loop, so a depth of 1,000,000 needs no stack.
export def triangle :: i64 -> i64
fn triangle limit =
    let rec go = \n acc -> if n > limit then acc else go (n + 1) (acc + n)
    go 1 0

export def factorial :: i64 -> i64
fn factorial count =
    let rec go = \n acc -> if n <= 1 then acc else go (n - 1) (acc * n)
    go count 1

export def gcd :: i64 -> i64 -> i64
fn gcd left right =
    let rec go = \x y -> if y == 0 then x else go y (x % y)
    go left right

// Non-tail recursion calls the lifted function directly.
export def fib :: i64 -> i64
fn fib count =
    let rec go = \k -> if k < 2 then k else go (k - 1) + go (k - 2)
    go count

// The function reads an array that its function owns, through a borrow.
export def count_above :: i64 -> i64
fn count_above limit =
    let values: [i64] = [5, 1, 9, 3, 7]
    let rec go = \i acc -> if i == values.length then acc else go (i + 1) (if values[i] > limit then acc + 1 else acc)
    go 0 0

export def binary_search :: i64 -> i64
fn binary_search target =
    let sorted: [i64] = [1, 3, 5, 7, 9, 11]
    let rec go = \low high ->
        if low > high then -1 else
        let middle = (low + high) / 2
        if sorted[middle] == target then middle
        elif sorted[middle] < target then go (middle + 1) high
        else go low (middle - 1)
    go 0 (sorted.length - 1)

// A loop over a borrowed array with a million iterations needs no stack either.
export def walk :: i64 -> i64
fn walk count =
    let values = Array.init count (i -> i)
    let rec go = \i acc -> if i == values.length then acc else go (i + 1) (acc + values[i])
    go 0 0

// A string that the function owns is borrowed too, and freed once.
export def digits :: i64 -> i64
fn digits number =
    let text = to_string number
    let rec go = \i -> if i == String.length (ref text) then 0 else 1 + go (i + 1)
    go 0

def make_scaled :: i64 -> (i64 -> i64)
fn make_scaled step =
    let rec go = \n -> if n <= 0 then 0 else step + go (n - 1)
    go

// The function leaves the block that made it as a closure over its numbers.
export def escaped :: i64 -> i64
fn escaped count =
    let scaled = make_scaled 3
    scaled count

export def partial :: i64 -> i64
fn partial start =
    let rec add = \x y -> if x == 0 then y else add (x - 1) (y + 2)
    let add_three = add 3
    add_three start

export def piped :: i64 -> i64
fn piped count =
    let rec go = \k -> if k <= 0 then 7 else (k - 1) |> go
    count |> go

// A `let rec` in the body of another one.
export def nested :: i64 -> i64
fn nested count =
    let rec outer = \k ->
        let rec inner = \j -> if j == 0 then 0 else j + inner (j - 1)
        if k == 0 then 0 else inner k + outer (k - 1)
    outer count

// Groups: the functions call each other, and share what they capture.
export def parity :: i64 -> i64
fn parity count =
    let rec even = \n -> if n == 0 then true else odd (n - 1)
    and odd = \n -> if n == 0 then false else even (n - 1)
    if even count then 1 else 0

export def group_captures :: i64 -> i64
fn group_captures count =
    let text = to_string count
    let values: [i64] = [10, 20, 30]
    let rec first = \k -> if k == 0 then String.length (ref text) else second (k - 1)
    and second = \k -> if k == 0 then values.length else first (k - 1)
    first 3 + second 3

// A later function calls an earlier one, which borrows what its function owns.
export def sibling :: i64 -> i64
fn sibling count =
    let text = to_string count
    let rec length = \k -> if k == 0 then String.length (ref text) else length (k - 1)
    let rec twice = \k -> length k + length k
    twice 2

// The functions of a group leave the block together.
def make_pair :: i64 -> (i64 -> bool) * (i64 -> bool)
fn make_pair base =
    let rec even = \m -> if m == base then true else odd (m - 1)
    and odd = \m -> if m == base then false else even (m - 1)
    (even, odd)

export def pair_even :: i64 -> i64
fn pair_even count =
    match make_pair 0 with
    | (even, _) -> if even count then 1 else 0

export def pair_odd :: i64 -> i64
fn pair_odd count =
    match make_pair 0 with
    | (_, odd) -> if odd count then 1 else 0

// The function is also a value: it goes to a function that takes one.
export def mapped :: i64 -> i64
fn mapped count =
    let rec sum = \n -> if n <= 0 then 0 else n + sum (n - 1)
    let values = Array.map sum [count, count + 1, count + 2]
    values[0] + values[1] + values[2]
