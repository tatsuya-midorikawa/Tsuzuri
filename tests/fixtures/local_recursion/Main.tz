// B09: local `let rec` functions and `and` groups.

// A tail call of the function itself is a loop, so a depth of 1,000,000 needs no stack.
export def triangle :: i64 -> i64
fn triangle limit =
    let rec go = \n acc -> if n > limit then acc else go (n + 1) (acc + n)
    go 1 0

export def factorial :: i64 -> i64
fn factorial count =
    let rec go = \n acc -> if n <= 1 then acc else go (n - 1) (acc * n)
    go count 1

export def gcd :: i64 -> i64 -> i64
fn gcd left right =
    let rec go = \x y -> if y == 0 then x else go y (x % y)
    go left right

// Non-tail recursion calls the lifted function directly.
export def fib :: i64 -> i64
fn fib count =
    let rec go = \k -> if k < 2 then k else go (k - 1) + go (k - 2)
    go count

// The function reads an array that its function owns, through a borrow.
export def count_above :: i64 -> i64
fn count_above limit =
    let values: [i64] = [5, 1, 9, 3, 7]
    let rec go = \i acc -> if i == values.length then acc else go (i + 1) (if values[i] > limit then acc + 1 else acc)
    go 0 0

export def binary_search :: i64 -> i64
fn binary_search target =
    let sorted: [i64] = [1, 3, 5, 7, 9, 11]
    let rec go = \low high ->
        if low > high then -1 else
        let middle = (low + high) / 2
        if sorted[middle] == target then middle
        elif sorted[middle] < target then go (middle + 1) high
        else go low (middle - 1)
    go 0 (sorted.length - 1)

// A loop over a borrowed array with a million iterations needs no stack either.
export def walk :: i64 -> i64
fn walk count =
    let values = Array.init count (i -> i)
    let rec go = \i acc -> if i == values.length then acc else go (i + 1) (acc + values[i])
    go 0 0

// A string that the function owns is borrowed too, and freed once.
export def digits :: i64 -> i64
fn digits number =
    let text = to_string number
    let rec go = \i -> if i == String.length (ref text) then 0 else 1 + go (i + 1)
    go 0

def make_scaled :: i64 -> (i64 -> i64)
fn make_scaled step =
    let rec go = \n -> if n <= 0 then 0 else step + go (n - 1)
    go

// The function leaves the block that made it as a closure over its numbers.
export def escaped :: i64 -> i64
fn escaped count =
    let scaled = make_scaled 3
    scaled count

export def partial :: i64 -> i64
fn partial start =
    let rec add = \x y -> if x == 0 then y else add (x - 1) (y + 2)
    let add_three = add 3
    add_three start

export def piped :: i64 -> i64
fn piped count =
    let rec go = \k -> if k <= 0 then 7 else (k - 1) |> go
    count |> go

// A `let rec` in the body of another one.
export def nested :: i64 -> i64
fn nested count =
    let rec outer = \k ->
        let rec inner = \j -> if j == 0 then 0 else j + inner (j - 1)
        if k == 0 then 0 else inner k + outer (k - 1)
    outer count

// Groups: the functions call each other, and share what they capture.
export def parity :: i64 -> i64
fn parity count =
    let rec even = \n -> if n == 0 then true else odd (n - 1)
    and odd = \n -> if n == 0 then false else even (n - 1)
    if even count then 1 else 0

export def group_captures :: i64 -> i64
fn group_captures count =
    let text = to_string count
    let values: [i64] = [10, 20, 30]
    let rec first = \k -> if k == 0 then String.length (ref text) else second (k - 1)
    and second = \k -> if k == 0 then values.length else first (k - 1)
    first 3 + second 3

// A later function calls an earlier one, which borrows what its function owns.
export def sibling :: i64 -> i64
fn sibling count =
    let text = to_string count
    let rec length = \k -> if k == 0 then String.length (ref text) else length (k - 1)
    let rec twice = \k -> length k + length k
    twice 2

// The functions of a group leave the block together.
def make_pair :: i64 -> (i64 -> bool) * (i64 -> bool)
fn make_pair base =
    let rec even = \m -> if m == base then true else odd (m - 1)
    and odd = \m -> if m == base then false else even (m - 1)
    (even, odd)

export def pair_even :: i64 -> i64
fn pair_even count =
    match make_pair 0 with
    | (even, _) -> if even count then 1 else 0

export def pair_odd :: i64 -> i64
fn pair_odd count =
    match make_pair 0 with
    | (_, odd) -> if odd count then 1 else 0

// The function is also a value: it goes to a function that takes one.
export def mapped :: i64 -> i64
fn mapped count =
    let rec sum = \n -> if n <= 0 then 0 else n + sum (n - 1)
    let values = Array.map sum [count, count + 1, count + 2]
    values[0] + values[1] + values[2]

// A group is called directly, with its captures passed on, only where they exist: in a group that
// is bound in the same function body or encloses it. Anywhere else, a group is a function value.

// The captures of `inner` are parameters of `outer`, so `outer` calls `inner` through its closure.
export def nested_string :: i64 -> i64
fn nested_string count =
    let rec outer = \s ->
        let rec inner = \j -> if j == 0 then String.length (ref s) else inner (j - 1)
        inner 3
    outer (to_string count)

record Labeled { value: i64, label: string }

export def nested_record :: i64 -> i64
fn nested_record count =
    let rec outer = \(item: Labeled) ->
        let rec inner = \j -> if j == 0 then item.value + String.length (ref item.label) else inner (j - 1)
        inner 3
    outer (Labeled { value: count, label: to_string count })

export def nested_closure :: i64 -> i64
fn nested_closure count =
    let rec go = \k ->
        let held = \x -> x + count
        let rec inner = \j -> held j
        inner k
    go 1

// A group in a closure, a continuation, or a loop body holds an earlier `let rec` function, which has
// captures of its own, as a function value.
export def group_in_closure :: i64 -> i64
fn group_in_closure count =
    let base = count * 2
    let rec early = \k -> k + base
    let make = \x ->
        let rec inner = \j -> if j == 0 then early x else inner (j - 1)
        inner 2
    make 3

def continued :: i64 -> Maybe<i64>
fn continued count =
    let scale = count * 2
    let rec first = \k -> if k == 0 then scale else first (k - 1)
    let! start = Maybe.Some count
    let rec second = \k -> first k + 1
    return second start

export def builder_continuation :: i64 -> i64
fn builder_continuation count =
    match continued count with
    | Maybe.Some value -> value
    | Maybe.None -> -1

export def group_in_loop :: i64 -> i64
fn group_in_loop count =
    let text = to_string count
    let rec early = \k -> k + String.length (ref text)
    let mut total = 0i64
    for i in 0i64 .. 2i64 do
        let rec later = \k -> early k + i
        total = total + later 1
    total

export def group_in_branch :: i64 -> i64
fn group_in_branch count =
    let text = to_string count
    let rec early = \k -> k + String.length (ref text)
    if count > 0 then
        let rec later = \k -> early k * 2
        later 1
    else 0

// A function holds the numbers that its captures had when it was made.
export def reassigned_direct :: i64 -> i64
fn reassigned_direct count =
    let mut x = 1
    let rec early = \k -> k + x
    x = 100
    early count

export def reassigned_group :: i64 -> i64
fn reassigned_group count =
    let mut x = 1
    let rec early = \k -> k + x
    x = 100
    let rec later = \k -> early k
    later count

// A `match` reads the value that it matches; only a binding that takes a string out of it moves it.
export def match_borrowed :: i64 -> i64
fn match_borrowed count =
    let text = to_string count
    let rec go = \k ->
        if k == 0 then
            match text with
            | "12345" -> 1
            | _ -> 2
        else go (k - 1)
    go 3

export def match_maybe :: i64 -> i64
fn match_maybe count =
    let found: Maybe<string> = if count > 0 then Maybe.Some (to_string count) else Maybe.None
    let rec go = \k ->
        if k == 0 then
            match found with
            | Maybe.Some _ -> 1
            | Maybe.None -> 2
        else go (k - 1)
    go 2

// An earlier function is a function value, which has no type variable of its own to capture.
def pick_after :: 'a -> 'a -> 'a
fn pick_after x y =
    let rec pick = \(a: 'a) (b: 'a) (k: i64) -> if k == 0 then a else pick b a (k - 1)
    let rec twice = \(a: 'a) (b: 'a) -> pick a b 2
    twice x y

export def generic_earlier :: i64 -> i64
fn generic_earlier count =
    pick_after count 7

// A group in the body of a task: its members are bound together, also after a `let!`.
def parity_job :: i64 -> Task<bool>
fn parity_job count =
    let rec even = \n -> if n == 0 then true else odd (n - 1)
    and odd = \n -> if n == 0 then false else even (n - 1)
    return even count

export def task_group :: i64 -> i64
fn task_group count =
    if Task.run (parity_job count) then 1 else 0

def bound_parity_job :: Task<i64> -> Task<bool>
fn bound_parity_job source =
    let! count = source
    let rec even = \n -> if n == 0 then true else odd (n - 1)
    and odd = \n -> if n == 0 then false else even (n - 1)
    return even count

export def task_group_after_bind :: i64 -> i64
fn task_group_after_bind count =
    if Task.run (bound_parity_job (task { return count })) then 1 else 0
