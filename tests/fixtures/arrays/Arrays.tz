record Empty {}
record Bundle { strings: [string], numbers: [i64] }
record Wide { flag: bool, value: i128 }

def generate :: i64 -> (i64 -> 'a) -> ['a]
fn generate n f = new ['a](n, f)

def choose :: bool -> [i64]
fn choose flag = if flag { [10] } else { [20, 30, 40] }

export def array_values :: i64 -> i64
fn array_values n = {
    let values = generate n (i -> i + 10);
    let copy = values;
    let borrowed = &values;
    if n == 0 { copy.length + borrowed.length }
    else { copy.length + borrowed.length + copy[0] + borrowed[n - 1] }
}

export def array_shapes :: bool -> i64
fn array_shapes flag = {
    let values = choose flag;
    let nested: [[i64]] = [[], [1], [2, 3, 4]];
    let copy = nested;
    values.length + values[0] + copy[2].length + nested[1][0]
}

export def array_empty :: i64
fn array_empty = {
    let values: [i64] = [];
    let mut evaluations = 0;
    let generated = new [i64](values.length, { evaluations = evaluations + 1; i -> 1 / i });
    assert (evaluations == 1);
    generated.length
}

export def array_zero_sized :: i64 -> i64
fn array_zero_sized n = {
    let values = new [Empty](n, i -> Empty {});
    let copy = values;
    let _ = if n > 0 { let _ = copy[n - 1]; } else {};
    values.length + copy.length
}

export def array_owned :: i64 -> i64
fn array_owned n = {
    let prefix = "abc";
    let strings = new [string](n, i -> prefix + "d");
    let moved = strings;
    let nested = new [[string]](n, i -> new [string](i + 1, j -> "xy"));
    if n == 0 { moved.length + nested.length }
    else { (clone_string (&moved[n - 1])).length + nested[n - 1].length + nested[n - 1][0].length }
}

export def array_capture :: i64 -> i64
fn array_capture n = {
    let bundle = Bundle {
        strings: new [string](n, i -> "abc"),
        numbers: new [i64](n, i -> i)
    };
    let take: unit -> i64 = u -> {
        let owned = bundle;
        let strings = owned.strings;
        strings.length + owned.numbers.length
    };
    let copy = take;
    take () + copy ()
}

export def array_functions :: i64 -> i64
fn array_functions n = {
    let functions = new [i64 -> i64](n, i -> x -> i + x);
    let copy = functions;
    if n == 0 { copy.length }
    else { functions[n - 1] 10 + copy[0] 20 }
}

export def array_temporaries :: i64
fn array_temporaries = {
    let f = new [i64 -> i64](3, i -> x -> i + x)[2];
    f 10 + new [[i64]](3, i -> [i, i + 1])[2][1]
}

export def array_wide :: bool
fn array_wide = {
    let values = new [Wide](3, i -> Wide { flag: i != 0, value: (i as i128) << 100 });
    let copy = values;
    let decimals = new [d128](3, i -> (i as d128) / 10.0);
    let flags = new [bool](3, i -> i == 2);
    let units = new [unit](3, i -> ());
    copy[2].value == (2i128 << 100) && values[1].flag
        && decimals[2] == 0.2 && flags[2] && !flags[0] && units[2] == ()
}

def refs :: &string -> i64 -> [&string]
fn refs value n = new [&string](n, i -> value)

export def array_borrows :: i64
fn array_borrows = {
    let text = "hello";
    let values = refs (&text) 3;
    let copy = values;
    values[0].length + copy[2].length + text.length
}

def replace :: &mut [string] -> unit
fn replace values = { *values = new [string](3, i -> "replacement"); }

export def array_replace :: i64
fn array_replace = {
    let mut numbers = [1];
    let copy = numbers;
    numbers = [2, 3];
    let mut strings = ["old"];
    replace (&mut strings);
    copy[0] + numbers.length + strings.length + strings[2].length
}

export def array_order :: i64
fn array_order = {
    let mut order = 0;
    let values = new [i64](
        { order = 1; 3 },
        { assert (order == 1); order = order + 1; i -> i + 20 }
    );
    order + values[0] + values[2]
}

def rec churn :: i64 -> [string] -> i64
fn rec churn n values = {
    let next = new [string](8, i -> "owned");
    if n == 0 { values.length } else { churn (n - 1) next }
}

export def array_churn :: i64 -> i64
fn array_churn n = churn n (new [string](8, i -> "initial"))

export def array_bounds :: i64 -> i64 -> i64
fn array_bounds n index = new [i64](n, i -> i)[index]

export def array_length :: i64 -> i64
fn array_length n = new [i64](n, i -> i).length

export def array_init_trap :: i64 -> i64
fn array_init_trap n = new [i64](n, i -> 10 / (i - 1)).length
