// A24 and A26: anonymous unions end to end. Every export takes and returns i64; tests/features.mjs compares the values with
// references written in JavaScript from the definitions below, natively (the host checks live == 0) and on WASM, at
// -O0 and -O3. Edition 2027: a parameter whose member is taken out by value is `own`.

// pick: one of three members by the sign of x, then a number back from the member (i64 is itself, string its length,
// bool 0 or 1). The match of `number` is the one the -O3 IR shows as a switch on the tag.
def make :: i64 -> (i64 | string | bool) = \x ->
    if x > 0 then x else if x == 0 then "zero" else true

def number :: (i64 | string | bool) -> i64 = \value ->
    match value with
    | :? i64 as n -> n
    | :? string as s -> s.length
    | :? bool as b -> if b then 1 else 0

export def pick :: i64 -> i64 = \x -> number (make x)

// mixed: an array of n elements, i64 at even positions and string at odd ones, summed by a for loop.
def element :: i64 -> (i64 | string) = \index ->
    if index % 2 == 0 then index else $"s{index}"

export def mixed :: i64 -> i64 = \n ->
    let items: [(i64 | string)] = Array.init n element
    let literal: [(string | i64)] = [1, "two"]
    let mut total = 0i64
    for item in items do
        total = total + (match item with
            | :? i64 as k -> k
            | :? string as s -> s.length)
    total + literal.length * 0

// owned: members that own heap memory (string and [i64]) are moved into an own parameter, overwritten in a loop,
// and dropped unread; the host checks that nothing stays live.
def measure :: own (string | [i64] | i64) -> i64 = \value ->
    match value with
    | :? string as text -> text.length
    | :? [i64] as numbers ->
        let mut sum = 0i64
        for x in numbers do sum = sum + x
        sum
    | :? i64 as k -> k

export def owned :: i64 -> i64 = \n ->
    let text: (string | [i64] | i64) = $"n={n}"
    let numbers: (string | [i64] | i64) = Array.init n (\i -> i + 1)
    let unread: (string | [i64] | i64) = $"dropped {n}"
    let mut slot: (string | [i64] | i64) = "start"
    for i in 0i64 ..< n do
        slot = if i % 2 == 0 then Array.init i (\k -> k) else $"{i}"
    let moved = numbers
    let _ = unread
    measure text * 1000000 + measure moved * 1000 + measure slot

// nested: an anonymous union inside Maybe and inside a record.
record Labeled { name: string, value: (i64 | string) }

def label :: i64 -> Labeled = \n ->
    Labeled { name: $"#{n}", value: if n % 3 == 0 then "three" else n }

def unwrap :: Maybe<(i64 | string)> -> i64 = \found ->
    match found with
    | Some (:? i64 as k) -> k
    | Some (:? string as s) -> s.length * 100
    | None -> -1

export def nested :: i64 -> i64 = \n ->
    let found: Maybe<(i64 | string)> = if n > 0 then Some n else if n == 0 then None else Some "negative"
    let labeled = label n
    let inner = match labeled.value with
        | :? i64 as k -> k * 10
        | :? string as s -> s.length
    unwrap found + inner + labeled.name.length * 1000

// recursive: a named union whose payload is an anonymous union with the union itself as a member; the nodes are on
// the heap. A chain of depth n ends in 7.
union Tree = Leaf | Node of (i64 | Tree)

def rec build :: i64 -> Tree = \depth ->
    if depth == 0 then Leaf else if depth == 1 then Node 7 else Node (build (depth - 1))

def rec total :: Tree -> i64 = \tree ->
    match tree with
    | Leaf -> 0
    | Node (:? i64 as v) -> v
    | Node (:? Tree as rest) -> 1 + total rest

export def recursive :: i64 -> i64 = \n -> total (build n)

// generic: a member that names a type variable of the signature, instantiated at i64 and at string.
def first_or :: own 'a -> own (Maybe<'a> | i64) -> 'a = \fallback value ->
    match value with
    | :? Maybe<'a> as found ->
        match found with
        | Some x -> x
        | None -> fallback
    | :? i64 -> fallback

export def generic :: i64 -> i64 = \n ->
    let number = first_or (n * 2) (if n > 0 then Some n else if n == 0 then None else 7)
    let word = first_or "fallback" (if n % 2 == 0 then Some "even" else n)
    number * 100 + word.length

// common: two members with the same LLVM type (the Common layout of a union).
def widen :: i64 -> (i64 | i64u) = \n ->
    if n >= 0 then (n as i64u) * 3i64u else n

export def common :: i64 -> i64 = \n ->
    match widen n with
    | :? i64u as u -> (u as i64) + 1
    | :? i64 as s -> s * 2

// wide: 32 members, the most an anonymous union holds; the function type is the last one in the canonical order.
type Wide =
    (i8u
    | i8
    | i16u
    | i16
    | i32u
    | i32
    | i64u
    | i64
    | i128u
    | i128
    | f16
    | f32
    | f64
    | f128
    | d32
    | d64
    | d128
    | bool
    | unit
    | char
    | utf8char
    | string
    | utf8string
    | Maybe<i64>
    | [i64]
    | [i64; 2]
    | [|i64|]
    | (i64 * i64)
    | (i64 * string)
    | (string * i64)
    | (i64 * i64 * i64)
    | (i64 -> i64))

export def wide :: i64 -> i64 = \n ->
    let value: Wide = if n > 0 then \x -> x * 2 + n else if n == 0 then "wide" else n
    match value with
    | :? (i64 -> i64) as f -> f 20
    | :? string as s -> s.length * 1000
    | :? i64 as k -> k
    | _ -> -1

// A26: the built-in instances Eq, Ord, Hash and Display. `key x` is the i64 x for an even x and the text `s{x}` for an
// odd one; in the canonical order the member i64 comes before the member string.
def key :: i64 -> (i64 | string) = \x ->
    if x % 2 == 0 then x else $"s{x}"

// ratio x is the f64 x / x: NaN for 0, else 1.0.
def ratio :: i64 -> (f64 | string) = \x -> (x as f64) / (x as f64)

// zero x is the f64 x * 0.0: -0.0 for a negative x, else 0.0.
def zero :: i64 -> (f64 | string) = \x -> (x as f64) * 0.0

// digit: `place` when the comparison holds, else 0.
def digit :: bool -> i64 -> i64 = \holds place -> if holds then place else 0

// equal: one decimal digit for each comparison, 1 when it holds.
export def equal :: i64 -> i64 = \x ->
    let a = key x
    let same = key x
    let other = key (x + 2)
    let neighbour = key (x + 1)
    let nan = ratio x
    let positive: (f64 | string) = 0.0
    let members = digit (a == same) 1 + digit (a == other) 10 + digit (a == neighbour) 100
    let negated = digit (a != neighbour) 1000 + digit (a != same) 10000
    let injected = digit (a == x) 100000 + digit (a == "s1") 1000000
    let floats = digit (nan == nan) 10000000 + digit (zero x == positive) 100000000
    members + negated + injected + floats + digit (Eq.eq (ref a) (ref same)) 1000000000

// order: one decimal digit for each comparison. `next` is the other member, `after` the same member.
export def order :: i64 -> i64 = \x ->
    let a = key x
    let next = key (x + 1)
    let after = key (x + 2)
    let across = digit (a < next) 1 + digit (a <= next) 10 + digit (a > next) 100 + digit (a >= next) 1000
    let within = digit (a < after) 10000 + digit (a >= after) 100000 + digit (a <= key x) 1000000 + digit (a > key x) 10000000
    across + within + digit (a < "s10") 100000000 + digit (a < 10) 1000000000

// A number for a text: its code units folded as in the JavaScript reference `checksum`.
def checksum :: string -> i64 = \text ->
    let mut hash = 7i64
    for unit in text do hash = (hash * 131 + (unit as i64)) % 1000000007
    hash

// sorted: the keys key 0 .. key (n - 1), inserted in a scrambled order into a Set, read back in the order of Ord
// (every i64 in numeric order, then every text in the order of its code units) and shown one after the other.
export def sorted :: i64 -> i64 = \n ->
    let mut set: Set<(i64 | string)> = Set.empty()
    for i in 0i64 ..< n do
        set = Set.insert (key (i * 7 % n)) set
    let mut text = ""
    for item in Set.iter set do
        text = text + Display.display item + ";"
    checksum text * 1000 + Set.length set

// hashed: n keys of at most 10 distinct values in a HashSet, and the number of times each was inserted in a HashMap.
export def hashed :: i64 -> i64 = \n ->
    let mut seen: HashSet<(i64 | string)> = HashSet.empty()
    let mut counts: HashMap<(i64 | string), i64> = HashMap.empty()
    for i in 0i64 ..< n do
        seen = HashSet.insert (key (i % 10)) seen
        let before = match HashMap.get (key (i % 10)) counts with
            | Some count -> count
            | None -> 0
        counts = HashMap.insert (key (i % 10)) (before + 1) counts
    let first = match HashMap.get (key 0) counts with
        | Some count -> count
        | None -> 0
    let text = match HashMap.get (key 3) counts with
        | Some count -> count
        | None -> 0
    let absent = if HashSet.contains (key 10) seen then 1 else 0
    HashSet.length seen + HashMap.length counts * 100 + first * 10000 + text * 1000000 + absent * 100000000

// digest: the hash of key x, and whether a named union with the same cases in the same order has the same hash.
union Named = Number of i64 | Text of string deriving (Hash)

def named :: i64 -> Named = \x ->
    if x % 2 == 0 then Number x else Text $"s{x}"

export def digest :: i64 -> i64 = \x ->
    let anonymous = Hash.hash (key x)
    if anonymous == Hash.hash (named x) then anonymous as i64 else 0

// shown: the texts of key x alone, in an interpolation, in a tuple, in an array, in a list, in a derived record and in
// a derived union. Alone and in an interpolation a text has no quotation marks; inside the others it has.
record Entry { name: string, value: (i64 | string) } deriving (Display)

union Boxed = Box of (i64 | string) deriving (Display)

export def shown :: i64 -> i64 = \x ->
    let alone = Display.display (key x)
    let interpolated = $"{key x}/{key (x + 1)}"
    let pair = Display.display (key x, key (x + 1))
    let items: [(i64 | string)] = [key x, key (x + 1)]
    let list: [|(i64 | string)|] = [|key (x + 1), key x|]
    let entry = Entry { name: "e", value: key (x + 1) }
    let boxed = Box (key (x + 1))
    let containers = Display.display items + "|" + Display.display list
    let derived = Display.display entry + "|" + Display.display boxed
    let text = alone + "|" + interpolated + "|" + pair + "|" + containers + "|" + derived
    checksum text * 1000 + text.length

// A26 Phase 2: Encode and Decode. `doc x` is one of five members by x mod 5: the i64 x, the bool x > 0, the text
// `s{x}`, the array [x, x + 1], the record Point { x, y = -x }. Encode writes the JSON of the member and no tag; Decode
// selects the member by the kind of the JSON value (number, boolean, string, array, object).
record Point { x: i64, y: i64 } deriving (Eq, Encode, Decode)

type Doc = (i64 | bool | string | [i64] | Point)

record Holder { name: string, value: Doc } deriving (Eq, Encode, Decode)

def doc :: i64 -> Doc = \x ->
    let kind = (x % 5 + 5) % 5
    if kind == 0 then x
    elif kind == 1 then x > 0
    elif kind == 2 then $"s{x}"
    elif kind == 3 then [x, x + 1]
    else Point { x: x, y: 0 - x }

// The JSON text of a value, or the text of the error.
def json_of :: Encode<'a> => own 'a -> string = \value ->
    match Json.serialize value with
    | Ok text -> String.from_utf8 (ref text)
    | Error error -> Display.display error

// encoded: the JSON texts of doc x alone, of five consecutive docs in an array, and of a derived record that holds one.
export def encoded :: i64 -> i64 = \x ->
    let items: [Doc] = [doc x, doc (x + 1), doc (x + 2), doc (x + 3), doc (x + 4)]
    let text = json_of (doc x) + "|" + json_of items + "|" + json_of (Holder { name: "h", value: doc (x + 2) })
    checksum text * 1000 + text.length

// What a decoded Doc is: the member and its payload, or the text of the error.
def described :: own Result<Doc, Json.Error> -> string = \decoded ->
    match decoded with
    | Error error -> "e:" + Display.display error
    | Ok value ->
        match value with
        | :? i64 as n -> $"i:{n}"
        | :? bool as b -> if b then "b:1" else "b:0"
        | :? string as s -> "s:" + s
        | :? [i64] as numbers ->
            let mut sum = 0i64
            for n in numbers do sum = sum + n
            $"a:{numbers.length}:{sum}"
        | :? Point as p -> $"p:{p.x},{p.y}"

def read :: own string -> string = \text ->
    let bytes = Utf8String.from_string (ref text)
    described (Json.deserialize (ref bytes))

type Table = (i64 | Map<string, i64>)

// A map member reads an object and an array of [key, value] arrays; the i64 member reads a number.
def table :: own string -> string = \text ->
    let bytes = Utf8String.from_string (ref text)
    let decoded: Result<Table, Json.Error> = Json.deserialize (ref bytes)
    match decoded with
    | Error error -> "e:" + Display.display error
    | Ok value ->
        match value with
        | :? i64 as n -> $"i:{n}"
        | :? Map<string, i64> as map ->
            let mut sum = 0i64
            for (_, item) in Map.iter map do sum = sum + deref item
            $"m:{Map.length map}:{sum}"

// decoded: JSON texts made from x, one for each kind, then the texts that no member reads or that the selected member
// refuses, then whether doc x .. doc (x + 4) and a derived record come back equal from their own JSON.
export def decoded :: i64 -> i64 = \x ->
    let members = read $"{x}" + "|" + read "true" + "|" + read " false " + "|" + read $"\"t{x}\"" + "|" + read $"[{x}, 2, 3]" + "|" + read "[]"
    let records = read $"{{\"y\": {x}, \"x\": 7, \"z\": null}}" + "|" + read "{\"x\": 1}" + "|" + read "{}"
    let refused = read "null" + "|" + read $"{x}.5" + "|" + read "[1, \"two\"]" + "|" + read "99999999999999999999" + "|" + read "{\"x\": true, \"y\": 2}" + "|" + read "tru"
    let tables = table $"{x}" + "|" + table $"{{\"a\": {x}, \"b\": 2}}" + "|" + table $"[[\"k\", {x}]]" + "|" + table "{}" + "|" + table "\"text\"" + "|" + table "[1]"
    let mut trips = 0i64
    for i in 0i64 ..< 5 do
        let back: Result<Doc, Json.Error> = match Json.serialize (doc (x + i)) with
            | Ok text -> Json.deserialize (ref text)
            | Error error -> Error error
        match back with
        | Ok value -> if value == doc (x + i) then trips = trips + 1
        | Error _ -> ()
    let holder: Result<Holder, Json.Error> = match Json.serialize (Holder { name: "h", value: doc x }) with
        | Ok text -> Json.deserialize (ref text)
        | Error error -> Error error
    let original = Holder { name: "h", value: doc x }
    let kept = match holder with
        | Ok value -> if value == original then 1 else 0
        | Error _ -> 0
    let text = members + "|" + records + "|" + refused + "|" + tables + $"|{trips}{kept}"
    checksum text * 1000 + text.length
