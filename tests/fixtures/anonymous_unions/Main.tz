// A24, A25 and A26: anonymous unions end to end. Every export takes and returns i64; tests/features.mjs compares the
// values with references written in JavaScript from the definitions below, natively (the host checks live == 0) and on
// WASM, at -O0 and -O3. Edition 2027: a parameter whose member is taken out by value is `own`.

// pick: one of three members by the sign of x, then a number back from the member (i64 is itself, string its length,
// bool 0 or 1). The match of `number` is the one the -O3 IR shows as a switch on the tag.
def make :: i64 -> (i64 | string | bool) = \x ->
    if x > 0 then x else if x == 0 then "zero" else true

def number :: (i64 | string | bool) -> i64 = \value ->
    match value with
    | :? i64 as n -> n
    | :? string as s -> s.length
    | :? bool as b -> if b then 1 else 0

export def pick :: i64 -> i64 = \x -> number (make x)

// mixed: an array of n elements, i64 at even positions and string at odd ones, summed by a for loop.
def element :: i64 -> (i64 | string) = \index ->
    if index % 2 == 0 then index else $"s{index}"

export def mixed :: i64 -> i64 = \n ->
    let items: [(i64 | string)] = Array.init n element
    let literal: [(string | i64)] = [1, "two"]
    let mut total = 0i64
    for item in items do
        total = total + (match item with
            | :? i64 as k -> k
            | :? string as s -> s.length)
    total + literal.length * 0

// owned: members that own heap memory (string and [i64]) are moved into an own parameter, overwritten in a loop,
// and dropped unread; the host checks that nothing stays live.
def measure :: own (string | [i64] | i64) -> i64 = \value ->
    match value with
    | :? string as text -> text.length
    | :? [i64] as numbers ->
        let mut sum = 0i64
        for x in numbers do sum = sum + x
        sum
    | :? i64 as k -> k

export def owned :: i64 -> i64 = \n ->
    let text: (string | [i64] | i64) = $"n={n}"
    let numbers: (string | [i64] | i64) = Array.init n (\i -> i + 1)
    let unread: (string | [i64] | i64) = $"dropped {n}"
    let mut slot: (string | [i64] | i64) = "start"
    for i in 0i64 ..< n do
        slot = if i % 2 == 0 then Array.init i (\k -> k) else $"{i}"
    let moved = numbers
    let _ = unread
    measure text * 1000000 + measure moved * 1000 + measure slot

// nested: an anonymous union inside Maybe and inside a record.
record Labeled { name: string, value: (i64 | string) }

def label :: i64 -> Labeled = \n ->
    Labeled { name: $"#{n}", value: if n % 3 == 0 then "three" else n }

def unwrap :: Maybe<(i64 | string)> -> i64 = \found ->
    match found with
    | Some (:? i64 as k) -> k
    | Some (:? string as s) -> s.length * 100
    | None -> -1

export def nested :: i64 -> i64 = \n ->
    let found: Maybe<(i64 | string)> = if n > 0 then Some n else if n == 0 then None else Some "negative"
    let labeled = label n
    let inner = match labeled.value with
        | :? i64 as k -> k * 10
        | :? string as s -> s.length
    unwrap found + inner + labeled.name.length * 1000

// recursive: a named union whose payload is an anonymous union with the union itself as a member; the nodes are on
// the heap. A chain of depth n ends in 7.
union Tree = Leaf | Node of (i64 | Tree)

def rec build :: i64 -> Tree = \depth ->
    if depth == 0 then Leaf else if depth == 1 then Node 7 else Node (build (depth - 1))

def rec total :: Tree -> i64 = \tree ->
    match tree with
    | Leaf -> 0
    | Node (:? i64 as v) -> v
    | Node (:? Tree as rest) -> 1 + total rest

export def recursive :: i64 -> i64 = \n -> total (build n)

// generic: a member that names a type variable of the signature, instantiated at i64 and at string.
def first_or :: own 'a -> own (Maybe<'a> | i64) -> 'a = \fallback value ->
    match value with
    | :? Maybe<'a> as found ->
        match found with
        | Some x -> x
        | None -> fallback
    | :? i64 -> fallback

export def generic :: i64 -> i64 = \n ->
    let number = first_or (n * 2) (if n > 0 then Some n else if n == 0 then None else 7)
    let word = first_or "fallback" (if n % 2 == 0 then Some "even" else n)
    number * 100 + word.length

// common: two members with the same LLVM type (the Common layout of a union).
def either_sign :: i64 -> (i64 | i64u) = \n ->
    if n >= 0 then (n as i64u) * 3i64u else n

export def common :: i64 -> i64 = \n ->
    match either_sign n with
    | :? i64u as u -> (u as i64) + 1
    | :? i64 as s -> s * 2

// wide: 32 members, the most an anonymous union holds; the function type is the last one in the canonical order.
type Wide =
    (i8u
    | i8
    | i16u
    | i16
    | i32u
    | i32
    | i64u
    | i64
    | i128u
    | i128
    | f16
    | f32
    | f64
    | f128
    | d32
    | d64
    | d128
    | bool
    | unit
    | char
    | utf8char
    | string
    | utf8string
    | Maybe<i64>
    | [i64]
    | [i64; 2]
    | [|i64|]
    | (i64 * i64)
    | (i64 * string)
    | (string * i64)
    | (i64 * i64 * i64)
    | (i64 -> i64))

export def wide :: i64 -> i64 = \n ->
    let value: Wide = if n > 0 then \x -> x * 2 + n else if n == 0 then "wide" else n
    match value with
    | :? (i64 -> i64) as f -> f 20
    | :? string as s -> s.length * 1000
    | :? i64 as k -> k
    | _ -> -1

// A26: the built-in instances Eq, Ord, Hash and Display. `key x` is the i64 x for an even x and the text `s{x}` for an
// odd one; in the canonical order the member i64 comes before the member string.
def key :: i64 -> (i64 | string) = \x ->
    if x % 2 == 0 then x else $"s{x}"

// ratio x is the f64 x / x: NaN for 0, else 1.0.
def ratio :: i64 -> (f64 | string) = \x -> (x as f64) / (x as f64)

// zero x is the f64 x * 0.0: -0.0 for a negative x, else 0.0.
def zero :: i64 -> (f64 | string) = \x -> (x as f64) * 0.0

// digit: `place` when the comparison holds, else 0.
def digit :: bool -> i64 -> i64 = \holds place -> if holds then place else 0

// equal: one decimal digit for each comparison, 1 when it holds.
export def equal :: i64 -> i64 = \x ->
    let a = key x
    let same = key x
    let other = key (x + 2)
    let neighbour = key (x + 1)
    let nan = ratio x
    let positive: (f64 | string) = 0.0
    let members = digit (a == same) 1 + digit (a == other) 10 + digit (a == neighbour) 100
    let negated = digit (a != neighbour) 1000 + digit (a != same) 10000
    let injected = digit (a == x) 100000 + digit (a == "s1") 1000000
    let floats = digit (nan == nan) 10000000 + digit (zero x == positive) 100000000
    members + negated + injected + floats + digit (Eq.eq (ref a) (ref same)) 1000000000

// order: one decimal digit for each comparison. `next` is the other member, `after` the same member.
export def order :: i64 -> i64 = \x ->
    let a = key x
    let next = key (x + 1)
    let after = key (x + 2)
    let across = digit (a < next) 1 + digit (a <= next) 10 + digit (a > next) 100 + digit (a >= next) 1000
    let within = digit (a < after) 10000 + digit (a >= after) 100000 + digit (a <= key x) 1000000 + digit (a > key x) 10000000
    across + within + digit (a < "s10") 100000000 + digit (a < 10) 1000000000

// A number for a text: its code units folded as in the JavaScript reference `checksum`.
def checksum :: string -> i64 = \text ->
    let mut hash = 7i64
    for unit in text do hash = (hash * 131 + (unit as i64)) % 1000000007
    hash

// sorted: the keys key 0 .. key (n - 1), inserted in a scrambled order into a Set, read back in the order of Ord
// (every i64 in numeric order, then every text in the order of its code units) and shown one after the other.
export def sorted :: i64 -> i64 = \n ->
    let mut set: Set<(i64 | string)> = Set.empty()
    for i in 0i64 ..< n do
        set = Set.insert (key (i * 7 % n)) set
    let mut text = ""
    for item in Set.iter set do
        text = text + Display.display item + ";"
    checksum text * 1000 + Set.length set

// hashed: n keys of at most 10 distinct values in a HashSet, and the number of times each was inserted in a HashMap.
export def hashed :: i64 -> i64 = \n ->
    let mut seen: HashSet<(i64 | string)> = HashSet.empty()
    let mut counts: HashMap<(i64 | string), i64> = HashMap.empty()
    for i in 0i64 ..< n do
        seen = HashSet.insert (key (i % 10)) seen
        let before = match HashMap.get (key (i % 10)) counts with
            | Some count -> count
            | None -> 0
        counts = HashMap.insert (key (i % 10)) (before + 1) counts
    let first = match HashMap.get (key 0) counts with
        | Some count -> count
        | None -> 0
    let text = match HashMap.get (key 3) counts with
        | Some count -> count
        | None -> 0
    let absent = if HashSet.contains (key 10) seen then 1 else 0
    HashSet.length seen + HashMap.length counts * 100 + first * 10000 + text * 1000000 + absent * 100000000

// digest: the hash of key x, and whether a named union with the same cases in the same order has the same hash.
union Named = Number of i64 | Text of string deriving (Hash)

def named :: i64 -> Named = \x ->
    if x % 2 == 0 then Number x else Text $"s{x}"

export def digest :: i64 -> i64 = \x ->
    let anonymous = Hash.hash (key x)
    if anonymous == Hash.hash (named x) then anonymous as i64 else 0

// shown: the texts of key x alone, in an interpolation, in a tuple, in an array, in a list, in a derived record and in
// a derived union. Alone and in an interpolation a text has no quotation marks; inside the others it has.
record Entry { name: string, value: (i64 | string) } deriving (Display)

union Boxed = Box of (i64 | string) deriving (Display)

export def shown :: i64 -> i64 = \x ->
    let alone = Display.display (key x)
    let interpolated = $"{key x}/{key (x + 1)}"
    let pair = Display.display (key x, key (x + 1))
    let items: [(i64 | string)] = [key x, key (x + 1)]
    let list: [|(i64 | string)|] = [|key (x + 1), key x|]
    let entry = Entry { name: "e", value: key (x + 1) }
    let boxed = Box (key (x + 1))
    let containers = Display.display items + "|" + Display.display list
    let derived = Display.display entry + "|" + Display.display boxed
    let text = alone + "|" + interpolated + "|" + pair + "|" + containers + "|" + derived
    checksum text * 1000 + text.length

// A26 Phase 2: Encode and Decode. `doc x` is one of five members by x mod 5: the i64 x, the bool x > 0, the text
// `s{x}`, the array [x, x + 1], the record Point { x, y = -x }. Encode writes the JSON of the member and no tag; Decode
// selects the member by the kind of the JSON value (number, boolean, string, array, object).
record Point { x: i64, y: i64 } deriving (Eq, Encode, Decode)

type Doc = (i64 | bool | string | [i64] | Point)

record Holder { name: string, value: Doc } deriving (Eq, Encode, Decode)

def doc :: i64 -> Doc = \x ->
    let kind = (x % 5 + 5) % 5
    if kind == 0 then x
    elif kind == 1 then x > 0
    elif kind == 2 then $"s{x}"
    elif kind == 3 then [x, x + 1]
    else Point { x: x, y: 0 - x }

// The JSON text of a value, or the text of the error.
def json_of :: Encode<'a> => own 'a -> string = \value ->
    match Json.serialize value with
    | Ok text -> String.from_utf8 (ref text)
    | Error error -> Display.display error

// encoded: the JSON texts of doc x alone, of five consecutive docs in an array, and of a derived record that holds one.
export def encoded :: i64 -> i64 = \x ->
    let items: [Doc] = [doc x, doc (x + 1), doc (x + 2), doc (x + 3), doc (x + 4)]
    let text = json_of (doc x) + "|" + json_of items + "|" + json_of (Holder { name: "h", value: doc (x + 2) })
    checksum text * 1000 + text.length

// What a decoded Doc is: the member and its payload, or the text of the error.
def described :: own Result<Doc, Json.Error> -> string = \decoded ->
    match decoded with
    | Error error -> "e:" + Display.display error
    | Ok value ->
        match value with
        | :? i64 as n -> $"i:{n}"
        | :? bool as b -> if b then "b:1" else "b:0"
        | :? string as s -> "s:" + s
        | :? [i64] as numbers ->
            let mut sum = 0i64
            for n in numbers do sum = sum + n
            $"a:{numbers.length}:{sum}"
        | :? Point as p -> $"p:{p.x},{p.y}"

def read :: own string -> string = \text ->
    let bytes = Utf8String.from_string (ref text)
    described (Json.deserialize (ref bytes))

type Table = (i64 | Map<string, i64>)

// A map member reads an object and an array of [key, value] arrays; the i64 member reads a number.
def table :: own string -> string = \text ->
    let bytes = Utf8String.from_string (ref text)
    let decoded: Result<Table, Json.Error> = Json.deserialize (ref bytes)
    match decoded with
    | Error error -> "e:" + Display.display error
    | Ok value ->
        match value with
        | :? i64 as n -> $"i:{n}"
        | :? Map<string, i64> as map ->
            let mut sum = 0i64
            for (_, item) in Map.iter map do sum = sum + deref item
            $"m:{Map.length map}:{sum}"

// decoded: JSON texts made from x, one for each kind, then the texts that no member reads or that the selected member
// refuses, then whether doc x .. doc (x + 4) and a derived record come back equal from their own JSON.
export def decoded :: i64 -> i64 = \x ->
    let members = read $"{x}" + "|" + read "true" + "|" + read " false " + "|" + read $"\"t{x}\"" + "|" + read $"[{x}, 2, 3]" + "|" + read "[]"
    let records = read $"{{\"y\": {x}, \"x\": 7, \"z\": null}}" + "|" + read "{\"x\": 1}" + "|" + read "{}"
    let refused = read "null" + "|" + read $"{x}.5" + "|" + read "[1, \"two\"]" + "|" + read "99999999999999999999" + "|" + read "{\"x\": true, \"y\": 2}" + "|" + read "tru"
    let tables = table $"{x}" + "|" + table $"{{\"a\": {x}, \"b\": 2}}" + "|" + table $"[[\"k\", {x}]]" + "|" + table "{}" + "|" + table "\"text\"" + "|" + table "[1]"
    let mut trips = 0i64
    for i in 0i64 ..< 5 do
        let back: Result<Doc, Json.Error> = match Json.serialize (doc (x + i)) with
            | Ok text -> Json.deserialize (ref text)
            | Error error -> Error error
        match back with
        | Ok value -> if value == doc (x + i) then trips = trips + 1
        | Error _ -> ()
    let holder: Result<Holder, Json.Error> = match Json.serialize (Holder { name: "h", value: doc x }) with
        | Ok text -> Json.deserialize (ref text)
        | Error error -> Error error
    let original = Holder { name: "h", value: doc x }
    let kept = match holder with
        | Ok value -> if value == original then 1 else 0
        | Error _ -> 0
    let text = members + "|" + records + "|" + refused + "|" + tables + $"|{trips}{kept}"
    checksum text * 1000 + text.length

// A25: conversions between anonymous unions.

// widen: a (i64 | string) where a read parameter of four members is expected. The call borrows the widened value,
// which is a temporary; its string is freed after the call.
def number_or_text :: i64 -> (i64 | string) = \n -> if n % 2 == 0 then n else $"odd {n}"

def weigh :: (f64 | i64 | string | [i64]) -> i64 = \value ->
    match value with
    | :? f64 -> 1
    | :? i64 as k -> k
    | :? string as s -> s.length
    | :? [i64] as xs -> xs.length

export def widen :: i64 -> i64 = \n -> weigh (number_or_text n)

// widen_owned: values that own heap memory are widened in bindings, in an assignment inside a loop (which frees the
// value it replaces) and into a value that is dropped unread.
export def widen_owned :: i64 -> i64 = \n ->
    let text: (i64 | string) = $"n={n}"
    let numbers: (i64 | [i64]) = Array.init n (\i -> i)
    let dropped: (string | [i64]) = $"dropped {n}"
    let wide: (f64 | i64 | string | [i64]) = text
    let mut slot: (f64 | i64 | string | [i64]) = numbers
    let unread: (i64 | string | [i64]) = dropped
    let total = weigh wide * 1000 + weigh slot
    for i in 0i64 ..< n do
        let step: (i64 | string) = if i % 2 == 0 then i else $"{i}"
        slot = step
    let _ = unread
    total + weigh slot * 1000000

// widen_read: owned values with an array or a string are widened straight into the read parameter of weigh, from a
// local and from a temporary. The call borrows the widened value, into which the payload moves, and frees it after
// the call; nothing is copied.
def counted :: i64 -> (i64 | [i64]) = \n -> if n % 2 == 0 then Array.init (n + 3) (\i -> i) else n

def labelled :: i64 -> (string | [i64]) = \n -> if n % 3 == 0 then $"label {n}" else Array.init (n + 1) (\i -> i)

export def widen_read :: i64 -> i64 = \n ->
    let numbers = counted n
    let label = labelled n
    weigh numbers + weigh label * 100 + weigh (labelled (n + 1)) * 10000

// widen_read_branch: an `if` and a `match` lent to the read parameter of weigh widen one branch and inject the other.
// The payload of the widened branch moves into the borrowed value; when the other branch runs, the local keeps its
// payload and is dropped at the end of the function. Nothing is copied.
export def widen_read_branch :: i64 -> i64 = \n ->
    let numbers = counted n
    let label = labelled n
    let first = weigh (if n > 2 then numbers else 1.5)
    let second = weigh (match n % 2 with
        | 0 -> label
        | _ -> 7)
    first + second * 100

// narrow: the numbers of a (f64 | i64 | string) are narrowed to (i64 | f64) and passed on. The matched value is a
// temporary that keeps its string: the narrowed value is a copy of the number.
def classify :: i64 -> (f64 | i64 | string) = \n ->
    if n % 3 == 0 then n else if n % 3 == 1 then (n as f64) * 0.5 else $"text {n}"

def scale :: (i64 | f64) -> i64 = \number ->
    match number with
    | :? i64 as k -> k * 3
    | :? f64 as x -> (x * 4.0) as i64

export def narrow :: i64 -> i64 = \n ->
    match classify n with
    | :? (i64 | f64) as number -> scale number
    | :? string as text -> text.length * 1000

// narrow_owned: the members that own heap memory move out of an owned value into the narrowed one, from a temporary
// in a loop, from a local, into a narrowed value that is dropped unread, and from the payload of a Maybe. In the last
// match `whole` moves the payload that `number` is narrowed from, so `number` is a copy made by the pattern.
def heap :: i64 -> (f64 | i64 | string | [i64]) = \n ->
    if n % 4 == 0 then $"n={n}" else if n % 4 == 1 then Array.init n (\i -> i) else if n % 4 == 2 then n else 1.5

def sized :: own (string | [i64]) -> i64 = \value ->
    match value with
    | :? string as text -> text.length
    | :? [i64] as numbers -> numbers.length * 10

export def narrow_owned :: i64 -> i64 = \n ->
    let mut total = 0i64
    for i in 0i64 ..< n do
        total = total + (match heap i with
            | :? (string | [i64]) as owner -> sized owner
            | :? i64 as k -> k
            | :? f64 -> 1)
    let kept = heap n
    let rest = match kept with
        | :? (string | [i64]) as owner -> sized owner
        | :? (i64 | f64) as number -> scale number
    let unread = match heap (n + 1) with
        | :? (string | [i64]) as _owner -> 7
        | :? (i64 | f64) as _number -> 9
    let wrapped: Maybe<(f64 | i64 | string | [i64])> = if n == 5 then None else Some (heap (n + 2))
    let inner = match wrapped with
        | Some (:? (string | [i64]) as owner) -> sized owner
        | Some ((:? (i64 | f64) as number) as whole) -> scale number + weigh whole
        | None -> 0
    total + rest * 1000000 + unread * 100000000 + inner * 10000000000

// narrow_views: the elements of an array are narrowed in place (the narrowed value is a copy, of an array too), under
// a guard that fails or holds, and through a read parameter.
def part :: ([i64] | i64) -> i64 = \value ->
    match value with
    | :? [i64] as numbers -> numbers.length * 10
    | :? i64 as k -> k

def numbers_of :: (f64 | i64 | string | [i64]) -> i64 = \value ->
    match value with
    | :? (i64 | f64) as number -> scale number
    | _ -> 0

export def narrow_views :: i64 -> i64 = \n ->
    let items: [(f64 | i64 | string | [i64])] = Array.init n heap
    let mut total = 0i64
    let mut numbers = 0i64
    for item in items do
        total = total + (match item with
            | :? ([i64] | i64) as piece when part piece > 25 -> 5
            | :? ([i64] | i64) as piece -> part piece
            | :? (f64 | string) -> 2)
        numbers = numbers + numbers_of item
    total * 1000000 + numbers + items.length * 0

// narrow_copy: a union of Copy members with an array, (i64 | f64 | [i64]), is narrowed to (i64 | [i64]) from a local
// that is read again and through a read parameter: the hidden binding views the matched value and the array is copied
// once, into the narrowed value. A union with a function member may hold loans: its narrowing copies the number in a
// step of the pattern and leaves the value to the read parameter.
def counted_or_half :: i64 -> (i64 | f64 | [i64]) = \n ->
    if n % 3 == 0 then Array.init (n + 2) (\i -> i) else if n % 3 == 1 then n else (n as f64) * 0.5

def kept_part :: (i64 | f64 | [i64]) -> i64 = \value ->
    match value with
    | :? (i64 | [i64]) as kept -> part kept
    | :? f64 -> 1

def callable :: i64 -> (i64 | f64 | string | (i64 -> i64)) = \n ->
    if n % 2 == 0 then n else \(k: i64) -> k + n

def call_or_scale :: (i64 | f64 | string | (i64 -> i64)) -> i64 = \value ->
    match value with
    | :? (i64 | f64) as number -> scale number
    | :? string as text -> text.length
    | :? (i64 -> i64) as f -> f 100

export def narrow_copy :: i64 -> i64 = \n ->
    let value = counted_or_half n
    let first = match value with
        | :? (i64 | [i64]) as kept -> part kept
        | :? f64 -> 1
    first + kept_part value * 1000 + call_or_scale (callable n) * 1000000

// narrow_generic: a narrowing into Copy members of a union with a type variable copies the number in a step of the
// pattern whatever the type argument, here a pair of a string and a function that captures n, which holds loans:
// through a read parameter and from an owned value that is read again. The narrowing of a Copy union beside a binding
// that moves another part of the matched value copies the array once.
def generic_number :: (i64 | f64 | Maybe<'a>) -> i64 = \value ->
    match value with
    | :? (i64 | f64) as number -> scale number
    | :? Maybe<'a> -> 7

def generic_again :: own (i64 | f64 | Maybe<'a>) -> i64 = \value ->
    let first = match value with
        | :? (i64 | f64) as number -> scale number
        | :? Maybe<'a> -> 0
    first * 1000 + generic_number value

def labelled_pair :: i64 -> (i64 | f64 | Maybe<(string * (i64 -> i64))>) = \n ->
    if n % 3 == 0 then n else if n % 3 == 1 then (n as f64) * 0.5 else Some ($"pair {n}", \(k: i64) -> k + n)

def beside_label :: own (string * (i64 | f64 | [i64])) -> i64 = \pair ->
    match pair with
    | (label, :? (i64 | [i64]) as kept) -> label.length * 1000 + part kept
    | (label, _) -> label.length

export def narrow_generic :: i64 -> i64 = \n ->
    generic_number (labelled_pair n) + generic_again (labelled_pair n) * 10 + beside_label ($"n={n}", counted_or_half n) * 100000000

// widen_captured: closures convert the values that they capture, on each call: a widening into an own and into a read
// parameter, a widening in an annotated binding and a narrowing; the continuation of a computation expression widens
// the value that it captures (`return`). A closure that does not consume its captures lends them to its body, so the
// payload that a conversion binds is a copy and the environment frees each value once.
def take :: own (f64 | i64 | string | [i64]) -> i64 = \value ->
    match value with
    | :? f64 -> 1
    | :? i64 as k -> k
    | :? string as s -> s.length
    | :? [i64] as xs -> xs.length

def pick_counted :: i64 -> Maybe<(f64 | i64 | string | [i64])> = \n ->
    let numbers = counted n
    let! _step = Maybe.Some n
    return numbers

export def widen_captured :: i64 -> i64 = \n ->
    let numbers = counted n
    let label = labelled n
    let item = heap n
    let wide = \(k: i64) -> take numbers * k + weigh numbers
    let typed = \(k: i64) ->
        let value: (f64 | i64 | string | [i64]) = label
        take value + k
    let narrowed = \(k: i64) ->
        match item with
        | :? (string | [i64]) as owner -> sized owner + k
        | :? (i64 | f64) as number -> scale number + k
    let continued = match pick_counted n with
        | Some value -> take value
        | None -> 0
    wide 1 + wide 2 + (typed 0 + typed 1) * 1000 + (narrowed 0 + narrowed 1) * 1000000 + continued * 1000000000

// widen_generic: an owned (Maybe<'a> | [i64]) is widened into (bool | Maybe<'a> | [i64]) in a generic function whose
// instances make 'a an i64 and a string: the array moves into the wider union in each of them, as it does when 'a is
// an array. Nothing is copied.
def open_size :: own (bool | Maybe<'a> | [i64]) -> i64 = \value ->
    match value with
    | :? bool -> 1
    | :? Maybe<'a> as found -> (match found with | Some _ -> 2 | None -> 3)
    | :? [i64] as numbers -> numbers.length * 10

def widen_open :: own (Maybe<'a> | [i64]) -> i64 = \value -> open_size value

def maybe_number :: i64 -> (Maybe<i64> | [i64]) = \n -> if n % 2 == 0 then Array.init (n + 1) (\i -> i) else Some n

def maybe_text :: i64 -> (Maybe<string> | [i64]) = \n ->
    if n % 3 == 0 then Array.init (n + 2) (\i -> i) else if n % 3 == 1 then Some $"t{n}" else None

export def widen_generic :: i64 -> i64 = \n -> widen_open (maybe_number n) + widen_open (maybe_text n) * 1000
