union List = Nil | Cons of (i64 * Rc<List>)
union AList = ANil | ACons of (i64 * Arc<AList>)
record Node { value: i64, children: Vec<Rc<Node>> }
record Link { value: i64, next: Maybe<Rc<Link>> }
record Pair<'a> { left: 'a, right: 'a }
record TreeNode { value: i64, parent: Maybe<Rc.Weak<TreeNode>>, children: Vec<Rc<TreeNode>> }

export def rc_counts :: i64
fn rc_counts =
    let first = Rc.new "value"
    let second = Rc.share (ref first)
    let third = Rc.share (ref second)
    let weak = Rc.downgrade (ref first)
    let other_weak = Rc.downgrade (ref third)
    let before = Rc.strong_count (ref first) * 10 + Rc.weak_count (ref first)
    Owned.drop second
    Owned.drop third
    Owned.drop other_weak
    let after = Rc.strong_count (ref first) * 10 + Rc.weak_count (ref first)
    let alive = match Rc.upgrade (ref weak) with
        | Maybe.Some strong -> Rc.strong_count (ref strong)
        | Maybe.None -> 0
    before * 10000 + after * 100 + alive

export def rc_try_unwrap :: i64
fn rc_try_unwrap =
    let shared = Rc.new "unwrap"
    let other = Rc.share (ref shared)
    match Rc.try_unwrap shared with
    | Result.Ok _text -> 0
    | Result.Error kept ->
        let count = Rc.strong_count (ref kept)
        Owned.drop other
        match Rc.try_unwrap kept with
        | Result.Ok text -> count * 100 + text.length
        | Result.Error _again -> 1

export def arc_try_unwrap :: i64
fn arc_try_unwrap =
    let shared = Arc.new "unwrap"
    let other = Arc.share (ref shared)
    match Arc.try_unwrap shared with
    | Result.Ok _text -> 0
    | Result.Error kept ->
        let count = Arc.strong_count (ref kept)
        Owned.drop other
        match Arc.try_unwrap kept with
        | Result.Ok text -> count * 100 + text.length
        | Result.Error _again -> 1

export def rc_upgrade_after_drop :: i64
fn rc_upgrade_after_drop =
    let shared = Rc.new [1, 2, 3]
    let weak = Rc.downgrade (ref shared)
    let before = match Rc.upgrade (ref weak) with
        | Maybe.Some strong -> Rc.strong_count (ref strong)
        | Maybe.None -> 0
    Owned.drop shared
    let after = match Rc.upgrade (ref weak) with
        | Maybe.Some _strong -> 100
        | Maybe.None -> 10
    before + after

export def arc_upgrade_after_drop :: i64
fn arc_upgrade_after_drop =
    let shared = Arc.new [1, 2, 3]
    let weak = Arc.downgrade (ref shared)
    let before = match Arc.upgrade (ref weak) with
        | Maybe.Some strong -> Arc.strong_count (ref strong)
        | Maybe.None -> 0
    Owned.drop shared
    let after = match Arc.upgrade (ref weak) with
        | Maybe.Some _strong -> 100
        | Maybe.None -> 10
    before + after

def build :: own i64 -> Rc<List>
fn build count =
    let mut list = Rc.new Nil
    let mut index = 0
    while index < count do
        list = Rc.new (Cons (index, list))
        index = index + 1
    list

def sum :: ref Rc<List> -> i64
fn sum list =
    let mut total = 0
    let mut cursor = Rc.share list
    let mut walking = true
    while walking do
        let next = match Rc.get (ref cursor) with
            | Cons (value, rest) ->
                total = total + value
                Maybe.Some (Rc.share (ref rest))
            | Nil -> Maybe.None
        match next with
        | Maybe.Some rest -> cursor = rest
        | Maybe.None -> walking = false
    total

export def rc_chain :: own i64 -> i64
fn rc_chain count =
    let list = build count
    sum (ref list)

export def rc_long_drop :: own i64 -> i64
fn rc_long_drop count =
    let mut chain: Maybe<Rc<Link>> = Maybe.None
    let mut index = 0
    while index < count do
        chain = Maybe.Some (Rc.new (Link { value: index, next: chain }))
        index = index + 1
    match chain with
    | Maybe.Some head ->
        let node = Rc.get (ref head)
        node.value + 1
    | Maybe.None -> 0

export def arc_chain :: own i64 -> i64
fn arc_chain count =
    let mut list = Arc.new ANil
    let mut index = 0
    while index < count do
        list = Arc.new (ACons (index, list))
        index = index + 1
    let mut total = 0
    let mut cursor = Arc.share (ref list)
    let mut walking = true
    while walking do
        let next = match Arc.get (ref cursor) with
            | ACons (value, rest) ->
                total = total + value
                Maybe.Some (Arc.share (ref rest))
            | ANil -> Maybe.None
        match next with
        | Maybe.Some rest -> cursor = rest
        | Maybe.None -> walking = false
    total

export def rc_shared_tails :: i64
fn rc_shared_tails =
    let base = build 11
    let first = Rc.new (Cons (100, Rc.share (ref base)))
    let second = Rc.new (Cons (200, Rc.share (ref base)))
    let count = Rc.strong_count (ref base)
    sum (ref first) + sum (ref second) + count * 1000

def leaf :: own i64 -> Rc<Node>
fn leaf value = Rc.new (Node { value: value, children: Vec.empty() })

def rec total :: ref Rc<Node> -> i64
fn rec total node =
    let current = Rc.get node
    let mut result = current.value
    let mut index = 0
    while index < Vec.length (ref current.children) do
        result = result + total (ref current.children[index])
        index = index + 1
    result

export def rc_dag :: i64
fn rc_dag =
    let bottom = leaf 4
    let left = Rc.new (Node { value: 2, children: Vec.push_owned (Rc.share (ref bottom)) (Vec.empty()) })
    let right = Rc.new (Node { value: 3, children: Vec.push_owned (Rc.share (ref bottom)) (Vec.empty()) })
    let top = Rc.new (Node { value: 1, children: Vec.push_owned right (Vec.push_owned left (Vec.empty())) })
    total (ref top) * 10 + Rc.strong_count (ref bottom)

export def rc_ptr_eq :: i64
fn rc_ptr_eq =
    let first = Rc.new 7
    let second = Rc.share (ref first)
    let other = Rc.new 7
    (if Rc.ptr_eq (ref first) (ref second) then 10 else 0) + (if Rc.ptr_eq (ref first) (ref other) then 1 else 0)

export def rc_borrowed :: i64
fn rc_borrowed =
    let text = "borrowed"
    let shared = Rc.new (ref text)
    let other = Rc.share (ref shared)
    let value = Rc.get (ref other)
    value.length

export def arc_capture :: i64
fn arc_capture =
    let shared = Arc.new 21
    let read = \() -> Arc.strong_count (ref shared)
    let copy = read
    read () * 10 + copy ()

// The parallel jobs below share an Arc between threads (on WASM threads too, where the jobs of
// `Parallel.for_each_chunk 1` go to the workers of the pool). A slot holds what its job owns, and the
// job writes its result over the slot, so the shares are dropped on the job's thread; a slot that
// still holds a share at the end is -1.
union Part = Pending of (Arc<[i64]> * i64) | Summed of i64

// Every fourth number of the shared array, from the job's offset.
def part :: i64 -> ref mut [Part..] -> unit
fn part _index slot =
    let total = match slot[0] with
        | Pending (values, offset) ->
            let numbers = Arc.get (ref values)
            let mut total = 0
            let mut index = offset
            while index < numbers.length do
                total = total + numbers[index]
                index = index + 4
            total
        | Summed total -> total
    Array.write 0 (Summed total) slot

def parts :: ref Arc<[i64]> -> [Part]
fn parts shared = new [Part](4, \offset -> Pending (Arc.share shared, offset))

def rec summed :: ref [Part] -> own i64 -> own i64 -> i64
fn rec summed jobs index sum =
    if index == jobs.length then sum
    else match jobs[index] with
        | Summed total -> summed jobs (index + 1) (sum + total)
        | Pending (_values, _offset) -> -1

export def arc_parallel :: own i64 -> i64
fn arc_parallel count =
    let shared = Arc.new (new [i64](count, \index -> index))
    let mut jobs = parts (ref shared)
    Parallel.for_each_chunk 1 part (ref mut jobs)
    summed (ref jobs) 0 0 * 10 + Arc.strong_count (ref shared)

union Peek = Watching of Arc.Weak<[i64]> | Seen of i64

def peek :: i64 -> ref mut [Peek..] -> unit
fn peek _index slot =
    let seen = match slot[0] with
        | Watching weak ->
            match Arc.upgrade (ref weak) with
            | Maybe.Some strong -> Array.sum (Arc.get (ref strong))
            | Maybe.None -> 0
        | Seen total -> total
    Array.write 0 (Seen seen) slot

def peeks :: ref Arc<[i64]> -> [Peek]
fn peeks shared = new [Peek](4, \_index -> Watching (Arc.downgrade shared))

def rec seen :: ref [Peek] -> own i64 -> own i64 -> i64
fn rec seen jobs index sum =
    if index == jobs.length then sum
    else match jobs[index] with
        | Seen total -> seen jobs (index + 1) (sum + total)
        | Watching _weak -> -1

export def arc_weak_parallel :: own i64 -> i64
fn arc_weak_parallel count =
    let shared = Arc.new (new [i64](count, \index -> index))
    let mut jobs = peeks (ref shared)
    Parallel.for_each_chunk 1 peek (ref mut jobs)
    seen (ref jobs) 0 0 * 10 + Arc.weak_count (ref shared)

export def rc_upgrade_dead :: i64
fn rc_upgrade_dead =
    let shared = Rc.new 5
    let weak = Rc.downgrade (ref shared)
    Owned.drop shared
    let strong = Maybe.get (Rc.upgrade (ref weak))
    deref (Rc.get (ref strong))

// The caller's share is gone before the jobs run: the job that finishes last frees the array.
def owned_parts :: own Arc<[i64]> -> [Part]
fn owned_parts shared = parts (ref shared)

export def arc_parallel_last :: own i64 -> i64
fn arc_parallel_last count =
    let mut jobs = owned_parts (Arc.new (new [i64](count, \index -> index)))
    Parallel.for_each_chunk 1 part (ref mut jobs)
    summed (ref jobs) 0 0

// A loop, not a recursion: a chain is longer than a worker's stack is deep.
def walk :: own Arc<AList> -> i64
fn walk list =
    let mut total = 0
    let mut cursor = list
    let mut walking = true
    while walking do
        let next = match Arc.get (ref cursor) with
            | ACons (value, rest) ->
                total = total + value
                Maybe.Some (Arc.share (ref rest))
            | ANil -> Maybe.None
        match next with
        | Maybe.Some rest -> cursor = rest
        | Maybe.None -> walking = false
    total

union Walk = Walking of Arc<AList> | Walked of i64

def walker :: i64 -> ref mut [Walk..] -> unit
fn walker _index slot =
    let total = match slot[0] with
        | Walking list -> walk (Arc.share (ref list))
        | Walked total -> total
    Array.write 0 (Walked total) slot

def walkers :: own Arc<AList> -> [Walk]
fn walkers list = new [Walk](4, \_index -> Walking (Arc.share (ref list)))

def rec walked :: ref [Walk] -> own i64 -> own i64 -> i64
fn rec walked jobs index sum =
    if index == jobs.length then sum
    else match jobs[index] with
        | Walked total -> walked jobs (index + 1) (sum + total)
        | Walking _list -> -1

export def arc_chain_parallel :: own i64 -> i64
fn arc_chain_parallel count =
    let mut list = Arc.new ANil
    let mut index = 0
    while index < count do
        list = Arc.new (ACons (index, list))
        index = index + 1
    let mut jobs = walkers list
    Parallel.for_each_chunk 1 walker (ref mut jobs)
    walked (ref jobs) 0 0

def inner_product :: ref Arc<(i64 * Maybe<Arc<i64>>)> -> i64
fn inner_product outer =
    match Arc.get outer with
    | (first, Maybe.Some second) -> first * deref (Arc.get (ref second))
    | (first, Maybe.None) -> first

// Named types that appear only inside shared pointers still get definitions.
export def shared_named_types :: i64
fn shared_named_types =
    let items: Vec<Rc<Maybe<string>>> = Vec.push_owned (Rc.new Maybe.None) (Vec.push_owned (Rc.new (Maybe.Some "four")) (Vec.empty()))
    let text = match Rc.get (ref items[0]) with
        | Maybe.Some value -> value.length
        | Maybe.None -> 0
    let pair: Maybe<Rc<Pair<i64>>> = Maybe.Some (Rc.new (Pair { left: 3, right: 5 }))
    let area = match pair with
        | Maybe.Some shared ->
            let value = Rc.get (ref shared)
            Rc.strong_count (ref shared) * 100 + value.left * value.right
        | Maybe.None -> 0
    let nested: Maybe<Arc<(i64 * Maybe<Arc<i64>>)>> = Maybe.Some (Arc.new (7, Maybe.Some (Arc.new 11)))
    let product = match nested with
        | Maybe.Some outer -> inner_product (ref outer)
        | Maybe.None -> 0
    (Vec.length (ref items) * 10 + text) * 1000000 + area * 1000 + product

def parent_value :: ref Rc<TreeNode> -> i64
fn parent_value node =
    match (Rc.get node).parent with
    | Maybe.Some weak ->
        match Rc.upgrade weak with
        | Maybe.Some parent -> (Rc.get (ref parent)).value
        | Maybe.None -> -1
    | Maybe.None -> 0

// Children name their parent weakly; `Rc.upgrade` gives `Maybe<Rc<TreeNode>>`.
export def rc_weak_parent :: i64
fn rc_weak_parent =
    let root = Rc.new (TreeNode { value: 7, parent: Maybe.None, children: Vec.empty() })
    let left = Rc.new (TreeNode { value: 2, parent: Maybe.Some (Rc.downgrade (ref root)), children: Vec.empty() })
    let right = Rc.new (TreeNode { value: 3, parent: Maybe.Some (Rc.downgrade (ref root)), children: Vec.empty() })
    let top = TreeNode { value: 1, parent: Maybe.None, children: Vec.push_owned right (Vec.push_owned (Rc.share (ref left)) (Vec.empty())) }
    let before = parent_value (ref left) + parent_value (ref top.children[1])
    let weak = Rc.weak_count (ref root)
    let mut children = 0
    let mut index = 0
    while index < Vec.length (ref top.children) do
        children = children + (Rc.get (ref top.children[index])).value
        index = index + 1
    Owned.drop root
    let after = parent_value (ref left)
    before * 1000 + weak * 100 + children * 10 + (after + 1)
