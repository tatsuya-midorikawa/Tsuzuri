def accumulate :: ref mut i64 -> ref i64 -> i64 -> i64
fn accumulate output input count =
    for _index in 0i64 .. (count - 1) do deref output = deref output + deref input
    deref output

export def scalar_loop :: i64 -> i64 -> i64
fn scalar_loop count seed =
    let mut output = 7i64
    accumulate (ref mut output) (ref seed) count

def together :: ref i64 -> ref i64 -> i64
fn together left right = deref left + deref right

export def shared_alias :: i64 -> i64
fn shared_alias seed = together (ref seed) (ref seed)

def copy_elements :: ref mut [i64..] -> ref [i64] -> unit
fn copy_elements output input =
    for index in 0i64 .. (input.length - 1) do Array.write index (input[index] + 1) output

export def buffer_loop :: i64 -> i64
fn buffer_loop count =
    let input = new [i64](count, \index -> index * 3)
    let mut output = new [i64](count, \_index -> 0)
    copy_elements (ref mut output) (ref input)
    Array.sum (ref output)

def first_pair :: ref [i64] -> ref [i64] -> i64
fn first_pair left right = left[0] * 10 + right[0]

export def overlapping_slices :: i64
fn overlapping_slices =
    let values = [1i64, 2, 3, 4]
    first_pair (ref values[1..3]) (ref values[2..4])

def split_copy :: ref mut [i64..] -> unit
fn split_copy values =
    match Array.split_at_mut 2 values with
    | (left, right) ->
        let first = right[0]
        let second = right[1]
        Array.write 0 (first + 1) left
        Array.write 1 (second + 1) left

export def disjoint_siblings :: i64
fn disjoint_siblings =
    let mut values = [1i64, 2, 3, 4]
    split_copy (ref mut values)
    values[0] * 1000 + values[1] * 100 + values[2] * 10 + values[3]

def atomic_steps :: ref Atomic<i64> -> ref Atomic<i64> -> i64 -> i64
fn atomic_steps left right count =
    for _index in 0i64 .. (count - 1) do Atomic.store right (Atomic.load left + 1)
    Atomic.load left

export def interior_alias :: i64 -> i64 -> i64
fn interior_alias count seed =
    let cell = Atomic.create seed
    atomic_steps (ref cell) (ref cell) count

def mutex_steps :: ref Mutex<i64> -> ref Mutex<i64> -> i64
fn mutex_steps left right =
    let before = Mutex.with_lock left (\value -> deref value)
    let _changed = Mutex.with_lock right (\value -> deref value = before + 1)
    Mutex.with_lock left (\value -> deref value)

export def mutex_alias :: i64 -> i64
fn mutex_alias seed =
    let cell = Mutex.create seed
    mutex_steps (ref cell) (ref cell)

def identity :: ref i64 -> ref i64
fn identity value = value

export def returned_reference :: i64 -> i64
fn returned_reference seed = together (identity (ref seed)) (ref seed)

def via_callback :: (ref i64 -> i64) -> ref i64 -> i64
fn via_callback callback value = callback value

def read :: ref i64 -> i64
fn read value = deref value

export def callback_reference :: i64 -> i64
fn callback_reference seed = via_callback read (ref seed)

record View {r} { value: ref {r} i64 }
def save {r s} :: ref {r} i64 -> ref mut {s} View {r} -> unit
fn save value target = deref target = View { value: value }

export def stored_reference :: i64 -> i64
fn stored_reference seed =
    let previous = 7i64
    let mut view = View { value: ref previous }
    save (ref seed) (ref mut view)
    deref view.value

def rec fold :: i64 -> i64 -> i64
fn rec fold count total = if count == 0 then total else fold (count - 1) (total + count)

export def self_tail :: i64 -> i64 -> i64
fn self_tail count seed = fold count seed

def copy_byte :: ref mut [ubyte..] -> ref [ubyte] -> unit
fn copy_byte output input = Array.write 0 input[0] output

export def byte_buffer :: i64
fn byte_buffer =
    let input = [255i8u]
    let mut output = [0i8u]
    copy_byte (ref mut output) (ref input)
    output[0] as i64

union Mixed = Word of i64 | Real of f64
def read_mixed :: ref Mixed -> i64
fn read_mixed value = match value with
    | Mixed.Word number -> number
    | Mixed.Real number -> number as i64

def change_mixed :: ref mut Mixed -> i64
fn change_mixed value =
    let before = read_mixed (ref value)
    deref value = Mixed.Real 3.5
    before + read_mixed (ref value)

export def union_overlap :: i64 -> i64
fn union_overlap seed =
    let mut value = Mixed.Word seed
    change_mixed (ref mut value)

def checked_step :: i64 -> unit
fn checked_step amount = for _ in 1 .. amount .. 2 do ()

export def trap_step :: unit
fn trap_step = checked_step 0

def must_assert :: bool -> unit
fn must_assert condition = assert condition

export def trap_assert :: unit
fn trap_assert = must_assert false

def never :: unit -> unit
fn never unused = unreachable ()

export def trap_unreachable :: unit
fn trap_unreachable = never ()

def unused_checked :: i64 -> unit
fn unused_checked value =
    let _result = @checked (value + 1)
    ()

export def trap_checked :: unit
fn trap_checked = unused_checked 9223372036854775807

def conditional_failure :: bool -> unit
fn conditional_failure condition = if condition then assert false else ()

export def trap_discarded :: i64
fn trap_discarded =
    conditional_failure true
    42

export def trap_loop :: unit
fn trap_loop = while true do assert false
