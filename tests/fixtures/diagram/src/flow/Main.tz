let counter = Mutex.create 0i64
match DataChannel.bounded 8 with
| (sender, receiver) ->
    let _sent = Routine.scope (ref sender) 8 (\shared index -> Worker.feed shared (index + 1))
    Owned.drop sender
    let _seen = Routine.scope (ref counter) 4 (\shared index -> Worker.bump shared index)
    Worker.drain (ref receiver)
