// A22: the noncanonical spellings that edition 2026 still accepts and edition 2027 rejects.
// `tsuzuri check --warn canonical` reports each with its rewrite; the tests apply the `certain`
// ones and compare the IR with this file's.

export def sum_to :: i64 -> i64 = \n ->
    let mut total = 0l
    for i in 1l .. n do
        total = total + i
    total

export def stepped :: i64 -> i64 = \n ->
    let mut total = 0l
    for i in 0l .. 3l .. n do
        total = total * 7l + i
    total

export def widths :: i64 -> i64 = \n ->
    let a = 86uy
    let b = 1_000s
    let c = 0x10us
    let d = 7u
    let e = 2ul
    let f = 3L
    let g = 4UL
    let h = 0b101y
    n + (a as i64) + (b as i64) + (c as i64) + (d as i64) + (e as i64) + (f as i64) + (g as i64) + (h as i64)

export def floats :: i64 -> i64 = \n ->
    let a = 1.5f
    let b = 2e3f
    let c = 0.25F
    ((n as f64) * (a as f64) + (b as f64) + (c as f64)) as i64

private def read :: &i64 -> i64 = \r -> *r

private def bump :: &mut i64 -> unit = \r -> *r = *r + 1l

export def borrows :: i64 -> i64 = \n ->
    let mut cell = n
    bump (&mut cell)
    let shared = &cell
    let twice = read &cell + read shared
    let xs = [1l, 2l, 3l, 4l]
    let part = &xs[1..3]
    twice + part.length + *shared

export def lambdas :: i64 -> i64 = \n ->
    let one = x -> x + 1l
    let two = x -> y -> x * y
    let three = a -> \b -> a - b
    let four = a -> b -> c -> a + b * c
    one n + two n 3l + three n 2l + four n 2l 5l

private def apply_to :: (i64 -> i64) -> i64 -> i64 = \f n -> f n

export def compose :: i64 -> i64 = \n -> apply_to (v -> v * 2l) n
