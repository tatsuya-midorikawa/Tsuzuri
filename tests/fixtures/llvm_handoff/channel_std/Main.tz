// An unused public function names the element type of a channel. The drops of the two channel ends stay roots of the
// executable, and their builtins load that type, so its definition must not go with the function.
def helper :: i64
fn helper =
    let pair: (DataChannel.Sender<Maybe<i64>> * DataChannel.Receiver<Maybe<i64>>) = DataChannel.bounded 2
    match pair with
    | (sender, receiver) ->
        let _sent = DataChannel.send (ref sender) (Maybe.Some 41i64)
        match DataChannel.recv (ref receiver) with
        | Maybe.Some (Maybe.Some v) -> v + 1
        | _ -> 0

"ok"
