// An operating-system API named only by a public function that nothing reaches.
// Native executable pruning drops `never_called` so no `@tsuzuri_os_` is emitted;
// WebAssembly keeps public functions as reachability roots and refuses OS APIs.
def never_called :: own string -> IO<Result<string, Os.Error>> = \path -> File.read_text path

def main :: unit -> i32 = \() ->
    do! IO.writeln "ok"
    0
