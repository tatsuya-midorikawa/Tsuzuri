/// NC11: `TensorCodec` on native and WebAssembly at `-O0` and `-O3` (`tests/features.mjs`, suite `tensor_codec`).
/// The module needs no capability and no import. `tests/features.mjs` computes each expected value itself: the
/// bytes of an `.npy` file from the format, CRC-32, and the plain values. `tests/tensor_codec.rs` compares the
/// same functions with the bytes that NumPy and zlib write.

def crc :: ref [ubyte] -> i64
fn crc bytes = TensorCodec.crc32 bytes as i64

/// The CRC-32 of the `.npy` file of a 3 by 4 tensor of the dtype number `kind`, whose element `i` is given by
/// the formula of that dtype; -1 for a number that is no dtype.
export def npy_crc :: own i64 -> i64
fn npy_crc kind =
    let shape = [3, 4]
    if kind == 0 then
        let t = Tensor.init shape (\i -> i % 3 == 0)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 1 then
        let t = Tensor.init shape (\i -> (i * 37 - 100) as i8)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 2 then
        let t = Tensor.init shape (\i -> (i * 3700 - 10000) as i16)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 3 then
        let t = Tensor.init shape (\i -> (i * 370000000 - 1000000000) as i32)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 4 then
        let t = Tensor.init shape (\i -> i * 1234567890123456789 - 5)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 5 then
        let t = Tensor.init shape (\i -> (i * 37) as i8u)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 6 then
        let t = Tensor.init shape (\i -> (i * 3700) as i16u)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 7 then
        let t = Tensor.init shape (\i -> (i * 370000000) as i32u)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 8 then
        let t = Tensor.init shape (\i -> (i * 1234567890123456789) as i64u)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 9 then
        let t = Tensor.init shape (\i -> (to_float i * 0.25 - 1.5) as f16)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 10 then
        let t = Tensor.init shape (\i -> (to_float i * 0.25 - 1.5) as f32)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 11 then
        let t = Tensor.init shape (\i -> to_float i * 0.1 - 1.5)
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 12 then
        let t = Tensor.init shape (\i -> Complex.of ((to_float i * 0.5) as f32) ((0.0 - to_float i) as f32))
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    elif kind == 13 then
        let t = Tensor.init shape (\i -> Complex.of (to_float i * 0.1) (0.0 - to_float i))
        crc (ref (Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))))
    else -1

/// The CRC-32 of the `.npy` file of a window that is not contiguous: the 3 by 4 tensor of `f64` with its axes
/// exchanged (`kind` 0), its rows reversed (1), or every other column (2).
export def npy_window_crc :: own i64 -> i64
fn npy_window_crc kind =
    let t = Tensor.init [3, 4] (\i -> to_float i * 0.1 - 1.5)
    let whole = Tensor.view (ref t)
    let window = if kind == 0 then Tensor.permute [1, 0] (ref whole) elif kind == 1 then Tensor.flip_axis 0 (ref whole) else Tensor.slice [Slice.all(), Slice.every 2] (ref whole)
    crc (ref (Result.get (TensorCodec.encode_npy (ref window))))

/// Encodes and decodes a tensor of `count` elements of `f32` and returns the sum of the decoded elements as
/// an integer (the elements are `i - 3`).
export def npy_round_trip :: own i64 -> i64
fn npy_round_trip count =
    let t = Tensor.init [count] (\i -> (to_float (i - 3)) as f32)
    let file = Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))
    let header = Result.get (TensorCodec.inspect_npy (ref file))
    let decoded: Result<Tensor<f32>, TensorCodec.Error> = TensorCodec.decode_npy (ref file)
    let back = Result.get decoded
    let raw = Result.get (TensorCodec.decode_npy_raw (ref file))
    let again: Result<Tensor<f32>, TensorCodec.Error> = TensorCodec.of_raw (ref raw)
    let same = Result.get again == back && Result.get (TensorCodec.encode_npy_raw (ref raw)) == file
    let total = Tensor.fold (\sum value -> sum + (value as f64)) 0.0 (Tensor.view (ref back))
    if same && header.data_offset % 64 == 0 && TensorCodec.dtype_of (Tensor.view (ref back)) == header.dtype then total as i64 else -1

/// The error number of decoding `kind` of broken input: every one is an error and none traps.
def error_number :: ref TensorCodec.Error -> i64
fn error_number error =
    match error with
    | TensorCodec.InvalidMagic -> 1
    | TensorCodec.UnsupportedVersion _ -> 2
    | TensorCodec.InvalidHeader _ -> 3
    | TensorCodec.DtypeMismatch _ -> 4
    | TensorCodec.UnsupportedDtype _ -> 5
    | TensorCodec.TruncatedData -> 6
    | TensorCodec.ShapeOverflow -> 7
    | TensorCodec.EntryNotFound _ -> 8
    | TensorCodec.UnsupportedCompression _ -> 9
    | TensorCodec.CsvParseError _ -> 10
    | TensorCodec.InvalidArchive _ -> 11
    | TensorCodec.CorruptData _ -> 12
    | TensorCodec.UnsupportedRank _ -> 13

def raw_error :: own Result<TensorCodec.Raw, TensorCodec.Error> -> i64
fn raw_error outcome =
    match outcome with
    | Result.Ok _ -> 0
    | Result.Error error -> error_number (ref error) + (Display.display (ref error)).length * 0

def archive_error :: own Result<TensorCodec.Archive, TensorCodec.Error> -> i64
fn archive_error outcome =
    match outcome with
    | Result.Ok _ -> 0
    | Result.Error error -> error_number (ref error)

export def hostile :: own i64 -> i64
fn hostile kind =
    let t = Tensor.init [4] (\i -> to_float i)
    let good = Result.get (TensorCodec.encode_npy (Tensor.view (ref t)))
    if kind == 0 then raw_error (TensorCodec.decode_npy_raw [1ubyte, 2ubyte, 3ubyte])
    elif kind == 1 then raw_error (TensorCodec.decode_npy_raw (ref good[0 ..< good.length - 1]))
    elif kind == 2 then raw_error (TensorCodec.decode_npy_raw (ref (new [ubyte](good.length, \i -> if i == 6 then 9ubyte else good[i]))))
    elif kind == 3 then raw_error (TensorCodec.decode_npy_raw (ref (new [ubyte](good.length, \i -> if i == 10 then 91ubyte else good[i]))))
    elif kind == 4 then
        let typed: Result<Tensor<i32>, TensorCodec.Error> = TensorCodec.decode_npy (ref good)
        match typed with
        | Result.Ok _ -> 0
        | Result.Error error -> error_number (ref error)
    elif kind == 5 then archive_error (TensorCodec.decode_npz (Array.copy (ref good)))
    elif kind == 6 then archive_error (TensorCodec.decode_safetensors (Array.copy (ref good)))
    elif kind == 7 then archive_error (TensorCodec.decode_safetensors [255ubyte, 255ubyte, 255ubyte, 255ubyte, 255ubyte, 255ubyte, 255ubyte, 255ubyte, 123ubyte, 125ubyte])
    elif kind == 8 then
        match TensorCodec.inflate 100 [7ubyte, 255ubyte, 255ubyte] with
        | Result.Ok _ -> 0
        | Result.Error error -> error_number (ref error)
    elif kind == 9 then
        match TensorCodec.inflate 3 [75ubyte, 76ubyte, 4ubyte, 1ubyte, 0ubyte] with
        | Result.Ok _ -> 0
        | Result.Error error -> error_number (ref error)
    elif kind == 10 then
        let table: Result<Tensor<i64>, TensorCodec.Error> = TensorCodec.decode_csv (TensorCodec.csv ()) u8"1,2\n3,four\n"
        match table with
        | Result.Ok _ -> 0
        | Result.Error error -> error_number (ref error)
    elif kind == 11 then
        let cube = Tensor.init [1, 1, 1] (\i -> i)
        match TensorCodec.encode_csv (TensorCodec.tsv ()) (Tensor.view (ref cube)) with
        | Result.Ok _ -> 0
        | Result.Error error -> error_number (ref error)
    else -1

/// The bytes `(i * i + i / 7) % 251` for `i` below `count`.
def pattern :: own i64 -> [ubyte]
fn pattern count = new [ubyte](count, \i -> ((i * i + i / 7) % 251) as ubyte)

/// The CRC-32 of what `inflate` gives back for the deflated pattern of `count` bytes, or -1 when the stream
/// is not smaller than the bytes it stands for plus the cost of a stored block.
export def deflate_round_trip :: own i64 -> i64
fn deflate_round_trip count =
    let plain = pattern count
    let packed = TensorCodec.deflate (ref plain)
    match TensorCodec.inflate count (ref packed) with
    | Result.Ok back -> if packed.length <= count + 5 * (count / 65535 + 1) then crc (ref back) else -1
    | Result.Error _ -> -2

/// The CRC-32 of what `inflate` reads from a stream that zlib wrote for the 304 bytes of the squares of 0 to 69,
/// each followed by a comma (Python: `data = b"".join(b"%d," % (i * i) for i in range(70))`, then
/// `c = zlib.compressobj(level, zlib.DEFLATED, -15, 8, strategy); c.compress(data) + c.flush()`):
/// `kind` 0 is level 0 (a stored block), 1 is `Z_FIXED` (the fixed codes), and 2 is level 9 (codes of its own).
export def inflate_zlib :: own i64 -> i64
fn inflate_zlib kind =
    let stored: [ubyte] = [1ubyte, 48ubyte, 1ubyte, 207ubyte, 254ubyte, 48ubyte, 44ubyte, 49ubyte, 44ubyte, 52ubyte, 44ubyte, 57ubyte, 44ubyte, 49ubyte, 54ubyte, 44ubyte, 50ubyte, 53ubyte, 44ubyte, 51ubyte, 54ubyte, 44ubyte, 52ubyte, 57ubyte, 44ubyte, 54ubyte, 52ubyte, 44ubyte, 56ubyte, 49ubyte, 44ubyte, 49ubyte, 48ubyte, 48ubyte, 44ubyte, 49ubyte, 50ubyte, 49ubyte, 44ubyte, 49ubyte, 52ubyte, 52ubyte, 44ubyte, 49ubyte, 54ubyte, 57ubyte, 44ubyte, 49ubyte, 57ubyte, 54ubyte, 44ubyte, 50ubyte, 50ubyte, 53ubyte, 44ubyte, 50ubyte, 53ubyte, 54ubyte, 44ubyte, 50ubyte, 56ubyte, 57ubyte, 44ubyte, 51ubyte, 50ubyte, 52ubyte, 44ubyte, 51ubyte, 54ubyte, 49ubyte, 44ubyte, 52ubyte, 48ubyte, 48ubyte, 44ubyte, 52ubyte, 52ubyte, 49ubyte, 44ubyte, 52ubyte, 56ubyte, 52ubyte, 44ubyte, 53ubyte, 50ubyte, 57ubyte, 44ubyte, 53ubyte, 55ubyte, 54ubyte, 44ubyte, 54ubyte, 50ubyte, 53ubyte, 44ubyte, 54ubyte, 55ubyte, 54ubyte, 44ubyte, 55ubyte, 50ubyte, 57ubyte, 44ubyte, 55ubyte, 56ubyte, 52ubyte, 44ubyte, 56ubyte, 52ubyte, 49ubyte, 44ubyte, 57ubyte, 48ubyte, 48ubyte, 44ubyte, 57ubyte, 54ubyte, 49ubyte, 44ubyte, 49ubyte, 48ubyte, 50ubyte, 52ubyte, 44ubyte, 49ubyte, 48ubyte, 56ubyte, 57ubyte, 44ubyte, 49ubyte, 49ubyte, 53ubyte, 54ubyte, 44ubyte, 49ubyte, 50ubyte, 50ubyte, 53ubyte, 44ubyte, 49ubyte, 50ubyte, 57ubyte, 54ubyte, 44ubyte, 49ubyte, 51ubyte, 54ubyte, 57ubyte, 44ubyte, 49ubyte, 52ubyte, 52ubyte, 52ubyte, 44ubyte, 49ubyte, 53ubyte, 50ubyte, 49ubyte, 44ubyte, 49ubyte, 54ubyte, 48ubyte, 48ubyte, 44ubyte, 49ubyte, 54ubyte, 56ubyte, 49ubyte, 44ubyte, 49ubyte, 55ubyte, 54ubyte, 52ubyte, 44ubyte, 49ubyte, 56ubyte, 52ubyte, 57ubyte, 44ubyte, 49ubyte, 57ubyte, 51ubyte, 54ubyte, 44ubyte, 50ubyte, 48ubyte, 50ubyte, 53ubyte, 44ubyte, 50ubyte, 49ubyte, 49ubyte, 54ubyte, 44ubyte, 50ubyte, 50ubyte, 48ubyte, 57ubyte, 44ubyte, 50ubyte, 51ubyte, 48ubyte, 52ubyte, 44ubyte, 50ubyte, 52ubyte, 48ubyte, 49ubyte, 44ubyte, 50ubyte, 53ubyte, 48ubyte, 48ubyte, 44ubyte, 50ubyte, 54ubyte, 48ubyte, 49ubyte, 44ubyte, 50