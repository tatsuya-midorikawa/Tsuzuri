    let dynamic: [ubyte] = [21ubyte, 142ubyte, 201ubyte, 1ubyte, 0ubyte, 33ubyte, 8ubyte, 3ubyte, 27ubyte, 226ubyte, 33ubyte, 144ubyte, 69ubyte, 233ubyte, 191ubyte, 177ubyte, 157ubyte, 188ubyte, 80ubyte, 200ubyte, 49ubyte, 39ubyte, 50ubyte, 20ubyte, 27ubyte, 57ubyte, 81ubyte, 95ubyte, 244ubyte, 132ubyte, 54ubyte, 70ubyte, 241ubyte, 50ubyte, 242ubyte, 156ubyte, 200ubyte, 98ubyte, 74ubyte, 92ubyte, 81ubyte, 44ubyte, 18ubyte, 52ubyte, 245ubyte, 49ubyte, 223ubyte, 70ubyte, 151ubyte, 208ubyte, 227ubyte, 70ubyte, 39ubyte, 49ubyte, 159ubyte, 226ubyte, 171ubyte, 141ubyte, 239ubyte, 78ubyte, 12ubyte, 186ubyte, 97ubyte, 94ubyte, 254ubyte, 151ubyte, 253ubyte, 227ubyte, 190ubyte, 232ubyte, 118ubyte, 156ubyte, 139ubyte, 49ubyte, 15ubyte, 9ubyte, 153ubyte, 68ubyte, 165ubyte, 51ubyte, 179ubyte, 8ubyte, 207ubyte, 118ubyte, 139ubyte, 92ubyte, 247ubyte, 185ubyte, 119ubyte, 12ubyte, 48ubyte, 38ubyte, 185ubyte, 16ubyte, 229ubyte, 147ubyte, 25ubyte, 32ubyte, 172ubyte, 99ubyte, 138ubyte, 52ubyte, 113ubyte, 157ubyte, 141ubyte, 234ubyte, 163ubyte, 40ubyte, 157ubyte, 132ubyte, 12ubyte, 71ubyte, 141ubyte, 95ubyte, 215ubyte, 187ubyte, 231ubyte, 235ubyte, 162ubyte, 107ubyte, 59ubyte, 154ubyte, 124ubyte, 67ubyte, 67ubyte, 222ubyte, 228ubyte, 181ubyte, 72ubyte, 110ubyte, 119ubyte, 244ubyte, 165ubyte, 173ubyte, 31ubyte, 189ubyte, 189ubyte, 16ubyte, 232ubyte, 192ubyte, 34ubyte, 83ubyte, 169ubyte, 225ubyte, 147ubyte, 32ubyte, 213ubyte, 192ubyte, 172ubyte, 11ubyte, 253ubyte, 15ubyte]
    let stream = if kind == 0 then stored elif kind == 1 then fixed else dynamic
    match TensorCodec.inflate 304 (ref stream) with
    | Result.Ok text -> crc (ref text)
    | Result.Error _ -> -1

/// Writes five tensors into an `.npz` archive with the given options and reads them back: the number of
/// tensors that came back equal, times 1000, plus the number of names.
export def npz_round_trip :: own i64 -> own i64 -> i64
fn npz_round_trip compress zip64 =
    let weights = Tensor.init [20, 10] (\i -> to_float (i % 9) * 0.5)
    let labels = Tensor.init [7] (\i -> i * i - 20)
    let flags = Tensor.init [5] (\i -> i % 2 == 0)
    let halves = Tensor.init [3] (\i -> (to_float i * 0.5) as f16)
    let pairs = Tensor.init [2] (\i -> Complex.of (to_float i) (to_float (i + 1)))
    let tensors = [("weights", TensorCodec.to_raw (Tensor.view (ref weights))), ("labels", TensorCodec.to_raw (Tensor.view (ref labels))), ("flags", TensorCodec.to_raw (Tensor.view (ref flags))), ("halves", TensorCodec.to_raw (Tensor.view (ref halves))), ("pairs", TensorCodec.to_raw (Tensor.view (ref pairs)))]
    let options = TensorCodec.NpzOptions { compress: compress != 0, zip64: zip64 != 0 }
    let file = Result.get (TensorCodec.encode_npz_with options (ref tensors))
    let shorthand = if compress != 0 then Result.get (TensorCodec.encode_npz_compressed (ref tensors)) else Result.get (TensorCodec.encode_npz (ref tensors))
    let archive = Result.get (TensorCodec.decode_npz file)
    let first: Result<Tensor<f64>, TensorCodec.Error> = TensorCodec.archive_get "weights" (ref archive)
    let second: Result<Tensor<i64>, TensorCodec.Error> = TensorCodec.archive_get "labels" (ref archive)
    let third: Result<Tensor<bool>, TensorCodec.Error> = TensorCodec.archive_get "flags" (ref archive)
    let fourth: Result<Tensor<f16>, TensorCodec.Error> = TensorCodec.archive_get "halves" (ref archive)
    let fifth = Result.get (TensorCodec.archive_raw "pairs" (ref archive))
    let place = Result.get (TensorCodec.archive_inspect "labels" (ref archive))
    let mut equal = 0
    if Result.get first == weights then equal = equal + 1
    if Result.get second == labels then equal = equal + 1
    if Result.get third == flags then equal = equal + 1
    if Result.get fourth == halves then equal = equal + 1
    if fifth == TensorCodec.to_raw (Tensor.view (ref pairs)) then equal = equal + 1
    if place.shape == [7] && (place.data_offset < 0) == (compress != 0) then equal = equal + 1
    if zip64 != 0 || shorthand.length == archive_size (ref archive) then equal = equal + 1
    equal * 1000 + (TensorCodec.archive_names (ref archive)).length + (TensorCodec.archive_metadata (ref archive)).length

/// The number of bytes that an archive would take again, through its names: used only to touch `encode_npz`.
def archive_size :: ref TensorCodec.Archive -> i64
fn archive_size archive =
    let names = TensorCodec.archive_names archive
    let mut tensors: Vec<(string * TensorCodec.Raw)> = Vec.empty()
    for index in 0i64 ..< names.length do
        tensors = Vec.push_owned ($"{names[index]}", Result.get (TensorCodec.archive_raw (ref names[index]) archive)) tensors
    let listed = Vec.to_array tensors
    let none = TensorCodec.NpzOptions { compress: false, zip64: false }
    let plain = Result.get (TensorCodec.encode_npz_with none (ref listed))
    let packed = Result.get (TensorCodec.encode_npz_compressed (ref listed))
    let first = Result.get (TensorCodec.archive_inspect (ref names[0]) archive)
    if first.data_offset < 0 then packed.length else plain.length

/// Writes three tensors and two metadata entries into a Safetensors file and reads them back: the number of
/// checks that hold.
export def safetensors_round_trip :: own i64 -> i64
fn safetensors_round_trip _unused =
    let wide = Tensor.init [4] (\i -> to_float i * 1.5)
    let narrow = Tensor.init [3] (\i -> (i + 1) as i8u)
    let middle = Tensor.init [2, 2] (\i -> (i * 7) as i32)
    let tensors = [("narrow", TensorCodec.to_raw (Tensor.view (ref narrow))), ("wide", TensorCodec.to_raw (Tensor.view (ref wide))), ("middle", TensorCodec.to_raw (Tensor.view (ref middle)))]
    let file = Result.get (TensorCodec.encode_safetensors_with [("format", "pt"), ("step", "3")] (ref tensors))
    let plain = Result.get (TensorCodec.encode_safetensors (ref tensors))
    let place = Result.get (TensorCodec.inspect_safetensors "wide" (ref file))
    let archive = Result.get (TensorCodec.decode_safetensors file)
    let first: Result<Tensor<f64>, TensorCodec.Error> = TensorCodec.archive_get "wide" (ref archive)
    let second: Result<Tensor<i8u>, TensorCodec.Error> = TensorCodec.archive_get "narrow" (ref archive)
    let third: Result<Tensor<i32>, TensorCodec.Error> = TensorCodec.archive_get "middle" (ref archive)
    let mut held = 0
    if Result.get first == wide then held = held + 1
    if Result.get second == narrow then held = held + 1
    if Result.get third == middle then held = held + 1
    if place.data_offset % 8 == 0 && place.shape == [4] then held = held + 1
    if TensorCodec.archive_metadata (ref archive) == [("format", "pt"), ("step", "3")] then held = held + 1
    if TensorCodec.archive_names (ref archive) == ["wide", "middle", "narrow"] then held = held + 1
    if plain.length < archive_bytes (ref archive) then held = held + 1
    held

def archive_bytes :: ref TensorCodec.Archive -> i64
fn archive_bytes archive =
    let names = TensorCodec.archive_names archive
    let mut total = 1000
    for index in 0i64 ..< names.length do
        let header = Result.get (TensorCodec.archive_inspect (ref names[index]) archive)
        total = total + TensorCodec.dtype_size (ref header.dtype) + (TensorCodec.dtype_name (ref header.dtype)).length
    total

/// Writes a 3 by 2 table of `f64` as text with the separator number `kind` and reads it back: the sum of the
/// elements times 8 as an integer (they are multiples of an eighth), or -1 when the bits changed.
export def csv_round_trip :: own i64 -> i64
fn csv_round_trip kind =
    let t = Tensor.of_array [3, 2] [1.5, -2.25, 1024.0, 0.125, -0.0, 3.0e10]
    let window = Tensor.view (ref t)
    let options = if kind == 0 then TensorCodec.csv () elif kind == 1 then TensorCodec.tsv () else TensorCodec.CsvOptions { delimiter: u8"", skip_rows: 0, comment: u8"%" }
    let again = if kind == 0 then TensorCodec.csv () elif kind == 1 then TensorCodec.tsv () else TensorCodec.CsvOptions { delimiter: u8"", skip_rows: 0, comment: u8"%" }
    let written = Result.get (TensorCodec.encode_csv options (ref window))
    let decoded: Result<Tensor<f64>, TensorCodec.Error> = TensorCodec.decode_csv again (ref written)
    let back = Result.get decoded
    let none: [f64] = []
    let same = TensorCodec.to_raw (Tensor.view (ref back)) == TensorCodec.to_raw (ref window) && TensorCodec.element_dtype (ref none) == TensorCodec.F64
    if same then (Tensor.fold (\sum value -> sum + value) 0.0 (Tensor.view (ref back)) * 8.0) as i64 else -1

def main :: unit -> i32 = \() -> 0
