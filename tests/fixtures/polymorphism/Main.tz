record Point { x: i32, y: i32 }

def id :: 'a -> 'a
fn id x = x

def add :: Add<'a> -> 'a -> 'a
fn add x y = x + y

def apply :: ('a -> 'b) -> 'a -> 'b
fn apply f x = f x

def twice :: 'a -> 'a
fn twice x = add x x

def increment :: 'a -> 'a
    @'a : Add, Integer
fn increment x = x + 1

def rec sum :: i64 -> 'a -> 'a -> 'a
fn rec sum n x total =
    if n == 0 { total } else { sum (n - 1) x (add total x) }

def rec countdown :: i64 -> 'a -> 'a
fn rec countdown n value = {
    let unused = "dropped on every iteration";
    if n == 0 { value } else { countdown (n - 1) value }
}

instance Classes.Score<Point> {
    fn score point = point.x + point.y
}

instance Classes.Score<i32> {
    fn score value = *value
}

instance Add<Point> {
    fn add left right = Point { x: left.x + right.x, y: left.y + right.y }
}

def score :: Classes.Score<'a> => &'a -> i32
fn score value = Classes.Score.score value

export def integer :: i32 -> i32 -> i32
fn integer x y = add x y

export def floating :: f64 -> f64 -> f64
fn floating x y = add x y

export def narrow :: i8 -> i8
fn narrow x = increment x

export def decimal :: f64
fn decimal = (add 0.1d128 0.2d128) as f64

export def wide :: i64
fn wide = (add 18446744073709551616i128 42i128) as i64

export def parametric :: i32
fn parametric = {
    let f: i32 -> i32 = id;
    apply f (twice 21i32)
}

export def classes :: i32
fn classes = {
    let point = add (Point { x: 10, y: 20 }) (Point { x: 5, y: 7 });
    let f: &Point -> i32 = Classes.Score.score;
    let value = f (&point);
    score (&value)
}

export def intrinsic :: i32
fn intrinsic = {
    let f: i32 -> i32 -> i32 = Add.add;
    f 20 22
}

export def recursion :: i64
fn recursion = sum 1_000_000 2i64 0

export def owned :: i64
fn owned = {
    let text = countdown 100_000 (id (add "hello" " world"));
    text.length
}

def borrow :: &'a -> &'a
fn borrow value = value

export def borrowed :: i64
fn borrowed = {
    let text = "borrowed";
    (borrow (&text)).length
}

def tick :: &mut i64 -> i64
fn tick counter = { *counter = *counter + 1; *counter }

def combine :: 'a -> 'a -> 'a
fn combine x y = x * 10 + y

export def ordered :: i64
fn ordered = {
    let mut counter = 0;
    combine (tick (&mut counter)) (tick (&mut counter))
}

def distance :: Point -> i32
fn distance point = point.x + point.y

def distance_of :: 'T -> 'U
    @'T : Copy, #distance
fn distance_of value = apply 'T.distance value

def forward_distance :: 'T -> 'U
fn forward_distance value = distance_of value

def scale_of :: 'T -> (f64 -> 'T)
    @'T : #scale
fn scale_of value = 'T.scale value

def extract :: 'T -> 'U
    @'T : #unwrap
fn extract value = 'T.unwrap value

def read_choice :: 'T -> i64
    @'T : #count
fn read_choice value = 'T.count value

export def constrained_integer :: i32
fn constrained_integer = forward_distance (Point { x: 20, y: 22 })

export def constrained_floating :: f64 -> f64 -> f64
fn constrained_floating x y = forward_distance (Geometry.Point { x: x, y: y })

export def constrained_partial :: f64
fn constrained_partial = {
        let scale = scale_of (Geometry.Point { x: 3.0, y: 4.0 });
        distance_of (scale 2.0)
}

export def constrained_owned :: i64
fn constrained_owned = {
        let text: string = extract (Geometry.Box { value: "owned" });
        text.length
}

export def constrained_union :: i64
fn constrained_union = read_choice (Geometry.Counted 42)

def adjust :: ref mut i64 -> i64 -> unit
fn adjust reference amount = deref reference = deref reference + amount

def number_value :: i64 -> i64
fn number_value number = number

def borrowed_sum :: ref i64 -> i64 -> i64
fn borrowed_sum reference amount = deref reference + amount

def staged_borrow :: ref mut i64 -> i64 -> i64
fn staged_borrow counter = {
    deref counter = deref counter + 1;
    fx value -> value
}

export def implicit_borrows :: i64
fn implicit_borrows = {
    let text = "\u{1f600}";
    let bytes = u8"\u{1f600}";
    let length = String.length;
    assert (length text == length ref text);
    assert (apply length text == 2);
    assert ((text |> length) == 2);
    assert (Utf8String.length bytes == 4);
    let copied = clone_string text;
    assert (copied == text);
    let mut number = 1;
    let reference = ref mut number;
    adjust reference 2;
    adjust reference 3;
    let shared = borrow reference;
    assert (number_value shared == 6);
    let twice = value -> { adjust value 2; adjust value 3; };
    twice reference;
    let plus = borrowed_sum reference;
    assert (plus 1 == 12);
    adjust reference 1;
    assert (number_value reference == 12);
    assert (number == 12);
    let mut counter = 0;
    let ordered_value = staged_borrow counter (tick counter);
    assert (ordered_value == 2 && counter == 2);
    42
}

def main :: i32
fn main = classes()
