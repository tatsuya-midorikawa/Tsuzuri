extern "e14_reenter" def reenter :: i64 -> i64
extern "e14_host_buffer" def host_buffer :: i64 -> [i64]

export def div :: own i64 -> own i64 -> i64
fn div a b = a / b

export def noop :: i64
fn noop = 7

export def fill_div :: own i64 -> own i64 -> i64
fn fill_div count divisor =
    let values = new [i64](count, \i -> i * 3 + 1)
    let text = "buffer" + to_string count
    values[count - 1] / divisor + text.length

export def imported_div :: own i64 -> own i64 -> i64
fn imported_div count divisor =
    let numbers = host_buffer count
    numbers[count - 1] / divisor

export def make :: own i64 -> [i64]
fn make count = new [i64](count, \i -> i * i)

export def label :: own i64 -> string
fn label n = "value " + to_string n

export def label_div :: own i64 -> string
fn label_div n = "value " + to_string (100 / n)

export def call_host :: own i64 -> i64
fn call_host n = reenter n + 1

export def parallel_div :: own i64 -> own i64 -> i64
fn parallel_div count divisor =
    let results = Parallel.init count (\i -> {
        let scratch = new [i64](64, \n -> n + i);
        (scratch[1] + i) / (if i == 5 then divisor else 1)
    })
    Array.sum (ref results)

// Every item builds a Result; the call reports the error of the lowest index, or the sum. A trap in
// an item is the call's trap, whatever the other items returned.
export def parallel_mixed :: own i64 -> own i64 -> i64
fn parallel_mixed fail_at trap_at =
    let results = Parallel.init 16 (\index -> {
        let scratch = new [i64](32, \n -> n);
        if index == trap_at then Result.Ok (1 / (index - trap_at)) else (if index == fail_at then Result.Error index else Result.Ok scratch[index])
    })
    first_error (ref results) 0 0

def rec first_error :: ref [Result<i64, i64>] -> own i64 -> own i64 -> i64
fn rec first_error results index sum =
    if index == results.length then sum
    else match results[index] with
        | Result.Ok value -> first_error results (index + 1) (sum + value)
        | Result.Error error -> 1000 + error

export def nested_div :: own i64 -> i64
fn nested_div trap_at =
    let outer = Parallel.init 4 (\i -> Array.sum (ref (Parallel.init 4 (\j -> 100 / (i * 4 + j - trap_at)))))
    Array.sum (ref outer)
