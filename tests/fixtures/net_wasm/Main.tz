// E09 Phase 3: the sockets of Net on WebAssembly, under --wasm-feature jspi and --wasm-feature net. The host is the generated
// JavaScript glue on Node.js, which keeps the contract of src/runtime/net.c with node:net, node:dgram, and node:dns. A program
// that listens tells the host its port with `report`, so that a peer can connect.

extern def report :: i64 -> unit

def pattern :: own i64 -> [ubyte]
fn pattern count = Array.init count (\index -> (index % 256) as ubyte)

def sum_of :: ref [ubyte] -> i64
fn sum_of bytes =
	let mut total = 0
	let mut index = 0
	while index < bytes.length do
		total = total + (bytes[index] as i64)
		index = index + 1
	total

def bytes_of :: ref string -> [ubyte]
fn bytes_of text = Utf8String.to_bytes (Utf8String.from_string text)

def nothing :: own unit -> [ubyte]
fn nothing _unit = []

/// The index of the Net.ErrorKind of a failure, from 1 (TimedOut) to 7 (Unclassified).
def kind_code :: own Os.Error -> i64
fn kind_code error =
	match Net.error_kind error with
	| Net.TimedOut -> 1
	| Net.ConnectionRefused -> 2
	| Net.ConnectionReset -> 3
	| Net.AddressInUse -> 4
	| Net.AddressNotAvailable -> 5
	| Net.Unreachable -> 6
	| Net.Unclassified -> 7

def loopback :: own i64 -> Net.Address
fn loopback port = Maybe.get (Net.parse_ip port (ref "127.0.0.1"))

/// Reads until `wanted` bytes arrived or the stream ended: the count and the sum, or the failure.
def rec collect :: own Net.TcpStream -> own i64 -> own i64 -> own i64 -> IO<(i64 * i64)>
fn rec collect stream wanted total sum =
	if total >= wanted then IO.pure (total, sum)
	else IO.bind (\received ->
		match received with
		| Result.Error error -> IO.pure (0 - kind_code error, 0)
		| Result.Ok bytes ->
			if bytes.length == 0 then IO.pure (total, sum)
			else collect stream wanted (total + bytes.length) (sum + sum_of (ref bytes))) (Net.read stream 4096 (Maybe.Some 20000))

/// The echo of 1024 bytes through the blocking API: the sum of what came back.
export def echo :: own i64 -> i64
fn echo port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! written = Net.write stream (pattern 1024) (Maybe.Some 5000)
		let! outcome = collect stream 1024 0 0
		let! closed = Net.close stream
		match (written, closed, outcome) with
		| (Result.Ok _, Result.Ok _, (count, sum)) -> if count == 1024 then sum else 0 - 2000 - count
		| _ -> 0 - 3000

/// The program listens, reports its port, takes one connection, and sends back what it read in capitals' place: a byte more.
export def serve_once :: own i64 -> i64
fn serve_once _seed =
	let! bound = Net.bind (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok listener ->
		report (Net.port (Net.local_addr listener))
		let! accepted = Net.accept listener (Maybe.Some 20000)
		match accepted with
		| Result.Error error -> 0 - 2000 - kind_code error
		| Result.Ok stream ->
			let! outcome = collect stream 6 0 0
			let! written = Net.write stream (bytes_of (ref "HELLO\n")) (Maybe.Some 5000)
			let! shut = Net.shutdown stream Net.Write
			let! rest = collect stream 1000000 0 0
			let! _closed = Net.close stream
			let! _closed_listener = Net.close_listener listener
			match (outcome, rest, written, shut) with
			| ((count, sum), (after, _), Result.Ok _, Result.Ok _) -> count * 1000 + sum + after * 1000000
			| _ -> 0 - 3000

/// One datagram in, one out: the length of what arrived, times ten, plus 1 when its source has a port.
export def udp_once :: own i64 -> i64
fn udp_once _seed =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		report (Net.port (Net.udp_local_addr socket))
		let! received = Net.recv_from socket 64 (Maybe.Some 20000)
		match received with
		| Result.Error error -> 0 - 2000 - kind_code error
		| Result.Ok (bytes, source) ->
			let! sent = Net.send_to socket (bytes_of (ref "pong")) source
			let! _closed = Net.close_udp socket
			bytes.length * 10 + (if Net.port source != 0 && Result.is_ok (ref sent) then 1 else 0)

/// How many addresses "localhost" has, and whether 127.0.0.1 or ::1 is among them: 0 when there is none.
export def lookup :: own i64 -> i64
fn lookup _seed =
	let! found = Net.resolve "localhost" 80
	match found with
	| Result.Ok addresses -> addresses.length
	| Result.Error _ -> 0

def is_invalid :: own Os.Error -> bool
fn is_invalid error =
	match error.kind with
	| Os.InvalidInput -> error.code == 0i32
	| _ -> false

def rec refused_count :: own [string] -> own i64 -> own i64 -> IO<i64>
fn rec refused_count hosts index total =
	if index >= hosts.length then IO.pure total
	else
		let resolving = Net.resolve (String.repeat 1 (ref hosts[index])) 80
		IO.bind (\found ->
			match found with
			| Result.Error error -> refused_count hosts (index + 1) (if is_invalid error then total + 1 else total)
			| Result.Ok _ -> refused_count hosts (index + 1) total) resolving

def address_count :: own Result<[Net.Address], Os.Error> -> i64
fn address_count found =
	match found with
	| Result.Ok addresses -> addresses.length
	| Result.Error _ -> 0

/// Address text that a system's resolver reads in its own way is refused (InvalidInput) by the strict parser, and
/// "127.0.0.1" and "::1" are read by it: 100 for each refusal of the twenty hosts, and 1 for each address that is read.
/// The last eight are the spellings that Node's resolver maps to 127.0.0.1 (IDNA turns fullwidth digits, the dots of
/// other scripts, and characters that map to nothing into the ASCII text), though the parser says they are no address.
export def literals :: own i64 -> i64
fn literals _seed =
	let hosts = [
		"127.1", "0x7f000001", "2130706433", "010.0.0.1", "0177.0.0.1", "fe80::1%lo0", "1.2.3", "0", "0x0", "4294967296", "1.2.3.4.", "127.0.0.1 ",
		"１２７．０．０．１", "127。0。0。1", "127｡0｡0｡1", "127.0.0.1\u00AD", "127.0.0.1\u200B", "２１３０７０６４３３", "０x7f000001", "127.0.0.１"
	]
	let! refused = refused_count hosts 0 0
	let! v4 = Net.resolve "127.0.0.1" 80
	let! v6 = Net.resolve "::1" 80
	refused * 100 + address_count v4 + address_count v6

/// A port that nobody listens on: the kind of the failure.
export def refused :: own i64 -> i64
fn refused port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Ok _ -> 0
	| Result.Error error -> kind_code error

/// A peer that says nothing: a read that times out leaves the stream good (it reads the byte that comes later).
export def quiet :: own i64 -> i64
fn quiet port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! first = Net.read stream 16 (Maybe.Some 50)
		let! second = Net.read stream 16 (Maybe.Some 20000)
		let! _closed = Net.close stream
		match (first, second) with
		| (Result.Error error, Result.Ok bytes) -> kind_code error * 100 + bytes.length
		| _ -> 0 - 3000

/// A closed handle, a timeout out of range, and a second close: the host errno of the first, then 100 for each of the others.
export def lifecycle :: own i64 -> i64
fn lifecycle port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! closed = Net.close stream
		let! again = Net.close stream
		let! stale = Net.read stream 16 (Maybe.Some 100)
		let! invalid = Net.read stream 16 (Maybe.Some 0)
		match (closed, again, stale, invalid) with
		| (Result.Ok _, Result.Error first, Result.Error second, Result.Error third) ->
			if first.code == second.code && third.code == 0i32 then first.code as i64 else 0 - 4000
		| _ -> 0 - 3000

/// The echo of 1024 bytes over the IPv6 loopback, through the blocking API.
export def echo6 :: own i64 -> i64
fn echo6 port =
	let! connected = Net.connect (Maybe.get (Net.parse_ip port (ref "::1"))) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! _written = Net.write stream (pattern 1024) (Maybe.Some 5000)
		let! outcome = collect stream 1024 0 0
		let! _closed = Net.close stream
		match outcome with
		| (count, sum) -> if count == 1024 then sum else 0 - 2000 - count

/// A peer that sends three mebibytes and ends: the sum of the bytes, read in pieces of 4 KiB, or the failure.
export def bigread :: own i64 -> i64
fn bigread port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! outcome = collect stream 100000000 0 0
		let! _closed = Net.close stream
		match outcome with
		| (count, sum) -> if count == 3145728 then sum else 0 - 2000 - count

/// Four mebibytes to a peer that reads slowly: whether the whole write went out.
export def bigwrite :: own i64 -> i64
fn bigwrite port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error _ -> 0
	| Result.Ok stream ->
		let! written = Net.write stream (pattern 4194304) (Maybe.Some 30000)
		let! _closed = Net.close stream
		if Result.is_ok (ref written) then 1 else 0

/// A datagram that does not fit (consumed, with the host's EMSGSIZE as its code), the next one, and an empty one.
export def datagrams :: own i64 -> i64
fn datagrams _seed =
	let! first = Net.bind_udp (loopback 0)
	let! second = Net.bind_udp (loopback 0)
	match (first, second) with
	| (Result.Ok receiver, Result.Ok sender) ->
		let target = Net.udp_local_addr receiver
		let! _sent = Net.send_to sender (pattern 100) target
		let! big = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! _next = Net.send_to sender (bytes_of (ref "ok")) target
		let! small = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! _empty = Net.send_to sender (nothing ()) target
		let! blank = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! _closed_receiver = Net.close_udp receiver
		let! _closed_sender = Net.close_udp sender
		match (big, small, blank) with
		| (Result.Error error, Result.Ok (kept, _), Result.Ok (empty, _)) -> error.code as i64 * 10000 + kept.length * 100 + empty.length
		| _ -> 0 - 3000
	| _ -> 0 - 1

// ---- The host's side of the sockets: what a program cannot see natively, and what must not break it ----

/// A trap with sockets open (a connected stream, a listener, and a UDP socket, none of them closed): it reports the ports of
/// the last two and divides by zero. The glue discards the instance, and with it the sockets, which nothing else could close.
export def trap_with_sockets :: own i64 -> i64
fn trap_with_sockets port =
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	let! bound = Net.bind (loopback 0)
	let! datagram = Net.bind_udp (loopback 0)
	match (connected, bound, datagram) with
	| (Result.Ok _, Result.Ok listener, Result.Ok socket) ->
		report (Net.port (Net.local_addr listener))
		report (Net.port (Net.udp_local_addr socket))
		let zero = port - port
		10 / zero
	| _ -> 0 - 1

/// A program that ends normally with sockets that it never closed: a listener, a connection to it and the one it accepted, and
/// a UDP socket. Natively the process end closes them, and Node must be able to end as well.
export def leak :: own i64 -> i64
fn leak _seed =
	let! bound = Net.bind (loopback 0)
	let! datagram = Net.bind_udp (loopback 0)
	match (bound, datagram) with
	| (Result.Ok listener, Result.Ok _socket) ->
		let! client = Net.connect (Net.local_addr listener) (Maybe.Some 5000)
		let! accepted = Net.accept listener (Maybe.Some 5000)
		match (client, accepted) with
		| (Result.Ok _, Result.Ok _) -> 7
		| _ -> 0 - 2
	| _ -> 0 - 1

/// A datagram to port 0, which Node refuses by throwing, and a system may refuse too: the code of the failure of a send times
/// 1000, plus the code of a second send of the same socket (the failure is the call's, and the socket stays usable).
export def zero_port :: own i64 -> i64
fn zero_port _seed =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		let target = loopback 0
		let! first = Net.send_to socket (bytes_of (ref "x")) target
		let! second = Net.send_to socket (bytes_of (ref "x")) target
		let! _closed = Net.close_udp socket
		match (first, second) with
		| (Result.Error failure, Result.Error again) -> failure.code as i64 * 1000 + again.code as i64
		| _ -> 0 - 3000

/// A peer that ends its sending and waits for the answer: the program reads to the end of the stream, and then writes. The
/// bytes read times ten, plus 1 when the write after the peer's half-close went out.
export def half_close :: own i64 -> i64
fn half_close _seed =
	let! bound = Net.bind (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok listener ->
		report (Net.port (Net.local_addr listener))
		let! accepted = Net.accept listener (Maybe.Some 20000)
		match accepted with
		| Result.Error error -> 0 - 2000 - kind_code error
		| Result.Ok stream ->
			let! outcome = collect stream 1000000 0 0
			let! written = Net.write stream (bytes_of (ref "ANSWER")) (Maybe.Some 5000)
			let! _closed = Net.close stream
			let! _closed_listener = Net.close_listener listener
			match (outcome, written) with
			| ((count, _), Result.Ok _) -> count * 10 + 1
			| ((count, _), Result.Error _) -> count * 10

/// A datagram that the system refuses to send (one more byte than a datagram can hold) is the failure of that send, and does
/// not spoil the socket's receive: the code of the failure times 10000, the kind of a receive on the same socket that finds
/// nothing times 100, and the length of the datagram that comes next.
export def datagram_failure :: own i64 -> i64
fn datagram_failure _seed =
	let! first = Net.bind_udp (loopback 0)
	let! second = Net.bind_udp (loopback 0)
	match (first, second) with
	| (Result.Ok sender, Result.Ok receiver) ->
		let! refused = Net.send_to sender (pattern 65536) (Net.udp_local_addr receiver)
		let! silence = Net.recv_from sender 64 (Maybe.Some 300)
		let! _sent = Net.send_to receiver (bytes_of (ref "ok")) (Net.udp_local_addr sender)
		let! answer = Net.recv_from sender 64 (Maybe.Some 5000)
		let! _closed_sender = Net.close_udp sender
		let! _closed_receiver = Net.close_udp receiver
		match (refused, silence, answer) with
		| (Result.Ok _, _, _) -> 0 - 1
		| (_, Result.Ok _, _) -> 0 - 2
		| (_, _, Result.Error _) -> 0 - 3
		| (Result.Error failure, Result.Error quiet, Result.Ok (bytes, _)) -> failure.code as i64 * 10000 + kind_code quiet * 100 + bytes.length
	| _ -> 0 - 1

/// A connection that was reset while the program was not reading it is a reset when it reads, not a clean end. The first
/// connection is accepted and left alone; the peer resets it, and then connects again, which ends the program's second accept.
/// The kind of the first read times 100, plus 1 when the read after it is the end of the stream.
export def reset_idle :: own i64 -> i64
fn reset_idle _seed =
	let! bound = Net.bind (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok listener ->
		report (Net.port (Net.local_addr listener))
		let! first = Net.accept listener (Maybe.Some 20000)
		let! second = Net.accept listener (Maybe.Some 20000)
		match (first, second) with
		| (Result.Ok reset, Result.Ok other) ->
			let! failed = Net.read reset 16 (Maybe.Some 5000)
			let! after = Net.read reset 16 (Maybe.Some 5000)
			let! _closed_reset = Net.close reset
			let! _closed_other = Net.close other
			let! _closed_listener = Net.close_listener listener
			match (failed, after) with
			| (Result.Error error, Result.Ok bytes) -> kind_code error * 100 + (if bytes.length == 0 then 1 else 0)
			| (Result.Ok bytes, _) -> bytes.length
			| _ -> 0 - 3000
		| _ -> 0 - 2000

/// A socket that nobody reads while datagrams arrive keeps a bounded number of them: it reports its port, and (once the host has
/// sent what it wants) reads until a receive finds nothing for a moment. How many it read.
export def udp_flood :: own i64 -> i64
fn udp_flood _seed =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		report (Net.port (Net.udp_local_addr socket))
		let mut count = 0
		let mut more = true
		while more do
			let! received = Net.recv_from socket 2048 (Maybe.Some 200)
			match received with
			| Result.Ok _ -> count = count + 1
			| Result.Error _ -> more = false
		let! _closed = Net.close_udp socket
		count

def rec accept_all :: own Net.TcpListener -> own i64 -> own i64 -> IO<i64>
fn rec accept_all listener count last =
	IO.bind (\accepted ->
		match accepted with
		| Result.Ok stream -> IO.bind (\_closed -> accept_all listener (count + 1) last) (Net.close stream)
		| Result.Error error ->
			if kind_code error == 1 then IO.pure (count * 1000 + last)
			else accept_all listener count (error.code as i64)) (Net.accept listener (Maybe.Some 200))

def close_accepted :: own Result<Net.TcpStream, Os.Error> -> IO<unit>
fn close_accepted accepted =
	match accepted with
	| Result.Ok stream -> IO.map (\_closed -> ()) (Net.close stream)
	| Result.Error _ -> IO.pure ()

/// A listener that nobody accepts from while clients connect keeps a bounded queue. The program listens at two ports and
/// reports both; its first accept waits for a connection to the second, which tells it that the first was flooded; then it
/// takes everything that waits at the first. The count times 1000, plus the code of the failure that the listener had
/// meanwhile (0 when none).
export def accept_flood :: own i64 -> i64
fn accept_flood _seed =
	let! first = Net.bind (loopback 0)
	let! second = Net.bind (loopback 0)
	match (first, second) with
	| (Result.Ok flooded, Result.Ok signal) ->
		report (Net.port (Net.local_addr flooded))
		report (Net.port (Net.local_addr signal))
		let! gate = Net.accept signal (Maybe.Some 30000)
		let! count = accept_all flooded 0 0
		do! close_accepted gate
		let! _closed_flooded = Net.close_listener flooded
		let! _closed_signal = Net.close_listener signal
		count
	| _ -> 0 - 1

// ---- Datagram sends: each send is one datagram and has its own result; the peer address of an accepted connection; the
// names of errors ----

def rec send_same :: own Net.UdpSocket -> own Net.Address -> own i64 -> own i64 -> IO<i64>
fn rec send_same socket target remaining sent =
	if remaining == 0 then IO.pure sent
	else IO.bind (\outcome ->
		send_same socket target (remaining - 1) (sent + (if Result.is_ok (ref outcome) then 1 else 0))) (Net.send_to socket (bytes_of (ref "same")) target)

def burst_message :: own i64 -> [ubyte]
fn burst_message index = Array.init 100 (\position -> (if position == 0 then index else 85) as ubyte)

def rec send_burst :: own Net.UdpSocket -> own Net.Address -> own i64 -> own i64 -> IO<i64>
fn rec send_burst socket target index sent =
	if index == 50 then IO.pure sent
	else IO.bind (\outcome ->
		send_burst socket target (index + 1) (sent + (if Result.is_ok (ref outcome) then 1 else 0))) (Net.send_to socket (burst_message index) target)

def ok_value :: ref Result<unit, Os.Error> -> i64
fn ok_value result = if Result.is_ok result then 1 else 0

/// Datagrams to a peer at `port` that counts them: one send, twelve sends in a row of the same bytes, fifty in a row of a
/// hundred bytes that start with their index, and an end marker. How many of the sends said Ok: one datagram for each of them
/// arrives, and no other.
export def udp_counts :: own i64 -> i64
fn udp_counts port =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		let target = loopback port
		let! single = Net.send_to socket (bytes_of (ref "one")) target
		let! rows = send_same socket target 12 0
		let! burst = send_burst socket target 0 0
		let! last = Net.send_to socket (bytes_of (ref "end")) target
		let! _closed = Net.close_udp socket
		ok_value (ref single) + rows + burst + ok_value (ref last)

def rec echo_datagrams :: own Net.UdpSocket -> own i64 -> own i64 -> IO<i64>
fn rec echo_datagrams socket remaining served =
	if remaining == 0 then IO.pure served
	else IO.bind (\received ->
		match received with
		| Result.Error _ -> IO.pure served
		| Result.Ok (bytes, source) ->
			IO.bind (\sent ->
				echo_datagrams socket (remaining - 1) (served + (if Result.is_ok (ref sent) then 1 else 0))) (Net.send_to socket bytes source)) (Net.recv_from socket 2048 (Maybe.Some 20000))

/// A datagram server: it reports its port and answers `count` requests, each with its own bytes to its source. How many
/// answers were sent.
export def udp_echo :: own i64 -> i64
fn udp_echo count =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		report (Net.port (Net.udp_local_addr socket))
		let! served = echo_datagrams socket count 0
		let! _closed = Net.close_udp socket
		served

/// A socket that is closed right after its send still sends the datagram, and the send still says how it went. The datagram
/// goes to a peer at `port`; how many of the two calls (the send and the close) said Ok.
export def udp_close_after_send :: own i64 -> i64
fn udp_close_after_send port =
	let! bound = Net.bind_udp (loopback 0)
	match bound with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok socket ->
		let! sent = Net.send_to socket (bytes_of (ref "after-send")) (loopback port)
		let! closed = Net.close_udp socket
		ok_value (ref sent) + ok_value (ref closed)

def os_kind_text :: own Os.ErrorKind -> string
fn os_kind_text kind =
	match kind with
	| Os.NotFound -> "NotFound"
	| Os.PermissionDenied -> "PermissionDenied"
	| Os.AlreadyExists -> "AlreadyExists"
	| Os.InvalidInput -> "InvalidInput"
	| Os.InvalidEncoding -> "InvalidEncoding"
	| Os.Interrupted -> "Interrupted"
	| Os.Other -> "Other"

/// "<Net.ErrorKind> <Os.ErrorKind> <system code>": the text of a failure in the lines of `udp_lines`.
def failure_text :: own Os.Error -> string
fn failure_text error = to_string (Net.error_kind error) + " " + os_kind_text error.kind + " " + to_string error.code

def unit_text :: own Result<unit, Os.Error> -> string
fn unit_text result =
	match result with
	| Result.Ok _ -> "ok"
	| Result.Error error -> failure_text error

def udp_text :: own Result<([ubyte] * Net.Address), Os.Error> -> string
fn udp_text result =
	match result with
	| Result.Ok (bytes, _) -> "datagram:" + to_string bytes.length
	| Result.Error error -> failure_text error

/// A datagram to a port that nobody listens on is no failure of the receive that follows it (Windows would report the ICMP
/// "port unreachable" from the next receive of the same socket unless that is turned off).
def vanished_line :: own Net.UdpSocket -> own Result<Net.UdpSocket, Os.Error> -> IO<string>
fn vanished_line receiver spare =
	match spare with
	| Result.Error error -> IO.pure (failure_text error)
	| Result.Ok gone ->
		let vanished_target = Net.udp_local_addr gone
		IO.bind (\_closed ->
			IO.bind (\_sent ->
				IO.map (\result -> udp_text result) (Net.recv_from receiver 64 (Maybe.Some 40))) (Net.send_to receiver (bytes_of (ref "x")) vanished_target)) (Net.close_udp gone)

/// What two UDP sockets of one program see, line by line, with the system's own numbers in the failures: a datagram and its
/// source, a receive that times out, a datagram to a closed port, a datagram that does not fit (consumed) and the two after it,
/// and the closes (the second close of a socket fails). The lines are joined by newlines.
export def udp_lines :: own i64 -> string
fn udp_lines _seed =
	let! first = Net.bind_udp (loopback 0)
	let! second = Net.bind_udp (loopback 0)
	match (first, second) with
	| (Result.Ok receiver, Result.Ok sender) ->
		let target = Net.udp_local_addr receiver
		let origin = Net.udp_local_addr sender
		let! sent = Net.send_to sender (bytes_of (ref "udp")) target
		let! received = Net.recv_from receiver 64 (Maybe.Some 5000)
		let exchange = match received with
			| Result.Error _ -> -1
			| Result.Ok (bytes, source) -> bytes.length * 10 + (if source == origin then 1 else 0)
		let! quiet = Net.recv_from receiver 64 (Maybe.Some 40)
		let! spare = Net.bind_udp (loopback 0)
		let! vanished = vanished_line receiver spare
		let! _big = Net.send_to sender (pattern 100) target
		let! cut = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! _next = Net.send_to sender (bytes_of (ref "ok")) target
		let! after = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! _empty = Net.send_to sender (nothing ()) target
		let! blank = Net.recv_from receiver 10 (Maybe.Some 5000)
		let! a = Net.close_udp receiver
		let! b = Net.close_udp sender
		let! c = Net.close_udp sender
		let truncated = udp_text cut + " then " + udp_text after + " then " + udp_text blank
		let closed = unit_text a + " " + unit_text b + " " + unit_text c
		"exchange: " + to_string exchange + " " + to_string (ok_value (ref sent)) + "\nquiet: " + udp_text quiet + "\nvanished: " + vanished + "\ntruncated: " + truncated + "\nclosed: " + closed
	| _ -> "no sockets"

/// A connection that its peer reset before the program accepted it still has the peer's address. The program listens twice and
/// reports both ports; the host queues a connection at the first and resets it, then connects to the second, whose accept
/// tells the program to take the first. The port of the peer's address times ten, plus 1 when its host is 127.0.0.1.
export def peer_after_reset :: own i64 -> i64
fn peer_after_reset _seed =
	let! first = Net.bind (loopback 0)
	let! second = Net.bind (loopback 0)
	match (first, second) with
	| (Result.Ok queued, Result.Ok gate) ->
		report (Net.port (Net.local_addr queued))
		report (Net.port (Net.local_addr gate))
		let! signal = Net.accept gate (Maybe.Some 20000)
		let! accepted = Net.accept queued (Maybe.Some 5000)
		do! close_accepted signal
		let! _closed_queued = Net.close_listener queued
		let! _closed_gate = Net.close_listener gate
		match accepted with
		| Result.Error error -> 0 - 2000 - kind_code error
		| Result.Ok stream ->
			let peer = Net.peer_addr stream
			let! _closed = Net.close stream
			Net.port peer * 10 + (if Net.ip_text peer == "127.0.0.1" then 1 else 0)
	| _ -> 0 - 1

/// Reports `port`, sends `data` to the echo peer at `port`, and reports `0 - port` once the answer is back: a call that
/// suspends between its two reports. The sum of the bytes that came back.
export def echo_bytes :: ref [ubyte] -> own i64 -> i64
fn echo_bytes data port =
	report port
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! _written = Net.write stream (Array.copy data) (Maybe.Some 5000)
		let! outcome = collect stream data.length 0 0
		let! _closed = Net.close stream
		report (0 - port)
		match outcome with
		| (count, sum) -> if count == data.length then sum else 0 - 2000 - count

/// Two gibibytes of capacity (nothing touches it) put every later allocation above 2 GiB, where an address is a negative number
/// to the host: the echo of 1024 bytes through buffers up there, and the capacity that was held meanwhile.
export def high_echo :: own i64 -> i64
fn high_echo port =
	let low: Vec<ubyte> = Vec.with_capacity 1073741824
	let high: Vec<ubyte> = Vec.with_capacity 1073741824
	let! connected = Net.connect (loopback port) (Maybe.Some 5000)
	match connected with
	| Result.Error error -> 0 - 1000 - kind_code error
	| Result.Ok stream ->
		let! _written = Net.write stream (pattern 1024) (Maybe.Some 5000)
		let! outcome = collect stream 1024 0 0
		let! _closed = Net.close stream
		match outcome with
		| (count, sum) -> if count == 1024 then sum + Vec.capacity (ref low) / 1073741824 + Vec.capacity (ref high) / 1073741824 else 0 - 2000 - count
