export def vec_push_sum :: own i64 -> i64
fn vec_push_sum count =
    let mut values: Vec<i64> = Vec.empty()
    for index in 0 ..= (count - 1) do values = Vec.push_owned index values
    let mut total = 0
    for value in values do total = total + value
    let array = Vec.to_array values
    assert (Array.sum (ref array) == total)
    total

export def vec_pop_order :: own i64 -> i64
fn vec_pop_order count =
    let mut values = Vec.of_array (Array.init count (\index -> index))
    let mut total = 0
    while values.length > 0 do
        match Vec.pop values with
        | (remaining, Some value) ->
            values = remaining
            total = total * 10 + value
        | (remaining, None) -> values = remaining
    match Vec.pop values with | (remaining, item) ->
        assert (Vec.is_empty (ref remaining) && Maybe.is_none (ref item))
        total

export def vec_growth :: i64
fn vec_growth =
    let values = Vec.push_owned 0i64 (Vec.empty())
    let first = Vec.capacity (ref values)
    let values = Vec.reserve 4 values
    first * 100 + Vec.capacity (ref values)

export def vec_set_swap :: i64
fn vec_set_swap =
    let values = Vec.of_array [1, 2, 3, 4]
    let values = Vec.set 0 2 values
    let values = Vec.swap 0 3 values
    let values = Vec.set 1 3 values
    let values = Vec.set 2 1 values
    let array = Vec.to_array values
    Array.fold_owned (\state value -> state * 10 + value) 0 (ref array)

export def vec_strings :: own i64 -> i64
fn vec_strings count =
    let mut values: Vec<string> = Vec.with_capacity 0
    for index in 0 ..= (count - 1) do values = Vec.push_owned ("owned" + "!") values
    let values = Vec.truncate 2 values
    let values = Vec.clear values
    let values = Vec.push_owned ("last" + "!") values
    (Vec.at 0 (ref values)).length

export def vec_clone :: i64
fn vec_clone =
    let values = Vec.of_array [1, 2, 3]
    let copy = Vec.clone (ref values)
    let copy = Vec.set 0 10 copy
    values[0] + copy[0] + values[1] + copy[2]

export def vec_get :: own i64 -> i64
fn vec_get index =
    let values = Vec.push_owned 42 (Vec.empty())
    Maybe.default_value (-1) (Vec.get index (ref values))

export def vec_capture :: i64
fn vec_capture =
    let values = Vec.push_owned ("owned" + "!") (Vec.empty())
    let read = \offset -> (Vec.at 0 (ref values)).length + offset
    read 10 + read 22

export def vec_empty_transfer :: i64
fn vec_empty_transfer =
    let array = new [i64](0, \index -> index)
    let values = Vec.of_array array
    let capacity = Vec.capacity (ref values)
    let array = Vec.to_array values
    capacity + array.length

export def vec_nested :: i64
fn vec_nested =
    let values = Vec.push_owned (new [20, 22]) (Vec.empty())
    Array.sum (Vec.at 0 (ref values))

export def vec_bounds :: i64
fn vec_bounds =
    let values = Vec.push_owned 42 (Vec.empty())
    deref (Vec.at 1 (ref values))

export def vec_negative_capacity :: i64
fn vec_negative_capacity =
    let values: Vec<i64> = Vec.with_capacity (-1)
    values.length

export def vec_negative_reserve :: i64
fn vec_negative_reserve =
    let values = Vec.push_owned 42 (Vec.empty())
    let values = Vec.reserve (-1) values
    values.length

export def vec_overflow_reserve :: i64
fn vec_overflow_reserve =
    let values = Vec.push_owned 42 (Vec.empty())
    let values = Vec.reserve 9223372036854775807 values
    values.length

export def vec_overflow_capacity :: i64
fn vec_overflow_capacity =
    let values: Vec<i64> = Vec.with_capacity 9223372036854775807
    values.length

export def vec_negative_truncate :: i64
fn vec_negative_truncate =
    let values = Vec.push_owned 42 (Vec.empty())
    let values = Vec.truncate (-1) values
    values.length