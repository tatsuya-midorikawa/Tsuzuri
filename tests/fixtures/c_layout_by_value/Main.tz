// W36: `@c_layout` records passed and returned by value. Each record matches the C struct of the
// same name (with the prefix `Bv`) in tests/c_layout_by_value_reference.c, and each extern matches
// the C prototype of its link name. The host (tests/c_layout_by_value_host.c) checks every field it
// receives and returns values that the checks below compare field by field.

extern type copy Tag

@c_layout
record Point { x: i32, y: i32 }
@c_layout
record PointF { x: f32, y: f32 }
@c_layout
record Rect { left: i32, top: i32, right: i32, bottom: i32 }
@c_layout
record Rgb { r: i8u, g: i8u, b: i8u }
@c_layout
record P2D { x: f64, y: f64 }
@c_layout
record Vec3 { x: f32, y: f32, z: f32 }
@c_layout
record F1 { f: f32 }
@c_layout
record D1 { d: f64 }
@c_layout
record S1 { s: i16 }
@c_layout
record C1 { c: i8 }
@c_layout
record DI { d: f64, i: i64 }
@c_layout
record DF { d: f64, f: f32 }
@c_layout
record B5 { b: [i8u; 5] }
@c_layout
record B7 { b: [i8u; 7] }
@c_layout
record B9 { b: [i8u; 9] }
@c_layout
record S3 { a: i16u, b: i16u, c: i16u }
@c_layout(pack = 1)
record Packed5 { tag: i8u, value: i32 }
@c_layout(pack = 1)
record PackedF2 { a: f32, b: f32 }
@c_layout
record Quad { v: [f32; 4] }
@c_layout(pack = 2)
record QuadP2 { a: [f32; 3], b: f32 }
@c_layout
record Nested3 { p: PointF, z: f32 }
@c_layout
record F5 { a: f32, b: f32, c: f32, d: f32, e: f32 }
@c_layout
record L3 { a: i64, b: i64, c: i64 }
@c_layout
record HX { h: Tag, x: i32 }
@c_layout
record H1 { h: Tag }
@c_layout
record H2 { h: Tag, g: Maybe<Tag> }
@c_layout
record RectD { x: f64, y: f64, w: f64, h: f64 }
@c_layout
record D3 { a: f64, b: f64, c: f64 }
@c_layout
record NsRange { location: i64u, length: i64u }
@c_layout
record CD { c: i8, d: f64 }
@c_layout
record IC { a: i32, b: i8 }
@c_layout
record LI { a: i64, b: i32 }
@c_layout
record I3 { a: i32, b: i32, c: i32 }
@c_layout
record FI { f: f32, i: i32 }
@c_layout
record FFD { a: f32, b: f32, c: f64 }
@c_layout
record DFF { a: f64, b: f32, c: f32 }
@c_layout
record FFFI { a: f32, b: f32, c: f32, d: i32 }
@c_layout
record CS { a: i8, b: i16 }
@c_layout
record Frame { origin: Point, size: Point }
@c_layout
record Line { head: PointF, tail: PointF }

