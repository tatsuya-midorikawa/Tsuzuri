export def seq_once :: i64
fn seq_once =
    let mut total = 0
    for value in Seq.once 42 do total = total + value
    total

export def seq_empty :: i64
fn seq_empty =
    let sequence: Seq<i64> = Seq.empty()
    let mut total = 0
    for value in sequence do total = total + value
    total

export def seq_cold :: i64
fn seq_cold =
    let _sequence: Seq<i64> = Seq.defer (\() -> { assert false; (Seq.empty(), Option.Some 0) })
    42

export def seq_range_sum :: i64 -> i64
fn seq_range_sum count =
    let counter = Counter { start: 0, finish: count }
    let mut total = 0
    for value in Counter.iter (&counter) do total = total + value
    total

export def seq_list :: i64 -> i64
fn seq_list count =
    let values = new [|i64|](count, \index -> index)
    let mut total = 0
    for value in List.iter (&values) do total = total + deref value
    total

export def seq_map_filter :: i64 -> i64
fn seq_map_filter count =
    let counter = Counter { start: 0, finish: count }
    let mapped = Seq.map (\value -> value * 2) (Counter.iter (&counter))
    let filtered = Seq.filter (\value -> deref value % 6 == 0) mapped
    let values = Seq.to_array filtered
    Array.sum (&values)

export def seq_owned :: i64 -> i64
fn seq_owned count =
    let counter = Counter { start: 0, finish: count }
    let text = Seq.map (\value -> to_string value) (Counter.iter (&counter))
    let filtered = Seq.filter (\value -> value.length % 2 == 0) text
    let mut total = 0
    for value in filtered do total = total + value.length
    total

export def seq_borrowed :: i64
fn seq_borrowed =
    let strings = ["a", "bc"]
    let vector = Vec.push (Vec.empty()) "owned"
    let map = Map.singleton "key" "value"
    let set = Set.singleton "borrowed"
    let mut total = 0
    for value in Array.iter (&strings) do total = total + value.length
    for value in Vec.iter (&vector) do total = total + value.length
    for (key, value) in Map.iter (&map) do total = total + key.length + value.length
    for value in Set.iter (&set) do total = total + value.length
    total + 1

export def seq_early_exit :: i64
fn seq_early_exit =
    let sequence = Seq.unfold (\value -> { assert (value <= 20); Option.Some (value, value + 1) }) 0
    let mut total = 0
    for value in sequence do
        if value == 20 then break
        if value % 2 == 0 then continue
        total = total + value
    total

export def seq_task :: i64
fn seq_task =
    let sequence = Seq.once (task { return 42 })
    let mut total = 0
    for work in sequence do total = total + Task.run work
    total
