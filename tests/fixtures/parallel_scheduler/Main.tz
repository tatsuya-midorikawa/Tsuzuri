// TZ11: the cases of tests/fixtures/parallel in a program that uses the tzroutine runtime (the
// scopes at the end spawn): Parallel runs on the scheduler, with the same results.

export def parallel_init_sum :: own i64 -> i64
fn parallel_init_sum count =
    let values = Parallel.init count (\index -> index + 1)
    Parallel.sum (ref values)

export def parallel_large_length :: own i64 -> i64
fn parallel_large_length count = (Parallel.init count (\index -> index as ubyte)).length

export def parallel_subtract :: own i64 -> i64
fn parallel_subtract count =
    let values = new [i64](count, \index -> index % 7)
    Parallel.reduce 10 (\left right -> left - right) (ref values)

export def parallel_slice :: i64
fn parallel_slice =
    let values = [1, 2, 3, 4, 5]
    let mapped = Parallel.map (\value -> value * 2) (ref values[1..4])
    Array.sum (ref mapped) + values[0]

export def parallel_strings :: own i64 -> i64
fn parallel_strings count =
    let values = new [string](count, \_index -> "he" + "llo")
    let lengths = Parallel.map_ref (\value -> value.length) (ref values)
    Parallel.sum (ref lengths)

export def parallel_copy_arrays :: own i64 -> i64
fn parallel_copy_arrays count =
    let values = new [[i64]](count, \index -> [index, 1])
    let mapped = Parallel.map (\row -> Array.sum (ref row)) (ref values)
    Array.sum (ref mapped)

export def parallel_copy_functions :: i64
fn parallel_copy_functions =
    let text = "hello"
    let reader = \delta -> text.length + delta
    let functions = [reader, reader]
    let copied = Parallel.map (\function -> function) (ref functions)
    let results = Parallel.map (\function -> function 1) (ref functions)
    copied[0] 0 + copied[1] 0 + Array.sum (ref results)

export def parallel_callback_snapshots :: own i64 -> i64
fn parallel_callback_snapshots count =
    let seed = Vec.push_owned 7 Vec.empty()
    let callback = \index -> { let values = Vec.push_owned index seed; Vec.length (ref values) }
    let values = Parallel.init count callback
    Array.sum (ref values)

export def parallel_copy_reduce :: own i64 -> i64
fn parallel_copy_reduce count =
    let values = new [[i64]](count, \index -> [index])
    let identity = [1i64]
    let result = Parallel.reduce identity (\left right -> [left[0] + right[0]]) (ref values)
    result[0]

export def parallel_float :: own i64 -> i64
fn parallel_float count =
    let values = new [f64](count, \index -> if index % 3 == 0 then 1e16 else if index % 3 == 1 then 1.0 else -1e16)
    Parallel.sum (ref values) as i64

export def parallel_float_special :: i64
fn parallel_float_special =
    let zeros = [-0.0, -0.0]
    let zero = Parallel.sum (ref zeros)
    let values = [1.0, 0.0 / 0.0, 2.0]
    let nan = Parallel.sum (ref values)
    if zero == 0.0 && 1.0 / zero > 0.0 && nan != nan then 1 else 0

export def parallel_order :: i64
fn parallel_order =
    let mut state = 0
    let values = [1, 2]
    let mapped = Parallel.map ({ state = state * 10 + 1; \value -> value }) ({ state = state * 10 + 2; ref values })
    state * 100 + Array.sum (ref mapped)

export def parallel_trap :: i64
fn parallel_trap = (Parallel.init 8192 (\index -> { assert (index != 4096); index })).length

export def parallel_capture_order :: i64
fn parallel_capture_order =
    let mut weights = new [10i64, 20]
    let values = [1i64, 2]
    let mapped = Parallel.map (\value -> value + weights[0]) ({ weights = new [30i64, 40]; ref values })
    Array.sum (ref mapped) + weights[0]

export def parallel_wrapping :: i64
fn parallel_wrapping =
    let values = [120i8, 120i8]
    Parallel.sum (ref values) as i64
// Routine.scope: 64 children pass a value around a ring of channels, which needs them all at once
// (with one P too); the results are in index order.
def received :: ref Channel<i64> -> i64
fn received channel =
    match Channel.recv channel with
    | Maybe.Some value -> value
    | Maybe.None -> 0

def pass_on :: ref [Channel<i64>] -> i64 -> i64
fn pass_on channels index =
    if index == 0 then {
        Channel.send (ref channels[1]) 1;
        received (ref channels[0])
    } else {
        let value = received (ref channels[index]) + 1;
        Channel.send (ref channels[(index + 1) % channels.length]) value;
        value
    }

export def scope_ring :: i64
fn scope_ring =
    let ring = new [Channel<i64>](64, \_index -> Channel.make 0)
    let results = Routine.scope (ref ring) 64 (\channels index -> pass_on channels index)
    if results[0] == 64 && results[1] == 2 && results[63] == 64 then Array.sum (ref results) else 0

// The example of Task.scope in task.md, on Routine.scope: each child sums a stride of the borrow.
def stride_sum :: ref [i64] -> i64 -> i64
fn stride_sum numbers start =
    let mut total = 0;
    let mut index = start;
    while index < numbers.length do
        total = total + numbers[index];
        index = index + 4
    total

export def scope_shares_borrow :: i64
fn scope_shares_borrow =
    let numbers = new [i64](100, \index -> index + 1)
    let partial = Routine.scope (ref numbers) 4 (\shared part -> stride_sum shared part)
    partial[0] * 1000000 + partial[3] * 100 + Array.sum (ref partial) - 5050

// An Atomic shared by borrow: every child adds once.
export def scope_shares_an_atomic :: i64
fn scope_shares_an_atomic =
    let hits = Atomic.create 0i64
    let _seen = Routine.scope (ref hits) 8 (\shared index -> Atomic.fetch_add shared (index + 1))
    Atomic.load (ref hits)

// A count of 0 makes no child.
export def scope_empty :: i64
fn scope_empty =
    let values = [1i64]
    (Routine.scope (ref values) 0 (\shared index -> shared[0] + index)).length
