extern type Counter
extern type copy IdHandle
extern "sqrt" def c_sqrt :: f64 -> f64
extern "env" "e12_host_now" def host_now :: unit -> i64
extern "e12_counter_new" def counter_new :: i64 -> Counter
extern "e12_counter_add" def counter_add :: ref Counter -> i64 -> i64
extern "e12_counter_free" def counter_free :: Counter -> i64
extern "e12_add_one" def add_one :: i64 -> i64
extern "e12_apply_twice" def apply_twice :: (i64 -> i64) -> i64 -> i64
extern "e12_fold" def fold_host :: (i64 -> i64 -> i64) -> i64 -> i64
extern "e12_run" def run_host :: (unit -> i64) -> i64
extern "e12_visit" def visit :: (ref Counter -> i64) -> ref Counter -> i64
extern "e12_apply_threaded" def apply_threaded :: (i64 -> i64) -> i64 -> i64
extern "e12_text_units" def text_units :: (i64 -> i64) -> ref string -> i64 -> i64
extern "e12_pair_mix" def pair_mix :: (i64 -> i64) -> ref Pair -> i64
extern "e12_sum_with" def sum_with :: (i64 -> i64) -> ref [i64] -> i64
extern "w18_id_new" def id_new :: i64 -> IdHandle
extern "w18_id_value" def id_value :: IdHandle -> i64
extern "w18_id_borrow" def id_borrow :: ref IdHandle -> i64

record Pair { x: i64, y: i64 }

const GREETING: string = "hello"

private def label :: own i64 -> string
fn label value = $"item-{value}"

private def triple :: own i64 -> i64
fn triple value = value * 3

private def via_host :: own i64 -> i64
fn via_host value = add_one value

private def boom :: own i64 -> i64
fn boom value =
    assert (value < 0)
    value

private def add_pair :: own i64 -> own i64 -> i64
fn add_pair total item = total + item

private def answer :: own unit -> i64
fn answer _ = 42

private def peek_five :: ref Counter -> i64
fn peek_five counter = counter_add counter 5

export def counters :: own i64 -> i64
fn counters start =
    let counter = counter_new start
    let first = counter_add (ref counter) 5
    let second = counter_add (ref counter) 7
    first + second + counter_free counter

export def callbacks :: own i64 -> i64
fn callbacks value = apply_twice triple value + apply_twice via_host 1

export def callback_shapes :: own i64 -> i64
fn callback_shapes start =
    let counter = counter_new start
    let seen = visit peek_five (ref counter)
    seen + counter_free counter + fold_host add_pair 4 + run_host answer

export def callback_trap :: own i64 -> i64
fn callback_trap value = apply_twice boom value

export def threaded :: own i64 -> i64
fn threaded value = apply_threaded triple value

export def misc :: own f64 -> i64
fn misc value = if c_sqrt value == 1.5 then host_now () else 0

export def pass_through :: own Counter -> Counter
fn pass_through counter = counter

export def temporaries :: own i64 -> i64
fn temporaries value =
    text_units triple "abc" 0 +
    text_units triple $"n={value}" 0 +
    text_units triple (label value) 0 +
    text_units triple GREETING 0 +
    pair_mix triple (ref (Pair { x: value, y: 2 })) +
    sum_with triple (ref [value, 2, 3])

export def temporary_then_raise :: own i64 -> i64
fn temporary_then_raise value =
    let outcome: Result<i64, Exception> =
        try
            text_units triple (label value) (@checked value * value)
        with
        | e is OverflowException -> e
    match outcome with
    | Result.Ok total -> total
    | Result.Error _ -> -1

export def copy_handles :: own i64 -> i64
fn copy_handles seed =
    let handle = id_new seed
    let copied = handle
    let tag = $"id-{seed}"
    let probe = \extra -> id_value handle + tag.length + extra
    let cloned = probe
    id_value handle + id_value copied + id_borrow (ref handle) + probe 2 + cloned 3


