record Named { text: string, n: i64 }

def length_of :: string -> i64 = \text -> text.length
def first :: ['a] -> i64 = \xs -> xs.length
def name_length :: Named -> i64 = \named -> named.text.length + named.n
def take :: own string -> string = \text -> $"{text}!"
def total :: [i64] -> i64 = \xs -> Array.sum xs
const def fixed_length :: string -> i64 = \text -> text.length
const Five: i64 = fixed_length "hello"

export def borrowed_text :: i64 =
    let text = "hello"
    length_of text + text.length

export def borrowed_array :: i64 =
    let xs = [2, 3, 5, 7]
    total xs + first xs + xs[2]

export def borrowed_record :: i64 =
    let named = Named { text: "hello", n: 7 }
    name_length named + named.text.length

export def owned_text :: i64 = (take "hello").length + Five

export def trap :: i64 -> i64 = \index ->
    let xs = [10, 20]
    total xs + xs[index]

def inspect :: 'a -> i64 = \value -> 3
def twice :: (ref 'a -> i64) -> 'a -> i64 = \f value -> f value + f value
def owned_inc :: own i64 -> i64 = \n -> n + 1
def generic_identity :: 'a -> 'a = \value -> value

export def generic_read :: i64 =
    let text = "hello"
    twice length_of text + inspect text + text.length

export def generic_scalar :: i64 = generic_identity 42

export def read_map :: i64 =
    let texts = ["a", "bc"]
    Array.sum (Array.map length_of texts) + texts.length

export def read_map_alias :: i64 =
    let texts = ["a", "bc"]
    let mapper = Array.map
    Array.sum (mapper (\text -> text.length) texts) + texts.length

export def read_mapi :: i64 =
    let texts = ["a", "bc"]
    Array.sum (Array.mapi (\index text -> index + text.length) texts)

export def read_fold :: i64 =
    let texts = ["a", "bc"]
    Array.fold (\total text -> total + text.length) 0 texts

export def read_list_map :: i64 =
    let texts = [|"a", "bc"|]
    List.sum (List.map (\text -> text.length) texts)

export def read_list_fold :: i64 =
    let texts = [|"a", "bc"|]
    List.fold (\total text -> total + text.length) 0 texts

export def callback_constructed_once :: i64 =
    let mut calls = 0
    let values = Array.map ({ calls = calls + 1; owned_inc }) [1, 2, 3]
    calls * 100 + Array.sum values
