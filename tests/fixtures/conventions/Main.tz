record Named { text: string, n: i64 }

def length_of :: string -> i64 = \text -> text.length
def first :: ['a] -> i64 = \xs -> xs.length
def name_length :: Named -> i64 = \named -> named.text.length + named.n
def take :: own string -> string = \text -> $"{text}!"
def total :: [i64] -> i64 = \xs -> Array.sum xs
const def fixed_length :: string -> i64 = \text -> text.length
const Five: i64 = fixed_length "hello"

export def borrowed_text :: i64 =
    let text = "hello"
    length_of text + text.length

export def borrowed_array :: i64 =
    let xs = [2, 3, 5, 7]
    total xs + first xs + xs[2]

export def borrowed_record :: i64 =
    let named = Named { text: "hello", n: 7 }
    name_length named + named.text.length

export def owned_text :: i64 = (take "hello").length + Five

export def trap :: i64 -> i64 = \index ->
    let xs = [10, 20]
    total xs + xs[index]

def inspect :: 'a -> i64 = \value -> 3
def twice :: (ref 'a -> i64) -> 'a -> i64 = \f value -> f value + f value
def owned_inc :: own i64 -> i64 = \n -> n + 1
def generic_identity :: 'a -> 'a = \value -> value

export def generic_read :: i64 =
    let text = "hello"
    twice length_of text + inspect text + text.length

export def generic_scalar :: i64 = generic_identity 42

export def read_map :: i64 =
    let texts = ["a", "bc"]
    Array.sum (Array.map length_of texts) + texts.length

export def read_map_alias :: i64 =
    let texts = ["a", "bc"]
    let mapper = Array.map
    Array.sum (mapper (\text -> text.length) texts) + texts.length

export def read_mapi :: i64 =
    let texts = ["a", "bc"]
    Array.sum (Array.mapi (\index text -> index + text.length) texts)

export def read_fold :: i64 =
    let texts = ["a", "bc"]
    Array.fold (\total text -> total + text.length) 0 texts

export def read_list_map :: i64 =
    let texts = [|"a", "bc"|]
    List.sum (List.map (\text -> text.length) texts)

export def read_list_fold :: i64 =
    let texts = [|"a", "bc"|]
    List.fold (\total text -> total + text.length) 0 texts

export def read_fold_back :: i64 =
    let texts = ["a", "bc"]
    Array.fold_back (\text total -> text.length + total * 10) 0 texts + texts.length

export def read_list_fold_back :: i64 =
    let texts = [|"a", "bc"|]
    List.fold_back (\text total -> text.length + total * 10) 0 texts + texts.length

export def read_list_mapi :: i64 =
    let texts = [|"a", "bc"|]
    let result = List.mapi (\index text -> index * 10 + text.length) texts
    List.sum result + texts.length

export def read_iters :: i64 =
    let texts = ["a", "bc"]
    let list = [|"a", "bc"|]
    Array.iter (\text -> assert (text.length > 0)) texts
    Array.iteri (\index text -> assert (text.length == index + 1)) texts
    List.iter (\text -> assert (text.length > 0)) list
    List.iteri (\index text -> assert (text.length == index + 1)) list
    texts.length + list.length

export def read_array_iter_trap :: i64 =
    let texts = ["a", ""]
    Array.iter (\text -> assert (text.length > 0)) texts
    0

export def read_array_iteri_trap :: i64 =
    let texts = ["a", ""]
    Array.iteri (\index text -> assert (text.length == index + 1)) texts
    0

export def read_list_iter_trap :: i64 =
    let texts = [|"a", ""|]
    List.iter (\text -> assert (text.length > 0)) texts
    0

export def read_list_iteri_trap :: i64 =
    let texts = [|"a", ""|]
    List.iteri (\index text -> assert (text.length == index + 1)) texts
    0

export def callback_constructed_once :: i64 =
    let mut calls = 0
    let values = Array.map ({ calls = calls + 1; owned_inc }) [1, 2, 3]
    calls * 100 + Array.sum values

def bump :: mut i64 -> unit = \value -> value = value + 1
def rename :: mut Named -> unit = \item ->
    item.text = $"next{item.n}"
    item.n = item.n + 1

def put :: i64 -> own string -> mut [string] -> unit = \index value texts -> texts[index] = value

export def mutable_record :: i64 =
    let mut value = 1
    let change = bump
    change value
    let mut item = Named { text: $"old{value}", n: value }
    rename item
    value + item.n + item.text.length

export def mutable_elements :: i64 -> i64 = \index ->
    let mut texts = ["first", "second"]
    put index $"changed{index}" texts
    texts[0].length + texts[1].length

export def rhs_before_index :: i64 =
    let mut order: i64 = 0
    let mut values: [i64] = [0]
    values[{ order = order * 10 + 2; 0 }] = { order = order * 10 + 1; 99 }
    order * 100 + values[0]

export def mutable_vector :: i64 -> i64 = \count ->
    let mut values: Vec<string> = Vec.empty()
    for index in 0 .. (count - 1) do Vec.push $"text{index}" values
    let mut result: i64 = 0
    for text in values do result = result + text.length
    result

export def mutable_vector_alias :: i64 =
    let mut values: Vec<i64> = Vec.empty()
    let push = Vec.push
    push 10 values
    let append = Vec.push 20
    append values
    values[0] + values[1]

export def mutable_vector_subject_last :: i64 =
    let mut values = Vec.of_array [1]
    Vec.push (values[0] + 1) values
    values[0] + values[1]
