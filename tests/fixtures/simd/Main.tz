export def vector_i8 :: i64 -> i64 -> i64
fn vector_i8 seed shift =
    let base: i8x16 = Simd.splat (seed as i8)
    let values = Simd.replace base 0 ((seed + 7) as i8)
    let shifts: i8x16 = Simd.splat (shift as i8)
    (Simd.sum_lanes ((values * values + values) <<< shifts)) as i64

export def vector_i8u :: i64 -> i64 -> i64
fn vector_i8u seed shift =
    let base: i8ux16 = Simd.splat (seed as ubyte)
    let values = Simd.replace base 0 ((seed + 7) as ubyte)
    let shifts: i8ux16 = Simd.splat (shift as ubyte)
    (Simd.sum_lanes ((values * values + values) <<< shifts)) as i64

