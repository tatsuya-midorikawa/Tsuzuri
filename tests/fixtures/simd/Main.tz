export def vector_i64 :: i64 -> i64 -> i64
fn vector_i64 seed shift =
    let base: i64x2 = Simd.splat seed
    let values = Simd.replace base 0 (seed + 7)
    let shifts: i64x2 = Simd.splat shift
    Simd.sum_lanes ((values * values + values) <<< shifts)

