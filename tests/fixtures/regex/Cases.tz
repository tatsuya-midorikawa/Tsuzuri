def linear_pattern :: i64 -> string
fn linear_pattern which =
    match which with
    | 0 -> "(a*)*b"
    | 1 -> "(a|a)*b"
    | 2 -> "(a|aa)*c"
    | 3 -> "(x+x+)+y"
    | 4 -> "(.*a){20}"
    | 5 -> "^(a+)+$"
    | 6 -> "(?i)(\u{DF}|ss)*x"
    | 7 -> "(?:a?){50}a{50}"
    | 8 -> "\\b\\w+\\b"
    | 9 -> "[\\p{L}\\d]+@"
    | _ -> ""

