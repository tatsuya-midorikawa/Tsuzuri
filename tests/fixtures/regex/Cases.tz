def escape_input :: i64 -> string
fn escape_input which =
    match which with
    | 0 -> ""
    | 1 -> "abc"
    | 2 -> "^$\\.*+?()[]{}|"
    | 3 -> "a.b*c"
    | 4 -> "-/ ,\u{E9}\u{1F600}"
    | 5 -> "\\\\"
    | _ -> ""
