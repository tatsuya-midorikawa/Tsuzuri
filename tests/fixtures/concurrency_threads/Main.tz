// F10 on real worker threads (tests/wasm_threads.mjs): atomics and locks must not lose updates between
// workers, and the children of a scope run on the pool. Every result is independent of the schedule.

export def atomic_counter :: i64 -> i64
fn atomic_counter n =
    let counter = Atomic.create 0i64
    let _previous = Task.scope (ref counter) n (shared -> index -> Atomic.fetch_add shared (index + 1))
    Atomic.load (ref counter)

// Each child adds one a thousand times: a plain, non-atomic add would lose updates between workers.
export def atomic_contended :: i64 -> i64
fn atomic_contended n =
    let counter = Atomic.create 0i64
    let _done = Task.scope (ref counter) n (shared -> _index -> add_many shared 1000)
    Atomic.load (ref counter)

def add_many :: ref Atomic<i64> -> i64 -> i64
fn add_many cell count =
    let mut round = 0i64
    while round < count do
        let _previous = Atomic.fetch_add cell 1
        round = round + 1
    round

// One compare-exchange loop: every child wins its update once, whatever the order.
export def atomic_compare_exchange_loop :: i64 -> i64
fn atomic_compare_exchange_loop n =
    let counter = Atomic.create 0i64
    let _done = Task.scope (ref counter) n (shared -> index -> increment shared (index + 1))
    Atomic.load (ref counter)

def rec increment :: ref Atomic<i64> -> i64 -> i64
fn rec increment cell amount =
    let seen = Atomic.load cell
    match Atomic.compare_exchange cell seen (seen + amount) with
    | Result.Ok _previous -> amount
    | Result.Error _current -> increment cell amount

export def scope_results_order :: i64 -> i64
fn scope_results_order n =
    let unit_value = 0i64
    let results = Task.scope (ref unit_value) n (_shared -> index -> index * 3 + 1)
    let mut checksum = 0;
    for position in 0i64 .. (results.length - 1) do
        checksum = checksum * 31 + results[position] + position
    checksum

def count :: Arc<Atomic<i64>> -> i64 -> Task<i64>
fn count shared amount = task {
    let _previous = Atomic.fetch_add (Arc.get (ref shared)) amount
    return amount
}

def counts :: ref Arc<Atomic<i64>> -> i64 -> [Task<i64>]
fn counts shared n = new [Task<i64>](n, \index -> count (Arc.share shared) (index + 1))

export def arc_atomic_tasks :: i64 -> i64
fn arc_atomic_tasks n =
    let shared = Arc.new (Atomic.create 0i64)
    let results = Task.run (Task.parallel (counts (ref shared) n))
    Array.sum (ref results) * 1000 + Atomic.load (Arc.get (ref shared))

// Mutex on real workers (F10 Phase 2): every child reads, adds and writes under the lock, so a lock
// that is not exclusive would lose updates, and a waiter that is never woken would hang.
def add_locked :: ref Mutex<i64> -> i64 -> i64
fn add_locked cell count =
    let mut round = 0i64
    while round < count do
        let _seen = Mutex.with_lock cell (value -> {
            deref value = deref value + 1;
            0
        })
        round = round + 1
    round

export def mutex_contended :: i64 -> i64
fn mutex_contended n =
    let total = Mutex.create 0i64
    let _done = Task.scope (ref total) n (shared -> _index -> add_locked shared 1000)
    Mutex.into_inner total

export def mutex_total :: i64 -> i64
fn mutex_total n =
    let total = Mutex.create 0i64
    let indices = Task.scope (ref total) n (shared -> index -> Mutex.with_lock shared (value -> {
        deref value = deref value + index + 1;
        index
    }))
    Mutex.into_inner total + Array.sum (ref indices)

// Owned data under the lock: each child writes its own slot of a shared array.
export def mutex_owned_array :: i64 -> i64
fn mutex_owned_array n =
    let slots = Mutex.create (new [i64](n, \_index -> 0))
    let _done = Task.scope (ref slots) n (shared -> index -> Mutex.with_lock shared (values -> {
        Array.write values index (index * 2 + 1);
        0
    }))
    Array.sum (ref (Mutex.into_inner slots))

def bump :: Arc<Mutex<i64>> -> i64 -> Task<i64>
fn bump shared amount = task {
    return Mutex.with_lock (Arc.get (ref shared)) (value -> { deref value = deref value + amount; deref value })
}

def bumps :: ref Arc<Mutex<i64>> -> i64 -> [Task<i64>]
fn bumps shared n = new [Task<i64>](n, \index -> bump (Arc.share shared) (index + 1))

export def arc_mutex_tasks :: i64 -> i64
fn arc_mutex_tasks n =
    let shared = Arc.new (Mutex.create 0i64)
    let _seen = Task.run (Task.parallel (bumps (ref shared) n))
    Mutex.with_lock (Arc.get (ref shared)) (value -> deref value) * 1000 + Arc.strong_count (ref shared)

// A critical section never waits, so these are refused on every schedule: a trap.
export def mutex_nested :: i64
fn mutex_nested =
    let outer = Mutex.create 1i64
    let inner = Mutex.create 2i64
    let inner_borrow = ref inner
    Mutex.with_lock (ref outer) (_a -> Mutex.with_lock inner_borrow (b -> deref b))

export def mutex_parallel_inside :: i64
fn mutex_parallel_inside =
    let total = Mutex.create 0i64
    let unit_value = 0i64
    Mutex.with_lock (ref total) (_value -> Array.sum (ref (Task.scope (ref unit_value) 2 (_shared -> index -> index))))

// A lock that was released by the end of a call can be taken again: the flag of the thread is clear.
export def mutex_twice :: i64 -> i64
fn mutex_twice n =
    let total = Mutex.create 0i64
    let _first = Task.scope (ref total) n (shared -> _index -> add_locked shared 10)
    let _second = Task.scope (ref total) n (shared -> _index -> add_locked shared 10)
    Mutex.into_inner total
