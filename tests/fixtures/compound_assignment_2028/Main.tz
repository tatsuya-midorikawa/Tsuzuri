export def window_updates :: own i64 -> i64 = \bonus ->
    let mut t = Tensor.init [3, 4] (\i -> i + 1)
    t[1, ..] *= 2
    t[.., ..< 2] += bonus
    t[2, 3] -= 1
    t[^0, 0] += 10
    let mut w = ref mut t[0 .. 1, ..]
    w += 3
    Tensor.sum (Tensor.view (ref t))

export def snapshot_shift_accumulate :: i64
fn snapshot_shift_accumulate =
    let mut a = Tensor.init [5] (\i -> i * 10)
    let v = ref a[.. ^1]
    let prev = Tensor.to_tensor (ref v)
    a[1 ..] += prev
    let arr = Tensor.as_array (ref a)
    arr[0] + arr[1] * 10 + arr[2] * 100 + arr[3] * 1000 + arr[4] * 10000

export def subwindow_reborrow :: i64
fn subwindow_reborrow =
    let mut raw = new [i64](12, \i -> i)
    let mut m = Tensor.borrow_mut [3, 4] (ref mut raw)
    let mut sub = ref mut m[1 .. 2, 1 ..< 4]
    sub += 100
    let mut row0 = ref mut sub[0, ..]
    row0 *= 2
    Array.fold (\acc x -> acc * 31 + x) 0 (ref raw)

export def trap_window_oob :: own i64 -> i64 = \bad ->
    let mut t = Tensor.init [3, 4] (\i -> i)
    t[bad, ..] += 1
    Tensor.sum (Tensor.view (ref t))
