pure def twice_sum :: [i64] -> i64 = \values ->
    let mapped = Parallel.map (\value -> value * 2) values
    Array.sum mapped

// A value that runs its work when it is called, after it was made.
pure def local_job :: i64 -> i64 = \n ->
    let job = \() -> n + 1
    job ()

pure def parallel_pair :: i64 -> i64 = \n ->
    let values = Parallel.init 2 (\index -> if index == 0 then n + 1 else n * 2)
    Array.sum values

pure def trap_map :: i64 -> i64 = \n ->
    let mapped = Parallel.init n (\i -> 100 / (i - 4096))
    Array.sum mapped

export def parallel_sum :: i64 -> i64 = \n -> twice_sum (Array.init n (\i -> i + 1))
export def run_job :: i64 -> i64 = \n -> local_job n
export def run_pair :: i64 -> i64 = \n -> parallel_pair n
export def parallel_trap :: i64 -> i64 = \n -> trap_map n
