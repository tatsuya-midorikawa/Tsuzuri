record Foo { v: i64 }

instance Index<Foo, i64, i64> {
    fn index k self = self.v + deref k
}

instance Index<Foo, (i64 * i64), i64> {
    fn index k self =
        match k with
        | (a, b) -> self.v + a + b
}

let mut foo = Foo { v: 1 }
foo[0, { foo = Foo { v: 5 }; 0 }]

// rule: OWN-031
// expect: check-error E1014 line=14 kind=borrow_conflict
