extern type copy Hwnd

record Point { x: f64, y: f64 }

export def keep :: Hwnd -> Hwnd = \h -> h

export def norm :: ref Point -> f64 = \p -> p.x + p.y

export def greet :: ref string -> string = \name -> clone_string name

0

