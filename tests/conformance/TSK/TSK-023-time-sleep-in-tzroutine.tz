// As many sleepers as there are processors: a sleep that held its processor would keep the yielding
// tzroutine from running until the sleepers wake.
def run :: unit -> string
fn run _ =
    let reports: Channel<string> = Channel.make 512
    for _ in 1 ..= Routine.max_procs () do
        let sleeper = Channel.share reports
        tzroutine {
            do! Time.sleep (300 * Time.millisecond)
            Channel.send sleeper "sleeper"
        }
    let worker = Channel.share reports
    tzroutine {
        for _ in 1 ..= 100 do
            Routine.yield ()
        Channel.send worker "worker"
    }
    match Channel.recv reports with
    | Maybe.Some first -> first
    | Maybe.None -> "none"

run ()

// rule: TSK-023
// expect: stdout "worker\n"
