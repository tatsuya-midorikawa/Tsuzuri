// A pending timer that is stopped reports it and sends nothing; a timer that may have fired just
// before its stop keeps nothing that it sent either.
def run :: unit -> i64
fn run _ =
    let timer = Timer.create Time.hour()
    let fired = Timer.channel timer
    let stopped = Timer.stop timer
    let short = Timer.create Time.millisecond()
    let short_fired = Timer.channel short
    let _maybe = Timer.stop short
    Time.sleep (20 * Time.millisecond())
    match (Channel.try_recv fired, Channel.try_recv short_fired) with
    | (Channel.Empty, Channel.Empty) -> if stopped then 1 else 2
    | _ -> 0

run ()

// rule: TSK-024
// expect: stdout "1\n"
