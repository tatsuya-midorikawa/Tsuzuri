def say :: i64 -> i64 = \n ->
    do! IO.write_line (to_string n)
    n

def f :: unit -> Maybe<i64> = \() ->
    let none: Maybe<i64> = None
    Maybe {
        let! a = Some (say 1)
        let! b = none
        let! c = Some (say 3)
        return a + b + c
    }

match f () with
| Some v -> v
| None -> -1

// rule: CTL-025
// expect: stdout "1\n-1\n"
