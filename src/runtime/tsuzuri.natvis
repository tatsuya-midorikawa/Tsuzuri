<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio and WinDbg views of Tsuzuri values (G16 Phase 3). A `-g` build for an MSVC target
  embeds this file in the PDB with /NATVIS. Types match by their Tsuzuri names, the names of the
  CodeView and DWARF types. Natvis wildcards match only template arguments, so `Vec<*>` and
  `Maybe<*>` have views here, while arrays, lists, and user unions keep the debugger's view of
  their members, whose `$tag` shows the case name.
-->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <!-- A `string` is Latin-1 when bit 62 of `length` is set (`TSUZURI_STRINGS=compact`): the low 62 bits count
       the bytes at `data`. A Latin-1 string shows as UTF-8 here, so only its ASCII text reads as text; its
       elements are the bytes. Bit 63 is never set (PM01's niche). -->
  <Type Name="string">
    <DisplayString Condition="(length &amp; 0x4000000000000000) != 0">{(char*)data,[length &amp; 0x3FFFFFFFFFFFFFFF]s8}</DisplayString>
    <DisplayString>{data,[length]su}</DisplayString>
    <StringView Condition="(length &amp; 0x4000000000000000) != 0">(char*)data,[length &amp; 0x3FFFFFFFFFFFFFFF]s8</StringView>
    <StringView>data,[length]su</StringView>
    <Expand>
      <Item Name="[length]">length &amp; 0x3FFFFFFFFFFFFFFF</Item>
      <ArrayItems Condition="(length &amp; 0x4000000000000000) != 0">
        <Size>length &amp; 0x3FFFFFFFFFFFFFFF</Size>
        <ValuePointer>(unsigned char*)data</ValuePointer>
      </ArrayItems>
      <ArrayItems Condition="(length &amp; 0x4000000000000000) == 0">
        <Size>length</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  <Type Name="utf8string">
    <DisplayString>u8{data,[length]s8}</DisplayString>
    <StringView>data,[length]s8</StringView>
    <Expand>
      <Item Name="[length]">length</Item>
      <ArrayItems>
        <Size>length</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  <Type Name="Vec&lt;*&gt;">
    <DisplayString>{{ length={length} capacity={capacity} }}</DisplayString>
    <Expand>
      <Item Name="[length]">length</Item>
      <Item Name="[capacity]">capacity</Item>
      <ArrayItems>
        <Size>length</Size>
        <ValuePointer>data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  <Type Name="Map&lt;*,*&gt;">
    <DisplayString>{{ size={length} }}</DisplayString>
    <Expand>
      <CustomListItems MaxItemsPerView="10000">
        <Variable Name="chunk" InitialValue="-1" />
        <Variable Name="offset" InitialValue="0" />
        <Variable Name="size" InitialValue="head.length" />
        <Size>length</Size>
        <Loop>
          <If Condition="offset &gt;= size">
            <Exec>chunk = chunk + 1</Exec>
            <Exec>offset = 0</Exec>
            <Break Condition="chunk &gt;= rest.length" />
            <Exec>size = rest.data[chunk].length</Exec>
          </If>
          <Item Condition="chunk &lt; 0">head.data[offset]</Item>
          <Item Condition="chunk &gt;= 0">rest.data[chunk].data[offset]</Item>
          <Exec>offset = offset + 1</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>
  <Type Name="Set&lt;*&gt;">
    <DisplayString>{{ size={length} }}</DisplayString>
    <Expand>
      <CustomListItems MaxItemsPerView="10000">
        <Variable Name="chunk" InitialValue="-1" />
        <Variable Name="offset" InitialValue="0" />
        <Variable Name="size" InitialValue="head.length" />
        <Size>length</Size>
        <Loop>
          <If Condition="offset &gt;= size">
            <Exec>chunk = chunk + 1</Exec>
            <Exec>offset = 0</Exec>
            <Break Condition="chunk &gt;= rest.length" />
            <Exec>size = rest.data[chunk].length</Exec>
          </If>
          <Item Condition="chunk &lt; 0">head.data[offset]</Item>
          <Item Condition="chunk &gt;= 0">rest.data[chunk].data[offset]</Item>
          <Exec>offset = offset + 1</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>
  <!-- A Maybe of a string stores no `$tag`: `$niche` is -1 for None (PM01). These entries come
       before `Maybe<*>`, which would otherwise match them first. -->
  <Type Name="Maybe&lt;string&gt;">
    <DisplayString Condition="$niche == -1">None</DisplayString>
    <DisplayString>Some({$payload.Some})</DisplayString>
    <Expand>
      <Item Name="[value]" Condition="$niche != -1">$payload.Some</Item>
    </Expand>
  </Type>
  <Type Name="Maybe&lt;utf8string&gt;">
    <DisplayString Condition="$niche == -1">None</DisplayString>
    <DisplayString>Some({$payload.Some})</DisplayString>
    <Expand>
      <Item Name="[value]" Condition="$niche != -1">$payload.Some</Item>
    </Expand>
  </Type>
  <Type Name="Maybe&lt;*&gt;">
    <DisplayString Condition="$tag == 0">None</DisplayString>
    <DisplayString Condition="$tag == 1">Some({$payload.Some})</DisplayString>
    <Expand>
      <Item Name="[value]" Condition="$tag == 1">$payload.Some</Item>
    </Expand>
  </Type>
  <Type Name="Result&lt;*,*&gt;">
    <DisplayString Condition="$tag == 0">Ok({$payload.Ok})</DisplayString>
    <DisplayString Condition="$tag == 1">Error({$payload.Error})</DisplayString>
    <Expand>
      <Item Name="[value]" Condition="$tag == 0">$payload.Ok</Item>
      <Item Name="[error]" Condition="$tag == 1">$payload.Error</Item>
    </Expand>
  </Type>
  <Type Name="Task&lt;*&gt;">
    <DisplayString>&lt;task&gt;</DisplayString>
  </Type>
</AutoVisualizer>
