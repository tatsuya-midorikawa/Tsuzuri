def hash :: i64u -> i64u
fn hash key =
    let value = key * 6364136223846793005 + 1442695040888963407
    value ^ (value >>> 29)

def fold :: i64u -> i64u -> i64u
fn fold total value = total * 31 + value

def word :: i64u -> string
fn word index =
    match index with
    | 0 -> "alpha"
    | 1 -> "beta"
    | 2 -> "gamma"
    | 3 -> "delta"
    | 4 -> "epsilon"
    | 5 -> "zeta"
    | 6 -> "eta"
    | _ -> "theta"

def parse_u64 :: ref string -> i64u
fn parse_u64 text =
    let parsed: Maybe<i64u> = Parse.parse text
    Maybe.get parsed

export def tokenize :: i64 -> i64u -> i64u
fn tokenize size seed =
    assert (size >= 0 && size <= 10000000)
    if size == 0 then 0 else
        let parts = new [string](size, \index -> word (hash (seed + index as i64u) >>> 61))
        let separator = " "
        let text = String.join (ref separator) (ref parts)
        let tokens = String.split (ref separator) (ref text)
        let mut total = tokens.length as i64u
        for token in tokens do total = fold total (token.length as i64u)
        total

export def format_join :: i64 -> i64u -> i64u
fn format_join size seed =
    assert (size >= 0 && size <= 10000000)
    if size == 0 then 0 else
        let parts = new [string](size, \index -> to_string (hash (seed + index as i64u)))
        let separator = ","
        let text = String.join (ref separator) (ref parts)
        let fields = String.split (ref separator) (ref text)
        let mut total = 0i64u
        for field in fields do total = total + parse_u64 (ref field)
        fold (text.length as i64u) total

export def csv_aggregate :: i64 -> i64u -> i64u
fn csv_aggregate size seed =
    assert (size >= 0 && size <= 10000000)
    if size == 0 then 0 else
        let parts = new [string](size, \index ->
            let value = hash (seed + index as i64u)
            to_string (value >>> 60) + "," + to_string ((value >>> 20) & 65535))
        let newline = "\n"
        let comma = ","
        let text = String.join (ref newline) (ref parts)
        let lines = String.split (ref newline) (ref text)
        let mut sums = Vec.of_array (new [i64u](16, \_ -> 0))
        let mut counts = Vec.of_array (new [i64u](16, \_ -> 0))
        for line in lines do
            let fields = String.split (ref comma) (ref line)
            assert (fields.length == 2)
            let category = parse_u64 (ref fields[0]) as i64
            let amount = parse_u64 (ref fields[1])
            let sum = sums[category] + amount
            let count = counts[category] + 1
            sums = Vec.set sums category sum
            counts = Vec.set counts category count
        let mut total = fold 0 (lines.length as i64u)
        for category in 0i64 .. 15i64 do total = fold (fold total sums[category]) counts[category]
        total

export def map_count :: i64 -> i64u -> i64u
fn map_count size seed =
    assert (size >= 0 && size <= 10000000)
    let mut counts: Map<i64u, i64u> = Map.empty()
    let mut keys: Set<i64u> = Set.empty()
    let mut state = seed
    for _index in 0i64 .. size - 1 do
        state = state * 6364136223846793005 + 1442695040888963407
        let key = (state >>> 33) & 1023
        let count = Maybe.default_value 0 (Map.get (ref counts) key)
        counts = Map.insert counts key (count + 1)
        keys = Set.insert keys (key & 255)
    let mut total = Map.length (ref counts) as i64u * 1000003 + Set.length (ref keys) as i64u
    for key in 0i64u .. 1023i64u do total = fold total (Maybe.default_value 0 (Map.get (ref counts) key))
    total

record Item { key: i64u, id: i64u }

def compare_items :: ref Item -> ref Item -> i64
fn compare_items left right =
    if left.key < right.key then -1 else if left.key > right.key then 1 else 0

export def record_sort :: i64 -> i64u -> i64u
fn record_sort size seed =
    assert (size >= 0 && size <= 10000000)
    let items = new [Item](size, \index -> Item { key: hash (seed + index as i64u) >>> 44, id: index as i64u })
    let sorted = Array.sort_by compare_items (ref items)
    Array.fold (\total item -> fold total item.id) 0i64u (ref sorted)

union Expr = Lit of i64u | Add of Expr * Expr | Mul of Expr * Expr | Neg of Expr

def rec build_expr :: i64 -> i64u -> Expr
fn rec build_expr depth key =
    let value = hash key
    if depth == 0 then Lit (value >>> 40) else
        match value & 3 with
        | 0 -> Neg (build_expr (depth - 1) (key * 2 + 1))
        | 1 ->
            let left = build_expr (depth - 1) (key * 2 + 1)
            let right = build_expr (depth - 1) (key * 2 + 2)
            Mul (left, right)
        | _ ->
            let left = build_expr (depth - 1) (key * 2 + 1)
            let right = build_expr (depth - 1) (key * 2 + 2)
            Add (left, right)

def rec simplify :: Expr -> Expr
fn rec simplify expression =
    match expression with
    | Lit value -> Lit value
    | Neg child ->
        match simplify child with
        | Neg nested -> nested
        | Lit value -> Lit (0i64u - value)
        | other -> Neg other
    | Add (left, right) ->
        let first = simplify left
        let second = simplify right
        match (first, second) with
        | (Lit a, Lit b) -> Lit (a + b)
        | (a, b) -> Add (a, b)
    | Mul (left, right) ->
        let first = simplify left
        let second = simplify right
        Mul (first, second)

def rec eval :: ref Expr -> i64u
fn rec eval expression =
    match expression with
    | Lit value -> value
    | Neg child -> 0i64u - eval (ref child)
    | Add (left, right) -> eval (ref left) + eval (ref right)
    | Mul (left, right) -> eval (ref left) * eval (ref right)

export def tree_transform :: i64 -> i64u -> i64u
fn tree_transform size seed =
    assert (size >= 0 && size <= 100000)
    let mut total = 0i64u
    for index in 0i64 .. size - 1 do
        let tree = simplify (build_expr 12 (seed + index as i64u))
        total = fold total (eval (ref tree))
    total

// Payload-free Leaf uses the recursive union's null representation.
union Tree = Leaf | Node of Tree * Tree

def rec build_tree :: i64 -> Tree
fn rec build_tree depth =
    if depth == 0 then Leaf else
        let left = build_tree (depth - 1)
        let right = build_tree (depth - 1)
        Node (left, right)

def rec count_tree :: ref Tree -> i64u
fn rec count_tree tree =
    match tree with
    | Leaf -> 1
    | Node (left, right) -> 1 + count_tree (ref left) + count_tree (ref right)

export def binary_trees :: i64 -> i64u -> i64u
fn binary_trees size seed =
    assert (size >= 0 && size <= 1000000)
    let mut total = 0i64u
    for index in 0i64 .. size - 1 do
        let depth = 4 + ((seed + index as i64u) & 7) as i64
        let tree = build_tree depth
        total = fold total (count_tree (ref tree))
    total

export def closure_pipeline :: i64 -> i64u -> i64u
fn closure_pipeline size seed =
    assert (size >= 0 && size <= 10000000)
    let functions = new [i64u -> i64u](4, \key -> \value -> value * 6364136223846793005 + (seed ^ key as i64u))
    let pipeline = ref functions
    let values = new [i64u](size, \index -> seed + index as i64u)
    let mapped = Array.map (\value -> pipeline[(value & 3) as i64] value) (ref values)
    Array.fold (\total value -> if (value & 1) == 0 then fold total value else total) 0i64u (ref mapped)

export def graph_bfs :: i64 -> i64u -> i64u
fn graph_bfs size seed =
    assert (size >= 0 && size <= 1000000)
    if size == 0 then 0 else
        let edges = new [(i64 * i64)](4 * size, \index ->
            let value = hash (seed + index as i64u)
            (((value >>> 32) % size as i64u) as i64, ((value & 4294967295) % size as i64u) as i64))
        let mut degrees = Vec.of_array (new [i64](size, \_ -> 0))
        for (source, _destination) in edges do
            let degree = degrees[source] + 1
            degrees = Vec.set degrees source degree
        let mut offsets = Vec.push (Vec.with_capacity (size + 1)) 0i64
        let mut running = 0i64
        for index in 0i64 .. size - 1 do
            running = running + degrees[index]
            offsets = Vec.push offsets running
        let starts = ref offsets
        let mut cursor = Vec.of_array (new [i64](size, \index -> starts[index]))
        let mut adjacent = Vec.of_array (new [i64](4 * size, \_ -> 0))
        for (source, destination) in edges do
            let position = cursor[source]
            adjacent = Vec.set adjacent position destination
            cursor = Vec.set cursor source (position + 1)
        let mut distances = Vec.of_array (new [i64](size, \_ -> -1))
        distances = Vec.set distances 0 0
        let mut queue = Vec.push (Vec.with_capacity size) 0i64
        let mut head = 0i64
        while head < Vec.length (ref queue) do
            let source = queue[head]
            head = head + 1
            let distance = distances[source] + 1
            for position in offsets[source] .. offsets[source + 1] - 1 do
                let destination = adjacent[position]
                if distances[destination] == -1 then
                    distances = Vec.set distances destination distance
                    queue = Vec.push queue destination
        let mut total = 0i64u
        for index in 0i64 .. size - 1 do total = fold total (distances[index] as i64u)
        total

def matrix_value :: i64 -> i64 -> f64
fn matrix_value row column =
    let sum = row + column
    1.0 / (sum * (sum + 1) / 2 + row + 1) as f64

def multiply :: bool -> ref [f64] -> [f64]
fn multiply transpose values =
    new [f64](values.length, \row ->
        let mut total = 0.0
        for column in 0i64 .. values.length - 1 do
            let coefficient = if transpose then matrix_value column row else matrix_value row column
            total = total + coefficient * values[column]
        total)

def multiply_ata :: ref [f64] -> [f64]
fn multiply_ata values =
    let intermediate = multiply false values
    multiply true (ref intermediate)

export def spectral_norm :: i64 -> i64u -> i64u
fn spectral_norm size seed =
    assert (size >= 0 && size <= 5000)
    if size == 0 then 0 else
        let mut u = new [f64](size, \_ -> 1.0)
        let mut v = new [f64](size, \_ -> 0.0)
        for _iteration in 1i64 .. 10i64 do
            v = multiply_ata (ref u)
            u = multiply_ata (ref v)
        let mut uv = 0.0
        let mut vv = 0.0
        for index in 0i64 .. size - 1 do
            uv = uv + u[index] * v[index]
            vv = vv + v[index] * v[index]
        (Math.sqrt (uv / vv) * 1e15) as i64u ^ seed
