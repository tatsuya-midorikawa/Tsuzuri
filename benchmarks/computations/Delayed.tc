def Return :: own i64 -> i64
fn Return value = value

def Yield :: own i64 -> i64
fn Yield value = value

def Delay :: own (unit -> i64) -> (unit -> i64)
fn Delay body = body

def Run :: own (unit -> i64) -> i64
fn Run body = body ()

def Combine :: own i64 -> own (unit -> i64) -> i64
fn Combine first rest = first + rest ()
