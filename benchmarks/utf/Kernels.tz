def pattern :: i64 -> string
fn pattern kind =
    if kind == 0 then "Az09-_ \n"
    elif kind == 1 then "A\u00E90\u00FC-\u00F1 \n"
    elif kind == 2 then "\u4E2D\u6587\u5B57\u65E5\u672C\u8A9E\u6F22\u5B57"
    elif kind == 3 then "\uD83D\uDE00\uD83D\uDE01\uD83D\uDE02\uD83D\uDE03"
    else "A\0\u03A9\uD83D\uDE00\u4E2Dz\n"

def utf_text :: i64 -> i64 -> string
fn utf_text kind size =
    let mut text = pattern kind
    while text.length < size do
        let copy = clone_string ref text
        text = copy + text
    text

export def utf_to_utf8 :: i64 -> i64 -> i64 -> i64
fn utf_to_utf8 kind size repeat =
    let text = utf_text kind size
    let mut total = 0
    for _ in 1 .. repeat do
        let bytes = Utf8String.from_string ref text
        total = total + bytes.length
    total

export def utf_from_utf8 :: i64 -> i64 -> i64 -> i64
fn utf_from_utf8 kind size repeat =
    let text = utf_text kind size
    let bytes = Utf8String.from_string ref text
    let mut total = 0
    for _ in 1 .. repeat do
        let decoded = String.from_utf8 ref bytes
        total = total + decoded.length
    total

export def utf_equal :: i64 -> i64 -> i64 -> i64
fn utf_equal kind size repeat =
    let text = utf_text kind size
    let right = clone_string ref text
    let mut total = 0
    for _ in 1 .. repeat do
        if text == right then total = total + 1
    total

export def utf_compare :: i64 -> i64 -> i64 -> i64
fn utf_compare kind size repeat =
    let text = utf_text kind size
    let right = Maybe.get (String.slice 0 (text.length - 1) (ref text)) + "\uFFFF"
    let mut total = 0
    for _ in 1 .. repeat do
        // Keep the repeated comparison observable across iterations under -O3.
        Bench.consume (ref text, ref right)
        if text < right then total = total + 1
    total

export def utf_is_well_formed :: i64 -> i64 -> i64 -> i64
fn utf_is_well_formed kind size repeat =
    let text = utf_text kind size + "\uD800"
    let mut total = 0
    for _ in 1 .. repeat do
        if not (String.is_well_formed ref text) then total = total + 1
    total

export def utf_to_well_formed :: i64 -> i64 -> i64 -> i64
fn utf_to_well_formed kind size repeat =
    let text = utf_text kind size + "\uD800"
    let mut total = 0
    for _ in 1 .. repeat do
        let repaired = String.to_well_formed ref text
        total = total + repaired.length
    total
