fn rec mix_loop(remaining: i64, state: i64) -> i64 {
    if remaining <= 0 {
        state
    } else {
        let mixed = (state ^ (state >>> 13)) * 6364136223846793005 + 1442695040888963407;
        mix_loop(remaining - 1, mixed)
    }
}

export fn mix(iterations: i64, seed: i64) -> i64 {
    let _ = assert(iterations >= 0);
    mix_loop(iterations, seed)
}
