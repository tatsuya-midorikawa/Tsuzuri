fn rec mix_loop(remaining: own i64, state: own i64) -> i64 {
    if remaining <= 0 {
        state
    } else {
        let mixed = (state ^ (Bits.ushr state 13)) * 6364136223846793005 + 1442695040888963407;
        mix_loop(remaining - 1, mixed)
    }
}

export fn mix(iterations: own i64, seed: own i64) -> i64 {
    let _ = assert(iterations >= 0);
    mix_loop(iterations, seed)
}
