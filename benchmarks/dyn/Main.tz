// The same shapes summed through dyn values, a union match, and monomorphized generic code.
// Element i is a square when i % 3 == 0, a rectangle when i % 3 == 1, and a triangle otherwise.
record Square { side: i64 }
record Rect { width: i64, height: i64 }
record Tri { base: i64, height: i64 }

instance Shapes.Shape<Square> {
    fn area square = square.side * square.side
}

instance Shapes.Shape<Rect> {
    fn area rect = rect.width * rect.height
}

instance Shapes.Shape<Tri> {
    fn area tri = tri.base * tri.height / 2
}

union Figure = FigSquare of i64 | FigRect of i64 * i64 | FigTri of i64 * i64

def square :: i64 -> Square
fn square i = Square { side: i % 7 }

def rect :: i64 -> Rect
fn rect i = Rect { width: i % 5, height: i % 11 }

def tri :: i64 -> Tri
fn tri i = Tri { base: i % 13, height: i % 3 }

def make_dyn :: i64 -> dyn Shapes.Shape
fn make_dyn i =
    match i % 3 with
    | 0 -> Dyn.of (square i)
    | 1 -> Dyn.of (rect i)
    | _ -> Dyn.of (tri i)

def make_figure :: i64 -> Figure
fn make_figure i =
    match i % 3 with
    | 0 -> FigSquare (i % 7)
    | 1 -> FigRect (i % 5, i % 11)
    | _ -> FigTri (i % 13, i % 3)

def figure_area :: Figure -> i64
fn figure_area figure =
    match figure with
    | FigSquare side -> side * side
    | FigRect (width, height) -> width * height
    | FigTri (base, height) -> base * height / 2

def sum_areas :: Shapes.Shape<'a> => ref ['a] -> i64
fn sum_areas items =
    let mut total = 0i64
    for index in 0i64 .. (items.length - 1) do total = total + Shapes.Shape.area (ref items[index])
    total

export def dyn_total :: i64 -> i64 -> i64
fn dyn_total count rounds =
    let items = Array.init count make_dyn
    let mut total = 0i64
    for _round in 1i64 .. rounds do
        for index in 0i64 .. (count - 1) do total = total + Shapes.Shape.area (ref items[index])
    total

export def union_total :: i64 -> i64 -> i64
fn union_total count rounds =
    let items = Array.init count make_figure
    let mut total = 0i64
    for _round in 1i64 .. rounds do
        for index in 0i64 .. (count - 1) do total = total + figure_area items[index]
    total

export def generic_total :: i64 -> i64 -> i64
fn generic_total count rounds =
    let squares = Array.init ((count + 2) / 3) (\j -> square (3 * j))
    let rects = Array.init ((count + 1) / 3) (\j -> rect (3 * j + 1))
    let tris = Array.init (count / 3) (\j -> tri (3 * j + 2))
    let mut total = 0i64
    for _round in 1i64 .. rounds do
        total = total + sum_areas (ref squares) + sum_areas (ref rects) + sum_areas (ref tris)
    total
