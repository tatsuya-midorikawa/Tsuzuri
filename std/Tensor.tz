/// ```
def mul :: (Mul<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<'a>, Error>
fn mul left right = map2 (\x y -> x * y) left right

private def rec mul_or_trap :: (Mul<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Tensor<'a>
fn rec mul_or_trap left right = map2_or_trap (\x y -> x * y) left right

/// Element-wise quotient (`left / right`) with broadcasting.
///
