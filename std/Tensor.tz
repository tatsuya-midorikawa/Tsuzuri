def prod_with :: Numeric<'a> => own AxisOptions -> ref View<'a> -> Tensor<'a>
fn prod_with opts view = reduce_axis_core true slice_prod opts.axis opts.keepdims view

/// Product of elements over `opts.axes`.
///
/// ```tsuzuri run=[24]
/// let t = Tensor.of_array [1, 2, 2] [1, 2, 3, 4]
