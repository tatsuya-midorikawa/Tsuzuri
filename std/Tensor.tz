/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [1.0]
/// Tensor.to_array (Tensor.log (Tensor.view t))
/// ```
def log :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn log view = map Math.log view

/// Writes `Math.log` into `target` with zero heap allocations.
///
/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [1.0]
/// let mut buf = [9.0]
/// let mut dst = Tensor.borrow_mut [1] (ref mut buf)
/// let _ = Tensor.log_into (Tensor.view t) (ref mut dst)
/// $"{buf}"
/// ```
def log_into { s r } :: (Elementary<'a>, Copy<'a>) => ref View<'a> { s } -> ref mut Mut<'a> { r } -> Result<unit, Error>
fn log_into src target = map_into Math.log src target

/// Element-wise base-2 logarithm `Math.log2`.
///
/// ```tsuzuri run=[3]
/// let t = Tensor.of_array [1] [8.0]
/// Tensor.to_array (Tensor.log2 (Tensor.view t))
/// ```
def log2 :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn log2 view = map Math.log2 view

/// Element-wise base-10 logarithm `Math.log10`.
///
/// ```tsuzuri run=[2]
/// let t = Tensor.of_array [1] [100.0]
/// Tensor.to_array (Tensor.log10 (Tensor.view t))
/// ```
def log10 :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn log10 view = map Math.log10 view

/// Element-wise `Math.log1p`.
///
/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [0.0]
/// Tensor.to_array (Tensor.log1p (Tensor.view t))
/// ```
def log1p :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn log1p view = map Math.log1p view

/// Element-wise normalized sinc `sin(pi * x) / (pi * x)` (`Math.sinc`).
///
/// ```tsuzuri run=[1,%200]
/// let t = Tensor.of_array [2] [0.0, 1.0]
/// Tensor.to_array (Tensor.sinc (Tensor.view t))
/// ```
def sinc :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn sinc view = map Math.sinc view

/// Converts radians to degrees element-wise (`Math.degrees`).
///
/// ```tsuzuri run=[180]
/// let pi: f64 = Math.pi()
/// let t = Tensor.of_array [1] [pi]
/// Tensor.to_array (Tensor.degrees (Tensor.view t))
/// ```
def degrees :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn degrees view = map Math.degrees view

/// Converts degrees to radians element-wise (`Math.radians`).
///
/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [0.0]
/// Tensor.to_array (Tensor.radians (Tensor.view t))
/// ```
def radians :: (Elementary<'a>, Copy<'a>) => ref View<'a> -> Tensor<'a>
fn radians view = map Math.radians view

/// Extracts the real part of every complex element (`Complex.real`).
///
/// ```tsuzuri run=[3,%205]
/// let t = Tensor.of_array [2] [Complex.of 3.0 4.0, Complex.of 5.0 (-1.0)]
/// Tensor.to_array (Tensor.real (Tensor.view t))
/// ```
def real :: Copy<'a> => ref View<Complex<'a>> -> Tensor<'a>
fn real view = map (\z -> Complex.real (ref z)) view

/// Extracts the imaginary part of every complex element (`Complex.imag`).
///
/// ```tsuzuri run=[4,%20-1]
/// let t = Tensor.of_array [2] [Complex.of 3.0 4.0, Complex.of 5.0 (-1.0)]
/// Tensor.to_array (Tensor.imag (Tensor.view t))
/// ```
def imag :: Copy<'a> => ref View<Complex<'a>> -> Tensor<'a>
fn imag view = map (\z -> Complex.imag (ref z)) view

/// Computes the complex conjugate of every element (`Complex.conj`).
///
/// ```tsuzuri run=[-4]
/// let t = Tensor.of_array [1] [Complex.of 3.0 4.0]
/// let c = Tensor.conj (Tensor.view t)
/// Tensor.to_array (Tensor.imag (Tensor.view c))
/// ```
def conj :: (Float<'a>, Neg<'a>, Copy<'a>) => ref View<Complex<'a>> -> Tensor<Complex<'a>>
fn conj view = map (\z -> Complex.conj (ref z)) view

/// Computes the phase angle in radians of every complex element (`Complex.arg`).
///
/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [Complex.of 2.0 0.0]
/// Tensor.to_array (Tensor.angle (Tensor.view t))
/// ```
def angle :: (Elementary<'a>, Copy<'a>) => ref View<Complex<'a>> -> Tensor<'a>
fn angle view = map (\z -> Complex.arg (ref z)) view

/// Tests each element for `NaN` (`Math.is_nan`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [0.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_nan (Tensor.view t))
/// ```
def is_nan :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_nan view = map Math.is_nan view

/// Tests each element for `±Inf` (`Math.is_infinite`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_infinite (Tensor.view t))
/// ```
def is_infinite :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_infinite view = map Math.is_infinite view

/// Tests whether each element is finite (`Math.is_finite`).
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [1.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_finite (Tensor.view t))
/// ```
def is_finite :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_finite view = map Math.is_finite view

/// Tests the IEEE 754 sign bit of each element (`Math.signbit`, `true` on `-0.0`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [-0.0, 0.0]
/// Tensor.to_array (Tensor.signbit (Tensor.view t))
/// ```
def signbit :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn signbit view = map Math.signbit view

/// Replaces `NaN` with `nan_val`, `+Inf` with `posinf_val`, and `-Inf` with `neginf_val`.
///
/// ```tsuzuri run=[0,%2099,%20-99,%203]
/// let t = Tensor.of_array [4] [0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 3.0]
/// Tensor.to_array (Tensor.nan_to_num 0.0 99.0 (-99.0) (Tensor.view t))
/// ```
def nan_to_num :: (Float<'a>, Copy<'a>) => own 'a -> own 'a -> own 'a -> ref View<'a> -> Tensor<'a>
fn nan_to_num nan_val posinf_val neginf_val view =
    map (\x ->
        if Math.is_nan x then nan_val
        elif Math.is_infinite x then (if Math.signbit x then neginf_val else posinf_val)
        else x) view

// Element-wise comparisons & approximate equality (§3)
/// Element-wise equality (`left == right`) with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [2] [1, 3]
/// match Tensor.elem_eq (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_eq :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_eq left right = map2 (\x y -> x == y) left right

/// Element-wise inequality (`left != right`) with broadcasting.
///
/// ```tsuzuri run=[false,%20true]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [2] [1, 3]
/// match Tensor.elem_ne (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_ne :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_ne left right = map2 (\x y -> x != y) left right

/// Element-wise `left < right` with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_lt (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_lt :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_lt left right = map2 (\x y -> x < y) left right

/// Element-wise `left <= right` with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_le (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_le :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_le left right = map2 (\x y -> x <= y) left right

/// Element-wise `left > right` with broadcasting.
///
/// ```tsuzuri run=[false,%20true]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_gt (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_gt :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_gt left right = map2 (\x y -> x > y) left right

/// Element-wise `left >= right` with broadcasting.
///
/// ```tsuzuri run=[true,%20true]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_ge (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_ge :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_ge left right = map2 (\x y -> x >= y) left right

/// Mask of elements where `x == threshold`.
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [1, 2]
/// Tensor.to_array (Tensor.eq_scalar 2 (Tensor.view t))
/// ```
def eq_scalar :: (Eq<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn eq_scalar threshold view = map (\x -> x == threshold) view

/// Mask of elements where `x != threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1, 2]
/// Tensor.to_array (Tensor.ne_scalar 2 (Tensor.view t))
/// ```
def ne_scalar :: (Eq<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn ne_scalar threshold view = map (\x -> x != threshold) view

/// Mask of elements where `x < threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1, 3]
/// Tensor.to_array (Tensor.lt_scalar 2 (Tensor.view t))
/// ```
def lt_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn lt_scalar threshold view = map (\x -> x < threshold) view

/// Mask of elements where `x <= threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [2, 3]
/// Tensor.to_array (Tensor.le_scalar 2 (Tensor.view t))
/// ```
def le_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn le_scalar threshold view = map (\x -> x <= threshold) view

/// Mask of elements where `x > threshold` (so `t[Tensor.gt_scalar 0 (Tensor.view t)]` keeps positives).
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [0, 3]
/// Tensor.to_array (Tensor.gt_scalar 0 (Tensor.view t))
/// ```
def gt_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn gt_scalar threshold view = map (\x -> x > threshold) view

/// Mask of elements where `x >= threshold`.
///
/// ```tsuzuri run=[true,%20true]
/// let t = Tensor.of_array [2] [0, 3]
/// Tensor.to_array (Tensor.ge_scalar 0 (Tensor.view t))
/// ```
def ge_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn ge_scalar threshold view = map (\x -> x >= threshold) view

private def close_elem :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> own 'a -> own 'a -> bool
fn close_elem rtol atol equal_nan x y =
    if Math.is_nan x || Math.is_nan y then
        equal_nan && Math.is_nan x && Math.is_nan y
    elif Math.is_infinite x || Math.is_infinite y then
        x == y
    else
        Math.abs (x - y) <= atol + rtol * Math.abs y

/// Element-wise tolerance comparison `|left - right| <= atol + rtol * |right|` with broadcasting
/// (`equal_nan` controls whether two `NaN`s compare equal).
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1.0, 1.1]
/// let b = Tensor.of_array [2] [1.0 + 1e-9, 1.0]
/// match Tensor.isclose 1e-5 1e-8 false (Tensor.view a) (Tensor.view b) with
/// | Result.Ok m -> Tensor.to_array m
/// | Result.Error _ -> []
/// ```
def isclose :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn isclose rtol atol equal_nan left right =
    map2 (\x y -> close_elem rtol atol equal_nan x y) left right

/// Returns `true` when `left` and `right` broadcast and every pair satisfies `isclose`.
///
/// ```tsuzuri run=true
/// let a = Tensor.of_array [2] [1.0, 2.0]
/// let b = Tensor.of_array [2] [1.0 + 1e-9, 2.0 - 1e-9]
/// Tensor.allclose 1e-5 1e-8 false (Tensor.view a) (Tensor.view b)
/// ```
def allclose :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> ref View<'a> -> ref View<'a> -> bool
fn allclose rtol atol equal_nan left right =
    match isclose rtol atol equal_nan left right with
    | Result.Error _ -> false
    | Result.Ok m -> Array.forall (\b -> b) (ref m.data)

private def rec equal_axis :: Eq<'a> => ref View<'a> -> ref View<'a> -> own i64 -> own i64 -> own i64 -> bool
fn rec equal_axis left right axis l_off r_off =
    let rank = left.shape.length
    let dim = left.shape[axis]
    let ls = left.strides[axis]
    let rs = right.strides[axis]
    if axis == rank - 1 then
        let mut ok = true
        for step in 0i64 ..< dim do
            if ok && not (Eq.eq (ref left.data[l_off + step * ls]) (ref right.data[r_off + step * rs])) then ok = false
        ok
    else
        let mut ok = true
        for step in 0i64 ..< dim do
            if ok && not (equal_axis left right (axis + 1) (l_off + step * ls) (r_off + step * rs)) then ok = false
        ok

/// Returns `true` when `left` and `right` have identical shapes and equal elements at all positions.
///
/// ```tsuzuri run=true%20false
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [1, 2] [1, 2]
/// $"{Tensor.array_equal (Tensor.view a) (Tensor.view a)} {Tensor.array_equal (Tensor.view a) (Tensor.view b)}"
/// ```
def array_equal :: Eq<'a> => ref View<'a> -> ref View<'a> -> bool
fn array_equal left right =
    if not (same_shape (ref left.shape) (ref right.shape)) then false
    else
        let total = volume (ref left.shape)
        if total == 0 then true
        elif left.shape.length == 0 then Eq.eq (ref left.data[left.offset]) (ref right.data[right.offset])
        else equal_axis left right 0 left.offset right.offset

/// Returns `true` when `left` and `right` are broadcast-compatible and equal at all broadcast positions.
///
/// ```tsuzuri run=true
/// let a = Tensor.of_array [2] [5, 5]
/// let b = Tensor.of_array [1] [5]
/// Tensor.array_equiv (Tensor.view a) (Tensor.view b)
/// ```
def array_equiv :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> bool
fn array_equiv left right =
    match elem_eq left right with
    | Result.Error _ -> false
    | Result.Ok m -> Array.forall (\b -> b) (ref m.data)

// Outer product & axis accumulation (§1 & §4)
/// Computes the outer-table tensor of shape `left.shape ++ right.shape` where each entry is `f x y`.
///
/// ```tsuzuri run=[2,%203]%20[10,%2020,%2030,%2020,%2040,%2060]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [3] [10, 20, 30]
/// let out = Tensor.outer_with (\x y -> x * y) (Tensor.view a) (Tensor.view b)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
/// ```
def outer_with :: (Copy<'a>, Copy<'b>) => own ('a -> 'b -> 'c) -> ref View<'a> -> ref View<'b> -> Tensor<'c>
fn outer_with f left right =
    let lr = left.shape.length
    let rr = right.shape.length
    assert (lr + rr <= 64)
    let out_shape = new [i64](lr + rr, \d -> if d < lr then left.shape[d] else right.shape[d - lr])
    let total = volume (ref out_shape)
    if total == 0 then Tensor { shape: out_shape, data: [] }
    else
        let lp = to_tensor left
        let rp = to_tensor right
        let r_len = rp.data.length
        let l_data = ref lp.data
        let r_data = ref rp.data
        Tensor { shape: out_shape, data: new ['c](total, \idx -> f l_data[idx / r_len] r_data[idx % r_len]) }

/// Applies binary `f` cumulatively along `axis` (ufunc `accumulate`), preserving the input shape.
///
/// ```tsuzuri run=[1,%203,%206,%204,%209,%2015]
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// Tensor.to_array (Tensor.accumulate (\acc x -> acc + x) 1 (Tensor.view t))
/// ```
def accumulate :: Copy<'a> => own ('a -> 'a -> 'a) -> own i64 -> ref View<'a> -> Tensor<'a>
fn accumulate f axis view =
    let rank = view.shape.length
    let norm = normalize_axis axis rank
    let out_shape = Array.copy (ref view.shape)
    let total = volume (ref out_shape)
    if total == 0 then Tensor { shape: out_shape, data: [] }
    else
        let packed = to_tensor view
        let mut out = Array.copy (ref packed.data)
        let dim = out_shape[norm]
        if dim > 1 then
            let mut inner_step = 1
            for d in (norm + 1) ..< rank do inner_step = inner_step * out_shape[d]
            let outer_span = inner_step * dim
            let outer_count = total / outer_span
            for o in 0i64 ..< outer_count do
                let base = o * outer_span
                for k in 0i64 ..< inner_step do
                    let mut acc = out[base + k]
                    for step in 1i64 ..< dim do
                        let slot = base + step * inner_step + k
                        acc = f acc out[slot]
                        Array.write slot acc (ref mut out)
        Tensor { shape: out_shape, data: out }

// Same-type `Tensor<'a>` arithmetic operator instances (§4, NC03 D1-A borrowed operands)
instance (Add<'a>, Copy<'a>) => Add<Tensor<'a>> {
    fn rec add left right = add_or_trap (ref (view left)) (ref (view right))
}

instance (Sub<'a>, Copy<'a>) => Sub<Tensor<'a>> {
    fn rec sub left right = sub_or_trap (ref (view left)) (ref (view right))
}

instance (Mul<'a>, Copy<'a>) => Mul<Tensor<'a>> {
    fn rec mul left right = mul_or_trap (ref (view left)) (ref (view right))
}

instance (Div<'a>, Copy<'a>) => Div<Tensor<'a>> {
    fn rec div left right = div_or_trap (ref (view left)) (ref (view right))
}

instance (Rem<'a>, Copy<'a>) => Rem<Tensor<'a>> {
    fn rec rem left right = rem_or_trap (ref (view left)) (ref (view right))
}

instance (Pow<'a>, Copy<'a>) => Pow<Tensor<'a>> {
    fn rec pow left right = pow_or_trap (ref (view left)) (ref (view right))
}

instance (Neg<'a>, Copy<'a>) => Neg<Tensor<'a>> {
    fn rec neg value = Tensor.neg (ref (view value))
}


