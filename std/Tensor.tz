/// An owned tensor: `shape` lists the extent of every axis and `data` holds the elements in
/// row-major (C) order. Invariants: at most 64 axes, no negative extent, the product of the
/// extents is data.length. The product of the non-zero extents must not overflow; a shape with a
/// 0 extent has no elements. A tensor with no axes holds one element.
record Tensor<'a> { shape: [i64], data: ['a] }

/// A borrowed strided window onto a buffer: element (i0, i1, ...) is
/// data[offset + i0 * strides[0] + i1 * strides[1] + ...]. Strides may be negative (reversed axis)
/// or 0 (broadcast axis), and every element lies inside `data`; every constructor checks this
/// without overflow and every operation preserves it.
record View<'a> { r } { data: ref { r } ['a], offset: i64, shape: [i64], strides: [i64] }

/// A borrowed writable N-dimensional window onto an exclusive buffer. Its layout is always
/// injective (no two distinct coordinates alias the same slot in `data`), and every element lies
/// inside `data`. Strides may be negative (reversed axes), never 0 on an axis with extent > 1.
record Mut<'a> { r } { data: ref mut { r } ['a..], offset: i64, shape: [i64], strides: [i64] }

/// Errors returned by fallible tensor shape and broadcasting operations.
union Error =
    | ShapeMismatch of ([i64] * [i64])
    | IncompatibleBroadcast of ([i64] * [i64])
    | InvalidAxis of (i64 * i64)
    | InvalidShape of [i64]
    | NonContiguous
    deriving (Eq)

instance Display<Error> {
    fn display err =
        match err with
        | Error.ShapeMismatch (left, right) -> $"shape mismatch: {left} vs {right}"
        | Error.IncompatibleBroadcast (left, right) -> $"cannot broadcast shapes {left} and {right}"
        | Error.InvalidAxis (axis, rank) -> $"axis {axis} is out of bounds for rank {rank}"
        | Error.InvalidShape shape -> $"invalid tensor shape: {shape}"
        | Error.NonContiguous -> "tensor view is not contiguous"
}

// The number of elements of a shape. Traps on more than 64 axes, a negative extent, or when the
// product of the non-zero extents overflows.
private def volume :: ref [i64] -> i64
fn volume shape =
    assert (shape.length <= 64)
    let mut empty = false
    let mut count = 1
    for axis in 0i64 ..= (shape.length - 1) do
        assert (shape[axis] >= 0)
        if shape[axis] == 0 then empty = true
        else
            assert (count <= 9223372036854775807 / shape[axis])
            count = count * shape[axis]
    if empty then 0 else count

private def try_volume :: ref [i64] -> Maybe<i64>
fn try_volume shape =
    if shape.length > 64 then Maybe.None
    else
        let mut ok = true
        let mut empty = false
        let mut count = 1
        for axis in 0i64 ..= (shape.length - 1) do
            if shape[axis] < 0 then ok = false
            elif shape[axis] == 0 then empty = true
            elif ok then
                if count > 9223372036854775807 / shape[axis] then ok = false
                else count = count * shape[axis]
        if ok then Maybe.Some (if empty then 0 else count)
        else Maybe.None

private def check_strided_bounds :: own i64 -> ref [i64] -> ref [i64] -> own i64 -> unit
fn check_strided_bounds offset shape strides data_len =
    assert (shape.length == strides.length && data_len >= 0)
    let total = volume shape
    if total == 0 then
        assert (offset >= 0)
    else
        assert (offset >= 0 && offset < data_len)
        let mut min_idx = offset
        let mut max_idx = offset
        for axis in 0i64 ..= (shape.length - 1) do
            let span = shape[axis] - 1
            let delta =
                match Int.checked_mul span strides[axis] with
                | Maybe.Some d -> d
                | Maybe.None ->
                    assert false
                    0
            if delta < 0 then
                min_idx =
                    match Int.checked_add min_idx delta with
                    | Maybe.Some v -> v
                    | Maybe.None ->
                        assert false
                        0
            else
                max_idx =
                    match Int.checked_add max_idx delta with
                    | Maybe.Some v -> v
                    | Maybe.None ->
                        assert false
                        0
        assert (min_idx >= 0 && max_idx < data_len)

private def stride_of :: ref [i64] -> own i64 -> i64
fn stride_of shape axis =
    let mut stride = 1
    for later in (axis + 1) ..= (shape.length - 1) do stride = stride * shape[later]
    stride

private def dense_strides :: ref [i64] -> [i64]
fn dense_strides shape = new [i64](shape.length, \axis -> stride_of shape axis)

/// Computes column-major (Fortran-order) strides for `shape`.
///
/// ```tsuzuri run=[1,%202,%206]
/// Tensor.fortran_strides [2, 3, 4]
/// ```
def fortran_strides :: ref [i64] -> [i64]
fn fortran_strides shape =
    let _ = volume shape
    let mut out = new [i64](shape.length, \_ -> 1)
    let mut stride = 1
    for axis in 0i64 ..= (shape.length - 1) do
        Array.write axis stride (ref mut out)
        stride = stride * shape[axis]
    out

/// Takes a row-major array without copying; traps unless its length is the product of the shape.
///
/// ```tsuzuri run=6
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// let v = Tensor.view t
/// deref (Tensor.at [1, 2] v)
/// ```
def of_array :: own [i64] -> own ['a] -> Tensor<'a>
fn of_array shape values =
    assert (values.length == volume (ref shape))
    Tensor { shape: shape, data: values }

/// Calls `initializer index` once per element in row-major order, with the flat row-major index.
///
/// ```tsuzuri run=[0,%2010,%2020,%2030]
/// Tensor.to_array (Tensor.init [2, 2] (\i -> i * 10))
/// ```
def init :: own [i64] -> own (i64 -> 'a) -> Tensor<'a>
fn init shape initializer =
    let count = volume (ref shape)
    Tensor { shape: shape, data: new ['a](count, initializer) }

/// Turns a matrix into a rank 2 tensor without copying.
///
/// ```tsuzuri run=[2,%202]%20[1,%202,%203,%204]
/// let t = Tensor.of_matrix (Matrix.of_array 2 2 [1, 2, 3, 4])
/// let v = Tensor.view t
/// $"{Tensor.shape v} {Tensor.as_array t}"
/// ```
def of_matrix :: own Matrix<'a> -> Tensor<'a>
fn of_matrix matrix =
    let shape = [Matrix.rows (ref matrix), Matrix.cols (ref matrix)]
    Tensor { shape: shape, data: Matrix.to_array matrix }

/// Turns a rank 2 tensor into a matrix without copying; traps unless the rank is 2.
///
/// ```tsuzuri run=2x3%203
/// let m = Tensor.to_matrix (Tensor.init [2, 3] (\i -> i))
/// $"{Matrix.rows m}x{Matrix.cols m} {deref (Matrix.at 1 0 m)}"
/// ```
def to_matrix :: own Tensor<'a> -> Matrix<'a>
fn to_matrix tensor =
    assert (tensor.shape.length == 2)
    Matrix.of_array tensor.shape[0] tensor.shape[1] tensor.data

/// Borrows all elements in row-major order.
///
/// ```tsuzuri run=[1,%202,%203,%204]
/// let t = Tensor.init [2, 2] (\i -> i + 1)
/// $"{Tensor.as_array t}"
/// ```
def as_array :: ref Tensor<'a> -> ref ['a]
fn as_array tensor = ref tensor.data

/// Consumes the tensor and returns its row-major buffer without copying.
///
/// ```tsuzuri run=[0,%201,%204,%209]
/// Tensor.to_array (Tensor.init [2, 2] (\i -> i * i))
/// ```
def to_array :: own Tensor<'a> -> ['a]
fn to_array tensor = tensor.data

/// Gives the elements a new shape without copying; traps unless the product of the shape is unchanged.
///
/// ```tsuzuri run=[3,%202]%204
/// let t = Tensor.reshape [3, 2] (Tensor.init [2, 3] (\i -> i))
/// let v = Tensor.view t
/// $"{Tensor.shape v} {deref (Tensor.at [2, 0] v)}"
/// ```
def reshape :: own [i64] -> own Tensor<'a> -> Tensor<'a>
fn reshape shape tensor =
    assert (volume (ref shape) == tensor.data.length)
    Tensor { shape: shape, data: tensor.data }

/// Borrows a tensor as a window.
///
/// ```tsuzuri run=[2,%203]%20[3,%201]
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// $"{Tensor.shape v} {Tensor.strides v}"
/// ```
def view { r } :: ref { r } Tensor<'a> -> View<'a> { r }
fn view tensor = View { data: ref tensor.data, offset: 0, shape: Array.copy (ref tensor.shape), strides: dense_strides (ref tensor.shape) }

/// Borrows a row-major array as a window of the given shape; traps unless its length is the product of the shape.
///
/// ```tsuzuri run=6
/// let data = [1, 2, 3, 4, 5, 6]
/// let v = Tensor.borrow [3, 2] data
/// deref (Tensor.at [2, 1] v)
/// ```
def borrow { r } :: own [i64] -> ref { r } ['a] -> View<'a> { r }
fn borrow shape data =
    assert (data.length == volume (ref shape))
    let strides = dense_strides (ref shape)
    View { data: data, offset: 0, shape: shape, strides: strides }

/// The number of axes.
///
/// ```tsuzuri run=3
/// let t = Tensor.init [2, 3, 4] (\i -> i)
/// Tensor.rank (Tensor.view t)
/// ```
def rank :: ref View<'a> -> i64
fn rank view = view.shape.length

/// The extent of every axis.
///
/// ```tsuzuri run=[2,%203,%204]
/// let t = Tensor.init [2, 3, 4] (\i -> i)
/// let v = Tensor.view t
/// $"{Tensor.shape v}"
/// ```
def shape :: ref View<'a> -> ref [i64]
fn shape view = ref view.shape

/// The number of elements.
///
/// ```tsuzuri run=24
/// let t = Tensor.init [2, 3, 4] (\i -> i)
/// Tensor.count (Tensor.view t)
/// ```
def count :: ref View<'a> -> i64
fn count view = volume (ref view.shape)

/// The distance in `data` between two consecutive positions of every axis.
///
/// ```tsuzuri run=[12,%204,%201]
/// let t = Tensor.init [2, 3, 4] (\i -> i)
/// let v = Tensor.view t
/// $"{Tensor.strides v}"
/// ```
def strides :: ref View<'a> -> ref [i64]
fn strides view = ref view.strides

/// The index of the first element in `data`.
///
/// ```tsuzuri run=2
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// Tensor.offset (Tensor.narrow 1 2 1 v)
/// ```
def offset :: ref View<'a> -> i64
fn offset view = view.offset

/// The whole backing slice, including elements outside the window.
///
/// ```tsuzuri run=3%20[0,%201,%202,%203,%204,%205]
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let row = Tensor.index_axis 0 1 v
/// $"{Tensor.count row} {Tensor.data row}"
/// ```
def data { r } :: ref View<'a> { r } -> ref { r } ['a]
fn data view = view.data

private def offset_of :: ref View<'a> -> ref [i64] -> i64
fn offset_of view index =
    assert (index.length == view.shape.length)
    let mut offset = view.offset
    for axis in 0i64 ..= (index.length - 1) do
        assert (index[axis] >= 0 && index[axis] < view.shape[axis])
        offset = offset + index[axis] * view.strides[axis]
    offset

/// Borrows one element; traps unless the index has one entry per axis, each inside its extent.
///
/// ```tsuzuri run=50
/// let t = Tensor.init [2, 3] (\i -> i * 10)
/// let v = Tensor.view t
/// deref (Tensor.at [1, 2] v)
/// ```
def at { r } :: own [i64] -> ref View<'a> { r } -> ref { r } 'a
fn at index view = ref view.data[offset_of view (ref index)]

/// Copies one element, or `None` unless the index has one entry per axis, each inside its extent.
///
/// ```tsuzuri run=4%20-1
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let inside = Maybe.default_value (-1) (Tensor.get [1, 1] v)
/// let outside = Maybe.default_value (-1) (Tensor.get [2, 0] v)
/// $"{inside} {outside}"
/// ```
def get :: Copy<'a> => own [i64] -> ref View<'a> -> Maybe<'a>
fn get index view =
    let mut inside = index.length == view.shape.length
    if inside then
        for axis in 0i64 ..= (index.length - 1) do
            if index[axis] < 0 || index[axis] >= view.shape[axis] then inside = false
    if inside then Maybe.Some view.data[offset_of view (ref index)] else Maybe.None

/// Reorders the axes without touching the data: axis i of the result is axis axes[i] of the view.
/// Traps unless `axes` is a permutation of 0 .. rank - 1.
///
/// ```tsuzuri run=[3,%202]%205
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let p = Tensor.permute [1, 0] v
/// $"{Tensor.shape p} {deref (Tensor.at [2, 1] p)}"
/// ```
def permute { r } :: own [i64] -> ref View<'a> { r } -> View<'a> { r }
fn permute axes view =
    let rank = view.shape.length
    assert (axes.length == rank)
    for axis in 0i64 ..= (rank - 1) do
        assert (axes[axis] >= 0 && axes[axis] < rank)
        for earlier in 0i64 ..= (axis - 1) do assert (axes[earlier] != axes[axis])
    View { data: view.data, offset: view.offset, shape: new [i64](rank, \axis -> view.shape[axes[axis]]), strides: new [i64](rank, \axis -> view.strides[axes[axis]]) }

/// Fixes one axis at a position, which removes that axis; traps unless the position is inside its extent.
///
/// ```tsuzuri run=[2,%205]
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let column = Tensor.index_axis 1 2 v
/// Tensor.to_array (Tensor.to_tensor column)
/// ```
def index_axis { r } :: own i64 -> own i64 -> ref View<'a> { r } -> View<'a> { r }
fn index_axis axis position view =
    let rank = view.shape.length
    assert (axis >= 0 && axis < rank && position >= 0 && position < view.shape[axis])
    View { data: view.data, offset: view.offset + position * view.strides[axis], shape: new [i64](rank - 1, \d -> if d < axis then view.shape[d] else view.shape[d + 1]), strides: new [i64](rank - 1, \d -> if d < axis then view.strides[d] else view.strides[d + 1]) }

/// Keeps `length` positions of one axis starting at `start`; traps unless they lie inside the extent.
///
/// ```tsuzuri run=[1,%202,%205,%206]
/// let t = Tensor.init [2, 4] (\i -> i)
/// let v = Tensor.view t
/// let middle = Tensor.narrow 1 1 2 v
/// Tensor.to_array (Tensor.to_tensor middle)
/// ```
def narrow { r } :: own i64 -> own i64 -> own i64 -> ref View<'a> { r } -> View<'a> { r }
fn narrow axis start length view =
    let rank = view.shape.length
    assert (axis >= 0 && axis < rank && start >= 0 && length >= 0 && start <= view.shape[axis] && length <= view.shape[axis] - start)
    View { data: view.data, offset: view.offset + start * view.strides[axis], shape: new [i64](rank, \d -> if d == axis then length else view.shape[d]), strides: Array.copy (ref view.strides) }

/// Whether the elements are one run of `data` in row-major order (a window without elements is contiguous).
///
/// ```tsuzuri run=true%20false
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let flipped = Tensor.permute [1, 0] v
/// $"{Tensor.is_contiguous v} {Tensor.is_contiguous flipped}"
/// ```
def is_contiguous :: ref View<'a> -> bool
fn is_contiguous view =
    let mut expected = 1
    let mut dense = true
    let mut axis = view.shape.length
    while axis > 0 do
        axis = axis - 1
        if view.shape[axis] != 1 && view.strides[axis] != expected then dense = false
        expected = expected * view.shape[axis]
    dense || volume (ref view.shape) == 0

/// Gives a contiguous window a new shape without copying; traps unless the window is contiguous and
/// the product of the shape is unchanged.
///
/// ```tsuzuri run=[6]%204
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let flat = Tensor.reshape_view [6] v
/// $"{Tensor.shape flat} {deref (Tensor.at [4] flat)}"
/// ```
def reshape_view { r } :: own [i64] -> ref View<'a> { r } -> View<'a> { r }
fn reshape_view shape view =
    assert (is_contiguous view && volume (ref shape) == volume (ref view.shape))
    let strides = dense_strides (ref shape)
    View { data: view.data, offset: view.offset, shape: shape, strides: strides }

private def rec fold_axis :: Copy<'a> => own ('state -> 'a -> 'state) -> ref ['a] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> own 'state -> 'state
fn rec fold_axis folder data shape strides axis offset state =
    let mut result = state
    if axis == shape.length - 1 then
        for position in 0i64 ..= (shape[axis] - 1) do
            result = folder result data[offset + position * strides[axis]]
    else
        for position in 0i64 ..= (shape[axis] - 1) do
            result = fold_axis folder data shape strides (axis + 1) (offset + position * strides[axis]) result
    result

/// Folds the elements left to right in row-major order of the window.
///
/// ```tsuzuri run=1324
/// let t = Tensor.init [2, 2] (\i -> i + 1)
/// let v = Tensor.view t
/// Tensor.fold (\text x -> text + to_string x) "" (Tensor.permute [1, 0] v)
/// ```
def fold :: Copy<'a> => own ('state -> 'a -> 'state) -> own 'state -> ref View<'a> -> 'state
fn fold folder initial view =
    if volume (ref view.shape) == 0 then initial
    elif view.shape.length == 0 then folder initial view.data[view.offset]
    else fold_axis folder view.data (ref view.shape) (ref view.strides) 0 view.offset initial

// Writes the elements of one axis and below into `out` from `position`; returns the next position.
private def rec gather :: Copy<'a> => ref ['a] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> ref mut ['a..] -> own i64 -> i64
fn rec gather data shape strides axis offset out position =
    let mut next = position
    if axis == shape.length - 1 then
        for step in 0i64 ..= (shape[axis] - 1) do
            Array.write next data[offset + step * strides[axis]] out
            next = next + 1
    else
        for step in 0i64 ..= (shape[axis] - 1) do
            next = gather data shape strides (axis + 1) (offset + step * strides[axis]) out next
    next

/// Copies the elements into a new contiguous tensor.
///
/// ```tsuzuri run=[0,%203,%201,%204,%202,%205]
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// Tensor.to_array (Tensor.to_tensor (Tensor.permute [1, 0] v))
/// ```
def to_tensor :: Copy<'a> => ref View<'a> -> Tensor<'a>
fn to_tensor view =
    let total = volume (ref view.shape)
    if total == 0 then Tensor { shape: Array.copy (ref view.shape), data: Array.init 0 (\_ -> view.data[0]) }
    elif is_contiguous view then Tensor { shape: Array.copy (ref view.shape), data: Array.sub view.offset total view.data }
    else
        let mut out = new ['a](total, \_ -> view.data[view.offset])
        let written = gather view.data (ref view.shape) (ref view.strides) 0 view.offset (ref mut out) 0
        assert (written == total)
        Tensor { shape: Array.copy (ref view.shape), data: out }

/// Applies `transform` to every element in row-major order of the window.
///
/// ```tsuzuri run=[0,%2010,%2020,%2030]
/// let t = Tensor.init [2, 2] (\i -> i)
/// let v = Tensor.view t
/// Tensor.to_array (Tensor.map (\x -> x * 10) v)
/// ```
def map :: Copy<'a> => own ('a -> 'b) -> ref View<'a> -> Tensor<'b>
fn map transform view =
    let total = volume (ref view.shape)
    if total > 0 && is_contiguous view then
        Tensor { shape: Array.copy (ref view.shape), data: Array.map_owned transform (ref view.data[view.offset .. view.offset + total]) }
    else
        let packed = to_tensor view
        Tensor { shape: Array.copy (ref packed.shape), data: Array.map_owned transform (ref packed.data) }

/// Views a rank 2 window as a matrix window without copying; traps unless the rank is 2 and both
/// strides are non-negative (materialize negative-stride views with `to_tensor` first).
///
/// ```tsuzuri run=2x3%205
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// let window = Tensor.as_matrix_view v
/// $"{MatrixView.rows window}x{MatrixView.cols window} {deref (MatrixView.at 1 2 window)}"
/// ```
def as_matrix_view { r } :: ref View<'a> { r } -> MatrixView<'a> { r }
fn as_matrix_view view =
    assert (view.shape.length == 2)
    MatrixView.strided view.offset view.shape[0] view.shape[1] view.strides[0] view.strides[1] view.data

/// Views a matrix window as a rank 2 window without copying.
///
/// ```tsuzuri run=[1,%202]%203
/// let m = Matrix.of_array 2 2 [1, 2, 3, 4]
/// let window = MatrixView.transpose (MatrixView.of_matrix m)
/// let v = Tensor.of_matrix_view window
/// $"{Tensor.strides v} {deref (Tensor.at [0, 1] v)}"
/// ```
def of_matrix_view { r } :: MatrixView<'a> { r } -> View<'a> { r }
fn of_matrix_view window =
    let shape = [MatrixView.rows window, MatrixView.cols window]
    let strides = [MatrixView.row_stride window, MatrixView.col_stride window]
    View { data: MatrixView.data window, offset: MatrixView.offset window, shape: shape, strides: strides }

/// Borrows a slice with explicit `offset`, `shape`, and `strides` (positive, zero, or negative).
/// Traps if `shape.length > 64`, `shape.length != strides.length`, any extent is negative,
/// stride arithmetic overflows `i64`, or any reachable element lies outside `data`.
///
/// ```tsuzuri run=[4,%203,%202,%201]
/// let data = [1, 2, 3, 4]
/// let rev = Tensor.strided 3 [4] [-1] (ref data)
/// Tensor.to_array (Tensor.to_tensor (ref rev))
/// ```
def strided { r } :: own i64 -> own [i64] -> own [i64] -> ref { r } ['a] -> View<'a> { r }
fn strided offset shape strides data =
    check_strided_bounds offset (ref shape) (ref strides) data.length
    View { data: data, offset: offset, shape: shape, strides: strides }

/// Alias of `is_contiguous`: whether the elements are one run of `data` in row-major (C) order.
///
/// ```tsuzuri run=true%20false
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// $"{Tensor.is_c_contiguous v} {Tensor.is_c_contiguous (Tensor.permute [1, 0] v)}"
/// ```
def is_c_contiguous :: ref View<'a> -> bool
fn is_c_contiguous view = is_contiguous view

/// Whether the elements are one run of `data` in column-major (Fortran) order (an empty window is contiguous).
///
/// ```tsuzuri run=false%20true
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// $"{Tensor.is_f_contiguous v} {Tensor.is_f_contiguous (Tensor.permute [1, 0] v)}"
/// ```
def is_f_contiguous :: ref View<'a> -> bool
fn is_f_contiguous view =
    let mut expected = 1
    let mut dense = true
    for axis in 0i64 ..= (view.shape.length - 1) do
        if view.shape[axis] != 1 && view.strides[axis] != expected then dense = false
        expected = expected * view.shape[axis]
    dense || volume (ref view.shape) == 0

/// Copies the elements of a window into a new C-contiguous tensor (alias of `to_tensor`).
///
/// ```tsuzuri run=[0,%203,%201,%204,%202,%205]
/// let t = Tensor.init [2, 3] (\i -> i)
/// let v = Tensor.view t
/// Tensor.to_array (Tensor.as_contiguous (Tensor.permute [1, 0] v))
/// ```
def as_contiguous :: Copy<'a> => ref View<'a> -> Tensor<'a>
fn as_contiguous view = to_tensor view

// Writes the elements of a view in column-major (Fortran) order into `out`.
private def rec gather_fortran :: Copy<'a> => ref ['a] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> ref mut ['a..] -> own i64 -> i64
fn rec gather_fortran data shape strides axis offset out position =
    let mut next = position
    if axis == 0 then
        for step in 0i64 ..= (shape[0] - 1) do
            Array.write next data[offset + step * strides[0]] out
            next = next + 1
    else
        for step in 0i64 ..= (shape[axis] - 1) do
            next = gather_fortran data shape strides (axis - 1) (offset + step * strides[axis]) out next
    next

/// Packs the elements of a window into a flat column-major (Fortran-order) array.
/// Pair with `Tensor.fortran_strides` and `Tensor.strided` to obtain an F-contiguous `View`.
///
/// ```tsuzuri run=[0,%203,%201,%204,%202,%205]
/// let t = Tensor.init [2, 3] (\i -> i)
/// Tensor.as_fortran (Tensor.view t)
/// ```
def as_fortran :: Copy<'a> => ref View<'a> -> ['a]
fn as_fortran view =
    let total = volume (ref view.shape)
    if total == 0 then Array.init 0 (\_ -> view.data[0])
    elif is_f_contiguous view then Array.sub view.offset total view.data
    elif view.shape.length == 0 then [view.data[view.offset]]
    else
        let mut out = new ['a](total, \_ -> view.data[view.offset])
        let written = gather_fortran view.data (ref view.shape) (ref view.strides) (view.shape.length - 1) view.offset (ref mut out) 0
        assert (written == total)
        out

/// Explicitly duplicates an owned tensor.
///
/// ```tsuzuri run=[1,%202,%203,%204]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// let copy = Tensor.clone (ref t)
/// Tensor.to_array copy
/// ```
def clone :: Copy<'a> => ref Tensor<'a> -> Tensor<'a>
fn clone tensor = Tensor { shape: Array.copy (ref tensor.shape), data: Array.copy (ref tensor.data) }

/// Explicitly copies a window into a new owned contiguous tensor (alias of `to_tensor`).
///
/// ```tsuzuri run=[1,%202,%203,%204]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.to_array (Tensor.clone_view (Tensor.view t))
/// ```
def clone_view :: Copy<'a> => ref View<'a> -> Tensor<'a>
fn clone_view view = to_tensor view

/// Converts every element of a window using `convert` into a new contiguous tensor.
///
/// ```tsuzuri run=[1,%202,%203]
/// let t = Tensor.of_array [3] [1, 2, 3]
/// let f = Tensor.astype (\x -> x as f64) (Tensor.view t)
/// Tensor.to_array f
/// ```
def astype :: (Copy<'a>, Copy<'b>) => own ('a -> 'b) -> ref View<'a> -> Tensor<'b>
fn astype convert view = map convert view

// ---------------------------------------------------------------------------
// Writable N-dimensional views (`Tensor.Mut`)
// ---------------------------------------------------------------------------

private def offset_of_mut :: ref Mut<'a> -> ref [i64] -> i64
fn offset_of_mut view index =
    assert (index.length == view.shape.length)
    let mut offset = view.offset
    for axis in 0i64 ..= (index.length - 1) do
        assert (index[axis] >= 0 && index[axis] < view.shape[axis])
        offset = offset + index[axis] * view.strides[axis]
    offset

/// Takes an exclusive row-major array as a writable N-dimensional window; traps unless
/// `data.length == volume shape`.
///
/// ```tsuzuri run=[0,%200,%207,%200]
/// let mut data = [0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [2, 2] (ref mut data)
/// Tensor.write [1, 0] 7 (ref mut m)
/// $"{data}"
/// ```
def borrow_mut { r } :: own [i64] -> ref mut { r } ['a..] -> Mut<'a> { r }
fn borrow_mut shape data =
    assert (data.length == volume (ref shape))
    let strides = dense_strides (ref shape)
    Mut { data: data, offset: 0, shape: shape, strides: strides }

/// Temporarily exposes an owned tensor's buffer as a writable `Mut` window, runs `writer`, and
/// returns the updated tensor without copying.
///
/// ```tsuzuri run=[0,%200,%209,%200]
/// let t = Tensor.zeros [2, 2]
/// let t2 = Tensor.update (\m -> Tensor.write [1, 0] 9 m) t
/// Tensor.to_array t2
/// ```
def update :: own (ref mut Mut<'a> -> unit) -> own Tensor<'a> -> Tensor<'a>
fn update writer tensor =
    let shape = tensor.shape
    let mut data = tensor.data
    let mut view = borrow_mut (Array.copy (ref shape)) (ref mut data)
    writer (ref mut view)
    Tensor { shape: shape, data: data }

/// Borrows a writable window as a read-only `View` until the next write.
///
/// ```tsuzuri run=18
/// let mut data = [1, 2, 3, 4]
/// let mut m = Tensor.borrow_mut [2, 2] (ref mut data)
/// Tensor.write [0, 0] 9 (ref mut m)
/// let v = Tensor.freeze (ref m)
/// Tensor.fold (\acc x -> acc + x) 0 (ref v)
/// ```
def freeze { r } :: ref { r } Mut<'a> { r } -> View<'a> { r }
fn freeze view =
    View {
        data: ref view.data[0 ..],
        offset: view.offset,
        shape: Array.copy (ref view.shape),
        strides: Array.copy (ref view.strides)
    }

/// Whether a writable window is one contiguous C-order run of its backing slice.
///
/// ```tsuzuri run=true%20false
/// let mut data = [1, 2, 3, 4, 5, 6]
/// let mut m = Tensor.borrow_mut [2, 3] (ref mut data)
/// let c1 = Tensor.is_contiguous_mut (ref m)
/// let mut p = Tensor.permute_mut [1, 0] (ref mut m)
/// let c2 = Tensor.is_contiguous_mut (ref p)
/// $"{c1} {c2}"
/// ```
def is_contiguous_mut { r } :: ref Mut<'a> { r } -> bool
fn is_contiguous_mut view =
    let mut expected = 1
    let mut dense = true
    let mut axis = view.shape.length
    while axis > 0 do
        axis = axis - 1
        if view.shape[axis] != 1 && view.strides[axis] != expected then dense = false
        expected = expected * view.shape[axis]
    dense || volume (ref view.shape) == 0

/// Lends a contiguous writable window as an exclusive flat slice; traps unless
/// `is_contiguous_mut view` holds.
///
/// ```tsuzuri run=[10,%202,%203,%204]
/// let mut data = [1, 2, 3, 4]
/// let mut m = Tensor.borrow_mut [2, 2] (ref mut data)
/// let s = Tensor.as_slice_mut (ref mut m)
/// Array.write 0 10 s
/// $"{data}"
/// ```
def as_slice_mut { r } :: ref mut { r } Mut<'a> { r } -> ref mut { r } ['a..]
fn as_slice_mut view =
    assert (is_contiguous_mut (ref view))
    let total = volume (ref view.shape)
    if total == 0 then ref mut view.data[0 .. 0]
    else ref mut view.data[view.offset .. view.offset + total]

/// Writes `value` at `index`; traps unless `index` has one entry per axis inside its extent.
///
/// ```tsuzuri run=[0,%200,%200,%200,%200,%205]
/// let mut data = [0, 0, 0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [2, 3] (ref mut data)
/// Tensor.write [1, 2] 5 (ref mut m)
/// $"{data}"
/// ```
def write { r } :: own [i64] -> own 'a -> ref mut Mut<'a> { r } -> unit
fn write index value view =
    let slot = offset_of_mut (ref view) (ref index)
    Array.write slot value view.data

private def rec fill_axis :: Copy<'a> => ref mut ['a..] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> own 'a -> unit
fn rec fill_axis data shape strides axis offset value =
    if axis == shape.length - 1 then
        for step in 0i64 ..= (shape[axis] - 1) do
            Array.write (offset + step * strides[axis]) value data
    else
        for step in 0i64 ..= (shape[axis] - 1) do
            fill_axis data shape strides (axis + 1) (offset + step * strides[axis]) value

/// Writes `value` to every element of the writable window.
///
/// ```tsuzuri run=[3,%203,%203,%203]
/// let mut data = [0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [2, 2] (ref mut data)
/// Tensor.fill 3 (ref mut m)
/// $"{data}"
/// ```
def fill { r } :: Copy<'a> => own 'a -> ref mut Mut<'a> { r } -> unit
fn fill value view =
    let total = volume (ref view.shape)
    if total > 0 then
        if view.shape.length == 0 then Array.write view.offset value view.data
        else
            let shape = Array.copy (ref view.shape)
            let strides = Array.copy (ref view.strides)
            let start = view.offset
            fill_axis view.data (ref shape) (ref strides) 0 start value

private def rec copy_axis :: Copy<'a> => ref ['a] -> ref [i64] -> own i64 -> ref mut ['a..] -> ref [i64] -> own i64 -> ref [i64] -> own i64 -> unit
fn rec copy_axis src src_strides src_offset dst dst_strides dst_offset shape axis =
    if axis == shape.length - 1 then
        for step in 0i64 ..= (shape[axis] - 1) do
            let value = src[src_offset + step * src_strides[axis]]
            Array.write (dst_offset + step * dst_strides[axis]) value dst
    else
        for step in 0i64 ..= (shape[axis] - 1) do
            copy_axis src src_strides (src_offset + step * src_strides[axis]) dst dst_strides (dst_offset + step * dst_strides[axis]) shape (axis + 1)

/// Copies elements from `source` into `target`; traps unless both windows have the same shape.
///
/// ```tsuzuri run=[1,%203,%202,%204]
/// let src = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// let sv = Tensor.view (ref src)
/// let transposed = Tensor.permute [1, 0] (ref sv)
/// let mut dst_data = [0, 0, 0, 0]
/// let mut dst = Tensor.borrow_mut [2, 2] (ref mut dst_data)
/// Tensor.copy_from (ref transposed) (ref mut dst)
/// $"{dst_data}"
/// ```
def copy_from { s r } :: Copy<'a> => ref View<'a> { s } -> ref mut Mut<'a> { r } -> unit
fn copy_from source target =
    assert (target.shape.length == source.shape.length)
    for axis in 0i64 ..= (target.shape.length - 1) do
        assert (target.shape[axis] == source.shape[axis])
    let total = volume (ref target.shape)
    if total > 0 then
        if target.shape.length == 0 then Array.write target.offset source.data[source.offset] target.data
        else
            let shape = Array.copy (ref target.shape)
            let dst_strides = Array.copy (ref target.strides)
            let dst_offset = target.offset
            copy_axis source.data (ref source.strides) source.offset target.data (ref dst_strides) dst_offset (ref shape) 0

private def rec map_in_place_axis :: Copy<'a> => own ('a -> 'a) -> ref mut ['a..] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> unit
fn rec map_in_place_axis transform data shape strides axis offset =
    if axis == shape.length - 1 then
        for step in 0i64 ..= (shape[axis] - 1) do
            let slot = offset + step * strides[axis]
            let value = transform data[slot]
            Array.write slot value data
    else
        for step in 0i64 ..= (shape[axis] - 1) do
            map_in_place_axis transform data shape strides (axis + 1) (offset + step * strides[axis])

/// Applies `transform` to every element of the writable window in place.
///
/// ```tsuzuri run=[1,%204,%209,%2016]
/// let mut data = [1, 2, 3, 4]
/// let mut m = Tensor.borrow_mut [2, 2] (ref mut data)
/// Tensor.map_in_place (\x -> x * x) (ref mut m)
/// $"{data}"
/// ```
def map_in_place { r } :: Copy<'a> => own ('a -> 'a) -> ref mut Mut<'a> { r } -> unit
fn map_in_place transform view =
    let total = volume (ref view.shape)
    if total > 0 then
        if view.shape.length == 0 then
            let value = transform view.data[view.offset]
            Array.write view.offset value view.data
        else
            let shape = Array.copy (ref view.shape)
            let strides = Array.copy (ref view.strides)
            let start = view.offset
            map_in_place_axis transform view.data (ref shape) (ref strides) 0 start

/// Reorders the axes of a writable window without copying; traps unless `axes` is a permutation.
///
/// ```tsuzuri run=[0,%200,%207,%200,%200,%200]
/// let mut data = [0, 0, 0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [2, 3] (ref mut data)
/// let mut p = Tensor.permute_mut [1, 0] (ref mut m)
/// Tensor.write [2, 0] 7 (ref mut p)
/// $"{data}"
/// ```
def permute_mut { r } :: own [i64] -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn permute_mut axes view =
    let rank = view.shape.length
    assert (axes.length == rank)
    for axis in 0i64 ..= (rank - 1) do
        assert (axes[axis] >= 0 && axes[axis] < rank)
        for earlier in 0i64 ..= (axis - 1) do assert (axes[earlier] != axes[axis])
    let old_shape = ref view.shape
    let old_strides = ref view.strides
    let new_shape = new [i64](rank, \axis -> old_shape[axes[axis]])
    let new_strides = new [i64](rank, \axis -> old_strides[axes[axis]])
    let start = view.offset
    Mut { data: ref mut view.data[0 ..], offset: start, shape: new_shape, strides: new_strides }

/// Fixes one axis of a writable window at `position`, removing that axis.
///
/// ```tsuzuri run=[0,%200,%200,%205,%205,%205]
/// let mut data = [0, 0, 0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [2, 3] (ref mut data)
/// let mut row = Tensor.index_axis_mut 0 1 (ref mut m)
/// Tensor.fill 5 (ref mut row)
/// $"{data}"
/// ```
def index_axis_mut { r } :: own i64 -> own i64 -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn index_axis_mut axis position view =
    let rank = view.shape.length
    assert (axis >= 0 && axis < rank && position >= 0 && position < view.shape[axis])
    let start = view.offset + position * view.strides[axis]
    let old_shape = ref view.shape
    let old_strides = ref view.strides
    let new_shape = new [i64](rank - 1, \d -> if d < axis then old_shape[d] else old_shape[d + 1])
    let new_strides = new [i64](rank - 1, \d -> if d < axis then old_strides[d] else old_strides[d + 1])
    Mut { data: ref mut view.data[0 ..], offset: start, shape: new_shape, strides: new_strides }

/// Keeps `length` positions of `axis` starting at `start` in a writable window.
///
/// ```tsuzuri run=[0,%201,%201,%200,%200,%201,%201,%200]
/// let mut data = new [i64](8, \_ -> 0)
/// let mut m = Tensor.borrow_mut [2, 4] (ref mut data)
/// let mut mid = Tensor.narrow_mut 1 1 2 (ref mut m)
/// Tensor.fill 1 (ref mut mid)
/// $"{data}"
/// ```
def narrow_mut { r } :: own i64 -> own i64 -> own i64 -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn narrow_mut axis start length view =
    let rank = view.shape.length
    assert (axis >= 0 && axis < rank && start >= 0 && length >= 0 && start <= view.shape[axis] && length <= view.shape[axis] - start)
    let new_offset = view.offset + start * view.strides[axis]
    let old_shape = ref view.shape
    let new_shape = new [i64](rank, \d -> if d == axis then length else old_shape[d])
    let new_strides = Array.copy (ref view.strides)
    Mut { data: ref mut view.data[0 ..], offset: new_offset, shape: new_shape, strides: new_strides }

/// Extracts an N-dimensional box sub-window `[starts[d] .. starts[d] + lengths[d])` from a
/// writable window.
///
/// ```tsuzuri run=[0,%200,%200,%200,%201,%201,%200,%201,%201]
/// let mut data = new [i64](9, \_ -> 0)
/// let mut m = Tensor.borrow_mut [3, 3] (ref mut data)
/// let mut corner = Tensor.sub_mut [1, 1] [2, 2] (ref mut m)
/// Tensor.fill 1 (ref mut corner)
/// $"{data}"
/// ```
def sub_mut { r } :: own [i64] -> own [i64] -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn sub_mut starts lengths view =
    let rank = view.shape.length
    assert (starts.length == rank && lengths.length == rank)
    let mut new_offset = view.offset
    for d in 0i64 ..= (rank - 1) do
        assert (starts[d] >= 0 && lengths[d] >= 0 && starts[d] <= view.shape[d] && lengths[d] <= view.shape[d] - starts[d])
        new_offset = new_offset + starts[d] * view.strides[d]
    let new_strides = Array.copy (ref view.strides)
    Mut { data: ref mut view.data[0 ..], offset: new_offset, shape: lengths, strides: new_strides }

/// Subsamples `axis` of a writable window by a non-zero `step` (negative `step` reverses the axis).
/// Traps if `axis` is out of bounds or `step == 0`.
///
/// ```tsuzuri run=[9,%200,%209,%200,%209]
/// let mut data = [0, 0, 0, 0, 0]
/// let mut m = Tensor.borrow_mut [5] (ref mut data)
/// let mut evens = Tensor.step_mut 0 2 (ref mut m)
/// Tensor.fill 9 (ref mut evens)
/// $"{data}"
/// ```
def step_mut { r } :: own i64 -> own i64 -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn step_mut axis step view =
    let rank = view.shape.length
    assert (axis >= 0 && axis < rank && step != 0)
    let old_len = view.shape[axis]
    let old_stride = view.strides[axis]
    let mut new_offset = view.offset
    let mut new_len = 0
    let mut new_stride = old_stride
    if old_len > 0 then
        if step > 0 then
            new_len = (old_len - 1) / step + 1
            if new_len > 1 then
                new_stride =
                    match Int.checked_mul old_stride step with
                    | Maybe.Some s -> s
                    | Maybe.None ->
                        assert false
                        0
        else
            let step_mag = 0i64u - (step as i64u)
            new_len = (((old_len - 1) as i64u) / step_mag) as i64 + 1
            new_offset = view.offset + (old_len - 1) * old_stride
            if new_len > 1 then
                new_stride =
                    match Int.checked_mul old_stride step with
                    | Maybe.Some s -> s
                    | Maybe.None ->
                        assert false
                        0
    let old_shape = ref view.shape
    let old_strides = ref view.strides
    let new_shape = new [i64](rank, \d -> if d == axis then new_len else old_shape[d])
    let new_strides = new [i64](rank, \d -> if d == axis then new_stride else old_strides[d])
    Mut { data: ref mut view.data[0 ..], offset: new_offset, shape: new_shape, strides: new_strides }

/// Reverses `axis` of a writable window in O(rank) without copying.
///
/// ```tsuzuri run=[3,%202,%201]
/// let mut data = [0, 0, 0]
/// let mut m = Tensor.borrow_mut [3] (ref mut data)
/// let mut rev = Tensor.flip_mut 0 (ref mut m)
/// Tensor.write [0] 1 (ref mut rev)
/// Tensor.write [1] 2 (ref mut rev)
/// Tensor.write [2] 3 (ref mut rev)
/// $"{data}"
/// ```
def flip_mut { r } :: own i64 -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn flip_mut axis view = step_mut axis (-1) view

// ---------------------------------------------------------------------------
// Broadcasting
// ---------------------------------------------------------------------------

/// Computes the NumPy-compatible right-aligned broadcast shape of two shapes.
///
/// ```tsuzuri run=[2,%203,%204]
/// match Tensor.broadcast_shape [2, 1, 4] [3, 1] with
/// | Result.Ok shape -> shape
/// | Result.Error _ -> []
/// ```
def broadcast_shape :: ref [i64] -> ref [i64] -> Result<[i64], Error>
fn broadcast_shape left right =
    match try_volume left with
    | Maybe.None -> Result.Error (Error.InvalidShape (Array.copy left))
    | Maybe.Some _ ->
        match try_volume right with
        | Maybe.None -> Result.Error (Error.InvalidShape (Array.copy right))
        | Maybe.Some _ ->
            let rank = if left.length >= right.length then left.length else right.length
            let mut out = new [i64](rank, \_ -> 1)
            let mut ok = true
            for i in 0i64 ..= (rank - 1) do
                let l_idx = left.length - 1 - i
                let r_idx = right.length - 1 - i
                let l_dim = if l_idx >= 0 then left[l_idx] else 1
                let r_dim = if r_idx >= 0 then right[r_idx] else 1
                if l_dim == r_dim then Array.write (rank - 1 - i) l_dim (ref mut out)
                elif l_dim == 1 then Array.write (rank - 1 - i) r_dim (ref mut out)
                elif r_dim == 1 then Array.write (rank - 1 - i) l_dim (ref mut out)
                else ok = false
            if not ok then Result.Error (Error.IncompatibleBroadcast (Array.copy left, Array.copy right))
            else
                match try_volume (ref out) with
                | Maybe.Some _ -> Result.Ok out
                | Maybe.None -> Result.Error (Error.InvalidShape out)

/// Broadcasts `view` to `target` shape in O(rank) without copying, setting stride 0 on expanded
/// axes.
///
/// ```tsuzuri run=[1,%202,%201,%202]
/// let t = Tensor.of_array [1, 2] [1, 2]
/// let v = Tensor.view (ref t)
/// match Tensor.broadcast_to [2, 2] (ref v) with
/// | Result.Ok bv -> Tensor.to_array (Tensor.to_tensor (ref bv))
/// | Result.Error _ -> []
/// ```
def broadcast_to :: own [i64] -> ref View<'a> -> Result<View<'a>, Error>
fn broadcast_to target view =
    match try_volume (ref target) with
    | Maybe.None -> Result.Error (Error.InvalidShape target)
    | Maybe.Some _ ->
        if target.length < view.shape.length then
            Result.Error (Error.IncompatibleBroadcast (Array.copy (ref view.shape), target))
        else
            let pad = target.length - view.shape.length
            let mut new_strides = new [i64](target.length, \_ -> 0)
            let mut ok = true
            for s in 0i64 ..= (view.shape.length - 1) do
                let t = pad + s
                if view.shape[s] == target[t] then
                    Array.write t view.strides[s] (ref mut new_strides)
                elif view.shape[s] == 1 then
                    Array.write t 0 (ref mut new_strides)
                else
                    ok = false
            if not ok then Result.Error (Error.IncompatibleBroadcast (Array.copy (ref view.shape), target))
            else Result.Ok (View { data: view.data, offset: view.offset, shape: target, strides: new_strides })

/// Broadcasts two views to their common broadcast shape without copying.
///
/// ```tsuzuri run=[2,%202]%20[1,%202,%201,%202]%20[10,%2010,%2020,%2020]
/// let a = Tensor.of_array [1, 2] [1, 2]
/// let b = Tensor.of_array [2, 1] [10, 20]
/// let av = Tensor.view (ref a)
/// let bv = Tensor.view (ref b)
/// match Tensor.broadcast_pair (ref av) (ref bv) with
/// | Result.Ok (ba, bb) -> $"{Tensor.shape (ref ba)} {Tensor.to_array (Tensor.to_tensor (ref ba))} {Tensor.to_array (Tensor.to_tensor (ref bb))}"
/// | Result.Error _ -> "err"
/// ```
def broadcast_pair :: ref View<'a> -> ref View<'b> -> Result<(View<'a> * View<'b>), Error>
fn broadcast_pair left right =
    match broadcast_shape (ref left.shape) (ref right.shape) with
    | Result.Error err -> Result.Error err
    | Result.Ok common ->
        match broadcast_to (Array.copy (ref common)) left with
        | Result.Error err -> Result.Error err
        | Result.Ok bl ->
            match broadcast_to common right with
            | Result.Error err -> Result.Error err
            | Result.Ok br -> Result.Ok (bl, br)

/// Broadcasts an array of views to a single common shape without copying.
///
/// ```tsuzuri run=2%20[2,%203]
/// let a = Tensor.of_array [1, 3] [1, 2, 3]
/// let b = Tensor.of_array [2, 1] [10, 20]
/// let views = [Tensor.view (ref a), Tensor.view (ref b)]
/// match Tensor.broadcast_arrays (ref views) with
/// | Result.Ok out -> $"{out.length} {Tensor.shape (ref out[0])}"
/// | Result.Error _ -> "err"
/// ```
def broadcast_arrays :: ref [View<'a>] -> Result<[View<'a>], Error>
fn broadcast_arrays views =
    if views.length == 0 then
        Result.Ok (Array.init 0 (\_ -> View { data: views[0].data, offset: 0, shape: [], strides: [] }))
    else
        let mut common = Array.copy (ref views[0].shape)
        let mut err_opt: Maybe<Error> = Maybe.None
        for i in 1i64 ..= (views.length - 1) do
            match err_opt with
            | Maybe.Some _ -> ()
            | Maybe.None ->
                match broadcast_shape (ref common) (ref views[i].shape) with
                | Result.Ok next -> common = next
                | Result.Error err -> err_opt = Maybe.Some err
        match err_opt with
        | Maybe.Some err -> Result.Error err
        | Maybe.None ->
            let out = new [View<'a>](views.length, \i ->
                match broadcast_to (Array.copy (ref common)) (ref views[i]) with
                | Result.Ok bv -> bv
                | Result.Error _ ->
                    assert false
                    View { data: views[i].data, offset: views[i].offset, shape: Array.copy (ref views[i].shape), strides: Array.copy (ref views[i].strides) })
            Result.Ok out

// ---------------------------------------------------------------------------
// Creation APIs
// ---------------------------------------------------------------------------

/// Creates a tensor filled with `Default.default()`.
///
/// ```tsuzuri run=[0,%200,%200,%200]
/// let t: Tensor<i64> = Tensor.zeros [2, 2]
/// Tensor.to_array t
/// ```
def zeros :: Default<'a> => own [i64] -> Tensor<'a>
fn zeros shape = init shape (\_ -> Default.default())

/// Creates a numeric tensor filled with `1`.
///
/// ```tsuzuri run=[1,%201,%201]
/// let t: Tensor<i64> = Tensor.ones [3]
/// Tensor.to_array t
/// ```
def ones :: Numeric<'a> => own [i64] -> Tensor<'a>
fn ones shape = init shape (\_ -> 1 as 'a)

/// Creates a tensor of `shape` filled with `value`.
///
/// ```tsuzuri run=[7,%207,%207,%207]
/// Tensor.to_array (Tensor.full 7 [2, 2])
/// ```
def full :: Copy<'a> => own 'a -> own [i64] -> Tensor<'a>
fn full value shape = init shape (\_ -> value)

/// Creates a zero-filled tensor matching the shape of `view`.
///
/// ```tsuzuri run=[2,%203]%20[0,%200,%200,%200,%200,%200]
/// let src = Tensor.init [2, 3] (\i -> i)
/// let z: Tensor<i64> = Tensor.zeros_like (Tensor.view src)
/// let zv = Tensor.view (ref z)
/// $"{Tensor.shape (ref zv)} {Tensor.as_array (ref z)}"
/// ```
def zeros_like :: Default<'a> => ref View<'b> -> Tensor<'a>
fn zeros_like view = zeros (Array.copy (ref view.shape))

/// Creates a one-filled numeric tensor matching the shape of `view`.
///
/// ```tsuzuri run=[1,%201,%201,%201]
/// let src = Tensor.init [2, 2] (\i -> i)
/// let o: Tensor<i64> = Tensor.ones_like (Tensor.view src)
/// Tensor.to_array o
/// ```
def ones_like :: Numeric<'a> => ref View<'b> -> Tensor<'a>
fn ones_like view = ones (Array.copy (ref view.shape))

/// Creates a tensor filled with `value` matching the shape of `view`.
///
/// ```tsuzuri run=[9,%209,%209]
/// let src = Tensor.init [3] (\i -> i)
/// Tensor.to_array (Tensor.full_like 9 (Tensor.view src))
/// ```
def full_like :: Copy<'a> => own 'a -> ref View<'b> -> Tensor<'a>
fn full_like value view = full value (Array.copy (ref view.shape))

/// Creates a rank-0 scalar tensor holding one element.
///
/// ```tsuzuri run=0%2042
/// let t = Tensor.scalar 42
/// let v = Tensor.view (ref t)
/// $"{Tensor.rank (ref v)} {deref (Tensor.at [] (ref v))}"
/// ```
def scalar :: own 'a -> Tensor<'a>
fn scalar value = Tensor { shape: [], data: [value] }

/// Evenly spaced `i64` values in `[start, stop)` separated by `step`; traps when `step == 0`.
///
/// ```tsuzuri run=[1,%203,%205,%207]
/// Tensor.to_array (Tensor.arange_i64 1 9 2)
/// ```
def arange_i64 :: own i64 -> own i64 -> own i64 -> Tensor<i64>
fn arange_i64 start stop step =
    assert (step != 0)
    if (step > 0 && stop <= start) || (step < 0 && stop >= start) then
        Tensor { shape: [0], data: [] }
    elif step > 0 then
        let dist = (stop as i64u) - (start as i64u)
        let s = step as i64u
        let count_u = (dist - 1i64u) / s + 1i64u
        assert (count_u <= 9223372036854775807i64u)
        let count = count_u as i64
        Tensor { shape: [count], data: new [i64](count, \i -> ((start as i64u) + (i as i64u) * s) as i64) }
    else
        let dist = (start as i64u) - (stop as i64u)
        let s = 0i64u - (step as i64u)
        let count_u = (dist - 1i64u) / s + 1i64u
        assert (count_u <= 9223372036854775807i64u)
        let count = count_u as i64
        Tensor { shape: [count], data: new [i64](count, \i -> ((start as i64u) - (i as i64u) * s) as i64) }

/// Evenly spaced `f64` values in `[start, stop)` separated by `step`; traps on `step == 0.0`,
/// non-finite inputs, or overflowing length.
///
/// ```tsuzuri run=[0,%200.5,%201,%201.5]
/// Tensor.to_array (Tensor.arange_f64 0.0 2.0 0.5)
/// ```
def arange_f64 :: own f64 -> own f64 -> own f64 -> Tensor<f64>
fn arange_f64 start stop step =
    assert (Math.is_finite start && Math.is_finite stop && Math.is_finite step && step != 0.0)
    if (step > 0.0 && stop <= start) || (step < 0.0 && stop >= start) then
        Tensor { shape: [0], data: [] }
    else
        let span = (stop - start) / step
        assert (Math.is_finite span && span >= 0.0 && span <= 9007199254740991.0)
        let count = Math.ceil span as i64
        Tensor { shape: [count], data: new [f64](count, \i -> start + (i as f64) * step) }

/// Evenly spaced `f32` values in `[start, stop)` separated by `step`; traps on `step == 0.0f32`,
/// non-finite inputs, or overflowing length.
///
/// ```tsuzuri run=[0,%200.5,%201,%201.5]
/// Tensor.to_array (Tensor.arange_f32 0.0f32 2.0f32 0.5f32)
/// ```
def arange_f32 :: own f32 -> own f32 -> own f32 -> Tensor<f32>
fn arange_f32 start stop step =
    assert (Math.is_finite start && Math.is_finite stop && Math.is_finite step && step != 0.0f32)
    if (step > 0.0f32 && stop <= start) || (step < 0.0f32 && stop >= start) then
        Tensor { shape: [0], data: [] }
    else
        let span = ((stop as f64) - (start as f64)) / (step as f64)
        assert (Math.is_finite span && span >= 0.0 && span <= 9007199254740991.0)
        let count = Math.ceil span as i64
        Tensor { shape: [count], data: new [f32](count, \i -> ((start as f64) + (i as f64) * (step as f64)) as f32) }

/// `count` evenly spaced values over the closed interval `[start, stop]`; traps when `count < 0`.
///
/// ```tsuzuri run=[0,%200.25,%200.5,%200.75,%201]
/// Tensor.to_array (Tensor.linspace 0.0 1.0 5)
/// ```
def linspace :: (Float<'a>, Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Copy<'a>) => own 'a -> own 'a -> own i64 -> Tensor<'a>
fn linspace start stop count =
    assert (count >= 0)
    if count == 0 then Tensor { shape: [0], data: Array.init 0 (\_ -> start) }
    elif count == 1 then Tensor { shape: [1], data: [start] }
    else
        let denom = (count - 1) as 'a
        let diff = stop - start
        Tensor {
            shape: [count],
            data: new ['a](count, \i ->
                if i == 0 then start
                elif i == count - 1 then stop
                else start + diff * ((i as 'a) / denom))
        }

/// `count` evenly spaced values over the half-open interval `[start, stop)`; traps when `count < 0`.
///
/// ```tsuzuri run=[0,%200.25,%200.5,%200.75]
/// Tensor.to_array (Tensor.linspace_open 0.0 1.0 4)
/// ```
def linspace_open :: (Float<'a>, Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Copy<'a>) => own 'a -> own 'a -> own i64 -> Tensor<'a>
fn linspace_open start stop count =
    assert (count >= 0)
    if count == 0 then Tensor { shape: [0], data: Array.init 0 (\_ -> start) }
    else
        let denom = count as 'a
        let diff = stop - start
        Tensor { shape: [count], data: new ['a](count, \i -> start + diff * ((i as 'a) / denom)) }

/// `count` values spaced evenly on a log scale: `base ^ linspace(start, stop, count)`.
///
/// ```tsuzuri run=[1,%2010,%20100]
/// Tensor.to_array (Tensor.logspace 0.0 2.0 3 10.0)
/// ```
def logspace :: (Elementary<'a>, Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Copy<'a>) => own 'a -> own 'a -> own i64 -> own 'a -> Tensor<'a>
fn logspace start stop count base =
    let exponents = linspace start stop count
    Tensor {
        shape: [count],
        data: new ['a](count, \i -> Math.pow base exponents.data[i])
    }

/// `count` values spaced evenly on a geometric (multiplicative) scale over `[start, stop]`.
/// Traps when `count < 0`, either endpoint is zero, or `start` and `stop` have opposite signs.
///
/// ```tsuzuri run=true
/// let g = Tensor.geomspace 1.0 100.0 3
/// let a = Tensor.as_array (ref g)
/// a[0] == 1.0 && Math.abs (a[1] - 10.0) < 1.0e-12 && Math.abs (a[2] - 100.0) < 1.0e-12
/// ```
def geomspace :: (Elementary<'a>, Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Neg<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own i64 -> Tensor<'a>
fn geomspace start stop count =
    let zero_v = 0.0 as 'a
    assert (count >= 0 && start != zero_v && stop != zero_v && ((start > zero_v && stop > zero_v) || (start < zero_v && stop < zero_v)))
    if count == 0 then Tensor { shape: [0], data: Array.init 0 (\_ -> start) }
    elif count == 1 then Tensor { shape: [1], data: [start] }
    else
        let negative = start < zero_v
        let log_start = Math.log (Math.abs start)
        let log_stop = Math.log (Math.abs stop)
        let denom = (count - 1) as 'a
        let diff = log_stop - log_start
        Tensor {
            shape: [count],
            data: new ['a](count, \i ->
                if i == 0 then start
                elif i == count - 1 then stop
                else
                    let mag = Math.exp (log_start + diff * ((i as 'a) / denom))
                    if negative then -mag else mag)
        }

/// 2D tensor with `1` on the `k`-th diagonal (`col - row == k`) and `0` elsewhere.
///
/// ```tsuzuri run=[0,%201,%200,%200,%200,%201]
/// let e: Tensor<i64> = Tensor.eye 2 3 1
/// Tensor.to_array e
/// ```
def eye :: Numeric<'a> => own i64 -> own i64 -> own i64 -> Tensor<'a>
fn eye rows cols k =
    let total = volume [rows, cols]
    Tensor {
        shape: [rows, cols],
        data: new ['a](total, \index ->
            let r = index / cols
            let c = index % cols
            if c - r == k then 1 as 'a else 0 as 'a)
    }

/// Square `n x n` identity tensor.
///
/// ```tsuzuri run=[1,%200,%200,%201]
/// let id: Tensor<i64> = Tensor.identity 2
/// Tensor.to_array id
/// ```
def identity :: Numeric<'a> => own i64 -> Tensor<'a>
fn identity n = eye n n 0

/// Constructs a 2D diagonal tensor from a 1D view placed on the `k`-th diagonal.
/// Traps unless `rank view == 1`.
///
/// ```tsuzuri run=[0,%201,%200,%200,%200,%202,%200,%200,%200]
/// let v = Tensor.of_array [2] [1, 2]
/// Tensor.to_array (Tensor.diag 1 (Tensor.view v))
/// ```
def diag :: (Default<'a>, Copy<'a>) => own i64 -> ref View<'a> -> Tensor<'a>
fn diag k view =
    assert (view.shape.length == 1)
    let n = view.shape[0]
    let shift = if k >= 0 then k else -k
    assert (n <= 9223372036854775807 - shift)
    let side = n + shift
    let total = volume [side, side]
    let mut out = new ['a](total, \_ -> Default.default())
    for i in 0i64 ..= (n - 1) do
        let row = if k >= 0 then i else i + shift
        let col = if k >= 0 then i + shift else i
        let val = view.data[view.offset + i * view.strides[0]]
        Array.write (row * side + col) val (ref mut out)
    Tensor { shape: [side, side], data: out }

/// Extracts the `k`-th diagonal of a 2D view as a 1D tensor. Traps unless `rank view == 2`.
///
/// ```tsuzuri run=[1,%205]
/// let t = Tensor.of_array [2, 3] [0, 1, 2, 3, 4, 5]
/// Tensor.to_array (Tensor.diagonal 1 (Tensor.view t))
/// ```
def diagonal :: Copy<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn diagonal k view =
    assert (view.shape.length == 2)
    let rows = view.shape[0]
    let cols = view.shape[1]
    let start_row = if k < 0 then -k else 0
    let start_col = if k > 0 then k else 0
    let rem_rows = if start_row < rows then rows - start_row else 0
    let rem_cols = if start_col < cols then cols - start_col else 0
    let count = if rem_rows < rem_cols then rem_rows else rem_cols
    if count == 0 then
        Tensor { shape: [0], data: Array.init 0 (\_ -> view.data[0]) }
    else
        let row_s = view.strides[0]
        let col_s = view.strides[1]
        Tensor {
            shape: [count],
            data: new ['a](count, \i -> view.data[view.offset + (start_row + i) * row_s + (start_col + i) * col_s])
        }

/// Flattens a view of any rank and places its elements on the `k`-th diagonal of a 2D tensor.
///
/// ```tsuzuri run=[1,%200,%200,%202]
/// let t = Tensor.of_array [1, 2] [1, 2]
/// Tensor.to_array (Tensor.diag_flat 0 (Tensor.view t))
/// ```
def diag_flat :: (Default<'a>, Copy<'a>) => own i64 -> ref View<'a> -> Tensor<'a>
fn diag_flat k view =
    let flat = to_tensor view
    let flat_1d = reshape [flat.data.length] flat
    diag k (ref (Tensor.view (ref flat_1d)))

/// 2D tensor with `1` on and below the `k`-th diagonal (`col - row <= k`) and `0` above.
///
/// ```tsuzuri run=[1,%200,%201,%201]
/// let t: Tensor<i64> = Tensor.tri 2 2 0
/// Tensor.to_array t
/// ```
def tri :: Numeric<'a> => own i64 -> own i64 -> own i64 -> Tensor<'a>
fn tri rows cols k =
    let total = volume [rows, cols]
    Tensor {
        shape: [rows, cols],
        data: new ['a](total, \index ->
            let r = index / cols
            let c = index % cols
            if c - r <= k then 1 as 'a else 0 as 'a)
    }

/// Returns a copy with elements above the `k`-th diagonal of the last two axes zeroed.
/// Traps unless `rank view >= 2`.
///
/// ```tsuzuri run=[1,%200,%203,%204]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.to_array (Tensor.tril 0 (Tensor.view t))
/// ```
def tril :: (Default<'a>, Copy<'a>) => own i64 -> ref View<'a> -> Tensor<'a>
fn tril k view =
    let rank = view.shape.length
    assert (rank >= 2)
    let packed = to_tensor view
    let rows = packed.shape[rank - 2]
    let cols = packed.shape[rank - 1]
    let plane = rows * cols
    let total = packed.data.length
    if total == 0 then packed
    else
        let mut data = packed.data
        let mut base = 0
        while base < total do
            for r in 0i64 ..= (rows - 1) do
                for c in 0i64 ..= (cols - 1) do
                    if c - r > k then Array.write (base + r * cols + c) (Default.default()) (ref mut data)
            base = base + plane
        Tensor { shape: packed.shape, data: data }

/// Returns a copy with elements below the `k`-th diagonal of the last two axes zeroed.
/// Traps unless `rank view >= 2`.
///
/// ```tsuzuri run=[1,%202,%200,%204]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.to_array (Tensor.triu 0 (Tensor.view t))
/// ```
def triu :: (Default<'a>, Copy<'a>) => own i64 -> ref View<'a> -> Tensor<'a>
fn triu k view =
    let rank = view.shape.length
    assert (rank >= 2)
    let packed = to_tensor view
    let rows = packed.shape[rank - 2]
    let cols = packed.shape[rank - 1]
    let plane = rows * cols
    let total = packed.data.length
    if total == 0 then packed
    else
        let mut data = packed.data
        let mut base = 0
        while base < total do
            for r in 0i64 ..= (rows - 1) do
                for c in 0i64 ..= (cols - 1) do
                    if c - r < k then Array.write (base + r * cols + c) (Default.default()) (ref mut data)
            base = base + plane
        Tensor { shape: packed.shape, data: data }

/// Returns coordinate grids `(X, Y)` with matrix (`ij`) indexing from two 1D views:
/// `X` and `Y` both have shape `[x.length, y.length]`, with `X[i, j] = x[i]` and `Y[i, j] = y[j]`.
///
/// ```tsuzuri run=[1,%201,%202,%202]%20[10,%2020,%2010,%2020]
/// let x = Tensor.of_array [2] [1, 2]
/// let y = Tensor.of_array [2] [10, 20]
/// let (gx, gy) = Tensor.meshgrid_ij (Tensor.view x) (Tensor.view y)
/// $"{Tensor.as_array (ref gx)} {Tensor.as_array (ref gy)}"
/// ```
def meshgrid_ij :: (Copy<'a>, Copy<'b>) => ref View<'a> -> ref View<'b> -> (Tensor<'a> * Tensor<'b>)
fn meshgrid_ij xs ys =
    assert (xs.shape.length == 1 && ys.shape.length == 1)
    let m = xs.shape[0]
    let n = ys.shape[0]
    let total = volume [m, n]
    let gx =
        if total == 0 then Tensor { shape: [m, n], data: Array.init 0 (\_ -> xs.data[0]) }
        else Tensor { shape: [m, n], data: new ['a](total, \idx -> xs.data[xs.offset + (idx / n) * xs.strides[0]]) }
    let gy =
        if total == 0 then Tensor { shape: [m, n], data: Array.init 0 (\_ -> ys.data[0]) }
        else Tensor { shape: [m, n], data: new ['b](total, \idx -> ys.data[ys.offset + (idx % n) * ys.strides[0]]) }
    (gx, gy)

/// Returns coordinate grids `(X, Y)` with Cartesian (`xy`) indexing from two 1D views:
/// `X` and `Y` both have shape `[y.length, x.length]`, with `X[j, i] = x[i]` and `Y[j, i] = y[j]`.
///
/// ```tsuzuri run=[1,%202,%201,%202]%20[10,%2010,%2020,%2020]
/// let x = Tensor.of_array [2] [1, 2]
/// let y = Tensor.of_array [2] [10, 20]
/// let (gx, gy) = Tensor.meshgrid (Tensor.view x) (Tensor.view y)
/// $"{Tensor.as_array (ref gx)} {Tensor.as_array (ref gy)}"
/// ```
def meshgrid :: (Copy<'a>, Copy<'b>) => ref View<'a> -> ref View<'b> -> (Tensor<'a> * Tensor<'b>)
fn meshgrid xs ys =
    assert (xs.shape.length == 1 && ys.shape.length == 1)
    let m = xs.shape[0]
    let n = ys.shape[0]
    let total = volume [n, m]
    let gx =
        if total == 0 then Tensor { shape: [n, m], data: Array.init 0 (\_ -> xs.data[0]) }
        else Tensor { shape: [n, m], data: new ['a](total, \idx -> xs.data[xs.offset + (idx % m) * xs.strides[0]]) }
    let gy =
        if total == 0 then Tensor { shape: [n, m], data: Array.init 0 (\_ -> ys.data[0]) }
        else Tensor { shape: [n, m], data: new ['b](total, \idx -> ys.data[ys.offset + (idx / m) * ys.strides[0]]) }
    (gx, gy)

// ---------------------------------------------------------------------------
// Eq and Display instances
// ---------------------------------------------------------------------------

private def rec tensor_eq :: Eq<'a> => ref Tensor<'a> -> ref Tensor<'a> -> bool
fn rec tensor_eq left right =
    if left.shape.length != right.shape.length then false
    else
        let mut same = true
        for axis in 0i64 ..= (left.shape.length - 1) do
            if left.shape[axis] != right.shape[axis] then same = false
        if not same then false
        else
            for i in 0i64 ..= (left.data.length - 1) do
                if not (Eq.eq (ref left.data[i]) (ref right.data[i])) then same = false
            same

instance Eq<'a> => Eq<Tensor<'a>> {
    fn rec eq left right = tensor_eq left right
    fn rec ne left right = not (tensor_eq left right)
}

private def spaces :: own i64 -> string
fn spaces count =
    let mut out = ""
    for _ in 0i64 ..= (count - 1) do out = out + " "
    out

private def rec format_axis :: Display<'a> => ref ['a] -> ref [i64] -> ref [i64] -> own i64 -> own i64 -> own bool -> string
fn rec format_axis data shape strides axis offset summarize =
    let len = shape[axis]
    let rank = shape.length
    if len == 0 then "[]"
    elif axis == rank - 1 then
        let mut out = "["
        if summarize && len > 6 then
            for i in 0i64 ..= 2 do
                if i > 0 then out = out + ", "
                out = out + Display.display (ref data[offset + i * strides[axis]])
            out = out + ", ..., "
            for i in (len - 3) ..= (len - 1) do
                if i > len - 3 then out = out + ", "
                out = out + Display.display (ref data[offset + i * strides[axis]])
        else
            for i in 0i64 ..= (len - 1) do
                if i > 0 then out = out + ", "
                out = out + Display.display (ref data[offset + i * strides[axis]])
        out + "]"
    else
        let mut out = "["
        let indent = spaces (axis + 1)
        let sep = if rank - axis >= 3 then ",\n\n" + indent else ",\n" + indent
        if summarize && len > 6 then
            for i in 0i64 ..= 2 do
                if i > 0 then out = $"{out}{sep}"
                out = out + format_axis data shape strides (axis + 1) (offset + i * strides[axis]) summarize
            out = $"{out}{sep}..."
            for i in (len - 3) ..= (len - 1) do
                let part = format_axis data shape strides (axis + 1) (offset + i * strides[axis]) summarize
                out = $"{out}{sep}{part}"
        else
            for i in 0i64 ..= (len - 1) do
                if i > 0 then out = $"{out}{sep}"
                out = out + format_axis data shape strides (axis + 1) (offset + i * strides[axis]) summarize
        out + "]"

private def rec format_strided :: Display<'a> => ref ['a] -> ref [i64] -> ref [i64] -> own i64 -> string
fn rec format_strided data shape strides offset =
    let total = volume shape
    if shape.length == 0 then Display.display (ref data[offset])
    else format_axis data shape strides 0 offset (total > 1000)

/// Formats a borrowed tensor window with nested brackets and `...` summarization when `count > 1000`.
///
/// ```tsuzuri run=[[1,%202],%0A%20[3,%204]]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.format_view (Tensor.view t)
/// ```
def format_view :: Display<'a> => ref View<'a> -> string
fn format_view view = format_strided view.data (ref view.shape) (ref view.strides) view.offset

instance Display<'a> => Display<Tensor<'a>> {
    fn rec display tensor =
        let strides = dense_strides (ref tensor.shape)
        format_strided (ref tensor.data) (ref tensor.shape) (ref strides) 0
}

instance Display<'a> => Display<View<'a>> {
    fn rec display view = format_strided view.data (ref view.shape) (ref view.strides) view.offset
}

private def slice_raw { r } :: own [Slice.Axis] -> ref { r } ['a] -> own i64 -> ref [i64] -> ref [i64] -> View<'a> { r }
fn slice_raw axes data offset shape strides =
    let in_rank = shape.length
    let mut new_offset = offset
    let mut out_shape = Vec.empty()
    let mut out_strides = Vec.empty()
    let mut in_axis = 0
    for i in 0i64 ..= (axes.length - 1) do
        match axes[i] with
        | Slice.Axis.NewAxis ->
            Vec.push_mut 1 (ref mut out_shape)
            Vec.push_mut 0 (ref mut out_strides)
        | _ ->
            assert (in_axis < in_rank)
            let dim = shape[in_axis]
            let stride = strides[in_axis]
            match Slice.resolve dim (ref axes[i]) with
            | Slice.Resolved.Index pos ->
                new_offset = new_offset + pos * stride
            | Slice.Resolved.Slice (start, len, step) ->
                if len > 0 then
                    new_offset = new_offset + start * stride
                let new_stride =
                    if len <= 1 then stride
                    else
                        match Int.checked_mul stride step with
                        | Maybe.Some s -> s
                        | Maybe.None ->
                            assert false
                            0
                Vec.push_mut len (ref mut out_shape)
                Vec.push_mut new_stride (ref mut out_strides)
            | Slice.Resolved.InsertAxis ->
                Vec.push_mut 1 (ref mut out_shape)
                Vec.push_mut 0 (ref mut out_strides)
            in_axis = in_axis + 1
    while in_axis < in_rank do
        Vec.push_mut shape[in_axis] (ref mut out_shape)
        Vec.push_mut strides[in_axis] (ref mut out_strides)
        in_axis = in_axis + 1
    let shape_arr = Vec.to_array out_shape
    let strides_arr = Vec.to_array out_strides
    assert (shape_arr.length <= 64)
    View { data: data, offset: new_offset, shape: shape_arr, strides: strides_arr }

/// Applies per-axis `Slice.Axis` descriptors to `view` without copying, supporting `All`, `At`,
/// `Range`, `From`, `To`, `Step` (including negative steps), `rev`, and `NewAxis`. Trailing
/// unmentioned axes are kept in full.
///
/// ```tsuzuri run=[8,%207,%205,%204]
/// let t = Tensor.init [3, 3] (\i -> i)
/// let v = Tensor.view (ref t)
/// let sub = Tensor.slice [Slice.step 2 0 (-1), Slice.step 2 0 (-1)] (ref v)
/// Tensor.to_array (Tensor.to_tensor (ref sub))
/// ```
def slice { r } :: own [Slice.Axis] -> ref View<'a> { r } -> View<'a> { r }
fn slice axes view = slice_raw axes view.data view.offset (ref view.shape) (ref view.strides)

instance Copy<'a> => Index<Tensor<'a>, [i64], 'a> {
    fn index coords self =
        let v = view self
        deref (at (Array.copy coords) (ref v))
}

instance Copy<'a> => Index<View<'a>, [i64], 'a> {
    fn index coords self = deref (at (Array.copy coords) self)
}

instance Index<Tensor<'a>, [Slice.Axis], View<'a>> {
    fn index axes self =
        let strides = dense_strides (ref self.shape)
        slice_raw (Array.copy axes) (ref self.data) 0 (ref self.shape) (ref strides)
}

instance Index<View<'a>, [Slice.Axis], View<'a>> {
    fn index axes self = slice (Array.copy axes) self
}

instance IndexMut<Mut<'a>, [i64], 'a> {
    fn index_mut coords value self = write (Array.copy coords) value self
}

