/// ```
def min :: (Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Ord<'a>, Copy<'a>) => ref View<'a> -> 'a
fn min view = reduce_full_slice false slice_min view

/// Minimum along `axis`; traps when the reduced axis is empty and propagates `NaN`.
