/// Extracts the real part of every complex element (`Complex.real`).
///
/// ```tsuzuri run=[3,%205]
/// let t = Tensor.of_array [2] [Complex.of 3.0 4.0, Complex.of 5.0 (-1.0)]
/// Tensor.to_array (Tensor.real (Tensor.view t))
/// ```
def real :: Copy<'a> => ref View<Complex<'a>> -> Tensor<'a>
fn real view = map (\z -> Complex.real (ref z)) view

/// Extracts the imaginary part of every complex element (`Complex.imag`).
///
/// ```tsuzuri run=[4,%20-1]
/// let t = Tensor.of_array [2] [Complex.of 3.0 4.0, Complex.of 5.0 (-1.0)]
/// Tensor.to_array (Tensor.imag (Tensor.view t))
/// ```
def imag :: Copy<'a> => ref View<Complex<'a>> -> Tensor<'a>
fn imag view = map (\z -> Complex.imag (ref z)) view

/// Computes the complex conjugate of every element (`Complex.conj`).
///
/// ```tsuzuri run=[-4]
/// let t = Tensor.of_array [1] [Complex.of 3.0 4.0]
/// let c = Tensor.conj (Tensor.view t)
/// Tensor.to_array (Tensor.imag (Tensor.view c))
/// ```
def conj :: (Float<'a>, Neg<'a>, Copy<'a>) => ref View<Complex<'a>> -> Tensor<Complex<'a>>
fn conj view = map (\z -> Complex.conj (ref z)) view

/// Computes the phase angle in radians of every complex element (`Complex.arg`).
///
/// ```tsuzuri run=[0]
/// let t = Tensor.of_array [1] [Complex.of 2.0 0.0]
/// Tensor.to_array (Tensor.angle (Tensor.view t))
/// ```
def angle :: (Elementary<'a>, Copy<'a>) => ref View<Complex<'a>> -> Tensor<'a>
fn angle view = map (\z -> Complex.arg (ref z)) view

/// Tests each element for `NaN` (`Math.is_nan`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [0.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_nan (Tensor.view t))
/// ```
def is_nan :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_nan view = map Math.is_nan view

/// Tests each element for `±Inf` (`Math.is_infinite`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_infinite (Tensor.view t))
/// ```
def is_infinite :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_infinite view = map Math.is_infinite view

/// Tests whether each element is finite (`Math.is_finite`).
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [1.0 / 0.0, 1.0]
/// Tensor.to_array (Tensor.is_finite (Tensor.view t))
/// ```
def is_finite :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn is_finite view = map Math.is_finite view

/// Tests the IEEE 754 sign bit of each element (`Math.signbit`, `true` on `-0.0`).
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [-0.0, 0.0]
/// Tensor.to_array (Tensor.signbit (Tensor.view t))
/// ```
def signbit :: (Float<'a>, Copy<'a>) => ref View<'a> -> Tensor<bool>
fn signbit view = map Math.signbit view

/// Replaces `NaN` with `nan_val`, `+Inf` with `posinf_val`, and `-Inf` with `neginf_val`.
///
/// ```tsuzuri run=[0,%2099,%20-99,%203]
/// let t = Tensor.of_array [4] [0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 3.0]
/// Tensor.to_array (Tensor.nan_to_num 0.0 99.0 (-99.0) (Tensor.view t))
/// ```
def nan_to_num :: (Float<'a>, Copy<'a>) => own 'a -> own 'a -> own 'a -> ref View<'a> -> Tensor<'a>
fn nan_to_num nan_val posinf_val neginf_val view =
    map (\x ->
        if Math.is_nan x then nan_val
        elif Math.is_infinite x then (if Math.signbit x then neginf_val else posinf_val)
        else x) view

// Element-wise comparisons & approximate equality (§3)
/// Element-wise equality (`left == right`) with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [2] [1, 3]
/// match Tensor.elem_eq (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_eq :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_eq left right = map2 (\x y -> x == y) left right

/// Element-wise inequality (`left != right`) with broadcasting.
///
/// ```tsuzuri run=[false,%20true]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [2] [1, 3]
/// match Tensor.elem_ne (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_ne :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_ne left right = map2 (\x y -> x != y) left right

/// Element-wise `left < right` with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_lt (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_lt :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_lt left right = map2 (\x y -> x < y) left right

/// Element-wise `left <= right` with broadcasting.
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_le (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_le :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_le left right = map2 (\x y -> x <= y) left right

/// Element-wise `left > right` with broadcasting.
///
/// ```tsuzuri run=[false,%20true]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_gt (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_gt :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_gt left right = map2 (\x y -> x > y) left right

/// Element-wise `left >= right` with broadcasting.
///
/// ```tsuzuri run=[true,%20true]
/// let a = Tensor.of_array [2] [2, 5]
/// let b = Tensor.of_array [2] [2, 3]
/// match Tensor.elem_ge (Tensor.view a) (Tensor.view b) with | Result.Ok t -> Tensor.to_array t | Result.Error _ -> []
/// ```
def elem_ge :: (Ord<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn elem_ge left right = map2 (\x y -> x >= y) left right

/// Mask of elements where `x == threshold`.
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [1, 2]
/// Tensor.to_array (Tensor.eq_scalar 2 (Tensor.view t))
/// ```
def eq_scalar :: (Eq<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn eq_scalar threshold view = map (\x -> x == threshold) view

/// Mask of elements where `x != threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1, 2]
/// Tensor.to_array (Tensor.ne_scalar 2 (Tensor.view t))
/// ```
def ne_scalar :: (Eq<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn ne_scalar threshold view = map (\x -> x != threshold) view

/// Mask of elements where `x < threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [1, 3]
/// Tensor.to_array (Tensor.lt_scalar 2 (Tensor.view t))
/// ```
def lt_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn lt_scalar threshold view = map (\x -> x < threshold) view

/// Mask of elements where `x <= threshold`.
///
/// ```tsuzuri run=[true,%20false]
/// let t = Tensor.of_array [2] [2, 3]
/// Tensor.to_array (Tensor.le_scalar 2 (Tensor.view t))
/// ```
def le_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn le_scalar threshold view = map (\x -> x <= threshold) view

/// Mask of elements where `x > threshold` (so `t[Tensor.gt_scalar 0 (Tensor.view t)]` keeps positives).
///
/// ```tsuzuri run=[false,%20true]
/// let t = Tensor.of_array [2] [0, 3]
/// Tensor.to_array (Tensor.gt_scalar 0 (Tensor.view t))
/// ```
def gt_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn gt_scalar threshold view = map (\x -> x > threshold) view

/// Mask of elements where `x >= threshold`.
///
/// ```tsuzuri run=[true,%20true]
/// let t = Tensor.of_array [2] [0, 3]
/// Tensor.to_array (Tensor.ge_scalar 0 (Tensor.view t))
/// ```
def ge_scalar :: (Ord<'a>, Copy<'a>) => own 'a -> ref View<'a> -> Tensor<bool>
fn ge_scalar threshold view = map (\x -> x >= threshold) view

private def close_elem :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> own 'a -> own 'a -> bool
fn close_elem rtol atol equal_nan x y =
    if Math.is_nan x || Math.is_nan y then
        equal_nan && Math.is_nan x && Math.is_nan y
    elif Math.is_infinite x || Math.is_infinite y then
        x == y
    else
        Math.abs (x - y) <= atol + rtol * Math.abs y

/// Element-wise tolerance comparison `|left - right| <= atol + rtol * |right|` with broadcasting
/// (`equal_nan` controls whether two `NaN`s compare equal).
///
/// ```tsuzuri run=[true,%20false]
/// let a = Tensor.of_array [2] [1.0, 1.1]
/// let b = Tensor.of_array [2] [1.0 + 1e-9, 1.0]
/// match Tensor.isclose 1e-5 1e-8 false (Tensor.view a) (Tensor.view b) with
/// | Result.Ok m -> Tensor.to_array m
/// | Result.Error _ -> []
/// ```
def isclose :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> ref View<'a> -> ref View<'a> -> Result<Tensor<bool>, Error>
fn isclose rtol atol equal_nan left right =
    map2 (\x y -> close_elem rtol atol equal_nan x y) left right

/// Returns `true` when `left` and `right` broadcast and every pair satisfies `isclose`.
///
/// ```tsuzuri run=true
/// let a = Tensor.of_array [2] [1.0, 2.0]
/// let b = Tensor.of_array [2] [1.0 + 1e-9, 2.0 - 1e-9]
/// Tensor.allclose 1e-5 1e-8 false (Tensor.view a) (Tensor.view b)
/// ```
def allclose :: (Float<'a>, Add<'a>, Sub<'a>, Mul<'a>, Ord<'a>, Copy<'a>) => own 'a -> own 'a -> own bool -> ref View<'a> -> ref View<'a> -> bool
fn allclose rtol atol equal_nan left right =
    match isclose rtol atol equal_nan left right with
    | Result.Error _ -> false
    | Result.Ok m -> Array.forall (\b -> b) (ref m.data)

private def rec equal_axis :: Eq<'a> => ref View<'a> -> ref View<'a> -> own i64 -> own i64 -> own i64 -> bool
fn rec equal_axis left right axis l_off r_off =
    let rank = left.shape.length
    let dim = left.shape[axis]
    let ls = left.strides[axis]
    let rs = right.strides[axis]
    if axis == rank - 1 then
        let mut ok = true
        for step in 0i64 ..< dim do
            if ok && not (Eq.eq (ref left.data[l_off + step * ls]) (ref right.data[r_off + step * rs])) then ok = false
        ok
    else
        let mut ok = true
        for step in 0i64 ..< dim do
            if ok && not (equal_axis left right (axis + 1) (l_off + step * ls) (r_off + step * rs)) then ok = false
        ok

/// Returns `true` when `left` and `right` have identical shapes and equal elements at all positions.
///
/// ```tsuzuri run=true%20false
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [1, 2] [1, 2]
/// $"{Tensor.array_equal (Tensor.view a) (Tensor.view a)} {Tensor.array_equal (Tensor.view a) (Tensor.view b)}"
/// ```
def array_equal :: Eq<'a> => ref View<'a> -> ref View<'a> -> bool
fn array_equal left right =
    if not (same_shape (ref left.shape) (ref right.shape)) then false
    else
        let total = volume (ref left.shape)
        if total == 0 then true
        elif left.shape.length == 0 then Eq.eq (ref left.data[left.offset]) (ref right.data[right.offset])
        else equal_axis left right 0 left.offset right.offset

/// Returns `true` when `left` and `right` are broadcast-compatible and equal at all broadcast positions.
///
/// ```tsuzuri run=true
/// let a = Tensor.of_array [2] [5, 5]
/// let b = Tensor.of_array [1] [5]
/// Tensor.array_equiv (Tensor.view a) (Tensor.view b)
/// ```
def array_equiv :: (Eq<'a>, Copy<'a>) => ref View<'a> -> ref View<'a> -> bool
fn array_equiv left right =
    match elem_eq left right with
    | Result.Error _ -> false
    | Result.Ok m -> Array.forall (\b -> b) (ref m.data)

// Outer product & axis accumulation (§1 & §4)
/// Computes the outer-table tensor of shape `left.shape ++ right.shape` where each entry is `f x y`.
///
/// ```tsuzuri run=[2,%203]%20[10,%2020,%2030,%2020,%2040,%2060]
/// let a = Tensor.of_array [2] [1, 2]
/// let b = Tensor.of_array [3] [10, 20, 30]
/// let out = Tensor.outer_with (\x y -> x * y) (Tensor.view a) (Tensor.view b)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
/// ```
def outer_with :: (Copy<'a>, Copy<'b>) => own ('a -> 'b -> 'c) -> ref View<'a> -> ref View<'b> -> Tensor<'c>
fn outer_with f left right =
    let lr = left.shape.length
    let rr = right.shape.length
    assert (lr + rr <= 64)
    let out_shape = new [i64](lr + rr, \d -> if d < lr then left.shape[d] else right.shape[d - lr])
    let total = volume (ref out_shape)
    if total == 0 then Tensor { shape: out_shape, data: [] }
    else
        let lp = to_tensor left
        let rp = to_tensor right
        let r_len = rp.data.length
        let l_data = ref lp.data
        let r_data = ref rp.data
        Tensor { shape: out_shape, data: new ['c](total, \idx -> f l_data[idx / r_len] r_data[idx % r_len]) }

/// Applies binary `f` cumulatively along `axis` (ufunc `accumulate`), preserving the input shape.
///
/// ```tsuzuri run=[1,%203,%206,%204,%209,%2015]
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// Tensor.to_array (Tensor.accumulate (\acc x -> acc + x) 1 (Tensor.view t))
/// ```
def accumulate :: Copy<'a> => own ('a -> 'a -> 'a) -> own i64 -> ref View<'a> -> Tensor<'a>
fn accumulate f axis view =
    let rank = view.shape.length
    let norm = normalize_axis axis rank
    let out_shape = Array.copy (ref view.shape)
    let total = volume (ref out_shape)
    if total == 0 then Tensor { shape: out_shape, data: [] }
    else
        let packed = to_tensor view
        let mut out = Array.copy (ref packed.data)
        let dim = out_shape[norm]
        if dim > 1 then
            let mut inner_step = 1
            for d in (norm + 1) ..< rank do inner_step = inner_step * out_shape[d]
            let outer_span = inner_step * dim
            let outer_count = total / outer_span
            for o in 0i64 ..< outer_count do
                let base = o * outer_span
                for k in 0i64 ..< inner_step do
                    let mut acc = out[base + k]
                    for step in 1i64 ..< dim do
                        let slot = base + step * inner_step + k
                        acc = f acc out[slot]
                        Array.write slot acc (ref mut out)
        Tensor { shape: out_shape, data: out }

// ============================================================================
// NC07 — Axis reductions, NaN-ignoring stats, cumulative/diff/interp/convolve,
//        quantiles, histograms, covariance, sorting, selection & 1-D set ops
// ============================================================================

private def total_cmp :: Ord<'a> => own 'a -> own 'a -> i64
fn total_cmp left right =
    let l_nan = !(left == left)
    let r_nan = !(right == right)
    if l_nan && r_nan then 0
    elif l_nan then 1
    elif r_nan then -1
    elif left < right then -1
    elif right < left then 1
    else 0

private def normalize_axes_sorted :: ref [i64] -> own i64 -> [i64]
fn normalize_axes_sorted axes rank =
    let k = axes.length
    if k == 0 then []
    else
        let norm = new [i64](k, \i -> normalize_axis axes[i] rank)
        let sorted = Array.sort (ref norm)
        for i in 1i64 ..< k do
            assert (sorted[i] != sorted[i - 1])
        sorted

private def axis_in_sorted :: ref [i64] -> own i64 -> bool
fn axis_in_sorted sorted target =
    let mut found = false
    for i in 0i64 ..< sorted.length do
        if sorted[i] == target then found = true
    found

// Multi-axis reduction kernel: gathers each reduced fiber in row-major order of `sorted_axes`
// without transposing the whole tensor, then invokes `reducer` on that fiber.
private def reduce_axes_core :: Copy<'a> => own bool -> own (ref ['a] -> 'b) -> ref [i64] -> own bool -> ref View<'a> -> Tensor<'b>
fn reduce_axes_core allow_empty reducer raw_axes keepdims view =
    let rank = view.shape.length
    let red_axes = normalize_axes_sorted raw_axes rank
    let red_rank = red_axes.length
    let rem_rank = rank - red_rank
    let mut rem_axes = new [i64](rem_rank, \_ -> 0)
    let mut rp = 0
    for d in 0i64 ..< rank do
        if !(axis_in_sorted (ref red_axes) d) then
            Array.write rp d (ref mut rem_axes)
            rp = rp + 1
    let red_shape = new [i64](red_rank, \i -> view.shape[red_axes[i]])
    let rem_shape = new [i64](rem_rank, \i -> view.shape[rem_axes[i]])
    let out_shape =
        if keepdims then
            new [i64](rank, \d -> if axis_in_sorted (ref red_axes) d then 1 else view.shape[d])
        else
            Array.copy (ref rem_shape)
    let red_len = volume (ref red_shape)
    if !allow_empty then assert (red_len > 0)
    let out_len = volume (ref out_shape)
    if out_len == 0 then Tensor { shape: out_shape, data: [] }
    else
        let rem_strides = dense_strides (ref rem_shape)
        let red_strides = dense_strides (ref red_shape)
        let v_strides = ref view.strides
        let v_data = view.data
        let v_offset = view.offset
        let out_data = new ['b](out_len, \out_idx ->
            let mut base_off = v_offset
            for i in 0i64 ..< rem_rank do
                let coord = (out_idx / rem_strides[i]) % rem_shape[i]
                base_off = base_off + coord * v_strides[rem_axes[i]]
            let fiber: ['a] =
                if red_len == 0 then []
                elif red_rank == 0 then [v_data[base_off]]
                elif red_rank == 1 then
                    let st = v_strides[red_axes[0]]
                    new ['a](red_len, \k -> v_data[base_off + k * st])
                else
                    new ['a](red_len, \r_idx ->
                        let mut off = base_off
                        for j in 0i64 ..< red_rank do
                            let rc = (r_idx / red_strides[j]) % red_shape[j]
                            off = off + rc * v_strides[red_axes[j]]
                        v_data[off])
            reducer (ref fiber))
        Tensor { shape: out_shape, data: out_data }

private def reduce_axis_core :: Copy<'a> => own bool -> own (ref ['a] -> 'b) -> own i64 -> own bool -> ref View<'a> -> Tensor<'b>
fn reduce_axis_core allow_empty reducer axis keepdims view =
    let axes = [axis]
    reduce_axes_core allow_empty reducer (ref axes) keepdims view

private def reduce_full_slice :: Copy<'a> => own bool -> own (ref ['a] -> 'b) -> ref View<'a> -> 'b
fn reduce_full_slice allow_empty reducer view =
    let packed = to_tensor view
    if !allow_empty then assert (packed.data.length > 0)
    reducer (ref packed.data)

// Applies `lane_fn` to every 1-D lane along `axis`, allowing the output extent along `axis` to be `new_dim`.
private def apply_along_axis_1d :: Copy<'a> => own (ref ['a] -> ['b]) -> own i64 -> own i64 -> ref View<'a> -> Tensor<'b>
fn apply_along_axis_1d lane_fn new_dim axis view =
    let rank = view.shape.length
    let norm = normalize_axis axis rank
    assert (new_dim >= 0)
    let mut out_shape = Array.copy (ref view.shape)
    Array.write norm new_dim (ref mut out_shape)
    let total_out = volume (ref out_shape)
    if total_out == 0 then Tensor { shape: out_shape, data: [] }
    else
        let dim = view.shape[norm]
        let out_strides = dense_strides (ref out_shape)
        let axis_out_stride = out_strides[norm]
        let outer_span = axis_out_stride * new_dim
        let outer_count = total_out / outer_span
        let rem_rank = rank - 1
        let rem_axes = new [i64](rem_rank, \i -> if i < norm then i else i + 1)
        let rem_shape = new [i64](rem_rank, \i -> view.shape[rem_axes[i]])
        let rem_strides = dense_strides (ref rem_shape)
        let sample = new ['a](dim, \k -> view.data[view.offset + k * view.strides[norm]])
        let first_lane = lane_fn (ref sample)
        assert (first_lane.length == new_dim)
        let mut out = new ['b](total_out, \_ -> first_lane[0])
        for o in 0i64 ..< outer_count do
            for inner in 0i64 ..< axis_out_stride do
                let lane_idx = o * axis_out_stride + inner
                let mut base_in = view.offset
                for r in 0i64 ..< rem_rank do
                    let c = (lane_idx / rem_strides[r]) % rem_shape[r]
                    base_in = base_in + c * view.strides[rem_axes[r]]
                let lane_out =
                    if lane_idx == 0 then Array.copy (ref first_lane)
                    else
                        let lane_in = new ['a](dim, \k -> view.data[base_in + k * view.strides[norm]])
                        lane_fn (ref lane_in)
                assert (lane_out.length == new_dim)
                let base_out = o * outer_span + inner
                for k in 0i64 ..< new_dim do
                    Array.write (base_out + k * axis_out_stride) lane_out[k] (ref mut out)
        Tensor { shape: out_shape, data: out }

// ---- Slice reducers ----

private def slice_sum :: Numeric<'a> => ref ['a] -> 'a
fn slice_sum values =
    let mut total = 0i64 as 'a
    for x in values do total = total + x
    total

private def slice_sum_kahan :: Float<'a> => ref ['a] -> 'a
fn slice_sum_kahan values = Array.sum_kahan values

private def slice_prod :: Numeric<'a> => ref ['a] -> 'a
fn slice_prod values =
    let mut total = 1i64 as 'a
    for x in values do total = total * x
    total

private def slice_mean :: Float<'a> => ref ['a] -> 'a
fn slice_mean values =
    let zero: 'a = 0i64 as 'a
    if values.length == 0 then zero / zero
    else slice_sum values / (values.length as 'a)

private def slice_var :: Float<'a> => own i64 -> ref ['a] -> 'a
fn slice_var ddof values =
    let zero: 'a = 0i64 as 'a
    let n = values.length
    if n == 0 || n - ddof <= 0 then zero / zero
    else
        let mu = slice_sum values / (n as 'a)
        let mut acc = zero
        for x in values do
            let d = x - mu
            acc = acc + d * d
        acc / ((n - ddof) as 'a)

private def slice_min :: (Numeric<'a>, Add<'a>, Sub<'a>, Mul<'a>, Div<'a>, Ord<'a>, Copy<'a>) => ref ['a] -> 'a
fn slice_min values =
    assert (values.length > 0)
    let mut best = values[0]
    for i in 1i64 ..< values.length do
        best = min_elem best values[i]
    best

private def slice_max :: (Numeric<'a>, Add<'a>, Ord<'a>, Copy<'a>) => ref ['a] -> 'a
fn slice_max values =
    assert (values.length > 0)
    let mut best = values[0]
    for i in 1i64 ..< values.length do
        best = max_elem best values[i]
    best

private def slice_argmin :: (Ord<'a>, Copy<'a>) => ref ['a] -> i64
fn slice_argmin values =
    assert (values.length > 0)
    let mut best_idx = 0
    let mut best_val = values[0]
    if !(best_val == best_val) then 0
    else
        let mut nan_idx = -1
        for i in 1i64 ..< values.length do
            if nan_idx < 0 then
                let x = values[i]
                if !(x == x) then nan_idx = i
                elif x < best_val then
                    best_val = x
                    best_idx = i
        if nan_idx >= 0 then nan_idx else best_idx

private def slice_argmax :: (Ord<'a>, Copy<'a>) => ref ['a] -> i64
fn slice_argmax values =
    assert (values.length > 0)
    let mut best_idx = 0
    let mut best_val = values[0]
    if !(best_val == best_val) then 0
    else
        let mut nan_idx = -1
        for i in 1i64 ..< values.length do
            if nan_idx < 0 then
                let x = values[i]
                if !(x == x) then nan_idx = i
                elif best_val < x then
                    best_val = x
                    best_idx = i
        if nan_idx >= 0 then nan_idx else best_idx

private def slice_all :: ref [bool] -> bool
fn slice_all values =
    let mut ok = true
    for x in values do
        if !x then ok = false
    ok

private def slice_any :: ref [bool] -> bool
fn slice_any values =
    let mut found = false
    for x in values do
        if x then found = true
    found

private def slice_count_nonzero :: Numeric<'a> => ref ['a] -> i64
fn slice_count_nonzero values =
    let zero: 'a = 0i64 as 'a
    let mut cnt = 0
    for x in values do
        if !(x == zero) then cnt = cnt + 1
    cnt

private def slice_nansum :: Float<'a> => ref ['a] -> 'a
fn slice_nansum values =
    let mut total = 0i64 as 'a
    for x in values do
        if !(Math.is_nan x) then total = total + x
    total

private def slice_nanprod :: Float<'a> => ref ['a] -> 'a
fn slice_nanprod values =
    let mut total = 1i64 as 'a
    for x in values do
        if !(Math.is_nan x) then total = total * x
    total

private def slice_nanmean :: Float<'a> => ref ['a] -> 'a
fn slice_nanmean values =
    let zero: 'a = 0i64 as 'a
    let mut total = zero
    let mut cnt = 0
    for x in values do
        if !(Math.is_nan x) then
            total = total + x
            cnt = cnt + 1
    if cnt == 0 then zero / zero else total / (cnt as 'a)

private def slice_nanvar :: Float<'a> => own i64 -> ref ['a] -> 'a
fn slice_nanvar ddof values =
    let zero: 'a = 0i64 as 'a
    let mut total = zero
    let mut cnt = 0
    for x in values do
        if !(Math.is_nan x) then
            total = total + x
            cnt = cnt + 1
    if cnt == 0 || cnt - ddof <= 0 then zero / zero
    else
        let mu = total / (cnt as 'a)
        let mut acc = zero
        for x in values do
            if !(Math.is_nan x) then
                let d = x - mu
                acc = acc + d * d
        acc / ((cnt - ddof) as 'a)

private def slice_nanmin :: Float<'a> => ref ['a] -> 'a
fn slice_nanmin values =
    assert (values.length > 0)
    let zero: 'a = 0i64 as 'a
    let mut has_val = false
    let mut best = zero / zero
    for x in values do
        if !(Math.is_nan x) then
            if !has_val then
                best = x
                has_val = true
            else
                best = Math.min best x
    best

private def slice_nanmax :: Float<'a> => ref ['a] -> 'a
fn slice_nanmax values =
    assert (values.length > 0)
    let zero: 'a = 0i64 as 'a
    let mut has_val = false
    let mut best = zero / zero
    for x in values do
        if !(Math.is_nan x) then
            if !has_val then
                best = x
                has_val = true
            else
                best = Math.max best x
    best

private def slice_nanargmin :: Float<'a> => ref ['a] -> i64
fn slice_nanargmin values =
    assert (values.length > 0)
    let mut best_idx = -1
    let mut best_val = values[0]
    for i in 0i64 ..< values.length do
        let x = values[i]
        if !(Math.is_nan x) then
            if best_idx < 0 || x < best_val then
                best_idx = i
                best_val = x
    assert (best_idx >= 0)
    best_idx

private def slice_nanargmax :: Float<'a> => ref ['a] -> i64
fn slice_nanargmax values =
    assert (values.length > 0)
    let mut best_idx = -1
    let mut best_val = values[0]
    for i in 0i64 ..< values.length do
        let x = values[i]
        if !(Math.is_nan x) then
            if best_idx < 0 || best_val < x then
                best_idx = i
                best_val = x
    assert (best_idx >= 0)
    best_idx

// ---- §1 Public Reductions & NaN-ignoring Reductions ----

/// Sums all elements of `view` (`0` when empty).
///
/// ```tsuzuri run=21
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// Tensor.sum (Tensor.view t)
/// ```
def sum :: Numeric<'a> => ref View<'a> -> 'a
fn sum view = reduce_full_slice true slice_sum view

/// Sums elements of `view` along `axis` (`keepdims = false`).
///
/// ```tsuzuri run=[5,%207,%209]
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// Tensor.to_array (Tensor.sum_axis 0 (Tensor.view t))
/// ```
def sum_axis :: Numeric<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn sum_axis axis view = reduce_axis_core true slice_sum axis false view

/// Sums elements of `view` along `opts.axis`, optionally retaining reduced axis extent `1`.
///
/// ```tsuzuri run=[1,%203]%20[5,%207,%209]
/// let t = Tensor.of_array [2, 3] [1, 2, 3, 4, 5, 6]
/// let out = Tensor.sum_with (Tensor.AxisOptions { axis: 0, keepdims: true }) (Tensor.view t)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
/// ```
def sum_with :: Numeric<'a> => own AxisOptions -> ref View<'a> -> Tensor<'a>
fn sum_with opts view = reduce_axis_core true slice_sum opts.axis opts.keepdims view

/// Sums elements of `view` over multiple axes (`opts.axes`).
///
/// ```tsuzuri run=[10,%2026]
/// let t = Tensor.of_array [2, 2, 2] [1, 2, 3, 4, 5, 6, 7, 8]
/// Tensor.to_array (Tensor.sum_axes (Tensor.AxesOptions { axes: [1, 2], keepdims: false }) (Tensor.view t))
/// ```
def sum_axes :: Numeric<'a> => own AxesOptions -> ref View<'a> -> Tensor<'a>
fn sum_axes opts view = reduce_axes_core true slice_sum (ref opts.axes) opts.keepdims view

/// Sums all elements using Kahan-Babuška-Neumaier compensated summation.
///
/// ```tsuzuri run=2
/// let t = Tensor.of_array [4] [1.0, 1e100, 1.0, -1e100]
/// Tensor.sum_kahan (Tensor.view t)
/// ```
def sum_kahan :: Float<'a> => ref View<'a> -> 'a
fn sum_kahan view = reduce_full_slice true slice_sum_kahan view

/// Kahan-Babuška-Neumaier compensated sum along `axis`.
///
/// ```tsuzuri run=[2]
/// let t = Tensor.of_array [1, 4] [1.0, 1e100, 1.0, -1e100]
/// Tensor.to_array (Tensor.sum_kahan_axis 1 (Tensor.view t))
/// ```
def sum_kahan_axis :: Float<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn sum_kahan_axis axis view = reduce_axis_core true slice_sum_kahan axis false view

/// Kahan-Babuška-Neumaier compensated sum with `AxisOptions`.
///
/// ```tsuzuri run=[1,%201]
/// let t = Tensor.of_array [1, 4] [1.0, 1e100, 1.0, -1e100]
/// let out = Tensor.sum_kahan_with (Tensor.AxisOptions { axis: 1, keepdims: true }) (Tensor.view t)
/// let ov = Tensor.view out
/// Array.copy (Tensor.shape ov)
/// ```
def sum_kahan_with :: Float<'a> => own AxisOptions -> ref View<'a> -> Tensor<'a>
fn sum_kahan_with opts view = reduce_axis_core true slice_sum_kahan opts.axis opts.keepdims view

/// Multiplies all elements of `view` (`1` when empty).
///
/// ```tsuzuri run=24
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.prod (Tensor.view t)
/// ```
def prod :: Numeric<'a> => ref View<'a> -> 'a
fn prod view = reduce_full_slice true slice_prod view

/// Product of elements along `axis`.
///
/// ```tsuzuri run=[2,%2012]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// Tensor.to_array (Tensor.prod_axis 1 (Tensor.view t))
/// ```
def prod_axis :: Numeric<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn prod_axis axis view = reduce_axis_core true slice_prod axis false view

/// Product of elements along `opts.axis` with optional `keepdims`.
///
/// ```tsuzuri run=[2,%201]%20[2,%2012]
/// let t = Tensor.of_array [2, 2] [1, 2, 3, 4]
/// let out = Tensor.prod_with (Tensor.AxisOptions { axis: 1, keepdims: true }) (Tensor.view t)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
