    fn rec add left right = add_or_trap (ref (view left)) (ref (view right))
}

instance (Sub<'a>, Copy<'a>) => Sub<Tensor<'a>> {
    fn rec sub left right = sub_or_trap (ref (view left)) (ref (view right))
}

