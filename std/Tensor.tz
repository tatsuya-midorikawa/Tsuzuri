/// Counts non-zero elements in `view` (`NaN` counts as non-zero; `-0.0` counts as zero).
///
/// ```tsuzuri run=3
/// let t = Tensor.of_array [5] [0, 2, 0, -5, 1]
/// Tensor.count_nonzero (Tensor.view t)
/// ```
def count_nonzero :: Numeric<'a> => ref View<'a> -> i64
fn count_nonzero view = reduce_full_slice true slice_count_nonzero view

/// Counts non-zero elements along `axis`.
///
/// ```tsuzuri run=[1,%202]
/// let t = Tensor.of_array [2, 3] [0, 2, 0, -5, 0, 1]
/// Tensor.to_array (Tensor.count_nonzero_axis 1 (Tensor.view t))
/// ```
def count_nonzero_axis :: Numeric<'a> => own i64 -> ref View<'a> -> Tensor<i64>
fn count_nonzero_axis axis view = reduce_axis_core true slice_count_nonzero axis false view

/// Counts non-zero elements with `AxisOptions`.
///
/// ```tsuzuri run=[2,%201]%20[1,%202]
/// let t = Tensor.of_array [2, 3] [0, 2, 0, -5, 0, 1]
/// let out = Tensor.count_nonzero_with (Tensor.AxisOptions { axis: 1, keepdims: true }) (Tensor.view t)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
/// ```
def count_nonzero_with :: Numeric<'a> => own AxisOptions -> ref View<'a> -> Tensor<i64>
fn count_nonzero_with opts view = reduce_axis_core true slice_count_nonzero opts.axis opts.keepdims view

