/// Arithmetic mean ignoring `NaN` (`NaN` when empty or all `NaN`).
///
/// ```tsuzuri run=2.5
/// let t = Tensor.of_array [3] [2.0, 0.0 / 0.0, 3.0]
/// Tensor.nanmean (Tensor.view t)
/// ```
def nanmean :: Float<'a> => ref View<'a> -> 'a
fn nanmean view = reduce_full_slice true slice_nanmean view

/// Arithmetic mean along `axis` ignoring `NaN`.
///
/// ```tsuzuri run=[2,%203.5]
/// let t = Tensor.of_array [2, 2] [2.0, 0.0 / 0.0, 3.0, 4.0]
/// Tensor.to_array (Tensor.nanmean_axis 1 (Tensor.view t))
/// ```
def nanmean_axis :: Float<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn nanmean_axis axis view = reduce_axis_core true slice_nanmean axis false view

/// Arithmetic mean with `AxisOptions` ignoring `NaN`.
///
/// ```tsuzuri run=[2,%201]%20[2,%203.5]
/// let t = Tensor.of_array [2, 2] [2.0, 0.0 / 0.0, 3.0, 4.0]
/// let out = Tensor.nanmean_with (Tensor.AxisOptions { axis: 1, keepdims: true }) (Tensor.view t)
/// let ov = Tensor.view out
/// $"{Tensor.shape ov} {Tensor.as_array out}"
/// ```
def nanmean_with :: Float<'a> => own AxisOptions -> ref View<'a> -> Tensor<'a>
fn nanmean_with opts view = reduce_axis_core true slice_nanmean opts.axis opts.keepdims view

/// Population variance (`ddof = 0`) ignoring `NaN`.
///
/// ```tsuzuri run=1
/// let t = Tensor.of_array [3] [1.0, 0.0 / 0.0, 3.0]
/// Tensor.nanvar (Tensor.view t)
/// ```
def nanvar :: Float<'a> => ref View<'a> -> 'a
fn nanvar view = reduce_full_slice true (\s -> slice_nanvar 0 s) view

/// Population variance (`ddof = 0`) along `axis` ignoring `NaN`.
///
/// ```tsuzuri run=[0,%201]
/// let t = Tensor.of_array [2, 2] [2.0, 0.0 / 0.0, 1.0, 3.0]
/// Tensor.to_array (Tensor.nanvar_axis 1 (Tensor.view t))
/// ```
def nanvar_axis :: Float<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn nanvar_axis axis view = reduce_axis_core true (\s -> slice_nanvar 0 s) axis false view

/// Variance ignoring `NaN` with `VarianceOptions`.
///
/// ```tsuzuri run=[2]
/// let t = Tensor.of_array [3] [1.0, 0.0 / 0.0, 3.0]
/// let opts = Tensor.VarianceOptions { axis: Maybe.Some 0, keepdims: true, ddof: 1 }
/// Tensor.to_array (Tensor.nanvar_with opts (Tensor.view t))
/// ```
def nanvar_with :: Float<'a> => own VarianceOptions -> ref View<'a> -> Tensor<'a>
fn nanvar_with opts view =
    let d = opts.ddof
    match opts.axis with
    | Maybe.Some ax -> reduce_axis_core true (\s -> slice_nanvar d s) ax opts.keepdims view
    | Maybe.None ->
        let val = reduce_full_slice true (\s -> slice_nanvar d s) view
        if opts.keepdims then Tensor { shape: new [i64](view.shape.length, \_ -> 1), data: [val] }
        else Tensor { shape: [], data: [val] }

/// Population standard deviation (`ddof = 0`) ignoring `NaN`.
///
/// ```tsuzuri run=1
/// let t = Tensor.of_array [3] [1.0, 0.0 / 0.0, 3.0]
/// Tensor.nanstd (Tensor.view t)
/// ```
def nanstd :: Float<'a> => ref View<'a> -> 'a
fn nanstd view = Math.sqrt (nanvar view)

/// Population standard deviation (`ddof = 0`) along `axis` ignoring `NaN`.
///
/// ```tsuzuri run=[0,%201]
/// let t = Tensor.of_array [2, 2] [2.0, 0.0 / 0.0, 1.0, 3.0]
/// Tensor.to_array (Tensor.nanstd_axis 1 (Tensor.view t))
/// ```
def nanstd_axis :: Float<'a> => own i64 -> ref View<'a> -> Tensor<'a>
fn nanstd_axis axis view =
    let vt = nanvar_axis axis view
    map Math.sqrt (ref (Tensor.view vt))

/// Standard deviation ignoring `NaN` with `VarianceOptions`.
///
/// ```tsuzuri run=[1]
/// let t = Tensor.of_array [3] [0.0, 0.0 / 0.0, 2.0]
/// let opts = Tensor.VarianceOptions { axis: Maybe.Some 0, keepdims: true, ddof: 0 }
/// Tensor.to_array (Tensor.nanstd_with opts (Tensor.view t))
/// ```
def nanstd_with :: Float<'a> => own VarianceOptions -> ref View<'a> -> Tensor<'a>
fn nanstd_with opts view =
    let vt = nanvar_with opts view
    map Math.sqrt (ref (Tensor.view vt))

/// Minimum element ignoring `NaN` (`NaN` if all elements are `NaN`; traps when empty).
