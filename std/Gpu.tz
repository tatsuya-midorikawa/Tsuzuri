union Backend = CpuReference | WebGpu | Vulkan | Cuda | Metal | Auto
union Error = Unavailable
record Device { backend: Backend }
record Buffer<'a> { values: ['a] }

/// Requests a device for `backend`. `CpuReference` and `Auto` always succeed; `WebGpu` and `Vulkan` succeed
/// only when the runtime opens such a device and it has what the program's kernels need; `Cuda` and `Metal`
/// are `Error Unavailable`. A failed request is never replaced by the CPU.
///
/// ```tsuzuri run=ok,%20unavailable
/// def status :: own Gpu.Backend -> string
/// fn status backend = match Gpu.request backend with
///     | Result.Ok _ -> "ok"
///     | Result.Error Gpu.Unavailable -> "unavailable"
/// status Gpu.CpuReference + ", " + status Gpu.Cuda
/// ```
def request :: own Backend -> Result<Device, Error>
fn request backend = match backend with
    | CpuReference -> Result.Ok (Device { backend: backend })
    | _ -> Result.Error Unavailable

/// The backend that `device` was requested for; an `Auto` device is `Auto`, whatever runs its calls.
///
/// ```tsuzuri run=CPU%20reference
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// match Gpu.backend device with
/// | Gpu.CpuReference -> "CPU reference"
/// | _ -> "another backend"
/// ```
def backend :: ref Device -> Backend
fn backend device = device.backend

/// Makes a buffer of `count` elements on `device`, element `i` being `initializer i`. A `count` outside 0 to
/// 2147483647 traps.
///
/// ```tsuzuri run=[0,%201,%204,%209,%2016]
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// Gpu.to_array (Gpu.init device 5 (\index -> index * index))
/// ```
def init :: ref Device -> own i64 -> own (i32 -> 'a) -> Buffer<'a>
fn init _device count initializer =
    assert (count >= 0 && count <= 2147483647)
    Buffer { values: Array.init count (\index -> initializer (index as i32)) }

/// Applies `transform` to each element of `buffer` on `device`, consuming the buffer, and returns the results
/// as a new buffer.
///
/// ```tsuzuri run=[10,%2020,%2030]
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// let buffer = Gpu.from_array device [1, 2, 3]
/// Gpu.to_array (Gpu.map device (\value -> value * 10) buffer)
/// ```
def map :: Copy<'a> => ref Device -> own ('a -> 'b) -> own Buffer<'a> -> Buffer<'b>
fn map _device transform buffer =
    let values = buffer.values
    Buffer { values: Array.map_owned transform (ref values) }

/// Makes a buffer as `init` does, but a GPU device may compute `f32` and `f16` lanes with relaxed precision;
/// the CPU reference gives the exact result of `init`.
///
/// ```tsuzuri run=[0,%200.5,%201,%201.5]
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// Gpu.to_array (Gpu.init_relaxed device 4 (\index -> (index as f32) * 0.5f32))
/// ```
def init_relaxed :: ref Device -> own i64 -> own (i32 -> 'a) -> Buffer<'a>
fn init_relaxed device count initializer = init device count initializer

/// Transforms a buffer as `map` does, but a GPU device may compute `f32` and `f16` lanes with relaxed
/// precision; the CPU reference gives the exact result of `map`.
///
/// ```tsuzuri run=[0.25,%200.5,%201]
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// let buffer = Gpu.from_array device [1.0f32, 2.0f32, 4.0f32]
/// Gpu.to_array (Gpu.map_relaxed device (\value -> value * 0.25f32) buffer)
/// ```
def map_relaxed :: Copy<'a> => ref Device -> own ('a -> 'b) -> own Buffer<'a> -> Buffer<'b>
fn map_relaxed device transform buffer = map device transform buffer

// The device-aware forms (F09 Phases 2 and 3), private to this module. A program that builds a non-CPU
// backend calls them instead of request, init, map, init_relaxed, and map_relaxed; the compiler adds the
// number of the call's kernel (-1: the call has no kernel for a device) as the last argument. A device of
// the WebGpu or Vulkan backend can only exist where the runtime opened one, and it runs the kernel of the
// call site: there is no run on the CPU, and a call without a kernel for that backend (a strict call whose
// lanes or operations the backend cannot reproduce) traps there after the runtime says why. A device of the
// Auto backend needs no open: each call asks the runtime for the CPU reference or Vulkan by its measured
// cost rule, so it always exists, and the CPU reference serves a call whenever no device is available or
// worth its cost.
private def request_on :: own Backend -> Result<Device, Error>
fn request_on backend = match backend with
    | CpuReference -> Result.Ok (Device { backend: backend })
    | WebGpu -> if Gpu.__open 1 (Gpu.__features()) == 0 then Result.Ok (Device { backend: backend }) else Result.Error Unavailable
    | Vulkan -> if Gpu.__open 2 (Gpu.__features()) == 0 then Result.Ok (Device { backend: backend }) else Result.Error Unavailable
    | Auto -> Result.Ok (Device { backend: backend })
    | _ -> Result.Error Unavailable

// The number of a backend in the runtime: its case index.
private def backend_code :: own Backend -> i32
fn backend_code backend = match backend with
    | CpuReference -> 0
    | WebGpu -> 1
    | Vulkan -> 2
    | Cuda -> 3
    | Metal -> 4
    | Auto -> 5

private def init_on :: ref Device -> own i64 -> own (i32 -> 'a) -> own i64 -> Buffer<'a>
fn init_on device count initializer kernel =
    assert (count >= 0 && count <= 2147483647)
    let backend = Gpu.__select (backend_code device.backend) kernel 1 count
    match backend with
    | 0 -> Buffer { values: Array.init count (\index -> initializer (index as i32)) }
    | _ -> {
        let none: [i32] = [];
        Buffer { values: Gpu.__run backend kernel 1 (ref none) count }
    }

private def map_on :: Copy<'a> => ref Device -> own ('a -> 'b) -> own Buffer<'a> -> own i64 -> Buffer<'b>
fn map_on device transform buffer kernel =
    let values = buffer.values
    let backend = Gpu.__select (backend_code device.backend) kernel 0 values.length
    match backend with
    | 0 -> Buffer { values: Array.map_owned transform (ref values) }
    | _ -> Buffer { values: Gpu.__run backend kernel 0 (ref values) values.length }

/// The backend that served the most recent `Gpu.init` or `Gpu.map` call (relaxed or not) of a program
/// that names a non-CPU backend: `CpuReference` before any such call, and the backend that actually ran
/// the call when the device was a `Gpu.Auto` one. Calls of other threads can come in any order.
///
/// ```tsuzuri
/// let device = Result.get (Gpu.request Gpu.Auto)
/// let _doubled = Gpu.init device 1000000 (\index -> index * 2)
/// match Gpu.last_backend () with
/// | Gpu.Vulkan -> IO.write_line "ran on Vulkan"
/// | _ -> IO.write_line "ran on the CPU reference"
/// ```
def last_backend :: own unit -> Backend
fn last_backend _unit = match Gpu.__last() with
    | 1 -> WebGpu
    | 2 -> Vulkan
    | _ -> CpuReference

/// Copies the array `values` into a new buffer on `device`.
///
/// ```tsuzuri run=[7,%208,%209]
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// let buffer = Gpu.from_array device [7, 8, 9]
/// Gpu.to_array buffer
/// ```
def from_array :: Copy<'a> => ref Device -> ref ['a] -> Buffer<'a>
fn from_array _device values = Buffer { values: deref values }

/// The elements of `buffer` as an array; the buffer is consumed.
///
/// ```tsuzuri run=6
/// let device = Result.get (Gpu.request Gpu.CpuReference)
/// let values = Gpu.to_array (Gpu.init device 3 (\index -> index + 1))
/// Array.sum values
/// ```
def to_array :: own Buffer<'a> -> ['a]
fn to_array buffer = buffer.values
