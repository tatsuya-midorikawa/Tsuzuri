/// Joins two paths with "/". An empty left path gives the right one, and an absolute right path
/// is only appended: nothing here is a sandbox.
def join :: ref string -> ref string -> string
fn join left right =
	let tail = Option.get (String.slice right 0 right.length)
	if left.length == 0 then tail
	else
		let head = Option.get (String.slice left 0 left.length)
		if left[left.length - 1] == 47i16u then head + tail else head + "/" + tail

/// Where the last name of a path ends: trailing "/" are dropped, but a lone "/" stays.
private def name_end :: ref string -> i64
fn name_end path =
	let mut end = path.length
	while end > 1 && path[end - 1] == 47i16u do end = end - 1
	end

/// Where the last name of `path[..end]` starts, or -1 when it has no "/".
private def name_start :: ref string -> i64 -> i64
fn name_start path end =
	let mut index = end - 1
	while index >= 0 && path[index] != 47i16u do index = index - 1
	index

/// The path without its last name, without trailing "/" except for a lone "/".
/// "a" and "/" and "" have none.
def parent :: ref string -> Option<string>
fn parent path =
	let end = name_end path
	if end == 1 && path[0] == 47i16u then Option.None
	else
		let slash = name_start path end
		if slash < 0 then Option.None
		else
			let mut stop = slash
			while stop > 1 && path[stop - 1] == 47i16u do stop = stop - 1
			Option.get (String.slice path 0 (if stop == 0 then 1 else stop)) |> Option.Some

/// The last name of a path, or `None` for "", "/", ".", and "..".
def file_name :: ref string -> Option<string>
fn file_name path =
	let end = name_end path
	let start = name_start path end + 1
	if end == 0 || (end == 1 && path[0] == 47i16u) then Option.None
	else
		let name = Option.get (String.slice path start end)
		if name == "." || name == ".." then Option.None else Option.Some name

/// What follows the last "." of the last name; a name that starts with its only "." has none.
def extension :: ref string -> Option<string>
fn extension path =
	match file_name path with
	| Option.None -> Option.None
	| Option.Some name ->
		let mut dot = name.length - 1
		while dot > 0 && name[dot] != 46i16u do dot = dot - 1
		if dot <= 0 then Option.None else String.slice (ref name) (dot + 1) name.length
