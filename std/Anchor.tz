/// An owner of a value stored in the runtime's anchor table, reachable on the creating OS thread
/// through an `i64` token (`Anchor.create`, `Anchor.token`, `Anchor.read`, `Anchor.update`, W23).
record Anchor<'a> { token: i64 }

instance Drop<Anchor<'a>> {
    fn drop anchor = Anchor.__release anchor.token
}

/// Why `Anchor.read` or `Anchor.update` did not access the anchored value.
union Error = Stale | WrongType | WrongThread | Busy deriving (Eq)

instance Display<Error> {
    fn display error =
        match error with
        | Stale -> "stale anchor token"
        | WrongType -> "anchor token has a different value type"
        | WrongThread -> "anchor token belongs to another thread"
        | Busy -> "anchor value is already borrowed"
}

/// The `i64` token for `anchor`, valid until `anchor` is dropped and never `0`.
///
/// ```tsuzuri run=true
/// let state = Anchor.create 42
/// let key = Anchor.token (ref state)
/// key > 0
/// ```
def token :: ref Anchor<'a> -> i64
fn token anchor = anchor.token

/// An owner of a value that every thread may read through its token (`Anchor.create_shared`,
/// `Anchor.shared_token`, `Anchor.read_shared`, M09): a thread of the host that has not joined the
/// runtime too. The value is Send and Sync and is never changed in place; put a `Mutex`, an
/// `Atomic` or a `Channel` in it to change state or to send to a tzroutine.
record Shared<'a> { token: i64 }

instance Drop<Shared<'a>> {
    fn drop shared = Anchor.__release shared.token
}

/// The `i64` token for `shared`, valid until `shared` is dropped (or, once detached, until
/// `Anchor.release_shared`) and never `0`.
///
/// ```tsuzuri run=true
/// let state = Anchor.create_shared 42
/// let key = Anchor.shared_token (ref state)
/// key > 0
/// ```
def shared_token :: ref Shared<'a> -> i64
fn shared_token shared = shared.token

/// Gives up `shared` and returns its token: the value stays readable until
/// `Anchor.release_shared` names the token, for an entry that outlives the function that made it.
///
/// ```tsuzuri run=true%20false
/// let key = Anchor.detach_shared (Anchor.create_shared 42)
/// let first = Anchor.release_shared key
/// let second = Anchor.release_shared key
/// $"{first} {second}"
/// ```
def detach_shared :: own Shared<'a> -> i64
fn detach_shared shared =
    let token = shared.token
    Anchor.__detach token
    token
