private def names_of :: i64 -> [ubyte] -> Result<[string], Os.Error>
fn names_of status bytes =
	if status == 0 then Os.split_names (ref bytes) else Result.Error (Os.error_of_status status)

private def variable :: ref string -> Result<Option<string>, Os.Error>
fn variable name =
	match Os.encode name with
	| Result.Error error -> Result.Error error
	| Result.Ok text ->
		match Os.__read 3i32 (ref text) with
		| (0, bytes) ->
			match Os.decode bytes with
			| Result.Ok value -> Result.Ok (Option.Some value)
			| Result.Error error -> Result.Error error
		| (status, _) ->
			let error = Os.error_of_status status
			match error.kind with
			| Os.NotFound -> Result.Ok Option.None
			| _ -> Result.Error error

private def working_directory :: unit -> Result<string, Os.Error>
fn working_directory _unit =
	let empty = u8""
	match Os.__read 2i32 (ref empty) with
	| (0, bytes) -> Os.decode bytes
	| (status, _) -> Result.Error (Os.error_of_status status)

/// The command-line arguments after the program name. Without arguments, or when a host
/// did not pass them (a library or a test executable), it is empty.
def args :: unit -> IO<Result<[string], Os.Error>>
fn args _unit = IO.map (\() ->
	match Os.__args () with
	| (status, bytes) -> names_of status bytes) (IO.pure ())

/// An environment variable; an unset one is `Ok None`. A name that is empty or contains `=` or
/// a NUL is `InvalidInput`, and a value that is not UTF-8 is `InvalidEncoding`.
def var :: string -> IO<Result<Option<string>, Os.Error>>
fn var name = IO.map (\() -> variable (ref name)) (IO.pure ())

/// The working directory, as the system reports it.
def current_dir :: unit -> IO<Result<string, Os.Error>>
fn current_dir _unit = IO.map (\() -> working_directory ()) (IO.pure ())
