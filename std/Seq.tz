record Seq<'a> {
    head: Option.Option<'a>,
    step: Option.Option<unit -> (Seq<'a> * Option.Option<'a>)>
}

def empty :: Seq<'a>
fn empty = Seq { head: Option.None, step: Option.None }

def once :: 'a -> Seq<'a>
fn once value = Seq { head: Option.Some value, step: Option.None }

def defer :: (unit -> (Seq<'a> * Option.Option<'a>)) -> Seq<'a>
fn defer step = Seq { head: Option.None, step: Option.Some step }

def rec unfold :: Capture<'state> => ('state -> Option.Option<('a * 'state)>) -> 'state -> Seq<'a>
fn rec unfold generator state = defer (\() ->
    match generator state with
    | Option.Some (value, remaining) -> (unfold generator remaining, Option.Some value)
    | Option.None -> (empty(), Option.None))

def rec map :: Capture<'a> => ('a -> 'b) -> Seq<'a> -> Seq<'b>
fn rec map transform sequence = defer (\() ->
    match Seq.next sequence with
    | (remaining, Option.Some value) -> (map transform remaining, Option.Some (transform value))
    | (_, Option.None) -> (empty(), Option.None))

def rec filter :: Capture<'a> => (ref 'a -> bool) -> Seq<'a> -> Seq<'a>
fn rec filter predicate sequence = defer (\() ->
    let mut current = sequence
    let mut selected: Option.Option<'a> = Option.None
    let mut finished = false
    while !finished do
        match Seq.next current with
        | (remaining, value) ->
            current = remaining
            match value with
            | Option.Some item ->
                if predicate (ref item) then
                    selected = Option.Some item
                    finished = true
            | Option.None -> finished = true
    let remaining = if Option.is_some (ref selected) then filter predicate current else empty()
    (remaining, selected))

def to_array :: Seq<'a> -> ['a]
fn to_array sequence =
    let mut values = Vec.empty()
    for value in sequence do values = Vec.push values value
    Vec.to_array values

