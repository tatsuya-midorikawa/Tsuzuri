// The `List<T>` class of .NET in Tsuzuri: the same members in snake_case (`FindIndex` is `find_index`), the receiver
// first, then the arguments in the .NET order, with an `i64` for every index and count. Where .NET returns a negative
// number (`-1`, or the complement of the insertion point of a binary search) this module does too, and where .NET
// throws an exception it traps. A `Vec` is an owned value: an operation that changes it takes the `Vec` and returns the
// changed one, as `Vec.push` does (`remove` and `remove_all` return a tuple with their result). Callbacks that read an
// element take it by value, so the element type must be `Copy`; the `r` forms (`existsr`, `findr`, `containsr`, ...)
// borrow each element, or the item to look for, and work for any element type.

private def rec iter_from :: ref Vec<'a> -> i64 -> Seq<ref 'a>
fn rec iter_from values index = Seq.defer (\() ->
    if index < Vec.length values then (iter_from values (index + 1), Maybe.Some (ref values[index]))
    else (Seq.empty(), Maybe.None))

def iter :: ref Vec<'a> -> Seq<ref 'a>
fn iter values = iter_from values 0

// ---- Construction ----

/// A `Vec` of the elements of a sequence, as `new List<T>(IEnumerable<T>)`.
def of_seq :: Seq<'a> -> Vec<'a>
fn of_seq items = add_range_seq (Vec.empty()) items

/// A `Vec` of the elements of a list, which are copied.
def of_list :: Copy<'a> => ref [|'a|] -> Vec<'a>
fn of_list items = Vec.of_array (List.to_array items)

// ---- Capacity ----

/// The capacity that .NET grows to for `required` elements: twice the capacity (4 for none), or `required` if that is more.
private def grown_capacity :: i64 -> i64 -> i64
fn grown_capacity capacity required =
    let doubled =
        if capacity == 0 then 4
        elif capacity > 4611686018427387903 then required
        else capacity * 2
    if required > doubled then required else doubled

/// Sets the capacity (`Capacity = value`), which must not be less than the length.
def set_capacity :: Vec<'a> -> i64 -> Vec<'a>
fn set_capacity values capacity = Vec.__set_capacity values capacity

/// Makes the capacity at least `capacity` elements in all (not additional ones, unlike `Vec.reserve`); the new
/// capacity is `Vec.capacity` of the result.
def ensure_capacity :: Vec<'a> -> i64 -> Vec<'a>
fn ensure_capacity values capacity =
    assert (capacity >= 0)
    let current = Vec.capacity (ref values)
    if current < capacity then Vec.__set_capacity values (grown_capacity current capacity) else values

/// Shrinks the capacity to the length when the length is below 90% of the capacity.
def trim_excess :: Vec<'a> -> Vec<'a>
fn trim_excess values =
    let capacity = Vec.capacity (ref values)
    let threshold = capacity / 10 * 9 + capacity % 10 * 9 / 10
    let length = Vec.length (ref values)
    if length < threshold then Vec.__set_capacity values length else values

// ---- Adding ----

def add :: Vec<'a> -> 'a -> Vec<'a>
fn add values item = Vec.push values item

/// Adds copies of the elements of an array at the end.
def add_range :: Copy<'a> => Vec<'a> -> ref ['a] -> Vec<'a>
fn add_range values items =
    let length = Vec.length (ref values)
    Vec.__splice values length 0 (deref items)

/// Adds the elements of a sequence at the end, which may be any type, as the sequence gives them up one by one.
def add_range_seq :: Vec<'a> -> Seq<'a> -> Vec<'a>
fn add_range_seq values items =
    let mut result = values
    for item in items do result = Vec.push result item
    result

/// Moves all the elements of `other` to the end of `values`; the elements need not be `Copy`.
def append :: Vec<'a> -> Vec<'a> -> Vec<'a>
fn append values other =
    let length = Vec.length (ref values)
    Vec.__splice values length 0 (Vec.to_array other)

/// Inserts an element at `index`, which may be the length, and moves the later elements up.
def insert :: Vec<'a> -> i64 -> 'a -> Vec<'a>
fn insert values index item = Vec.__insert values index item

def insert_range :: Copy<'a> => Vec<'a> -> i64 -> ref ['a] -> Vec<'a>
fn insert_range values index items = Vec.__splice values index 0 (deref items)

def insert_range_seq :: Vec<'a> -> i64 -> Seq<'a> -> Vec<'a>
fn insert_range_seq values index items =
    assert (index >= 0 && index <= Vec.length (ref values))
    Vec.__splice values index 0 (Vec.to_array (of_seq items))

// ---- Removing ----

def remove_at :: Vec<'a> -> i64 -> Vec<'a>
fn remove_at values index = Vec.__splice values index 1 []

def remove_range :: Vec<'a> -> i64 -> i64 -> Vec<'a>
fn remove_range values index count = Vec.__splice values index count []

/// Removes the first element equal to `item`; the result says whether there was one.
def remover :: Eq<'a> => Vec<'a> -> ref 'a -> (Vec<'a> * bool)
fn remover values item =
    let index = index_ofr (ref values) item
    if index >= 0 then (remove_at values index, true) else (values, false)

def remove :: Eq<'a> => Vec<'a> -> 'a -> (Vec<'a> * bool)
fn remove values item = remover values (ref item)

/// Moves the elements that the predicate rejects to the front, in order, and returns their number. The predicate runs
/// once for each element, in order; the other elements end up behind them in no particular order.
private def compact :: (ref 'a -> bool) -> ref mut ['a..] -> i64
fn compact predicate view =
    let length = view.length
    let mut kept = 0
    let mut index = 0
    while index < length do
        if !(predicate (ref view[index])) then
            if kept != index then Array.swap_in view kept index
            kept = kept + 1
        index = index + 1
    kept

private def compact_values :: Copy<'a> => ('a -> bool) -> ref mut ['a..] -> i64
fn compact_values predicate view =
    let length = view.length
    let mut kept = 0
    let mut index = 0
    while index < length do
        if !(predicate view[index]) then
            if kept != index then Array.swap_in view kept index
            kept = kept + 1
        index = index + 1
    kept

/// Removes every element that the predicate accepts and returns how many there were. The remaining elements keep their
/// order; the removed ones are dropped after the last call of the predicate, in no particular order.
def remove_allr :: Vec<'a> -> (ref 'a -> bool) -> (Vec<'a> * i64)
fn remove_allr values predicate =
    let mut owned = values
    let kept = compact predicate (Vec.__view (ref mut owned))
    let removed = Vec.length (ref owned) - kept
    (Vec.truncate owned kept, removed)

def remove_all :: Copy<'a> => Vec<'a> -> ('a -> bool) -> (Vec<'a> * i64)
fn remove_all values predicate =
    let mut owned = values
    let kept = compact_values predicate (Vec.__view (ref mut owned))
    let removed = Vec.length (ref owned) - kept
    (Vec.truncate owned kept, removed)

// ---- Reversing and sorting ----

private def reverse_slice :: ref mut ['a..] -> i64 -> i64 -> unit
fn reverse_slice view first count =
    let mut low = first
    let mut high = first + count - 1
    while low < high do
        Array.swap_in view low high
        low = low + 1
        high = high - 1

def reverse :: Vec<'a> -> Vec<'a>
fn reverse values =
    let mut owned = values
    let length = Vec.length (ref owned)
    reverse_slice (Vec.__view (ref mut owned)) 0 length
    owned

def reverse_range :: Vec<'a> -> i64 -> i64 -> Vec<'a>
fn reverse_range values index count =
    assert (index >= 0 && count >= 0 && Vec.length (ref values) - index >= count)
    let mut owned = values
    reverse_slice (Vec.__view (ref mut owned)) index count
    owned

/// Gives each element the place that `order` names: position `p` gets the element that was at `order[p]`. The order is
/// used up.
private def arrange :: ref mut ['a..] -> ref mut [i64..] -> unit
fn arrange view order =
    for start in 0 .. (order.length - 1) do
        if order[start] != start then
            let mut current = start
            while order[current] != start do
                let next = order[current]
                Array.swap_in view current next
                Array.write order current current
                current = next
            Array.write order current current

/// Moves the elements that differ from themselves (a NaN) to the front, in their order, and returns their number; .NET
/// sorts a NaN before every number.
private def unordered_first :: Eq<'a> => ref mut ['a..] -> i64
fn unordered_first view =
    let length = view.length
    let mut found = 0
    for index in 0 .. (length - 1) do
        if !(Eq.eq (ref view[index]) (ref view[index])) then found = found + 1
    if found > 0 then
        let mut places: Vec<i64> = Vec.with_capacity length
        for index in 0 .. (length - 1) do
            if !(Eq.eq (ref view[index]) (ref view[index])) then places = Vec.push places index
        for index in 0 .. (length - 1) do
            if Eq.eq (ref view[index]) (ref view[index]) then places = Vec.push places index
        let mut order = Vec.to_array places
        arrange view (ref mut order)
    found

private def sort_view :: Ord<'a> => ref mut ['a..] -> i64 -> i64 -> unit
fn sort_view view index count =
    let window = ref mut view[index .. index + count]
    let numbers = unordered_first window
    Array.sort_in_place (ref mut window[numbers .. window.length])

/// Sorts a range in place, stably, with `Ord`; a NaN comes first, as in .NET.
def sort_range :: Ord<'a> => Vec<'a> -> i64 -> i64 -> Vec<'a>
fn sort_range values index count =
    assert (index >= 0 && count >= 0 && Vec.length (ref values) - index >= count)
    let mut owned = values
    sort_view (Vec.__view (ref mut owned)) index count
    owned

def sort :: Ord<'a> => Vec<'a> -> Vec<'a>
fn sort values =
    let length = Vec.length (ref values)
    sort_range values 0 length

private def sort_view_with :: Copy<'a> => ('a -> 'a -> i64) -> ref mut ['a..] -> i64 -> i64 -> unit
fn sort_view_with comparison view index count =
    Array.sort_in_place_with comparison (ref mut view[index .. index + count])

/// Sorts a range in place, stably, with a comparison that returns a negative number, zero or a positive number.
def sort_range_with :: Copy<'a> => Vec<'a> -> i64 -> i64 -> ('a -> 'a -> i64) -> Vec<'a>
fn sort_range_with values index count comparison =
    assert (index >= 0 && count >= 0 && Vec.length (ref values) - index >= count)
    let mut owned = values
    sort_view_with comparison (Vec.__view (ref mut owned)) index count
    owned

def sort_with :: Copy<'a> => Vec<'a> -> ('a -> 'a -> i64) -> Vec<'a>
fn sort_with values comparison =
    let length = Vec.length (ref values)
    sort_range_with values 0 length comparison

/// Sorts a range in place, like `sort_range_with`, but the comparison borrows the elements, so they need not be `Copy`.
/// Insertion sorts blocks of 20 elements, then merges them by rotation (SymMerge), so it is stable and takes no
/// extra memory.
def sort_range_withr :: Vec<'a> -> i64 -> i64 -> (ref 'a -> ref 'a -> i64) -> Vec<'a>
fn sort_range_withr values index count comparison =
    assert (index >= 0 && count >= 0 && Vec.length (ref values) - index >= count)
    let mut owned = values
    sort_view_by comparison (Vec.__view (ref mut owned)) index count
    owned

def sort_withr :: Vec<'a> -> (ref 'a -> ref 'a -> i64) -> Vec<'a>
fn sort_withr values comparison =
    let length = Vec.length (ref values)
    sort_range_withr values 0 length comparison

private def sort_view_by :: (ref 'a -> ref 'a -> i64) -> ref mut ['a..] -> i64 -> i64 -> unit
fn sort_view_by comparison view index count =
    sort_slice_by comparison (ref mut view[index .. index + count])

private def sort_slice_by :: (ref 'a -> ref 'a -> i64) -> ref mut ['a..] -> unit
fn sort_slice_by comparison values =
    let length = values.length
    let blocks = length / 20
    for block in 0i64 .. (blocks - 1) do
        insertion_by comparison values (block * 20) (block * 20 + 20)
    insertion_by comparison values (blocks * 20) length
    let mut width = 20i64
    let mut double = 40i64
    while width < length do
        let pairs = length / double
        for pair in 0i64 .. (pairs - 1) do
            merge_by comparison values (pair * double) (pair * double + width) (pair * double + double)
        let rest = pairs * double
        if rest + width < length then merge_by comparison values rest (rest + width) length
        width = double
        double = double * 2

private def insertion_by :: (ref 'a -> ref 'a -> i64) -> ref mut ['a..] -> i64 -> i64 -> unit
fn insertion_by comparison values first last =
    for index in (first + 1) .. (last - 1) do
        let mut current = index
        while current > first && comparison (ref values[current]) (ref values[current - 1]) < 0 do
            Array.swap_in values current (current - 1)
            current = current - 1

/// Merges the sorted runs `[first, middle)` and `[middle, last)` in place, stably (SymMerge).
private def rec merge_by :: (ref 'a -> ref 'a -> i64) -> ref mut ['a..] -> i64 -> i64 -> i64 -> unit
fn rec merge_by comparison values first middle last =
    if middle - first == 1 then
        let mut low = middle
        let mut high = last
        while low < high do
            let half = low + (high - low) / 2
            if comparison (ref values[half]) (ref values[first]) < 0 then low = half + 1 else high = half
        for index in first .. (low - 2) do
            Array.swap_in values index (index + 1)
    elif last - middle == 1 then
        let mut low = first
        let mut high = middle
        while low < high do
            let half = low + (high - low) / 2
            if !(comparison (ref values[middle]) (ref values[half]) < 0) then low = half + 1 else high = half
        for index in middle .. -1 .. (low + 1) do
            Array.swap_in values index (index - 1)
    else
        let center = first + (last - first) / 2
        let total = center + middle
        let mut start = if middle > center then total - last else first
        let mut bound = if middle > center then center else middle
        let probe = total - 1
        while start < bound do
            let half = start + (bound - start) / 2
            if !(comparison (ref values[probe - half]) (ref values[half]) < 0) then start = half + 1 else bound = half
        let finish = total - start
        if start < middle && middle < finish then rotate_slice values start middle finish
        if first < start && start < center then merge_by comparison values first start center
        if center < finish && finish < last then merge_by comparison values center finish last

/// Exchanges the adjacent runs `[first, middle)` and `[middle, last)` by swaps.
private def rotate_slice :: ref mut ['a..] -> i64 -> i64 -> i64 -> unit
fn rotate_slice values first middle last =
    let mut left = middle - first
    let mut right = last - middle
    while left != right do
        let count = if left > right then right else left
        let source = middle - left
        let target = if left > right then middle else middle + right - left
        for step in 0i64 .. (count - 1) do
            Array.swap_in values (source + step) (target + step)
        if left > right then left = left - right else right = right - left
    for step in 0i64 .. (left - 1) do
        Array.swap_in values (middle - left + step) (middle + step)

// ---- Searching ----

def index_ofr :: Eq<'a> => ref Vec<'a> -> ref 'a -> i64
fn index_ofr values item = first_index values item 0 (Vec.length values)

private def first_index :: Eq<'a> => ref Vec<'a> -> ref 'a -> i64 -> i64 -> i64
fn first_index values item start count =
    let last = start + count
    let mut index = start
    while index < last && !(Eq.eq (ref values[index]) item) do index = index + 1
    if index < last then index else -1

private def last_index :: Eq<'a> => ref Vec<'a> -> ref 'a -> i64 -> i64 -> i64
fn last_index values item start count =
    let stop = start - count
    let mut index = start
    while index > stop && !(Eq.eq (ref values[index]) item) do index = index - 1
    if index > stop then index else -1

/// The index of the first element equal to `item`, or `-1`.
def index_of :: Eq<'a> => ref Vec<'a> -> 'a -> i64
fn index_of values item = first_index values (ref item) 0 (Vec.length values)

/// Looks from `index` on; `index` may be the length.
def index_of_from :: Eq<'a> => ref Vec<'a> -> 'a -> i64 -> i64
fn index_of_from values item index =
    assert (index >= 0 && index <= Vec.length values)
    first_index values (ref item) index (Vec.length values - index)

/// Looks at `count` elements from `index` on.
def index_of_range :: Eq<'a> => ref Vec<'a> -> 'a -> i64 -> i64 -> i64
fn index_of_range values item index count =
    assert (index >= 0 && index <= Vec.length values)
    assert (count >= 0 && index <= Vec.length values - count)
    first_index values (ref item) index count

def last_index_ofr :: Eq<'a> => ref Vec<'a> -> ref 'a -> i64
fn last_index_ofr values item =
    let length = Vec.length values
    if length == 0 then -1 else last_index values item (length - 1) length

/// The index of the last element equal to `item`, or `-1`.
def last_index_of :: Eq<'a> => ref Vec<'a> -> 'a -> i64
fn last_index_of values item = last_index_ofr values (ref item)

/// Looks backward from `index` to the front. An empty `Vec` takes `-1` as `index`, as in .NET.
def last_index_of_from :: Eq<'a> => ref Vec<'a> -> 'a -> i64 -> i64
fn last_index_of_from values item index =
    assert (index < Vec.length values)
    last_index_of_range values item index (index + 1)

/// Looks backward from `index` at `count` elements.
def last_index_of_range :: Eq<'a> => ref Vec<'a> -> 'a -> i64 -> i64 -> i64
fn last_index_of_range values item index count =
    let length = Vec.length values
    if length == 0 then -1 else
        assert (index >= 0 && count >= 0)
        assert (index < length)
        assert (count <= index + 1)
        last_index values (ref item) index count

def containsr :: Eq<'a> => ref Vec<'a> -> ref 'a -> bool
fn containsr values item = index_ofr values item >= 0

def contains :: Eq<'a> => ref Vec<'a> -> 'a -> bool
fn contains values item = index_ofr values (ref item) >= 0

/// Like `find_index`, but `predicate` borrows each element, so the elements need not be `Copy`.
def find_indexr :: ref Vec<'a> -> (ref 'a -> bool) -> i64
fn find_indexr values predicate =
    let length = Vec.length values
    let mut index = 0
    while index < length && !(predicate (ref values[index])) do index = index + 1
    if index < length then index else -1

/// The index of the first element that the predicate accepts, or `-1`.
def find_index :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> i64
fn find_index values predicate = find_index_range values 0 (Vec.length values) predicate

def find_index_from :: Copy<'a> => ref Vec<'a> -> i64 -> ('a -> bool) -> i64
fn find_index_from values start predicate =
    assert (start >= 0 && start <= Vec.length values)
    find_index_range values start (Vec.length values - start) predicate

def find_index_range :: Copy<'a> => ref Vec<'a> -> i64 -> i64 -> ('a -> bool) -> i64
fn find_index_range values start count predicate =
    assert (start >= 0 && start <= Vec.length values)
    assert (count >= 0 && start <= Vec.length values - count)
    let last = start + count
    let mut index = start
    while index < last && !(predicate values[index]) do index = index + 1
    if index < last then index else -1

def find_last_indexr :: ref Vec<'a> -> (ref 'a -> bool) -> i64
fn find_last_indexr values predicate =
    let mut index = Vec.length values - 1
    while index >= 0 && !(predicate (ref values[index])) do index = index - 1
    index

/// The index of the last element that the predicate accepts, or `-1`.
def find_last_index :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> i64
fn find_last_index values predicate =
    find_last_index_range values (Vec.length values - 1) (Vec.length values) predicate

/// Looks backward from `start` to the front. An empty `Vec` takes `-1` as `start`, as in .NET.
def find_last_index_from :: Copy<'a> => ref Vec<'a> -> i64 -> ('a -> bool) -> i64
fn find_last_index_from values start predicate =
    find_last_index_range values start (start + 1) predicate

/// Looks backward from `start` at `count` elements.
def find_last_index_range :: Copy<'a> => ref Vec<'a> -> i64 -> i64 -> ('a -> bool) -> i64
fn find_last_index_range values start count predicate =
    let length = Vec.length values
    if length == 0 then assert (start == -1) else assert (start >= 0 && start < length)
    assert (count >= 0 && start - count + 1 >= 0)
    let stop = start - count
    let mut index = start
    while index > stop && !(predicate values[index]) do index = index - 1
    if index > stop then index else -1

def existsr :: ref Vec<'a> -> (ref 'a -> bool) -> bool
fn existsr values predicate = find_indexr values predicate >= 0

def exists :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> bool
fn exists values predicate = find_index values predicate >= 0

def true_for_allr :: ref Vec<'a> -> (ref 'a -> bool) -> bool
fn true_for_allr values predicate =
    let length = Vec.length values
    let mut index = 0
    while index < length && predicate (ref values[index]) do index = index + 1
    index == length

/// Whether the predicate accepts every element; it does for an empty `Vec`.
def true_for_all :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> bool
fn true_for_all values predicate =
    let length = Vec.length values
    let mut index = 0
    while index < length && predicate values[index] do index = index + 1
    index == length

/// The first element that the predicate accepts. .NET returns the default value when there is none; this returns `None`.
def findr :: ref Vec<'a> -> (ref 'a -> bool) -> Maybe<ref 'a>
fn findr values predicate =
    let index = find_indexr values predicate
    if index >= 0 then Maybe.Some (ref values[index]) else Maybe.None

def find :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> Maybe<'a>
fn find values predicate =
    let index = find_index values predicate
    if index >= 0 then Maybe.Some values[index] else Maybe.None

def find_lastr :: ref Vec<'a> -> (ref 'a -> bool) -> Maybe<ref 'a>
fn find_lastr values predicate =
    let index = find_last_indexr values predicate
    if index >= 0 then Maybe.Some (ref values[index]) else Maybe.None

/// The last element that the predicate accepts, or `None`.
def find_last :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> Maybe<'a>
fn find_last values predicate =
    let index = find_last_index values predicate
    if index >= 0 then Maybe.Some values[index] else Maybe.None

/// A `Vec` of the elements that the predicate accepts, in order.
def find_all :: Copy<'a> => ref Vec<'a> -> ('a -> bool) -> Vec<'a>
fn find_all values predicate =
    let length = Vec.length values
    let mut found: Vec<'a> = Vec.empty()
    let mut index = 0
    while index < length do
        if predicate values[index] then found = Vec.push found values[index]
        index = index + 1
    found

/// The index where `item` is, or the complement (`-1 - place`) of the index where it would go in a sorted `Vec`. It
/// follows the search of .NET step by step, so a `Vec` with equal elements gives the same index.
private def search :: ref Vec<'a> -> i64 -> i64 -> (ref 'a -> i64) -> i64
fn search values index count compare =
    let mut low = index
    let mut high = index + count - 1
    let mut result = 0
    let mut finished = false
    while !finished do
        if low > high then
            result = -1 - low
            finished = true
        else
            let middle = low + (high - low) / 2
            let order = compare (ref values[middle])
            if order == 0 then
                result = middle
                finished = true
            elif order < 0 then low = middle + 1
            else high = middle - 1
    result

/// How `Ord` orders two elements as a number, with a NaN before everything and equal to itself, as `double.CompareTo`.
private def ordering :: Ord<'a> => ref 'a -> ref 'a -> i64
fn ordering left right =
    if Ord.lt left right then -1
    elif Ord.lt right left then 1
    elif Eq.eq left right then 0
    elif Eq.eq left left then 1
    elif Eq.eq right right then -1
    else 0

def binary_searchr :: Ord<'a> => ref Vec<'a> -> ref 'a -> i64
fn binary_searchr values item = search values 0 (Vec.length values) (element -> ordering element item)

def binary_search :: Ord<'a> => ref Vec<'a> -> 'a -> i64
fn binary_search values item = binary_searchr values (ref item)

def binary_search_withr :: ref Vec<'a> -> ref 'a -> (ref 'a -> ref 'a -> i64) -> i64
fn binary_search_withr values item comparison =
    search values 0 (Vec.length values) (element -> comparison element item)

def binary_search_with :: Copy<'a> => ref Vec<'a> -> 'a -> ('a -> 'a -> i64) -> i64
fn binary_search_with values item comparison =
    binary_search_range values 0 (Vec.length values) item comparison

def binary_search_range :: Copy<'a> => ref Vec<'a> -> i64 -> i64 -> 'a -> ('a -> 'a -> i64) -> i64
fn binary_search_range values index count item comparison =
    assert (index >= 0 && count >= 0 && Vec.length values - index >= count)
    search values index count (element -> comparison (deref element) item)

// ---- Visiting and converting ----

def for_eachr :: ref Vec<'a> -> (ref 'a -> unit) -> unit
fn for_eachr values action =
    let length = Vec.length values
    let mut index = 0
    while index < length do
        action (ref values[index])
        index = index + 1

def for_each :: Copy<'a> => ref Vec<'a> -> ('a -> unit) -> unit
fn for_each values action =
    let length = Vec.length values
    let mut index = 0
    while index < length do
        action values[index]
        index = index + 1

def convert_allr :: ref Vec<'a> -> (ref 'a -> 'b) -> Vec<'b>
fn convert_allr values converter =
    let length = Vec.length values
    let mut converted: Vec<'b> = Vec.with_capacity length
    let mut index = 0
    while index < length do
        converted = Vec.push converted (converter (ref values[index]))
        index = index + 1
    converted

/// A `Vec` of the converted elements, with a capacity of its length.
def convert_all :: Copy<'a> => ref Vec<'a> -> ('a -> 'b) -> Vec<'b>
fn convert_all values converter =
    let length = Vec.length values
    let mut converted: Vec<'b> = Vec.with_capacity length
    let mut index = 0
    while index < length do
        converted = Vec.push converted (converter values[index])
        index = index + 1
    converted

// ---- Ranges and copies ----

/// A `Vec` of copies of `count` elements from `index` on, with a capacity of `count`.
def get_range :: Copy<'a> => ref Vec<'a> -> i64 -> i64 -> Vec<'a>
fn get_range values index count =
    assert (index >= 0 && count >= 0 && Vec.length values - index >= count)
    Vec.of_array (new ['a](count, position -> values[index + position]))

def slice :: Copy<'a> => ref Vec<'a> -> i64 -> i64 -> Vec<'a>
fn slice values start length = get_range values start length

/// Copies `count` elements from `index` on into `target` from `target_index` on.
def copy_to_range :: Copy<'a> => ref Vec<'a> -> i64 -> ref mut ['a..] -> i64 -> i64 -> unit
fn copy_to_range values index target target_index count =
    assert (index >= 0 && count >= 0 && Vec.length values - index >= count)
    assert (target_index >= 0 && target.length - target_index >= count)
    let mut offset = 0
    while offset < count do
        Array.write target (target_index + offset) values[index + offset]
        offset = offset + 1

def copy_to_at :: Copy<'a> => ref Vec<'a> -> ref mut ['a..] -> i64 -> unit
fn copy_to_at values target target_index =
    copy_to_range values 0 target target_index (Vec.length values)

def copy_to :: Copy<'a> => ref Vec<'a> -> ref mut ['a..] -> unit
fn copy_to values target = copy_to_range values 0 target 0 (Vec.length values)
