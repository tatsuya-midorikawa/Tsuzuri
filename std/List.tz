def length :: ref [|'a|] -> i64
fn length values = values.length

def is_empty :: ref [|'a|] -> bool
fn is_empty values = values.length == 0

/// Returns a new list with a copy of every element, the explicit form of an implicit list copy.
def copy :: Copy<'a> => ref [|'a|] -> [|'a|]
fn copy values = *values

def fold :: Copy<'a> => ('state -> 'a -> 'state) -> 'state -> ref [|'a|] -> 'state
fn fold folder initial values =
    let mut state = initial
    for value in values do state = folder state value
    state

def iter :: ref [|'a|] -> Seq<ref 'a>
fn iter values =
    let references = List.fold_ref (\state value -> Vec.push state value) (Vec.empty()) values
    Seq.unfold (\state ->
        match state with
        | (references, index) ->
            if index < Vec.length (ref references) then
                let value = references[index]
                Option.Some (value, (references, index + 1))
            else Option.None) (references, 0)
