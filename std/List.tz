def length :: ref [|'a|] -> i64
fn length values = values.length

def is_empty :: ref [|'a|] -> bool
fn is_empty values = values.length == 0

def fold :: Copy<'a> => ref [|'a|] -> 'state -> ('state -> 'a -> 'state) -> 'state
fn fold values initial folder =
    let mut state = initial
    for value in values do state = folder state value
    state

def iter :: ref [|'a|] -> Seq.Seq<ref 'a>
fn iter values =
    let references = List.fold_ref values (Vec.empty()) (\state value -> Vec.push state value)
    Seq.unfold (references, 0) (\state ->
        match state with
        | (references, index) ->
            if index < Vec.length (ref references) then
                let value = references[index]
                Option.Some (value, (references, index + 1))
            else Option.None)
