/// A map that many tzroutines read and update at once (Go's `sync.Map`, TZ06 Phase 3): a `HashMap`
/// behind a `RwMutex`. Reads (`load`, `with_value`, `length`, `for_each`) share the lock; `store`,
/// `load_or_store` and `delete` take it alone. Share it with `Arc<SyncMap<K, V>>`. It is not Copy and
/// no function value can capture it.
record SyncMap<'k, 'v> { inner: RwMutex<HashMap<'k, 'v>> }

/// An empty map.
///
/// ```tsuzuri run=0
/// let map: SyncMap<i64, string> = SyncMap.create ()
/// SyncMap.length (ref map)
/// ```
def create :: (Send<'k>, Send<'v>) => own unit -> SyncMap<'k, 'v>
fn create _unit = SyncMap { inner: RwMutex.create (HashMap.empty()) }

/// The value of the key, copied (Go's `m.Load(key)`).
///
/// ```tsuzuri run=20
/// let map: SyncMap<i64, i64> = SyncMap.create ()
/// SyncMap.store (ref map) 2 20
/// match SyncMap.load (ref map) (ref 2) with
/// | Maybe.Some value -> value
/// | Maybe.None -> 0
/// ```
def load :: (Hash<'k>, Eq<'k>, Copy<'v>, Send<'v>) => ref SyncMap<'k, 'v> -> ref 'k -> Maybe<'v>
fn load map key = RwMutex.with_read (ref map.inner) (\table -> HashMap.get_ref key table)

/// The function's result for the value of the key, called under the read lock.
///
/// ```tsuzuri run=5
/// let map: SyncMap<i64, string> = SyncMap.create ()
/// SyncMap.store (ref map) 1 "hello"
/// match SyncMap.with_value (ref map) (ref 1) (\text -> String.length text) with
/// | Maybe.Some length -> length
/// | Maybe.None -> 0
/// ```
def with_value :: (Hash<'k>, Eq<'k>, Send<'b>) => ref SyncMap<'k, 'v> -> ref 'k -> own (ref 'v -> 'b) -> Maybe<'b>
fn with_value map key reader = RwMutex.with_read (ref map.inner) (\table ->
    if HashMap.contains_key_ref key table then Maybe.Some (reader (HashMap.at_ref key table)) else Maybe.None)

/// Sets the value of the key (Go's `m.Store(key, value)`).
///
/// ```tsuzuri run=2
/// let map: SyncMap<string, i64> = SyncMap.create ()
/// SyncMap.store (ref map) "a" 1
/// SyncMap.store (ref map) "b" 2
/// SyncMap.store (ref map) "a" 3
/// SyncMap.length (ref map)
/// ```
def store :: (Hash<'k>, Eq<'k>, Send<'k>, Send<'v>) => ref SyncMap<'k, 'v> -> own 'k -> own 'v -> unit
fn store map key value =
    // The callback can run more than once as far as its type says, so it borrows the pair in a
    // cell and takes it out once, instead of capturing values that a function cannot hold.
    let pending = Mutex.create (Maybe.Some (key, value))
    let slot = ref pending
    RwMutex.with_write (ref map.inner) (\table ->
        match take slot with
        | Maybe.Some (key, value) -> {
            let old = SyncMap.__replace (HashMap.empty()) table;
            deref table = HashMap.insert key value old
        }
        | Maybe.None -> ())

/// The value that the key has, with `true`, or the given value, which it stores, with `false` (Go's
/// `m.LoadOrStore(key, value)`).
///
/// ```tsuzuri run=11
/// let map: SyncMap<i64, i64> = SyncMap.create ()
/// let first = SyncMap.load_or_store (ref map) 7 1
/// let second = SyncMap.load_or_store (ref map) 7 2
/// match (first, second) with
/// | ((stored, false), (found, true)) -> stored * 10 + found
/// | _ -> 0
/// ```
def load_or_store :: (Hash<'k>, Eq<'k>, Copy<'v>, Send<'k>, Send<'v>) => ref SyncMap<'k, 'v> -> own 'k -> own 'v -> ('v * bool)
fn load_or_store map key value =
    let fallback = value
    let pending = Mutex.create (Maybe.Some (key, value))
    let slot = ref pending
    RwMutex.with_write (ref map.inner) (\table ->
        match take slot with
        | Maybe.Some (key, value) ->
            match HashMap.get_ref (ref key) (deref table) with
            | Maybe.Some found -> (found, true)
            | Maybe.None -> {
                let old = SyncMap.__replace (HashMap.empty()) table;
                deref table = HashMap.insert key value old;
                (value, false)
            }
        | Maybe.None -> (fallback, false))

/// Removes the key; true when it was there (Go's `m.Delete(key)`).
///
/// ```tsuzuri run=true%0A0
/// let map: SyncMap<i64, i64> = SyncMap.create ()
/// SyncMap.store (ref map) 1 10
/// let removed = SyncMap.delete (ref map) (ref 1)
/// $"{removed}\n{SyncMap.length (ref map)}"
/// ```
def delete :: (Hash<'k>, Eq<'k>) => ref SyncMap<'k, 'v> -> ref 'k -> bool
fn delete map key = RwMutex.with_write (ref map.inner) (\table -> {
    let old = SyncMap.__replace (HashMap.empty()) table;
    let before = HashMap.length (ref old);
    let left = HashMap.remove_ref key old;
    let removed = HashMap.length (ref left) < before;
    deref table = left;
    removed
})

/// The number of keys.
///
/// ```tsuzuri run=1
/// let map: SyncMap<i64, i64> = SyncMap.create ()
/// SyncMap.store (ref map) 1 10
/// SyncMap.length (ref map)
/// ```
def length :: ref SyncMap<'k, 'v> -> i64
fn length map = RwMutex.with_read (ref map.inner) (\table -> HashMap.length table)

/// Calls the function for each key and value under the read lock (Go's `m.Range(f)`, in no
/// particular order). A write to the same map from inside it traps: the tzroutine holds its lock.
///
/// ```tsuzuri run=30
/// let map: SyncMap<i64, i64> = SyncMap.create ()
/// SyncMap.store (ref map) 1 10
/// SyncMap.store (ref map) 2 20
/// let total = Arc.new (Atomic.create 0i64)
/// let mine = Arc.get (ref total)
/// SyncMap.for_each (ref map) (\_key value -> {
///     let _old = Atomic.fetch_add mine (deref value);
///     ()
/// })
/// Atomic.load mine
/// ```
def for_each :: ref SyncMap<'k, 'v> -> own (ref 'k -> ref 'v -> unit) -> unit
fn for_each map visit = RwMutex.with_read (ref map.inner) (\table -> HashMap.fold (\_state key value -> visit key value) () table)

/// Takes the pair out of its cell, once: `store` and `load_or_store` lend it to their callback.
private def take :: Send<'a> => ref Mutex<Maybe<'a>> -> Maybe<'a>
fn take pending = Mutex.with_lock pending (\slot -> SyncMap.__replace Maybe.None slot)
