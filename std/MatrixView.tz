/// A read-only window onto a borrowed row-major buffer. Element (row, col) is
/// data[offset + row * row_stride + col * col_stride]. The strides are never negative and every
/// element of the window lies inside `data`; the constructors check this and every operation keeps it.
record MatrixView<'a> { r } { data: ref { r } ['a], offset: i64, rows: i64, cols: i64, row_stride: i64, col_stride: i64 }

/// A window that can write. Its layout is row-major with padding (col_stride 1 and row_stride >= cols)
/// or the transpose of that (row_stride 1 and col_stride >= rows), so no two elements share a slot.
record Mut<'a> { r } { data: ref mut { r } ['a..], offset: i64, rows: i64, cols: i64, row_stride: i64, col_stride: i64 }

private def checked_count :: own i64 -> own i64 -> i64
fn checked_count rows cols =
    assert (rows >= 0 && cols >= 0 && (cols == 0 || rows <= 9223372036854775807 / cols))
    rows * cols

// The index of the last element of a window, or -1 for an empty window. Traps on negative
// arguments and on overflow. The index itself can be i64::MAX, so it is compared with the length
// of the data as `last < length` and never as `last + 1 <= length`, which would wrap.
private def last_index :: own i64 -> own i64 -> own i64 -> own i64 -> own i64 -> i64
fn last_index offset rows cols row_stride col_stride =
    assert (offset >= 0 && rows >= 0 && cols >= 0 && row_stride >= 0 && col_stride >= 0)
    if rows == 0 || cols == 0 then (- 1) else
        let last_row = rows - 1
        let last_col = cols - 1
        assert (row_stride == 0 || last_row <= (9223372036854775807 - offset) / row_stride)
        let after_rows = offset + last_row * row_stride
        assert (col_stride == 0 || last_col <= (9223372036854775807 - after_rows) / col_stride)
        after_rows + last_col * col_stride

/// Borrows a whole matrix as a window.
///
/// ```tsuzuri run=3
/// let m = Matrix.of_array 2 2 [1, 2, 3, 4]
/// let window = MatrixView.of_matrix m
/// deref (MatrixView.at 1 0 window)
/// ```
def of_matrix { r } :: ref { r } Matrix<'a> -> MatrixView<'a> { r }
fn of_matrix matrix =
    let cols = Matrix.cols matrix
    MatrixView { data: Matrix.as_array matrix, offset: 0, rows: Matrix.rows matrix, cols: cols, row_stride: cols, col_stride: 1 }

/// Borrows a row-major array of rows * cols elements as a window.
///
/// ```tsuzuri run=6
/// let data = [1, 2, 3, 4, 5, 6]
/// let window = MatrixView.of_array 2 3 data
/// deref (MatrixView.at 1 2 window)
/// ```
def of_array { r } :: own i64 -> own i64 -> ref { r } ['a] -> MatrixView<'a> { r }
fn of_array rows cols data =
    assert (data.length == checked_count rows cols)
    MatrixView { data: data, offset: 0, rows: rows, cols: cols, row_stride: cols, col_stride: 1 }

/// A window with explicit layout: element (row, col) is data[offset + row * row_stride + col * col_stride].
/// Traps on a negative argument, when rows * cols overflows, or when an element would lie outside `data`.
/// Strides of 0 repeat a row or a column.
///
/// ```tsuzuri run=[2,%204,%206]
/// let data = [1, 2, 3, 4, 5, 6]
/// let column = MatrixView.strided 1 3 1 2 0 data
/// Matrix.to_array (MatrixView.to_matrix column)
/// ```
def strided { r } :: own i64 -> own i64 -> own i64 -> own i64 -> own i64 -> ref { r } ['a] -> MatrixView<'a> { r }
fn strided offset rows cols row_stride col_stride data =
    assert (checked_count rows cols >= 0 && last_index offset rows cols row_stride col_stride < data.length)
    MatrixView { data: data, offset: offset, rows: rows, cols: cols, row_stride: row_stride, col_stride: col_stride }

/// The number of rows.
///
/// ```tsuzuri run=2
/// let data = [1, 2, 3, 4, 5, 6]
/// MatrixView.rows (MatrixView.of_array 2 3 data)
/// ```
def rows { r } :: MatrixView<'a> { r } -> i64
fn rows view = view.rows

/// The number of columns.
///
/// ```tsuzuri run=3
/// let data = [1, 2, 3, 4, 5, 6]
/// MatrixView.cols (MatrixView.of_array 2 3 data)
/// ```
def cols { r } :: MatrixView<'a> { r } -> i64
fn cols view = view.cols

/// The index of element (0, 0) in `data`.
///
/// ```tsuzuri run=4
/// let data = [1, 2, 3, 4, 5, 6]
/// let window = MatrixView.sub 1 1 1 2 (MatrixView.of_array 2 3 data)
/// MatrixView.offset window
/// ```
def offset { r } :: MatrixView<'a> { r } -> i64
fn offset view = view.offset

/// The distance in `data` between two consecutive rows.
///
/// ```tsuzuri run=3%201
/// let data = [1, 2, 3, 4, 5, 6]
/// let view = MatrixView.of_array 2 3 data
/// $"{MatrixView.row_stride view} {MatrixView.row_stride (MatrixView.transpose view)}"
/// ```
def row_stride { r } :: MatrixView<'a> { r } -> i64
fn row_stride view = view.row_stride

/// The distance in `data` between two consecutive columns.
///
/// ```tsuzuri run=1%203
/// let data = [1, 2, 3, 4, 5, 6]
/// let view = MatrixView.of_array 2 3 data
/// $"{MatrixView.col_stride view} {MatrixView.col_stride (MatrixView.transpose view)}"
/// ```
def col_stride { r } :: MatrixView<'a> { r } -> i64
fn col_stride view = view.col_stride

/// The whole backing slice, including elements outside the window.
///
/// ```tsuzuri run=1x1%20[1,%202,%203,%204,%205,%206]
/// let data = [1, 2, 3, 4, 5, 6]
/// let corner = MatrixView.sub 0 0 1 1 (MatrixView.of_array 2 3 data)
/// $"{MatrixView.rows corner}x{MatrixView.cols corner} {MatrixView.data corner}"
/// ```
def data { r } :: MatrixView<'a> { r } -> ref { r } ['a]
fn data view = view.data

/// Borrows one element; traps when the row or the column is out of range.
///
/// ```tsuzuri run=3
/// let data = [1, 2, 3, 4, 5, 6]
/// deref (MatrixView.at 0 2 (MatrixView.of_array 2 3 data))
/// ```
def at { r } :: own i64 -> own i64 -> MatrixView<'a> { r } -> ref { r } 'a
fn at row col view =
    assert (row >= 0 && row < view.rows && col >= 0 && col < view.cols)
    ref view.data[view.offset + row * view.row_stride + col * view.col_stride]

/// Copies one element, or `None` when the row or the column is out of range.
///
/// ```tsuzuri run=5%20true
/// let data = [1, 2, 3, 4, 5, 6]
/// let view = MatrixView.of_array 2 3 data
/// $"{Maybe.default_value 0 (MatrixView.get 1 1 view)} {Maybe.is_none (MatrixView.get 2 0 view)}"
/// ```
def get { r } :: Copy<'a> => own i64 -> own i64 -> MatrixView<'a> { r } -> Maybe<'a>
fn get row col view =
    if row < 0 || row >= view.rows || col < 0 || col >= view.cols then Maybe.None
    else Maybe.Some view.data[view.offset + row * view.row_stride + col * view.col_stride]

/// Swaps rows and columns without touching the data.
///
/// ```tsuzuri run=3x2%206
/// let data = [1, 2, 3, 4, 5, 6]
/// let t = MatrixView.transpose (MatrixView.of_array 2 3 data)
/// $"{MatrixView.rows t}x{MatrixView.cols t} {deref (MatrixView.at 2 1 t)}"
/// ```
def transpose { r } :: MatrixView<'a> { r } -> MatrixView<'a> { r }
fn transpose view = MatrixView { data: view.data, offset: view.offset, rows: view.cols, cols: view.rows, row_stride: view.col_stride, col_stride: view.row_stride }

/// The rows x cols window whose top-left element is (row, col); traps unless it lies inside the view.
///
/// ```tsuzuri run=[5,%206,%208,%209]
/// let data = [1, 2, 3, 4, 5, 6, 7, 8, 9]
/// let corner = MatrixView.sub 1 1 2 2 (MatrixView.of_array 3 3 data)
/// Matrix.to_array (MatrixView.to_matrix corner)
/// ```
def sub { r } :: own i64 -> own i64 -> own i64 -> own i64 -> MatrixView<'a> { r } -> MatrixView<'a> { r }
fn sub row col rows cols view =
    assert (row >= 0 && col >= 0 && rows >= 0 && cols >= 0 && row <= view.rows && col <= view.cols && rows <= view.rows - row && cols <= view.cols - col)
    MatrixView { data: view.data, offset: view.offset + row * view.row_stride + col * view.col_stride, rows: rows, cols: cols, row_stride: view.row_stride, col_stride: view.col_stride }

/// One row as a 1 x cols window.
///
/// ```tsuzuri run=[4,%205,%206]
/// let data = [1, 2, 3, 4, 5, 6]
/// let line = MatrixView.row 1 (MatrixView.of_array 2 3 data)
/// Matrix.to_array (MatrixView.to_matrix line)
/// ```
def row { r } :: own i64 -> MatrixView<'a> { r } -> MatrixView<'a> { r }
fn row index view = sub index 0 1 view.cols view

/// One column as a rows x 1 window.
///
/// ```tsuzuri run=[2,%205]
/// let data = [1, 2, 3, 4, 5, 6]
/// let column = MatrixView.col 1 (MatrixView.of_array 2 3 data)
/// Matrix.to_array (MatrixView.to_matrix column)
/// ```
def col { r } :: own i64 -> MatrixView<'a> { r } -> MatrixView<'a> { r }
fn col index view = sub 0 index view.rows 1 view

/// Whether the elements are one run of `data` in row-major order (an empty window is contiguous).
///
/// ```tsuzuri run=true%20false
/// let data = [1, 2, 3, 4, 5, 6]
/// let view = MatrixView.of_array 2 3 data
/// $"{MatrixView.is_contiguous view} {MatrixView.is_contiguous (MatrixView.col 1 view)}"
/// ```
def is_contiguous { r } :: MatrixView<'a> { r } -> bool
fn is_contiguous view = view.rows * view.cols == 0 || ((view.cols == 1 || view.col_stride == 1) && (view.rows == 1 || view.row_stride == view.cols))

/// Copies the elements into a new row-major matrix.
///
/// ```tsuzuri run=[1,%204,%202,%205,%203,%206]
/// let data = [1, 2, 3, 4, 5, 6]
/// let flipped = MatrixView.transpose (MatrixView.of_array 2 3 data)
/// Matrix.to_array (MatrixView.to_matrix flipped)
/// ```
def to_matrix { r } :: Copy<'a> => MatrixView<'a> { r } -> Matrix<'a>
fn to_matrix view =
    let count = view.rows * view.cols
    if count == 0 then Matrix.init view.rows view.cols (\_row _col -> view.data[0])
    elif is_contiguous view then Matrix.of_array view.rows view.cols (Array.sub view.offset count view.data)
    else
        let mut out = new ['a](count, \_ -> view.data[view.offset])
        for i in 0i64 ..= (view.rows - 1) do
            let target = ref mut out[i * view.cols .. i * view.cols + view.cols]
            let base = view.offset + i * view.row_stride
            for j in 0i64 ..= (view.cols - 1) do
                let value = view.data[base + j * view.col_stride]
                Array.write j value target
        Matrix.of_array view.rows view.cols out

/// Folds the elements left to right in row-major order of the window.
///
/// ```tsuzuri run=1324
/// let data = [1, 2, 3, 4]
/// let flipped = MatrixView.transpose (MatrixView.of_array 2 2 data)
/// MatrixView.fold (\text x -> text + to_string x) "" flipped
/// ```
def fold { r } :: Copy<'a> => own ('state -> 'a -> 'state) -> own 'state -> MatrixView<'a> { r } -> 'state
fn fold folder initial view =
    if view.rows == 0 || view.cols == 0 then initial else
        let mut state = initial
        for i in 0i64 ..= (view.rows - 1) do
            let base = view.offset + i * view.row_stride
            for j in 0i64 ..= (view.cols - 1) do
                state = folder state view.data[base + j * view.col_stride]
        state

/// Applies `transform` to every element in row-major order of the window.
///
/// ```tsuzuri run=[10,%2030]
/// let data = [1, 2, 3, 4]
/// let column = MatrixView.col 0 (MatrixView.of_array 2 2 data)
/// Matrix.to_array (MatrixView.map (\x -> x * 10) column)
/// ```
def map { r } :: Copy<'a> => own ('a -> 'b) -> MatrixView<'a> { r } -> Matrix<'b>
fn map transform view =
    let count = view.rows * view.cols
    Matrix.of_array view.rows view.cols (new ['b](count, \index -> transform view.data[view.offset + (index / view.cols) * view.row_stride + (index % view.cols) * view.col_stride]))

/// The product of two windows. Operands that are not contiguous are first copied into row-major
/// buffers, then `Matrix.mul` runs, so the bits equal `Matrix.mul` of the copied operands.
/// Traps unless left.cols == right.rows; the shapes are compared before anything is copied.
///
/// ```tsuzuri run=[26,%2030,%2038,%2044]
/// let a = [1, 2, 3, 4]
/// let b = [5, 6, 7, 8]
/// let product = MatrixView.mul (MatrixView.transpose (MatrixView.of_array 2 2 a)) (MatrixView.of_array 2 2 b)
/// Matrix.to_array product
/// ```
def mul { r s } :: Numeric<'a> => MatrixView<'a> { r } -> MatrixView<'a> { s } -> Matrix<'a>
fn mul left right =
    assert (left.cols == right.rows)
    let packed_left = to_matrix left
    let packed_right = to_matrix right
    Matrix.mul (ref packed_left) (ref packed_right)

/// Takes an exclusive row-major array of rows * cols elements as a writable window.
///
/// ```tsuzuri run=[0,%200,%207,%200]
/// let mut data = [0, 0, 0, 0]
/// let mut grid = MatrixView.of_array_mut 2 2 (ref mut data)
/// MatrixView.write 1 0 7 (ref mut grid)
/// $"{data}"
/// ```
def of_array_mut { r } :: own i64 -> own i64 -> ref mut { r } ['a..] -> Mut<'a> { r }
fn of_array_mut rows cols data =
    assert (data.length == checked_count rows cols)
    Mut { data: data, offset: 0, rows: rows, cols: cols, row_stride: cols, col_stride: 1 }

/// Reads through a writable window: a shared reborrow that ends before the next write.
///
/// ```tsuzuri run=18
/// let mut data = [1, 2, 3, 4]
/// let mut grid = MatrixView.of_array_mut 2 2 (ref mut data)
/// MatrixView.write 0 0 9 (ref mut grid)
/// let view = MatrixView.freeze grid
/// MatrixView.fold (\total x -> total + x) 0 view
/// ```
def freeze { r } :: ref { r } Mut<'a> { r } -> MatrixView<'a> { r }
fn freeze view = MatrixView { data: ref view.data[0 ..], offset: view.offset, rows: view.rows, cols: view.cols, row_stride: view.row_stride, col_stride: view.col_stride }

/// Replaces one element; traps when the row or the column is out of range.
///
/// ```tsuzuri run=[0,%200,%200,%200,%200,%205]
/// let mut data = [0, 0, 0, 0, 0, 0]
/// let mut grid = MatrixView.of_array_mut 2 3 (ref mut data)
/// MatrixView.write 1 2 5 (ref mut grid)
/// $"{data}"
/// ```
def write { r } :: own i64 -> own i64 -> own 'a -> ref mut Mut<'a> { r } -> unit
fn write row col value view =
    assert (row >= 0 && row < view.rows && col >= 0 && col < view.cols)
    let index = view.offset + row * view.row_stride + col * view.col_stride
    Array.write index value view.data

/// Lends one row of a row-major window as an exclusive slice; traps unless col_stride is 1.
///
/// ```tsuzuri run=[0,%200,%200,%208,%200,%200]
/// let mut data = [0, 0, 0, 0, 0, 0]
/// let mut grid = MatrixView.of_array_mut 2 3 (ref mut data)
/// let line = MatrixView.row_mut 1 (ref mut grid)
/// Array.write 0 8 line
/// $"{data}"
/// ```
def row_mut { r } :: own i64 -> ref mut { r } Mut<'a> { r } -> ref mut { r } ['a..]
fn row_mut index view =
    assert (index >= 0 && index < view.rows && view.col_stride == 1)
    let start = view.offset + index * view.row_stride
    ref mut view.data[start .. start + view.cols]

/// A writable sub-window; the original cannot be used while it lives.
///
/// ```tsuzuri run=[0,%200,%200,%200,%201,%201,%200,%201,%201]
/// let mut data = new [i64](9, \_ -> 0)
/// let mut grid = MatrixView.of_array_mut 3 3 (ref mut data)
/// let mut corner = MatrixView.sub_mut 1 1 2 2 (ref mut grid)
/// MatrixView.fill 1 (ref mut corner)
/// $"{data}"
/// ```
def sub_mut { r } :: own i64 -> own i64 -> own i64 -> own i64 -> ref mut { r } Mut<'a> { r } -> Mut<'a> { r }
fn sub_mut row col rows cols view =
    assert (row >= 0 && col >= 0 && rows >= 0 && cols >= 0 && row <= view.rows && col <= view.cols && rows <= view.rows - row && cols <= view.cols - col)
    let start = view.offset + row * view.row_stride + col * view.col_stride
    let row_stride = view.row_stride
    let col_stride = view.col_stride
    Mut { data: ref mut view.data[0 ..], offset: start, rows: rows, cols: cols, row_stride: row_stride, col_stride: col_stride }

/// Swaps rows and columns of a writable window without touching the data.
///
/// ```tsuzuri run=[0,%200,%207,%200,%200,%200]
/// let mut data = new [i64](6, \_ -> 0)
/// let mut grid = MatrixView.transpose_mut (MatrixView.of_array_mut 2 3 (ref mut data))
/// MatrixView.write 2 0 7 (ref mut grid)
/// $"{data}"
/// ```
def transpose_mut { r } :: Mut<'a> { r } -> Mut<'a> { r }
fn transpose_mut view = Mut { data: view.data, offset: view.offset, rows: view.cols, cols: view.rows, row_stride: view.col_stride, col_stride: view.row_stride }

/// Writes `value` to every element in row-major order of the window.
///
/// ```tsuzuri run=[3,%203,%203,%203]
/// let mut data = new [i64](4, \_ -> 0)
/// let mut grid = MatrixView.of_array_mut 2 2 (ref mut data)
/// MatrixView.fill 3 (ref mut grid)
/// $"{data}"
/// ```
def fill { r } :: Copy<'a> => own 'a -> ref mut Mut<'a> { r } -> unit
fn fill value view =
    if view.rows > 0 && view.cols > 0 then
        for i in 0i64 ..= (view.rows - 1) do
            let base = view.offset + i * view.row_stride
            for j in 0i64 ..= (view.cols - 1) do
                let index = base + j * view.col_stride
                Array.write index value view.data

/// Copies the elements of a window of the same shape; traps when the shapes differ.
///
/// ```tsuzuri run=[1,%203,%202,%204]
/// let source = [1, 2, 3, 4]
/// let mut data = [0, 0, 0, 0]
/// let mut grid = MatrixView.of_array_mut 2 2 (ref mut data)
/// MatrixView.copy_from (MatrixView.transpose (MatrixView.of_array 2 2 source)) (ref mut grid)
/// $"{data}"
/// ```
def copy_from { s r } :: Copy<'a> => MatrixView<'a> { s } -> ref mut Mut<'a> { r } -> unit
fn copy_from source target =
    assert (target.rows == source.rows && target.cols == source.cols)
    if target.rows > 0 && target.cols > 0 then
        for i in 0i64 ..= (target.rows - 1) do
            let source_base = source.offset + i * source.row_stride
            let target_base = target.offset + i * target.row_stride
            for j in 0i64 ..= (target.cols - 1) do
                let value = source.data[source_base + j * source.col_stride]
                let index = target_base + j * target.col_stride
                Array.write index value target.data

/// Replaces every element by `transform` of it, in row-major order of the window.
///
/// ```tsuzuri run=[1,%204,%209,%2016]
/// let mut data = [1, 2, 3, 4]
/// let mut grid = MatrixView.of_array_mut 2 2 (ref mut data)
/// MatrixView.map_in_place (\x -> x * x) (ref mut grid)
/// $"{data}"
/// ```
def map_in_place { r } :: Copy<'a> => own ('a -> 'a) -> ref mut Mut<'a> { r } -> unit
fn map_in_place transform view =
    if view.rows > 0 && view.cols > 0 then
        for i in 0i64 ..= (view.rows - 1) do
            let base = view.offset + i * view.row_stride
            for j in 0i64 ..= (view.cols - 1) do
                let index = base + j * view.col_stride
                let value = transform view.data[index]
                Array.write index value view.data
