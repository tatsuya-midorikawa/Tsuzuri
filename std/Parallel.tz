/// The sum of the elements of `values`, computed with `Parallel.reduce` from a zero start.
///
/// ```tsuzuri run=10
/// Parallel.sum [1, 2, 3, 4]
/// ```
def sum :: (Numeric<'a>, Add<'a>, Copy<'a>, Send<'a>) => ref ['a] -> 'a
fn sum values = Parallel.reduce (0i64 as 'a) (\left right -> left + right) values