private record Entry<'key, 'value> { hash: i64, key: 'key, value: 'value }
record HashMap<'key, 'value> { entries: Vec<Entry<'key, 'value>>, slots: Vec<i64>, key0: i64u, key1: i64u, keyed: bool }

/// An empty map.
///
/// ```tsuzuri run=0
/// let map: HashMap<string, i64> = HashMap.empty()
/// HashMap.length map
/// ```
def empty :: HashMap<'key, 'value>
fn empty = HashMap { entries: Vec.empty(), slots: Vec.empty(), key0: 0i64u, key1: 0i64u, keyed: false }

/// The number of entries.
///
/// ```tsuzuri run=2
/// HashMap.empty() |> HashMap.insert "a" 1 |> HashMap.insert "b" 2 |> HashMap.insert "a" 3 |> HashMap.length
/// ```
def length :: ref HashMap<'key, 'value> -> i64
fn length map = Vec.length (ref map.entries)

/// Whether the map has no entries.
///
/// ```tsuzuri run=true
/// HashMap.empty() |> HashMap.insert 1 "one" |> HashMap.remove 1 |> HashMap.is_empty
/// ```
def is_empty :: ref HashMap<'key, 'value> -> bool
fn is_empty map = length map == 0

private def mix :: own i64u -> i64
fn mix hash =
	let first = (hash ^ (hash >>> 33)) * 0xff51afd7ed558ccd
	let second = (first ^ (first >>> 33)) * 0xc4ceb9fe1a85ec53
	(second ^ (second >>> 33)) as i64

private def sip_round :: own (i64u * i64u * i64u * i64u) -> (i64u * i64u * i64u * i64u)
fn sip_round state =
	match state with
	| (v0, v1, v2, v3) ->
		let a0 = v0 + v1
		let a1 = (Int.rotate_left v1 13) ^ a0
		let a2 = v2 + v3
		let a3 = (Int.rotate_left v3 16) ^ a2
		let b0 = (Int.rotate_left a0 32) + a3
		let b3 = (Int.rotate_left a3 21) ^ b0
		let b2 = a2 + a1
		let b1 = (Int.rotate_left a1 17) ^ b2
		(b0, b1, Int.rotate_left b2 32, b3)

/// SipHash-1-3 of one 64-bit word (its eight little-endian bytes) under the 128-bit key `key0`, `key1`.
/// A map made with `with_seed` finalizes `Hash.hash` with it, so a table position cannot be chosen
/// without knowing the seed.
///
/// ```tsuzuri run=3931806377309739662
/// HashMap.sip13 0x0706050403020100i64u 0x0f0e0d0c0b0a0908i64u 0x0706050403020100i64u
/// ```
def sip13 :: own i64u -> own i64u -> own i64u -> i64u
fn sip13 key0 key1 message =
	let start = (key0 ^ 0x736f6d6570736575i64u, key1 ^ 0x646f72616e646f6di64u, key0 ^ 0x6c7967656e657261i64u, key1 ^ 0x7465646279746573i64u)
	let first =
		match start with
		| (v0, v1, v2, v3) -> sip_round (v0, v1, v2, v3 ^ message)
	let second =
		match first with
		| (v0, v1, v2, v3) -> sip_round (v0 ^ message, v1, v2, v3 ^ 0x0800000000000000i64u)
	let mut state =
		match second with
		| (v0, v1, v2, v3) -> (v0 ^ 0x0800000000000000i64u, v1, v2 ^ 0xffi64u, v3)
	let mut round = 0
	while round < 3 do
		state = sip_round state
		round = round + 1
	match state with
	| (v0, v1, v2, v3) -> v0 ^ v1 ^ v2 ^ v3

private def split_mix :: own i64u -> i64u
fn split_mix seed =
	let state = seed + 0x9e3779b97f4a7c15i64u
	let first = (state ^ (state >>> 30)) * 0xbf58476d1ce4e5b9i64u
	let second = (first ^ (first >>> 27)) * 0x94d049bb133111ebi64u
	second ^ (second >>> 31)

private def hash_of :: (Hash<'key>, Eq<'key>) => ref HashMap<'key, 'value> -> ref 'key -> i64
fn hash_of map key =
	assert (Eq.eq key key)
	if map.keyed then (sip13 map.key0 map.key1 (Hash.hash key)) as i64 else mix (Hash.hash key)

private def table_size :: own i64 -> i64
fn table_size count =
	assert (count >= 0 && count <= 1152921504606846976)
	let mut size = 8
	while size < 2 * count do size = size * 2
	size

private def empty_slots :: own i64 -> Vec<i64>
fn empty_slots size =
	let mut slots = Vec.with_capacity size
	let mut index = 0
	while index < size do
		slots = Vec.push_owned (-1) slots
		index = index + 1
	slots

private def locate :: ref Vec<i64> -> own i64 -> own i64 -> i64
fn locate slots hash index =
	let mask = Vec.length slots - 1
	let mut position = hash & mask
	while slots[position] != index do position = (position + 1) & mask
	position

private def rebuild :: ref Vec<Entry<'key, 'value>> -> own i64 -> Vec<i64>
fn rebuild entries size =
	let mut slots = empty_slots size
	let mut index = 0
	while index < Vec.length entries do
		let position = locate (ref slots) entries[index].hash (-1)
		slots = Vec.set position index slots
		index = index + 1
	slots

private def probe :: (Hash<'key>, Eq<'key>) => ref HashMap<'key, 'value> -> ref 'key -> own i64 -> i64
fn probe map key hash =
	let mask = Vec.length (ref map.slots) - 1
	let mut position = hash & mask
	while map.slots[position] >= 0 && !(map.entries[map.slots[position]].hash == hash && Eq.eq (ref map.entries[map.slots[position]].key) key) do
		position = (position + 1) & mask
	position

private def find :: (Hash<'key>, Eq<'key>) => ref HashMap<'key, 'value> -> ref 'key -> i64
fn find map key =
	let hash = hash_of map key
	if Vec.length (ref map.slots) == 0 then -1 else map.slots[probe map key hash]

/// An empty map with room for `count` entries before its table grows.
///
/// ```tsuzuri run=1
/// HashMap.with_capacity 100 |> HashMap.insert "a" 1 |> HashMap.length
/// ```
def with_capacity :: own i64 -> HashMap<'key, 'value>
fn with_capacity count =
	let size = table_size count
	if count == 0 then empty() else HashMap { entries: Vec.with_capacity count, slots: empty_slots size, key0: 0i64u, key1: 0i64u, keyed: false }

/// An empty map whose hashes are keyed by `seed`, so keys chosen to share table positions under the
/// fixed mixing of `empty` spread out. The 128-bit key is two SplitMix64 outputs of the seed, and the
/// iteration order does not depend on it. Keys that collide in the whole `Hash.hash` digest still collide.
///
/// ```tsuzuri run=2
/// let map = HashMap.with_seed 2026i64u |> HashMap.insert "a" 1 |> HashMap.insert "b" 2
/// HashMap.get "b" map |> Maybe.default_value 0
/// ```
def with_seed :: own i64u -> HashMap<'key, 'value>
fn with_seed seed = HashMap { entries: Vec.empty(), slots: Vec.empty(), key0: split_mix seed, key1: split_mix (seed + 0x9e3779b97f4a7c15i64u), keyed: true }

/// `with_seed` with room for `count` entries that needs no growth.
///
/// ```tsuzuri run=20
/// let map = HashMap.with_capacity_and_seed 16 2026i64u |> HashMap.insert 1 10 |> HashMap.insert 2 20
/// HashMap.get 2 map |> Maybe.default_value 0
/// ```
def with_capacity_and_seed :: own i64 -> own i64u -> HashMap<'key, 'value>
fn with_capacity_and_seed count seed =
	let size = table_size count
	if count == 0 then with_seed seed else HashMap { entries: Vec.with_capacity count, slots: empty_slots size, key0: split_mix seed, key1: split_mix (seed + 0x9e3779b97f4a7c15i64u), keyed: true }

/// An empty map keyed by a seed from the operating system (`Random.next_u64`). A failure to get one is
/// reported, never replaced by a fixed seed. Not available on the default wasm32 target, which has no
/// operating-system APIs; give `with_seed` a seed the host chose instead.
///
/// ```tsuzuri
/// def main :: unit -> i32 = \() ->
///     let! made = HashMap.try_randomized ()
///     match made with
///     | Result.Ok map -> if HashMap.contains_key "a" (HashMap.insert "a" 1 map) then 0 else 1
///     | Result.Error _ -> 2
/// ```
def try_randomized :: own unit -> IO<Result<HashMap<'key, 'value>, Os.Error>>
fn try_randomized _unit = IO.map (\seed ->
	match seed with
	| Result.Ok word -> Result.Ok (with_seed word)
	| Result.Error error -> Result.Error error) (Random.next_u64 ())

/// `try_randomized` that traps when the operating system gives no seed.
///
/// ```tsuzuri
/// def main :: unit -> i32 = \() ->
///     let! map = HashMap.randomized ()
///     let counts = map |> HashMap.insert "a" 1 |> HashMap.insert "b" 2
///     if HashMap.length counts == 2 then 0 else 1
/// ```
def randomized :: own unit -> IO<HashMap<'key, 'value>>
fn randomized _unit = IO.map (\made -> Result.get made) (try_randomized ())

/// Whether an entry has `key`, which is borrowed.
///
/// ```tsuzuri run=true
/// let key = "tea"
/// HashMap.empty() |> HashMap.insert "tea" 3 |> HashMap.contains_key_ref (ref key)
/// ```
def contains_key_ref :: (Hash<'key>, Eq<'key>) => ref 'key -> ref HashMap<'key, 'value> -> bool
fn contains_key_ref key map = find map key >= 0

/// Whether an entry has `key`.
///
/// ```tsuzuri run=true%20false
/// let map = HashMap.empty() |> HashMap.insert 1 "one"
/// $"{HashMap.contains_key 1 map} {HashMap.contains_key 2 map}"
/// ```
def contains_key :: (Hash<'key>, Eq<'key>) => own 'key -> ref HashMap<'key, 'value> -> bool
fn contains_key key map = contains_key_ref (ref key) map

/// The value for `key`, which is borrowed, or `None`.
///
/// ```tsuzuri run=5
/// let key = "cake"
/// let prices = HashMap.empty() |> HashMap.insert "tea" 3 |> HashMap.insert "cake" 5
/// HashMap.get_ref (ref key) prices |> Maybe.default_value 0
/// ```
def get_ref :: (Hash<'key>, Eq<'key>, Copy<'value>) => ref 'key -> ref HashMap<'key, 'value> -> Maybe<'value>
fn get_ref key map =
	let index = find map key
	if index >= 0 then Maybe.Some map.entries[index].value else Maybe.None

/// The value for `key`, or `None`.
///
/// ```tsuzuri run=3%200
/// let prices = HashMap.empty() |> HashMap.insert "tea" 3
/// let tea = HashMap.get "tea" prices |> Maybe.default_value 0
/// let cake = HashMap.get "cake" prices |> Maybe.default_value 0
/// $"{tea} {cake}"
/// ```
def get :: (Hash<'key>, Eq<'key>, Copy<'value>) => own 'key -> ref HashMap<'key, 'value> -> Maybe<'value>
fn get key map = get_ref (ref key) map

/// A reference to the value for `key`, which is borrowed; traps when no entry has it.
///
/// ```tsuzuri run=one
/// let key = 1
/// let names = HashMap.empty() |> HashMap.insert 1 "one" |> HashMap.insert 2 "two"
/// $"{HashMap.at_ref (ref key) names}"
/// ```
def at_ref {r s} :: (Hash<'key>, Eq<'key>) => ref {s} 'key -> ref {r} HashMap<'key, 'value> -> ref {r} 'value
fn at_ref key map =
	let index = find map key
	assert (index >= 0)
	ref map.entries[index].value

/// A reference to the value for `key`; traps when no entry has it.
///
/// ```tsuzuri run=two
/// let names = HashMap.empty() |> HashMap.insert 1 "one" |> HashMap.insert 2 "two"
/// $"{HashMap.at 2 names}"
/// ```
def at :: (Hash<'key>, Eq<'key>) => own 'key -> ref HashMap<'key, 'value> -> ref 'value
fn at key map = at_ref (ref key) map

/// Adds an entry for `key` with `value`, or replaces the value of the entry that has `key`.
///
/// ```tsuzuri run=1%2030
/// let map = HashMap.empty() |> HashMap.insert "a" 10 |> HashMap.insert "a" 30
/// $"{HashMap.length map} {deref (HashMap.at "a" map)}"
/// ```
def insert :: (Hash<'key>, Eq<'key>) => own 'key -> own 'value -> own HashMap<'key, 'value> -> HashMap<'key, 'value>
fn insert key value map =
	let hash = hash_of (ref map) (ref key)
	let count = length (ref map)
	let size = Vec.length (ref map.slots)
	let found = if size == 0 then -1 else map.slots[probe (ref map) (ref key) hash]
	match map with
	| HashMap { entries = entries, slots = slots, key0 = key0, key1 = key1, keyed = keyed } ->
		if found >= 0 then
			match Vec.pop (Vec.swap found (count - 1) entries) with
			| (remaining, Maybe.Some old) ->
				let replacement = Entry { hash: old.hash, key: old.key, value: value }
				HashMap { entries: Vec.swap found (count - 1) (Vec.push_owned replacement remaining), slots: slots, key0: key0, key1: key1, keyed: keyed }
			| (_, Maybe.None) -> unreachable ()
		else
			let grown = if 2 * (count + 1) > size then rebuild (ref entries) (if size == 0 then 8 else size * 2) else slots
			let position = locate (ref grown) hash (-1)
			HashMap { entries: Vec.push_owned (Entry { hash: hash, key: key, value: value }) entries, slots: Vec.set position count grown, key0: key0, key1: key1, keyed: keyed }

private def unlink :: ref Vec<Entry<'key, 'value>> -> own Vec<i64> -> own i64 -> Vec<i64>
fn unlink entries slots start =
	let mask = Vec.length (ref slots) - 1
	let mut current = slots
	let mut hole = start
	let mut position = (start + 1) & mask
	while current[position] >= 0 do
		let ideal = entries[current[position]].hash & mask
		if ((position - ideal) & mask) >= ((position - hole) & mask) then
			let moved = current[position]
			current = Vec.set hole moved current
			hole = position
		position = (position + 1) & mask
	Vec.set hole (-1) current

/// Removes the entry that has `key`, which is borrowed; a map without one comes back unchanged.
///
/// ```tsuzuri run=false%201
/// let key = "tea"
/// let map = HashMap.empty() |> HashMap.insert "tea" 3 |> HashMap.insert "cake" 5 |> HashMap.remove_ref (ref key)
/// $"{HashMap.contains_key_ref (ref key) map} {HashMap.length map}"
/// ```
def remove_ref :: (Hash<'key>, Eq<'key>) => ref 'key -> own HashMap<'key, 'value> -> HashMap<'key, 'value>
fn remove_ref key map =
	let hash = hash_of (ref map) key
	let count = length (ref map)
	if count == 0 then map else
		let slot = probe (ref map) key hash
		let index = map.slots[slot]
		if index < 0 then map else
			match map with
			| HashMap { entries = entries, slots = slots, key0 = key0, key1 = key1, keyed = keyed } ->
				let last = count - 1
				let unlinked = unlink (ref entries) slots slot
				let relinked = if index == last then unlinked else
					let position = locate (ref unlinked) entries[last].hash last
					Vec.set position index unlinked
				match Vec.pop (Vec.swap index last entries) with
				| (remaining, _removed) -> HashMap { entries: remaining, slots: relinked, key0: key0, key1: key1, keyed: keyed }

/// Removes the entry that has `key`; a map without one comes back unchanged.
///
/// ```tsuzuri run=[(3,%2030)]
/// let map = HashMap.empty() |> HashMap.insert 1 10 |> HashMap.insert 3 30
/// map |> HashMap.remove 1 |> HashMap.remove 2 |> HashMap.to_array
/// ```
def remove :: (Hash<'key>, Eq<'key>) => own 'key -> own HashMap<'key, 'value> -> HashMap<'key, 'value>
fn remove key map = remove_ref (ref key) map

/// How far the entry that sits farthest from its ideal table position is from it: 0 for an empty map.
/// A diagnostic for tuning and tests; a map that is flooded with colliding keys has a large value.
///
/// ```tsuzuri run=0
/// HashMap.empty() |> HashMap.insert 7 "seven" |> HashMap.longest_probe
/// ```
def longest_probe :: ref HashMap<'key, 'value> -> i64
fn longest_probe map =
	let size = Vec.length (ref map.slots)
	let mask = size - 1
	let mut longest = 0
	let mut position = 0
	while position < size do
		let index = map.slots[position]
		if index >= 0 then
			let distance = (position - (map.entries[index].hash & mask)) & mask
			if distance > longest then longest = distance
		position = position + 1
	longest

/// The entries as `(key, value)` pairs, in the order of the entries (see `iter`).
///
/// ```tsuzuri run=[(1,%2010),%20(2,%2020)]
/// let map = HashMap.empty() |> HashMap.insert 2 20 |> HashMap.insert 1 10
/// HashMap.to_array map |> Array.sort
/// ```
def to_array :: (Copy<'key>, Copy<'value>) => ref HashMap<'key, 'value> -> [('key * 'value)]
fn to_array map = new [('key * 'value)](length map, \index -> (map.entries[index].key, map.entries[index].value))

/// The keys, in the order of the entries (see `iter`).
///
/// ```tsuzuri run=[1,%202,%203]
/// let map = HashMap.empty() |> HashMap.insert 3 "c" |> HashMap.insert 1 "a" |> HashMap.insert 2 "b"
/// HashMap.keys map |> Array.sort
/// ```
def keys :: Copy<'key> => ref HashMap<'key, 'value> -> ['key]
fn keys map = new ['key](length map, \index -> map.entries[index].key)

/// The values, in the order of the entries (see `iter`).
///
/// ```tsuzuri run=[10,%2020,%2030]
/// let map = HashMap.empty() |> HashMap.insert "c" 30 |> HashMap.insert "a" 10 |> HashMap.insert "b" 20
/// HashMap.values map |> Array.sort
/// ```
def values :: Copy<'value> => ref HashMap<'key, 'value> -> ['value]
fn values map = new ['value](length map, \index -> map.entries[index].value)

/// Folds `folder` over the entries, in the order of the entries (see `iter`), starting from `initial`.
///
/// ```tsuzuri run=8
/// let stock = HashMap.empty() |> HashMap.insert "tea" 3 |> HashMap.insert "cake" 5
/// HashMap.fold (\total _name count -> total + deref count) 0 stock
/// ```
def fold :: own ('state -> ref 'key -> ref 'value -> 'state) -> own 'state -> ref HashMap<'key, 'value> -> 'state
fn fold folder initial map =
	let mut state = initial
	let mut index = 0
	while index < length map do
		state = folder state (ref map.entries[index].key) (ref map.entries[index].value)
		index = index + 1
	state

private def rec iter_from :: ref HashMap<'key, 'value> -> own i64 -> Seq<(ref 'key * ref 'value)>
fn rec iter_from map index = Seq.defer (\() ->
	if index < length map then (iter_from map (index + 1), Maybe.Some (ref map.entries[index].key, ref map.entries[index].value))
	else (Seq.empty(), Maybe.None))

/// A sequence of references to the keys and values, in the order of the entries: the order of insertion, until a
/// `remove` moves the last entry into the place of the removed one.
///
/// ```tsuzuri run=8
/// let stock = HashMap.empty() |> HashMap.insert "tea" 3 |> HashMap.insert "cake" 5
/// let mut total = 0
/// for (_name, count) in HashMap.iter stock do total = total + deref count
/// total
/// ```
def iter :: ref HashMap<'key, 'value> -> Seq<(ref 'key * ref 'value)>
fn iter map = iter_from map 0
