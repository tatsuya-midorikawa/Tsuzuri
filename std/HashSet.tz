record HashSet<'key> { map: HashMap<'key, unit> }

/// An empty set.
///
/// ```tsuzuri run=0
/// let set: HashSet<string> = HashSet.empty()
/// HashSet.length set
/// ```
def empty :: HashSet<'key>
fn empty = HashSet { map: HashMap.empty() }

/// An empty set with room for `count` keys before its table grows.
///
/// ```tsuzuri run=1
/// HashSet.with_capacity 100 |> HashSet.insert "a" |> HashSet.length
/// ```
def with_capacity :: own i64 -> HashSet<'key>
fn with_capacity count = HashSet { map: HashMap.with_capacity count }

/// The number of keys.
///
/// ```tsuzuri run=2
/// HashSet.empty() |> HashSet.insert "a" |> HashSet.insert "b" |> HashSet.insert "a" |> HashSet.length
/// ```
def length :: ref HashSet<'key> -> i64
fn length set = HashMap.length (ref set.map)

/// Whether the set has no keys.
///
/// ```tsuzuri run=true
/// HashSet.empty() |> HashSet.insert 1 |> HashSet.remove 1 |> HashSet.is_empty
/// ```
def is_empty :: ref HashSet<'key> -> bool
fn is_empty set = HashMap.is_empty (ref set.map)

/// An empty set whose hashes are keyed by `seed`; see `HashMap.with_seed`.
///
/// ```tsuzuri run=true
/// let set = HashSet.with_seed 2026i64u |> HashSet.insert "a" |> HashSet.insert "b"
/// HashSet.contains "b" set
/// ```
def with_seed :: own i64u -> HashSet<'key>
fn with_seed seed = HashSet { map: HashMap.with_seed seed }

/// An empty set with room for `count` keys whose hashes are keyed by `seed`; see `HashMap.with_capacity_and_seed`.
///
/// ```tsuzuri run=2
/// let set = HashSet.with_capacity_and_seed 16 2026i64u |> HashSet.insert 1 |> HashSet.insert 2
/// HashSet.length set
/// ```
def with_capacity_and_seed :: own i64 -> own i64u -> HashSet<'key>
fn with_capacity_and_seed count seed = HashSet { map: HashMap.with_capacity_and_seed count seed }

/// An empty set keyed by a seed from the operating system; see `HashMap.try_randomized`.
///
/// ```tsuzuri
/// def main :: unit -> i32 = \() ->
///     let! made = HashSet.try_randomized ()
///     match made with
///     | Result.Ok set -> if HashSet.contains "a" (HashSet.insert "a" set) then 0 else 1
///     | Result.Error _ -> 2
/// ```
def try_randomized :: own unit -> IO<Result<HashSet<'key>, Os.Error>>
fn try_randomized _unit = IO.map (\made ->
	match made with
	| Result.Ok map -> Result.Ok (HashSet { map: map })
	| Result.Error error -> Result.Error error) (HashMap.try_randomized ())

/// `try_randomized` that traps when the operating system gives no seed.
///
/// ```tsuzuri
/// def main :: unit -> i32 = \() ->
///     let! set = HashSet.randomized ()
///     let words = set |> HashSet.insert "a" |> HashSet.insert "b"
///     if HashSet.length words == 2 then 0 else 1
/// ```
def randomized :: own unit -> IO<HashSet<'key>>
fn randomized _unit = IO.map (\made -> Result.get made) (try_randomized ())

/// Adds `key`; a set that has it already comes back unchanged.
///
/// ```tsuzuri run=true%202
/// let set = HashSet.empty() |> HashSet.insert "tea" |> HashSet.insert "cake" |> HashSet.insert "tea"
/// $"{HashSet.contains "cake" set} {HashSet.length set}"
/// ```
def insert :: (Hash<'key>, Eq<'key>) => own 'key -> own HashSet<'key> -> HashSet<'key>
fn insert key set = HashSet { map: HashMap.insert key () set.map }

/// Removes `key`, which is borrowed; a set without it comes back unchanged.
///
/// ```tsuzuri run=false
/// let key = "tea"
/// let set = HashSet.empty() |> HashSet.insert "tea" |> HashSet.remove_ref (ref key)
/// HashSet.contains_ref (ref key) set
/// ```
def remove_ref :: (Hash<'key>, Eq<'key>) => ref 'key -> own HashSet<'key> -> HashSet<'key>
fn remove_ref key set = HashSet { map: HashMap.remove_ref key set.map }

/// Removes `key`; a set without it comes back unchanged.
///
/// ```tsuzuri run=[3]
/// let set = HashSet.empty() |> HashSet.insert 1 |> HashSet.insert 3
/// set |> HashSet.remove 1 |> HashSet.remove 2 |> HashSet.to_array
/// ```
def remove :: (Hash<'key>, Eq<'key>) => own 'key -> own HashSet<'key> -> HashSet<'key>
fn remove key set = HashSet { map: HashMap.remove key set.map }

/// Whether the set has `key`, which is borrowed.
///
/// ```tsuzuri run=true
/// let key = "tea"
/// HashSet.empty() |> HashSet.insert "tea" |> HashSet.contains_ref (ref key)
/// ```
def contains_ref :: (Hash<'key>, Eq<'key>) => ref 'key -> ref HashSet<'key> -> bool
fn contains_ref key set = HashMap.contains_key_ref key (ref set.map)

/// Whether the set has `key`.
///
/// ```tsuzuri run=true%20false
/// let set = HashSet.empty() |> HashSet.insert 1 |> HashSet.insert 3
/// $"{HashSet.contains 3 set} {HashSet.contains 2 set}"
/// ```
def contains :: (Hash<'key>, Eq<'key>) => own 'key -> ref HashSet<'key> -> bool
fn contains key set = HashMap.contains_key key (ref set.map)

/// The longest probe of the underlying table; see `HashMap.longest_probe`.
///
/// ```tsuzuri run=0
/// HashSet.empty() |> HashSet.insert 7 |> HashSet.longest_probe
/// ```
def longest_probe :: ref HashSet<'key> -> i64
fn longest_probe set = HashMap.longest_probe (ref set.map)

/// The keys, in the order of the entries of the underlying map (see `HashMap.iter`).
///
/// ```tsuzuri run=[1,%202,%203]
/// let set = HashSet.empty() |> HashSet.insert 3 |> HashSet.insert 1 |> HashSet.insert 2
/// HashSet.to_array set |> Array.sort
/// ```
def to_array :: Copy<'key> => ref HashSet<'key> -> ['key]
fn to_array set = HashMap.keys (ref set.map)

/// Folds `folder` over the keys, in the order of the entries of the underlying map, starting from `initial`.
///
/// ```tsuzuri run=6
/// let set = HashSet.empty() |> HashSet.insert 1 |> HashSet.insert 2 |> HashSet.insert 3
/// HashSet.fold (\total key -> total + deref key) 0 set
/// ```
def fold :: own ('state -> ref 'key -> 'state) -> own 'state -> ref HashSet<'key> -> 'state
fn fold folder initial set = HashMap.fold (\state key _unit -> folder state key) initial (ref set.map)

/// A sequence of references to the keys, in the order of the entries of the underlying map.
///
/// ```tsuzuri run=7
/// let set = HashSet.empty() |> HashSet.insert "tea" |> HashSet.insert "cake"
/// let mut total = 0
/// for key in HashSet.iter set do total = total + key.length
/// total
/// ```
def iter :: ref HashSet<'key> -> Seq<ref 'key>
fn iter set = Seq.map (\pair -> match pair with | (key, _unit) -> key) (HashMap.iter (ref set.map))
