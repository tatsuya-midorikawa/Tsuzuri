def length :: ref string -> i64
fn length text = text.length

private def append_range :: Vec<i16u> -> ref string -> i64 -> i64 -> Vec<i16u>
fn append_range initial text first last =
	let mut output = initial
	for index in first .. (last - 1) do output = Vec.push output text[index]
	output

private def add_length :: i64 -> i64 -> i64
fn add_length left right =
	assert (left <= 9007199254740991 - right)
	left + right

private def matches_at :: ref string -> ref string -> i64 -> bool
fn matches_at needle text offset =
	if offset < 0 || offset > text.length || needle.length > text.length - offset then false else
		let mut index = 0
		while index < needle.length && needle[index] == text[offset + index] do index = index + 1
		index == needle.length

def find :: ref string -> ref string -> Option<i64>
fn find needle text =
	let mut offset = 0
	let mut result = Option.None
	while offset <= text.length do
		if matches_at needle text offset then
			result = Option.Some offset
			break
		offset = offset + 1
	result

def rfind :: ref string -> ref string -> Option<i64>
fn rfind needle text =
	let mut offset = text.length
	let mut result = Option.None
	while offset >= 0 do
		if matches_at needle text offset then
			result = Option.Some offset
			break
		offset = offset - 1
	result

def contains :: ref string -> ref string -> bool
fn contains needle text =
	let result = find needle text
	Option.is_some (ref result)

def starts_with :: ref string -> ref string -> bool
fn starts_with prefix text = matches_at prefix text 0

def ends_with :: ref string -> ref string -> bool
fn ends_with suffix text = suffix.length <= text.length && matches_at suffix text (text.length - suffix.length)

def slice :: ref string -> i64 -> i64 -> Option<string>
fn slice text first last =
	if first < 0 || last < first || last > text.length then Option.None else
		let output = append_range (Vec.with_capacity (last - first)) text first last
		Option.Some (String.from_code_units (Vec.to_array output))

def sub :: ref string -> i64 -> i64 -> Option<string>
fn sub text first count =
	if first < 0 || count < 0 || first > 9223372036854775807 - count then Option.None else slice text first (first + count)

def decode_at :: ref string -> i64 -> (char * i64)
fn decode_at text offset = (Char.of_u16 text[offset], offset + 1)

def char_count :: ref string -> i64
fn char_count text = text.length

def chars :: ref string -> [char]
fn chars text = new [char](text.length, index -> Char.of_u16 text[index])

def join :: ref string -> ref [string] -> string
fn join separator parts =
	let mut size = 0
	for index in 0 .. (parts.length - 1) do
		size = add_length size parts[index].length
		if index > 0 then size = add_length size separator.length
	let mut output: Vec<i16u> = Vec.with_capacity size
	for index in 0 .. (parts.length - 1) do
		if index > 0 then output = append_range output separator 0 separator.length
		output = append_range output (ref parts[index]) 0 parts[index].length
	String.from_code_units (Vec.to_array output)

def concat :: ref [string] -> string
fn concat parts =
	let empty = ""
	join (ref empty) parts

def split :: ref string -> ref string -> [string]
fn split separator text =
	if separator.length == 0 then
		new [string](text.length, index -> Option.get (slice text index (index + 1)))
	else
		let mut count = 1
		let mut index = 0
		while index <= text.length - separator.length do
			if matches_at separator text index then
				count = count + 1
				index = index + separator.length
			else index = index + 1
		let mut output: Vec<string> = Vec.with_capacity count
		let mut start = 0
		let mut offset = 0
		while offset <= text.length - separator.length do
			if matches_at separator text offset then
				output = Vec.push output (Option.get (slice text start offset))
				offset = offset + separator.length
				start = offset
			else offset = offset + 1
		output = Vec.push output (Option.get (slice text start text.length))
		Vec.to_array output

private def whitespace :: i16u -> bool
fn whitespace value = value == 32i16u || (value >= 9i16u && value <= 13i16u)

def trim_start :: ref string -> string
fn trim_start text =
	let mut first = 0
	while first < text.length && whitespace text[first] do first = first + 1
	Option.get (slice text first text.length)

def trim_end :: ref string -> string
fn trim_end text =
	let mut last = text.length
	while last > 0 && whitespace text[last - 1] do last = last - 1
	Option.get (slice text 0 last)

def trim :: ref string -> string
fn trim text =
	let mut first = 0
	let mut last = text.length
	while first < last && whitespace text[first] do first = first + 1
	while last > first && whitespace text[last - 1] do last = last - 1
	Option.get (slice text first last)

def to_ascii_lower :: ref string -> string
fn to_ascii_lower text = String.from_code_units (new [i16u](text.length, index -> Char.to_u16 (Char.to_ascii_lower (Char.of_u16 text[index]))))

def to_ascii_upper :: ref string -> string
fn to_ascii_upper text = String.from_code_units (new [i16u](text.length, index -> Char.to_u16 (Char.to_ascii_upper (Char.of_u16 text[index]))))

def repeat :: ref string -> i64 -> string
fn repeat text count =
	assert (count >= 0)
	if count == 0 || text.length == 0 then "" else
		let size = Option.get (Int.checked_mul text.length count)
		assert (size <= 9007199254740991)
		String.from_code_units (new [i16u](size, index -> text[index % text.length]))

def replace :: ref string -> ref string -> ref string -> string
fn replace needle replacement text =
	let mut occurrences = 0
	let mut offset = 0
	while offset <= text.length do
		if matches_at needle text offset then
			occurrences = occurrences + 1
			offset = offset + (if needle.length == 0 then 1 else needle.length)
		else offset = offset + 1
	let removed = Option.get (Int.checked_mul occurrences needle.length)
	let inserted = Option.get (Int.checked_mul occurrences replacement.length)
	let size = add_length (text.length - removed) inserted
	let mut output: Vec<i16u> = Vec.with_capacity size
	let mut index = 0
	while index <= text.length do
		let matched = matches_at needle text index
		if matched then output = append_range output replacement 0 replacement.length
		if matched && needle.length > 0 then index = index + needle.length
		else
			if index < text.length then output = Vec.push output text[index]
			index = index + 1
	String.from_code_units (Vec.to_array output)
