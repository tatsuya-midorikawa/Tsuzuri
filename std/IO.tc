record IO<'a> { work: unit -> 'a }

union Error = ReadFailed | WriteFailed | InvalidEncoding

def pure :: Capture<'a> => own 'a -> IO<'a>
fn pure value = IO { work: \() -> value }

def bind :: own ('a -> IO<'b>) -> own IO<'a> -> IO<'b>
fn bind next action = IO { work: \() -> {
    let value = action.work ();
    (next value).work ()
} }

def map :: own ('a -> 'b) -> own IO<'a> -> IO<'b>
fn map transform action = IO { work: \() -> transform (action.work ()) }

/// Runs an action where a body that has no builder writes `let!` or `do!`.
private def run :: own IO<'a> -> 'a
fn run action = action.work ()

def Return :: Capture<'a> => own 'a -> IO<'a>
fn Return value = pure value

def ReturnFrom :: own IO<'a> -> IO<'a>
fn ReturnFrom action = action

def Bind :: own IO<'a> -> own ('a -> IO<'b>) -> IO<'b>
fn Bind action next = bind next action

def Using :: own (('a -> 'b) -> 'c) -> own ('a -> IO<'b>) -> IO<'c>
fn Using source next = IO { work: \() -> source (value -> (next value).work ()) }

def Zero :: IO<unit>
fn Zero = pure ()

def Delay :: own (unit -> IO<'a>) -> IO<'a>
fn Delay body = IO { work: \() -> (body ()).work () }

def Combine :: own IO<unit> -> own IO<'a> -> IO<'a>
fn Combine first rest = IO { work: \() -> {
    first.work ();
    rest.work ()
} }

def For :: (Copy<'a>, Capture<'a>) => own ['a] -> own ('a -> IO<unit>) -> IO<unit>
fn For values body = IO { work: \() -> for value in values do (body value).work () }

def While :: own (unit -> bool) -> own IO<unit> -> IO<unit>
fn While guard body = IO { work: \() -> while guard () do body.work () }

def MergeSources :: own IO<'a> -> own IO<'b> -> IO<('a * 'b)>
fn MergeSources first second = IO { work: \() -> (first.work (), second.work ()) }

def BindReturn :: own IO<'a> -> own ('a -> 'b) -> IO<'b>
fn BindReturn action transform = map transform action

def try_read_line :: own unit -> IO<Result<Maybe<string>, Error>>
fn try_read_line _unit = IO { work: \() ->
    match IO.__read_line () with
    | (0, bytes) ->
        match Utf8String.from_bytes bytes with
        | Maybe.Some text -> Result.Ok (Maybe.Some (String.from_utf8 (ref text)))
        | Maybe.None -> Result.Error InvalidEncoding
    | (1, _) -> Result.Ok Maybe.None
    | _ -> Result.Error ReadFailed
}

def read_line :: own unit -> IO<Maybe<string>>
fn read_line _unit = map Result.get (try_read_line ())

private def try_output :: (Display<'a>, Capture<'a>) => own i32 -> own bool -> own 'a -> IO<Result<unit, Error>>
fn try_output destination newline value = IO { work: \() ->
    let text = Display.display (ref value)
    if String.is_well_formed (ref text) then
        let output = if newline then text + "\n" else text
        let bytes = Utf8String.from_string (ref output)
        if IO.__write destination (ref bytes) == 0 then Result.Ok () else Result.Error WriteFailed
    else Result.Error InvalidEncoding
}

def try_write :: (Display<'a>, Capture<'a>) => own 'a -> IO<Result<unit, Error>>
fn try_write value = try_output 1i32 false value

def try_write_line :: (Display<'a>, Capture<'a>) => own 'a -> IO<Result<unit, Error>>
fn try_write_line value = try_output 1i32 true value

def try_write_error :: (Display<'a>, Capture<'a>) => own 'a -> IO<Result<unit, Error>>
fn try_write_error value = try_output 2i32 false value

def try_write_error_line :: (Display<'a>, Capture<'a>) => own 'a -> IO<Result<unit, Error>>
fn try_write_error_line value = try_output 2i32 true value

def write :: (Display<'a>, Capture<'a>) => own 'a -> IO<unit>
fn write value = map Result.get (try_write value)

def write_line :: (Display<'a>, Capture<'a>) => own 'a -> IO<unit>
fn write_line value = map Result.get (try_write_line value)

/// The same action as `write_line`.
def writeln :: (Display<'a>, Capture<'a>) => own 'a -> IO<unit>
fn writeln value = write_line value

def write_error :: (Display<'a>, Capture<'a>) => own 'a -> IO<unit>
fn write_error value = map Result.get (try_write_error value)

def write_error_line :: (Display<'a>, Capture<'a>) => own 'a -> IO<unit>
fn write_error_line value = map Result.get (try_write_error_line value)
