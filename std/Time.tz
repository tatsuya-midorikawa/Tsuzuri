private def reading :: own i32 -> Result<i64, Os.Error>
fn reading clock =
	let nanoseconds = Os.__clock clock
	if nanoseconds == -9223372036854775808 then Result.Error (Os.Error { kind: Os.Other, code: 0i32 })
	else Result.Ok nanoseconds

private def pause :: own i64 -> Result<unit, Os.Error>
fn pause milliseconds =
	let status = Os.__sleep milliseconds
	if status == 0 then Result.Ok () else Result.Error (Os.error_of_status status)

/// Nanoseconds on a clock that never goes backwards. Its start is unspecified; only differences mean anything.
///
/// ```tsuzuri
/// let! start = Time.monotonic_ns ()
/// let! _slept = Time.sleep_ms 10
/// let! stop = Time.monotonic_ns ()
/// match (start, stop) with
/// | (Result.Ok first, Result.Ok last) -> IO.write_line (to_string ((last - first) / 1000000) + " ms")
/// | _ -> IO.write_line "no clock"
/// ```
def monotonic_ns :: own unit -> IO<Result<i64, Os.Error>>
fn monotonic_ns _unit = IO.map (\() -> reading 0i32) (IO.pure ())

/// Nanoseconds since 1970-01-01 UTC. A time that does not fit an `i64` is `Other`.
///
/// ```tsuzuri
/// let! now = Time.unix_ns ()
/// match now with
/// | Result.Ok nanoseconds -> IO.write_line (to_string (nanoseconds / 1000000000) + " s since 1970")
/// | Result.Error error -> IO.write_line (Os.message error)
/// ```
def unix_ns :: own unit -> IO<Result<i64, Os.Error>>
fn unix_ns _unit = IO.map (\() -> reading 1i32) (IO.pure ())

/// Waits at least the given milliseconds; a negative count is `InvalidInput`, and 0 returns at once.
///
/// ```tsuzuri
/// let! slept = Time.sleep_ms 250
/// match slept with
/// | Result.Ok _ -> IO.write_line "a quarter second later"
/// | Result.Error error -> IO.write_line (Os.message error)
/// ```
def sleep_ms :: own i64 -> IO<Result<unit, Os.Error>>
fn sleep_ms milliseconds = IO.map (\() -> pause milliseconds) (IO.pure ())
