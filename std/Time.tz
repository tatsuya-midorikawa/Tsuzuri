private def reading :: i32 -> Result<i64, Os.Error>
fn reading clock =
	let nanoseconds = Os.__clock clock
	if nanoseconds == -9223372036854775808 then Result.Error (Os.Error { kind: Os.Other, code: 0i32 })
	else Result.Ok nanoseconds

private def pause :: i64 -> Result<unit, Os.Error>
fn pause milliseconds =
	let status = Os.__sleep milliseconds
	if status == 0 then Result.Ok () else Result.Error (Os.error_of_status status)

/// Nanoseconds on a clock that never goes backwards. Its start is unspecified; only differences mean anything.
def monotonic_ns :: unit -> IO<Result<i64, Os.Error>>
fn monotonic_ns _unit = IO.map (\() -> reading 0i32) (IO.pure ())

/// Nanoseconds since 1970-01-01 UTC. A time that does not fit an `i64` is `Other`.
def unix_ns :: unit -> IO<Result<i64, Os.Error>>
fn unix_ns _unit = IO.map (\() -> reading 1i32) (IO.pure ())

/// Waits at least the given milliseconds; a negative count is `InvalidInput`, and 0 returns at once.
def sleep_ms :: i64 -> IO<Result<unit, Os.Error>>
fn sleep_ms milliseconds = IO.map (\() -> pause milliseconds) (IO.pure ())
