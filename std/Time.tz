private def reading :: own i32 -> Result<i64, Os.Error>
fn reading clock =
	let nanoseconds = Os.__clock clock
	if nanoseconds == -9223372036854775808 then Result.Error (Os.Error { kind: Os.Other, code: 0i32 })
	else Result.Ok nanoseconds

private def pause :: own i64 -> Result<unit, Os.Error>
fn pause milliseconds =
	let status = Os.__sleep milliseconds
	if status == 0 then Result.Ok () else Result.Error (Os.error_of_status status)

/// Nanoseconds on a clock that never goes backwards. Its start is unspecified; only differences mean anything.
///
/// ```tsuzuri
/// let! start = Time.monotonic_ns ()
/// let! _slept = Time.sleep_ms 10
/// let! stop = Time.monotonic_ns ()
/// match (start, stop) with
/// | (Result.Ok first, Result.Ok last) -> IO.write_line (to_string ((last - first) / 1000000) + " ms")
/// | _ -> IO.write_line "no clock"
/// ```
def monotonic_ns :: own unit -> IO<Result<i64, Os.Error>>
fn monotonic_ns _unit = IO.map (\() -> reading 0i32) (IO.pure ())

/// Nanoseconds since 1970-01-01 UTC. A time that does not fit an `i64` is `Other`.
///
/// ```tsuzuri
/// let! now = Time.unix_ns ()
/// match now with
/// | Result.Ok nanoseconds -> IO.write_line (to_string (nanoseconds / 1000000000) + " s since 1970")
/// | Result.Error error -> IO.write_line (Os.message error)
/// ```
def unix_ns :: own unit -> IO<Result<i64, Os.Error>>
fn unix_ns _unit = IO.map (\() -> reading 1i32) (IO.pure ())

/// Waits at least the given milliseconds; a negative count is `InvalidInput`, and 0 returns at once.
///
/// ```tsuzuri
/// let! slept = Time.sleep_ms 250
/// match slept with
/// | Result.Ok _ -> IO.write_line "a quarter second later"
/// | Result.Error error -> IO.write_line (Os.message error)
/// ```
def sleep_ms :: own i64 -> IO<Result<unit, Os.Error>>
fn sleep_ms milliseconds = IO.map (\() -> pause milliseconds) (IO.pure ())

/// One nanosecond. A length of time is a count of nanoseconds in an `i64`, as Go's `time.Duration`:
/// `Time.sleep`, `Time.after`, `Time.tick`, `Time.after_func`, `Timer` and `Ticker` take one, and
/// the constants below make it readable (`50 * Time.millisecond`).
const nanosecond: i64 = 1
/// 1,000 nanoseconds.
const microsecond: i64 = 1000
/// 1,000,000 nanoseconds.
const millisecond: i64 = 1000000
/// 10⁹ nanoseconds.
const second: i64 = 1000000000
/// 60 seconds.
const minute: i64 = 60000000000
/// 60 minutes.
const hour: i64 = 3600000000000

/// Waits at least the given nanoseconds (Go's `time.Sleep`). In a tzroutine only that tzroutine
/// waits: the others go on running on its thread. 0 or less gives the processor away once, as
/// `Routine.yield` does.
///
/// ```tsuzuri run=10%20ms%20later
/// do! Time.sleep (10 * Time.millisecond)
/// do! IO.write_line "10 ms later"
/// ```
def sleep :: own i64 -> IO<unit>
fn sleep nanoseconds = IO.map (\() -> Time.__sleep_ns nanoseconds) (IO.pure ())

/// A channel that receives the time once, the given nanoseconds from now (Go's `time.After`). The
/// time is on `Time.monotonic_ns`'s clock. Waiting for it in a `select` gives up on the other arms:
///
/// ```tsuzuri run=timeout
/// let! deadline = Time.after (20 * Time.millisecond)
/// let never: Channel<i64> = Channel.make 0
/// let result =
///     select
///     | recv _ from never -> "value"
///     | recv _ from deadline -> "timeout"
/// IO.write_line result
/// ```
def after :: own i64 -> IO<Channel<i64>>
fn after nanoseconds = IO.map (\() -> Time.__after nanoseconds) (IO.pure ())

/// A channel that receives the time every period (Go's `time.Tick`). It holds one time: while the
/// receiver has not taken the last one, the next is dropped. It stops once every handle of the
/// channel is dropped. A period of 0 or less traps; `Ticker` is the one that can be stopped and reset.
///
/// ```tsuzuri run=true
/// let! ticks = Time.tick (5 * Time.millisecond)
/// let first = Channel.recv ticks
/// let second = Channel.recv ticks
/// match (first, second) with
/// | (Maybe.Some earlier, Maybe.Some later) -> IO.write_line (later > earlier)
/// | _ -> IO.write_line "closed"
/// ```
def tick :: own i64 -> IO<Channel<i64>>
fn tick period = IO.map (\() -> Time.__tick period) (IO.pure ())

/// Calls the function once on a new tzroutine, the given nanoseconds from now (Go's
/// `time.AfterFunc`). The returned `Timer` stops it (and `Timer.reset` schedules it again); the end
/// of the `main`, `export`, `test` or `bench` that made it stops it too, and dropping the `Timer`
/// does, dropping the function without calling it. It starts at once, as `Routine.go` does: an
/// `IO` action may run more than once, and the function runs at most once.
///
/// ```tsuzuri run=called
/// let done: Channel<i64> = Channel.make 1
/// let signal = Channel.share done
/// let _timer = Time.after_func (5 * Time.millisecond) (Owned.function (\() -> Channel.send signal 1))
/// match Channel.recv done with
/// | Maybe.Some _ -> "called"
/// | Maybe.None -> "not called"
/// ```
def after_func :: own i64 -> own Owned.Function<unit, unit> -> Timer
fn after_func nanoseconds function = Time.__after_func nanoseconds function
