def length :: ref ['a] -> i64
fn length values = values.length

def is_empty :: ref ['a] -> bool
fn is_empty values = values.length == 0

private def rec iter_from :: ref ['a] -> i64 -> Seq<ref 'a>
fn rec iter_from values index = Seq.defer (\() ->
    if index < values.length then (iter_from values (index + 1), Maybe.Some (ref values[index]))
    else (Seq.empty(), Maybe.None))

def iter :: ref ['a] -> Seq<ref 'a>
fn iter values = iter_from values 0

def get :: Copy<'a> => ref ['a] -> i64 -> Maybe<'a>
fn get values index =
    if index < 0 || index >= values.length then Maybe.None else Maybe.Some values[index]

def at :: ref ['a] -> i64 -> ref 'a
fn at values index = ref values[index]

def init :: i64 -> (i64 -> 'a) -> ['a]
fn init count initializer = new ['a](count, initializer)

def sub :: Copy<'a> => ref ['a] -> i64 -> i64 -> ['a]
fn sub values start count =
    assert (start >= 0 && start <= values.length && count >= 0 && count <= values.length - start)
    let selected = ref values[start..start + count]
    deref selected

def reverse :: Copy<'a> => ref ['a] -> ['a]
fn reverse values = new ['a](values.length, index -> values[values.length - 1 - index])

/// Returns a new array with a copy of every element, the explicit form of an implicit array copy.
def copy :: Copy<'a> => ref ['a] -> ['a]
fn copy values = *values

def append :: Copy<'a> => ref ['a] -> ref ['a] -> ['a]
fn append left right =
    assert (left.length <= 9223372036854775807 - right.length)
    new ['a](left.length + right.length, index -> if index < left.length then left[index] else right[index - left.length])

def zip :: ref ['a] -> ref ['b] -> [('a * 'b)]
fn zip left right =
    assert (left.length == right.length)
    new [('a * 'b)](left.length, index -> (left[index], right[index]))

def map :: Copy<'a> => ('a -> 'b) -> ref ['a] -> ['b]
fn map transform values = new ['b](values.length, index -> transform values[index])

def mapi :: Copy<'a> => (i64 -> 'a -> 'b) -> ref ['a] -> ['b]
fn mapi transform values = new ['b](values.length, index -> transform index values[index])

def map_ref :: (ref 'a -> 'b) -> ref ['a] -> ['b]
fn map_ref transform values = new ['b](values.length, index -> transform (ref values[index]))

def mapi_ref :: (i64 -> ref 'a -> 'b) -> ref ['a] -> ['b]
fn mapi_ref transform values = new ['b](values.length, index -> transform index (ref values[index]))

def fold :: Copy<'a> => ('state -> 'a -> 'state) -> 'state -> ref ['a] -> 'state
fn fold folder initial values =
    let mut state = initial
    for value in values do state = folder state value
    state

def fold_ref :: ('state -> ref 'a -> 'state) -> 'state -> ref ['a] -> 'state
fn fold_ref folder initial values =
    let mut state = initial
    let mut index = 0
    while index < values.length do
        state = folder state (ref values[index])
        index = index + 1
    state

def fold_back :: Copy<'a> => ('a -> 'state -> 'state) -> ref ['a] -> 'state -> 'state
fn fold_back folder values initial =
    let mut state = initial
    let mut index = values.length
    while index > 0 do
        index = index - 1
        state = folder values[index] state
    state

def fold_back_ref :: (ref 'a -> 'state -> 'state) -> ref ['a] -> 'state -> 'state
fn fold_back_ref folder values initial =
    let mut state = initial
    let mut index = values.length
    while index > 0 do
        index = index - 1
        state = folder (ref values[index]) state
    state

def reduce :: Copy<'a> => ('a -> 'a -> 'a) -> ref ['a] -> Maybe<'a>
fn reduce folder values =
    if values.length == 0 then Maybe.None else
        let mut state = values[0]
        let mut index = 1
        while index < values.length do
            state = folder state values[index]
            index = index + 1
        Maybe.Some state

def sum :: Numeric<'a> => ref ['a] -> 'a
fn sum values =
    let mut total = 0i64 as 'a
    for value in values do total = total + value
    total

/// Sums adjacent pairs in a fixed tree, carrying an odd final element unchanged.
/// Uses one working copy. Empty input returns positive zero.
def sum_pairwise :: Float<'a> => ref ['a] -> 'a
fn sum_pairwise values =
    if values.length == 0 then 0i64 as 'a else
        let mut buffer = deref values
        let mut remaining = values.length
        while remaining > 1 do
            let next = remaining / 2 + remaining % 2
            let mut index = 0
            while index < next do
                let left = index * 2
                let value = if left + 1 < remaining then buffer[left] + buffer[left + 1] else buffer[left]
                buffer = Array.set buffer index value
                index = index + 1
            remaining = next
        buffer[0]

/// Computes the left-to-right Kahan-Babuska-Neumaier compensated sum.
/// Intermediate operations are not fused or reassociated.
def sum_kahan :: Float<'a> => ref ['a] -> 'a
fn sum_kahan values =
    let mut total = 0i64 as 'a
    let mut correction = 0i64 as 'a
    for value in values do
        let next = total + value
        correction = correction + (if Math.abs total >= Math.abs value then (total - next) + value else (value - next) + total)
        total = next
    total + correction

/// Computes a left-to-right dot product with separate multiply and add rounding.
/// Unequal lengths trap before reading elements; empty inputs return positive zero.
def dot :: Float<'a> => ref ['a] -> ref ['a] -> 'a
fn dot left right =
    assert (left.length == right.length)
    let mut total = 0i64 as 'a
    let mut index = 0
    while index < left.length do
        total = total + (left[index] * right[index])
        index = index + 1
    total

/// Computes a left-to-right dot product with one rounding per explicit FMA step.
/// Unequal lengths trap before reading elements; empty inputs return positive zero.
def dot_fma :: Float<'a> => ref ['a] -> ref ['a] -> 'a
fn dot_fma left right =
    assert (left.length == right.length)
    let mut total = 0i64 as 'a
    let mut index = 0
    while index < left.length do
        total = Math.fma left[index] right[index] total
        index = index + 1
    total

def product :: Numeric<'a> => ref ['a] -> 'a
fn product values =
    let mut total = 1i64 as 'a
    for value in values do total = total * value
    total

/// The first position of the smallest element under `<`, or 0 when `values` is empty.
private def min_index :: Ord<'a> => ref ['a] -> i64
fn min_index values =
    let mut best = 0
    let mut index = 1
    while index < values.length do
        if values[index] < values[best] then best = index
        index = index + 1
    best

/// The first position of the largest element under `>`, or 0 when `values` is empty.
private def max_index :: Ord<'a> => ref ['a] -> i64
fn max_index values =
    let mut best = 0
    let mut index = 1
    while index < values.length do
        if values[index] > values[best] then best = index
        index = index + 1
    best

def min :: Ord<'a> => ref ['a] -> Maybe<ref 'a>
fn min values =
    if values.length == 0 then Maybe.None else Maybe.Some (ref values[min_index values])

def max :: Ord<'a> => ref ['a] -> Maybe<ref 'a>
fn max values =
    if values.length == 0 then Maybe.None else Maybe.Some (ref values[max_index values])

def any :: (ref 'a -> bool) -> ref ['a] -> bool
fn any predicate values =
    let mut index = 0
    while index < values.length && !(predicate (ref values[index])) do index = index + 1
    index < values.length

def all :: (ref 'a -> bool) -> ref ['a] -> bool
fn all predicate values =
    let mut index = 0
    while index < values.length && predicate (ref values[index]) do index = index + 1
    index == values.length

def count :: (ref 'a -> bool) -> ref ['a] -> i64
fn count predicate values =
    let mut found = 0
    let mut index = 0
    while index < values.length do
        if predicate (ref values[index]) then found = found + 1
        index = index + 1
    found

def find :: (ref 'a -> bool) -> ref ['a] -> Maybe<ref 'a>
fn find predicate values =
    let mut index = 0
    while index < values.length && !(predicate (ref values[index])) do index = index + 1
    if index < values.length then Maybe.Some (ref values[index]) else Maybe.None

def index_of :: Eq<'a> => ref ['a] -> ref 'a -> Maybe<i64>
fn index_of values target =
    let mut index = 0
    while index < values.length && !(Eq.eq (ref values[index]) target) do index = index + 1
    if index < values.length then Maybe.Some index else Maybe.None

def contains :: Eq<'a> => ref ['a] -> ref 'a -> bool
fn contains values target =
    let result = index_of values target
    Maybe.is_some (ref result)

def equal :: Eq<'a> => ref ['a] -> ref ['a] -> bool
fn equal left right =
    if left.length != right.length then false else
        let mut index = 0
        while index < left.length && left[index] == right[index] do index = index + 1
        index == left.length

def binary_search :: Ord<'a> => ref ['a] -> ref 'a -> Maybe<i64>
fn binary_search values target =
    let mut lower = 0
    let mut upper = values.length
    while lower < upper do
        let middle = lower + (upper - lower) / 2
        if Ord.lt (ref values[middle]) target then lower = middle + 1 else upper = middle
    if lower < values.length && !(Ord.lt target (ref values[lower])) then Maybe.Some lower else Maybe.None

def sort :: Ord<'a> => ref ['a] -> ['a]
fn sort values = Array.sort_by (left -> right -> if Ord.lt right left then 1i64 else 0i64) values

/// Sorts an exclusive slice in place, stably and without allocating: the order of `Array.sort`.
/// Insertion sorts blocks of 20 elements, then merges them by rotation (SymMerge, as Go's `sort.Stable`).
def sort_in_place :: Ord<'a> => ref mut ['a..] -> unit
fn sort_in_place values =
    let length = values.length
    let blocks = length / 20
    for block in 0i64 .. (blocks - 1) do
        sort_in_place_insertion values (block * 20) (block * 20 + 20)
    sort_in_place_insertion values (blocks * 20) length
    let mut width = 20i64
    let mut double = 40i64
    while width < length do
        let pairs = length / double
        for pair in 0i64 .. (pairs - 1) do
            sort_in_place_merge values (pair * double) (pair * double + width) (pair * double + double)
        let rest = pairs * double
        if rest + width < length then sort_in_place_merge values rest (rest + width) length
        width = double
        double = double * 2

private def sort_in_place_insertion :: Ord<'a> => ref mut ['a..] -> i64 -> i64 -> unit
fn sort_in_place_insertion values first last =
    for index in (first + 1) .. (last - 1) do
        let mut current = index
        while current > first && Ord.lt (ref values[current]) (ref values[current - 1]) do
            Array.swap_in values current (current - 1)
            current = current - 1

private def rec sort_in_place_merge :: Ord<'a> => ref mut ['a..] -> i64 -> i64 -> i64 -> unit
fn rec sort_in_place_merge values first middle last =
    if middle - first == 1 then
        let mut low = middle
        let mut high = last
        while low < high do
            let half = low + (high - low) / 2
            if Ord.lt (ref values[half]) (ref values[first]) then low = half + 1 else high = half
        for index in first .. (low - 2) do
            Array.swap_in values index (index + 1)
    elif last - middle == 1 then
        let mut low = first
        let mut high = middle
        while low < high do
            let half = low + (high - low) / 2
            if !(Ord.lt (ref values[middle]) (ref values[half])) then low = half + 1 else high = half
        for index in middle .. -1 .. (low + 1) do
            Array.swap_in values index (index - 1)
    else
        let center = first + (last - first) / 2
        let total = center + middle
        let mut start = if middle > center then total - last else first
        let mut bound = if middle > center then center else middle
        let probe = total - 1
        while start < bound do
            let half = start + (bound - start) / 2
            if !(Ord.lt (ref values[probe - half]) (ref values[half])) then start = half + 1 else bound = half
        let finish = total - start
        if start < middle && middle < finish then sort_in_place_rotate values start middle finish
        if first < start && start < center then sort_in_place_merge values first start center
        if center < finish && finish < last then sort_in_place_merge values center finish last

private def sort_in_place_rotate :: ref mut ['a..] -> i64 -> i64 -> i64 -> unit
fn sort_in_place_rotate values first middle last =
    let mut left = middle - first
    let mut right = last - middle
    while left != right do
        let count = if left > right then right else left
        let source = middle - left
        let target = if left > right then middle else middle + right - left
        for step in 0i64 .. (count - 1) do
            Array.swap_in values (source + step) (target + step)
        if left > right then left = left - right else right = right - left
    for step in 0i64 .. (left - 1) do
        Array.swap_in values (middle - left + step) (middle + step)

def filter :: Copy<'a> => (ref 'a -> bool) -> ref ['a] -> ['a]
fn filter predicate values =
    let mut selected = Vec.empty()
    let mut index = 0
    while index < values.length do
        if predicate (ref values[index]) then selected = Vec.push selected values[index]
        index = index + 1
    Vec.to_array selected