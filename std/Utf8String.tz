/// The number of UTF-8 bytes in `text`.
///
/// ```tsuzuri run=3%202
/// $"{Utf8String.length u8"abc"} {Utf8String.length u8"é"}"
/// ```
def length :: ref utf8string -> i64
fn length text = text.length

private def append_range :: own Vec<ubyte> -> ref utf8string -> own i64 -> own i64 -> Vec<ubyte>
fn append_range initial text first last =
	let mut output = initial
	for index in first ..= (last - 1) do output = Vec.push_owned text[index] output
	output

private def add_length :: own i64 -> own i64 -> i64
fn add_length left right =
	assert (left <= 9223372036854775807 - right)
	left + right

private def matches_at :: ref utf8string -> ref utf8string -> own i64 -> bool
fn matches_at needle text offset =
	if offset < 0 || offset > text.length || needle.length > text.length - offset then false else
		let mut index = 0
		while index < needle.length && needle[index] == text[offset + index] do index = index + 1
		index == needle.length

private def boundary :: ref utf8string -> own i64 -> bool
fn boundary text offset = offset == 0 || offset == text.length || (text[offset] & 192ubyte) != 128ubyte

/// The byte offset of the first occurrence of `needle` in `text`, or `None` when there is none.
///
/// ```tsuzuri run=3%20-1
/// let at = Utf8String.find u8"l" u8"héllo" |> Maybe.default_value (-1)
/// let missing = Utf8String.find u8"x" u8"héllo" |> Maybe.default_value (-1)
/// $"{at} {missing}"
/// ```
def find :: ref utf8string -> ref utf8string -> Maybe<i64>
fn find needle text =
	let mut offset = 0
	let mut result = Maybe.None
	while offset <= text.length do
		if matches_at needle text offset then
			result = Maybe.Some offset
			break
		offset = offset + 1
	result

/// The byte offset of the last occurrence of `needle` in `text`, or `None` when there is none.
///
/// ```tsuzuri run=3
/// Utf8String.rfind u8"an" u8"banana" |> Maybe.default_value (-1)
/// ```
def rfind :: ref utf8string -> ref utf8string -> Maybe<i64>
fn rfind needle text =
	let mut offset = text.length
	let mut result = Maybe.None
	while offset >= 0 do
		if matches_at needle text offset then
			result = Maybe.Some offset
			break
		offset = offset - 1
	result

/// Whether `needle` occurs in `text`.
///
/// ```tsuzuri run=true%20false
/// $"{Utf8String.contains u8"zu" u8"Tsuzuri"} {Utf8String.contains u8"Zu" u8"Tsuzuri"}"
/// ```
def contains :: ref utf8string -> ref utf8string -> bool
fn contains needle text =
	let result = find needle text
	Maybe.is_some (ref result)

/// Whether `text` begins with `prefix`.
///
/// ```tsuzuri run=true%20false
/// $"{Utf8String.starts_with u8"Tsu" u8"Tsuzuri"} {Utf8String.starts_with u8"zu" u8"Tsuzuri"}"
/// ```
def starts_with :: ref utf8string -> ref utf8string -> bool
fn starts_with prefix text = matches_at prefix text 0

/// Whether `text` ends with `suffix`.
///
/// ```tsuzuri run=true%20false
/// $"{Utf8String.ends_with u8"ri" u8"Tsuzuri"} {Utf8String.ends_with u8"Tsu" u8"Tsuzuri"}"
/// ```
def ends_with :: ref utf8string -> ref utf8string -> bool
fn ends_with suffix text = suffix.length <= text.length && matches_at suffix text (text.length - suffix.length)

/// The bytes of `text` from `first` up to, but not including, `last`; `None` when a position is negative,
/// `last < first`, `last` is past the end, or a position falls inside a character.
///
/// ```tsuzuri run=hé%20?
/// let piece = Utf8String.slice 0 3 u8"héllo" |> Maybe.default_value u8"?"
/// let inside = Utf8String.slice 0 2 u8"héllo" |> Maybe.default_value u8"?"
/// $"{piece} {inside}"
/// ```
def slice :: own i64 -> own i64 -> ref utf8string -> Maybe<utf8string>
fn slice first last text =
	if first < 0 || last < first || last > text.length then Maybe.None
	elif !(boundary text first) || !(boundary text last) then Maybe.None
	else
		let output = append_range (Vec.with_capacity (last - first)) text first last
		Utf8String.from_bytes (Vec.to_array output)

/// The `count` bytes of `text` that start at `first`; `None` when the range is negative, not inside `text`, or
/// does not start and end between characters.
///
/// ```tsuzuri run=é%20?
/// let piece = Utf8String.sub 1 2 u8"héllo" |> Maybe.default_value u8"?"
/// let outside = Utf8String.sub 3 9 u8"héllo" |> Maybe.default_value u8"?"
/// $"{piece} {outside}"
/// ```
def sub :: own i64 -> own i64 -> ref utf8string -> Maybe<utf8string>
fn sub first count text =
	if first < 0 || count < 0 || first > 9223372036854775807 - count then Maybe.None else slice first (first + count) text

/// The number of Unicode scalars in `text`.
///
/// ```tsuzuri run=5%206
/// $"{Utf8String.char_count u8"héllo"} {Utf8String.length u8"héllo"}"
/// ```
def char_count :: ref utf8string -> i64
fn char_count text =
	let mut index = 0
	let mut count = 0
	while index < text.length do
		match Utf8String.decode_at index text with | (_, next) -> index = next
		count = count + 1
	count

/// The Unicode scalars of `text` as an array of `utf8char`.
///
/// ```tsuzuri run=[u8'h',%20u8'é']
/// Utf8String.chars u8"hé"
/// ```
def chars :: ref utf8string -> [utf8char]
fn chars text =
	let mut result: Vec<utf8char> = Vec.with_capacity (char_count text)
	let mut index = 0
	while index < text.length do
		match Utf8String.decode_at index text with | (value, next) ->
			result = Vec.push_owned value result
			index = next
	Vec.to_array result

/// The elements of `parts` joined with `separator` between each two of them; an empty array gives `u8""`.
///
/// ```tsuzuri run=a,%20b,%20c
/// Utf8String.join u8", " [u8"a", u8"b", u8"c"]
/// ```
def join :: ref utf8string -> ref [utf8string] -> utf8string
fn join separator parts =
	let mut size = 0
	for index in 0 ..= (parts.length - 1) do
		size = add_length size parts[index].length
		if index > 0 then size = add_length size separator.length
	let mut output: Vec<ubyte> = Vec.with_capacity size
	for index in 0 ..= (parts.length - 1) do
		if index > 0 then output = append_range output separator 0 separator.length
		output = append_range output (ref parts[index]) 0 parts[index].length
	Maybe.get (Utf8String.from_bytes (Vec.to_array output))

/// The elements of `parts` joined with nothing between them; an empty array gives `u8""`.
///
/// ```tsuzuri run=Tsuzuri
/// Utf8String.concat [u8"Tsu", u8"zu", u8"ri"]
/// ```
def concat :: ref [utf8string] -> utf8string
fn concat parts =
	let empty = u8""
	join (ref empty) parts

/// Splits `text` at each `separator`; matches at the ends or next to each other give empty elements, and an empty
/// `separator` splits between characters.
///
/// ```tsuzuri run=[u8"a",%20u8"",%20u8"b"]
/// Utf8String.split u8"," u8"a,,b"
/// ```
def split :: ref utf8string -> ref utf8string -> [utf8string]
fn split separator text =
	if separator.length == 0 then
		let mut output: Vec<utf8string> = Vec.with_capacity (char_count text)
		let mut index = 0
		while index < text.length do
			match Utf8String.decode_at index text with | (_, next) ->
				output = Vec.push_owned (Maybe.get (slice index next text)) output
				index = next
		Vec.to_array output
	else
		let mut count = 1
		let mut index = 0
		while index <= text.length - separator.length do
			if matches_at separator text index then
				count = count + 1
				index = index + separator.length
			else index = index + 1
		let mut output: Vec<utf8string> = Vec.with_capacity count
		let mut start = 0
		let mut offset = 0
		while offset <= text.length - separator.length do
			if matches_at separator text offset then
				output = Vec.push_owned (Maybe.get (slice start offset text)) output
				offset = offset + separator.length
				start = offset
			else offset = offset + 1
		output = Vec.push_owned (Maybe.get (slice start text.length text)) output
		Vec.to_array output

private def whitespace :: own ubyte -> bool
fn whitespace value = value == 32ubyte || (value >= 9ubyte && value <= 13ubyte)

/// `text` without its leading ASCII whitespace (bytes 9 to 13 and 32).
///
/// ```tsuzuri run=[hi%20%20]
/// $"[{Utf8String.trim_start u8"  hi  "}]"
/// ```
def trim_start :: ref utf8string -> utf8string
fn trim_start text =
	let mut first = 0
	while first < text.length && whitespace text[first] do first = first + 1
	Maybe.get (slice first text.length text)

/// `text` without its trailing ASCII whitespace (bytes 9 to 13 and 32).
///
/// ```tsuzuri run=[%20%20hi]
/// $"[{Utf8String.trim_end u8"  hi  "}]"
/// ```
def trim_end :: ref utf8string -> utf8string
fn trim_end text =
	let mut last = text.length
	while last > 0 && whitespace text[last - 1] do last = last - 1
	Maybe.get (slice 0 last text)

/// `text` without its leading and trailing ASCII whitespace (bytes 9 to 13 and 32).
///
/// ```tsuzuri run=[hi]
/// $"[{Utf8String.trim u8" \t hi\n"}]"
/// ```
def trim :: ref utf8string -> utf8string
fn trim text =
	let mut first = 0
	let mut last = text.length
	while first < last && whitespace text[first] do first = first + 1
	while last > first && whitespace text[last - 1] do last = last - 1
	Maybe.get (slice first last text)

/// `text` with the ASCII letters `A` to `Z` made lowercase; every other byte is kept.
///
/// ```tsuzuri run=tsuzuri%20Äb
/// Utf8String.to_ascii_lower u8"TSUZURI ÄB"
/// ```
def to_ascii_lower :: ref utf8string -> utf8string
fn to_ascii_lower text = Maybe.get (Utf8String.from_bytes (new [ubyte](text.length, \index -> if text[index] >= 65ubyte && text[index] <= 90ubyte then text[index] + 32ubyte else text[index])))

/// `text` with the ASCII letters `a` to `z` made uppercase; every other byte is kept.
///
/// ```tsuzuri run=STRAßE
/// Utf8String.to_ascii_upper u8"straße"
/// ```
def to_ascii_upper :: ref utf8string -> utf8string
fn to_ascii_upper text = Maybe.get (Utf8String.from_bytes (new [ubyte](text.length, \index -> if text[index] >= 97ubyte && text[index] <= 122ubyte then text[index] - 32ubyte else text[index])))

/// `text` repeated `count` times; a negative `count` traps.
///
/// ```tsuzuri run=ababab
/// Utf8String.repeat 3 u8"ab"
/// ```
def repeat :: own i64 -> ref utf8string -> utf8string
fn repeat count text =
	assert (count >= 0)
	if count == 0 || text.length == 0 then u8"" else
		let size = Maybe.get (Int.checked_mul text.length count)
		Maybe.get (Utf8String.from_bytes (new [ubyte](size, \index -> text[index % text.length])))

/// `text` with each non-overlapping occurrence of `needle`, from the left, replaced by `replacement`; an empty
/// `needle` inserts `replacement` between characters and at both ends.
///
/// ```tsuzuri run=baNANA
/// Utf8String.replace u8"na" u8"NA" u8"banana"
/// ```
def replace :: ref utf8string -> ref utf8string -> ref utf8string -> utf8string
fn replace needle replacement text =
	let mut occurrences = 0
	let mut offset = 0
	while offset <= text.length do
		if needle.length == 0 then
			occurrences = occurrences + 1
			if offset == text.length then break
			match Utf8String.decode_at offset text with | (_, next) -> offset = next
		elif matches_at needle text offset then
			occurrences = occurrences + 1
			offset = offset + needle.length
		else offset = offset + 1
	let removed = Maybe.get (Int.checked_mul occurrences needle.length)
	let inserted = Maybe.get (Int.checked_mul occurrences replacement.length)
	let size = add_length (text.length - removed) inserted
	let mut output: Vec<ubyte> = Vec.with_capacity size
	let mut index = 0
	while index <= text.length do
		if needle.length == 0 then
			output = append_range output replacement 0 replacement.length
			if index == text.length then break
			match Utf8String.decode_at index text with | (_, next) ->
				output = append_range output text index next
				index = next
		elif matches_at needle text index then
			output = append_range output replacement 0 replacement.length
			index = index + needle.length
		else
			if index < text.length then output = Vec.push_owned text[index] output
			index = index + 1
	Maybe.get (Utf8String.from_bytes (Vec.to_array output))

// `utf8string` is a `Text`: each method calls the function of the same name in `Utf8String`.
instance Text<utf8string> {
	fn length text = Utf8String.length text
	fn compare left right = Utf8String.compare left right
	fn clone text = Utf8String.clone text
	fn find needle text = Utf8String.find needle text
	fn rfind needle text = Utf8String.rfind needle text
	fn contains needle text = Utf8String.contains needle text
	fn starts_with prefix text = Utf8String.starts_with prefix text
	fn ends_with suffix text = Utf8String.ends_with suffix text
	fn slice first last text = Utf8String.slice first last text
	fn sub first count text = Utf8String.sub first count text
	fn join separator parts = Utf8String.join separator parts
	fn concat parts = Utf8String.concat parts
	fn split separator text = Utf8String.split separator text
	fn trim text = Utf8String.trim text
	fn trim_start text = Utf8String.trim_start text
	fn trim_end text = Utf8String.trim_end text
	fn to_ascii_lower text = Utf8String.to_ascii_lower text
	fn to_ascii_upper text = Utf8String.to_ascii_upper text
	fn repeat count text = Utf8String.repeat count text
	fn replace needle replacement text = Utf8String.replace needle replacement text
}
