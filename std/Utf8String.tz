def length :: ref utf8string -> i64
fn length text = text.length

private def append_range :: Vec<ubyte> -> ref utf8string -> i64 -> i64 -> Vec<ubyte>
fn append_range initial text first last =
	let mut output = initial
	for index in first .. (last - 1) do output = Vec.push output text[index]
	output

private def add_length :: i64 -> i64 -> i64
fn add_length left right =
	assert (left <= 9223372036854775807 - right)
	left + right

private def matches_at :: ref utf8string -> ref utf8string -> i64 -> bool
fn matches_at needle text offset =
	if offset < 0 || offset > text.length || needle.length > text.length - offset then false else
		let mut index = 0
		while index < needle.length && needle[index] == text[offset + index] do index = index + 1
		index == needle.length

private def boundary :: ref utf8string -> i64 -> bool
fn boundary text offset = offset == 0 || offset == text.length || (text[offset] & 192ubyte) != 128ubyte

def find :: ref utf8string -> ref utf8string -> Option<i64>
fn find needle text =
	let mut offset = 0
	let mut result = Option.None
	while offset <= text.length do
		if matches_at needle text offset then
			result = Option.Some offset
			break
		offset = offset + 1
	result

def rfind :: ref utf8string -> ref utf8string -> Option<i64>
fn rfind needle text =
	let mut offset = text.length
	let mut result = Option.None
	while offset >= 0 do
		if matches_at needle text offset then
			result = Option.Some offset
			break
		offset = offset - 1
	result

def contains :: ref utf8string -> ref utf8string -> bool
fn contains needle text =
	let result = find needle text
	Option.is_some (ref result)

def starts_with :: ref utf8string -> ref utf8string -> bool
fn starts_with prefix text = matches_at prefix text 0

def ends_with :: ref utf8string -> ref utf8string -> bool
fn ends_with suffix text = suffix.length <= text.length && matches_at suffix text (text.length - suffix.length)

def slice :: ref utf8string -> i64 -> i64 -> Option<utf8string>
fn slice text first last =
	if first < 0 || last < first || last > text.length then Option.None
	elif !(boundary text first) || !(boundary text last) then Option.None
	else
		let output = append_range (Vec.with_capacity (last - first)) text first last
		Utf8String.from_bytes (Vec.to_array output)

def sub :: ref utf8string -> i64 -> i64 -> Option<utf8string>
fn sub text first count =
	if first < 0 || count < 0 || first > 9223372036854775807 - count then Option.None else slice text first (first + count)

def char_count :: ref utf8string -> i64
fn char_count text =
	let mut index = 0
	let mut count = 0
	while index < text.length do
		match Utf8String.decode_at text index with | (_, next) -> index = next
		count = count + 1
	count

def chars :: ref utf8string -> [utf8char]
fn chars text =
	let mut result: Vec<utf8char> = Vec.with_capacity (char_count text)
	let mut index = 0
	while index < text.length do
		match Utf8String.decode_at text index with | (value, next) ->
			result = Vec.push result value
			index = next
	Vec.to_array result

def join :: ref utf8string -> ref [utf8string] -> utf8string
fn join separator parts =
	let mut size = 0
	for index in 0 .. (parts.length - 1) do
		size = add_length size parts[index].length
		if index > 0 then size = add_length size separator.length
	let mut output: Vec<ubyte> = Vec.with_capacity size
	for index in 0 .. (parts.length - 1) do
		if index > 0 then output = append_range output separator 0 separator.length
		output = append_range output (ref parts[index]) 0 parts[index].length
	Option.get (Utf8String.from_bytes (Vec.to_array output))

def concat :: ref [utf8string] -> utf8string
fn concat parts =
	let empty = u8""
	join (ref empty) parts

def split :: ref utf8string -> ref utf8string -> [utf8string]
fn split separator text =
	if separator.length == 0 then
		let mut output: Vec<utf8string> = Vec.with_capacity (char_count text)
		let mut index = 0
		while index < text.length do
			match Utf8String.decode_at text index with | (_, next) ->
				output = Vec.push output (Option.get (slice text index next))
				index = next
		Vec.to_array output
	else
		let mut count = 1
		let mut index = 0
		while index <= text.length - separator.length do
			if matches_at separator text index then
				count = count + 1
				index = index + separator.length
			else index = index + 1
		let mut output: Vec<utf8string> = Vec.with_capacity count
		let mut start = 0
		let mut offset = 0
		while offset <= text.length - separator.length do
			if matches_at separator text offset then
				output = Vec.push output (Option.get (slice text start offset))
				offset = offset + separator.length
				start = offset
			else offset = offset + 1
		output = Vec.push output (Option.get (slice text start text.length))
		Vec.to_array output

private def whitespace :: ubyte -> bool
fn whitespace value = value == 32ubyte || (value >= 9ubyte && value <= 13ubyte)

def trim_start :: ref utf8string -> utf8string
fn trim_start text =
	let mut first = 0
	while first < text.length && whitespace text[first] do first = first + 1
	Option.get (slice text first text.length)

def trim_end :: ref utf8string -> utf8string
fn trim_end text =
	let mut last = text.length
	while last > 0 && whitespace text[last - 1] do last = last - 1
	Option.get (slice text 0 last)

def trim :: ref utf8string -> utf8string
fn trim text =
	let mut first = 0
	let mut last = text.length
	while first < last && whitespace text[first] do first = first + 1
	while last > first && whitespace text[last - 1] do last = last - 1
	Option.get (slice text first last)

def to_ascii_lower :: ref utf8string -> utf8string
fn to_ascii_lower text = Option.get (Utf8String.from_bytes (new [ubyte](text.length, index -> if text[index] >= 65ubyte && text[index] <= 90ubyte then text[index] + 32ubyte else text[index])))

def to_ascii_upper :: ref utf8string -> utf8string
fn to_ascii_upper text = Option.get (Utf8String.from_bytes (new [ubyte](text.length, index -> if text[index] >= 97ubyte && text[index] <= 122ubyte then text[index] - 32ubyte else text[index])))

def repeat :: ref utf8string -> i64 -> utf8string
fn repeat text count =
	assert (count >= 0)
	if count == 0 || text.length == 0 then u8"" else
		let size = Option.get (Int.checked_mul text.length count)
		Option.get (Utf8String.from_bytes (new [ubyte](size, index -> text[index % text.length])))

def replace :: ref utf8string -> ref utf8string -> ref utf8string -> utf8string
fn replace needle replacement text =
	let mut occurrences = 0
	let mut offset = 0
	while offset <= text.length do
		if needle.length == 0 then
			occurrences = occurrences + 1
			if offset == text.length then break
			match Utf8String.decode_at text offset with | (_, next) -> offset = next
		elif matches_at needle text offset then
			occurrences = occurrences + 1
			offset = offset + needle.length
		else offset = offset + 1
	let removed = Option.get (Int.checked_mul occurrences needle.length)
	let inserted = Option.get (Int.checked_mul occurrences replacement.length)
	let size = add_length (text.length - removed) inserted
	let mut output: Vec<ubyte> = Vec.with_capacity size
	let mut index = 0
	while index <= text.length do
		if needle.length == 0 then
			output = append_range output replacement 0 replacement.length
			if index == text.length then break
			match Utf8String.decode_at text index with | (_, next) ->
				output = append_range output text index next
				index = next
		elif matches_at needle text index then
			output = append_range output replacement 0 replacement.length
			index = index + needle.length
		else
			if index < text.length then output = Vec.push output text[index]
			index = index + 1
	Option.get (Utf8String.from_bytes (Vec.to_array output))
