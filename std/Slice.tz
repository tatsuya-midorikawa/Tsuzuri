/// A per-axis slice descriptor for `Tensor`, `Matrix`, and `MatrixView` indexing.
///
/// Negative positions count backward from the axis length (`len + i`), following NumPy/Python
/// slice clamping rules for ranges and trapping on out-of-bounds `At` indices or `step == 0`.
union Axis =
    | All
    | At of i64
    | Range of (i64 * i64)
    | From of i64
    | To of i64
    | Step of (Maybe<i64> * Maybe<i64> * i64)
    | NewAxis

private pure def maybe_eq :: ref Maybe<i64> -> ref Maybe<i64> -> bool
fn maybe_eq left right =
    match (left, right) with
    | (Maybe.None, Maybe.None) -> true
    | (Maybe.Some a, Maybe.Some b) -> a == b
    | _ -> false

private pure def axis_eq :: ref Axis -> ref Axis -> bool
fn axis_eq left right =
    match (left, right) with
    | (Axis.All, Axis.All) -> true
    | (Axis.At a, Axis.At b) -> a == b
    | (Axis.Range (a1, a2), Axis.Range (b1, b2)) -> a1 == b1 && a2 == b2
    | (Axis.From a, Axis.From b) -> a == b
    | (Axis.To a, Axis.To b) -> a == b
    | (Axis.Step (as1, ae1, st1), Axis.Step (as2, ae2, st2)) ->
        maybe_eq (ref as1) (ref as2) && maybe_eq (ref ae1) (ref ae2) && st1 == st2
    | (Axis.NewAxis, Axis.NewAxis) -> true
    | _ -> false

instance Eq<Axis> {
    fn eq left right = axis_eq left right
    fn ne left right = not (axis_eq left right)
}

/// The normalized result of resolving one `Slice.Axis` against a concrete axis extent.
union Resolved =
    | Index of i64
    | Slice of (i64 * i64 * i64)
    | InsertAxis
    deriving (Eq)

/// Selects every position along the axis.
///
/// ```tsuzuri run=true
/// Slice.all() == Slice.Axis.All
/// ```
pure def all :: Axis
fn all = Axis.All

/// Selects a single position `index` (negative counts from the end) and removes the axis.
///
/// ```tsuzuri run=true
/// Slice.at (-1) == Slice.Axis.At (-1)
/// ```
pure def at :: own i64 -> Axis
fn at index = Axis.At index

/// Selects the half-open interval `[start, stop)` with step 1.
///
/// ```tsuzuri run=true
/// Slice.range 1 4 == Slice.Axis.Range (1, 4)
/// ```
pure def range :: own i64 -> own i64 -> Axis
fn range start stop = Axis.Range (start, stop)

/// Selects from `start` through the end of the axis with step 1.
///
/// ```tsuzuri run=true
/// Slice.from 2 == Slice.Axis.From 2
/// ```
pure def from :: own i64 -> Axis
fn from start = Axis.From start

/// Selects from the start of the axis up to (excluding) `stop` with step 1.
///
/// ```tsuzuri run=true
/// Slice.until 3 == Slice.Axis.To 3
/// ```
pure def until :: own i64 -> Axis
fn until stop = Axis.To stop

/// Selects positions from `start` to `stop` (exclusive) by `step`; `step == 0` traps on resolve.
///
/// ```tsuzuri run=true
/// Slice.step 1 7 2 == Slice.Axis.Step (Maybe.Some 1, Maybe.Some 7, 2)
/// ```
pure def step :: own i64 -> own i64 -> own i64 -> Axis
fn step start stop stride = Axis.Step (Maybe.Some start, Maybe.Some stop, stride)

/// Selects the whole axis stepping by `stride` (negative reverses the axis).
///
/// ```tsuzuri run=true
/// Slice.every 2 == Slice.Axis.Step (Maybe.None, Maybe.None, 2)
/// ```
pure def every :: own i64 -> Axis
fn every stride = Axis.Step (Maybe.None, Maybe.None, stride)

/// Reverses the whole axis (`step = -1`).
///
/// ```tsuzuri run=true
/// Slice.rev() == Slice.Axis.Step (Maybe.None, Maybe.None, -1)
/// ```
pure def rev :: Axis
fn rev = Axis.Step (Maybe.None, Maybe.None, -1)

/// Inserts a new length-1 axis without consuming an input axis.
///
/// ```tsuzuri run=true
/// Slice.new_axis() == Slice.Axis.NewAxis
/// ```
pure def new_axis :: Axis
fn new_axis = Axis.NewAxis

private pure def clamp_pos :: own i64 -> own i64 -> i64
fn clamp_pos index len =
    let norm = if index < 0 then len + index else index
    if norm < 0 then 0
    elif norm > len then len
    else norm

private pure def clamp_neg :: own i64 -> own i64 -> i64
fn clamp_neg index len =
    let norm = if index < 0 then len + index else index
    if norm < (-1) then (-1)
    elif norm >= len then len - 1
    else norm

private pure def resolve_step :: own i64 -> Maybe<i64> -> Maybe<i64> -> own i64 -> Resolved
fn resolve_step len start_opt stop_opt stride =
    assert (len >= 0 && stride != 0)
    if stride > 0 then
        let start =
            match start_opt with
            | Maybe.Some s -> clamp_pos s len
            | Maybe.None -> 0
        let stop =
            match stop_opt with
            | Maybe.Some e -> clamp_pos e len
            | Maybe.None -> len
        if stop <= start then Resolved.Slice (0, 0, stride)
        else
            let dist = (stop as i64u) - (start as i64u)
            let s = stride as i64u
            let count = ((dist - 1i64u) / s + 1i64u) as i64
            Resolved.Slice (start, count, stride)
    else
        let start =
            match start_opt with
            | Maybe.Some s -> clamp_neg s len
            | Maybe.None -> len - 1
        let stop =
            match stop_opt with
            | Maybe.Some e -> clamp_neg e len
            | Maybe.None -> (-1)
        if start <= stop then Resolved.Slice (0, 0, stride)
        else
            let dist = (start as i64u) - (stop as i64u)
            let s = 0i64u - (stride as i64u)
            let count = ((dist - 1i64u) / s + 1i64u) as i64
            Resolved.Slice (start, count, stride)

/// Resolves one `Slice.Axis` against an axis of extent `len >= 0`.
/// Traps on out-of-bounds `At` indices or `step == 0`.
///
/// ```tsuzuri run=true
/// Slice.resolve 5 (Slice.rev()) == Slice.Resolved.Slice (4, 5, -1)
/// ```
pure def resolve :: own i64 -> ref Axis -> Resolved
fn resolve len axis =
    assert (len >= 0)
    match axis with
    | Axis.All -> Resolved.Slice (0, len, 1)
    | Axis.At index ->
        let norm = if index < 0 then len + index else index
        assert (norm >= 0 && norm < len)
        Resolved.Index norm
    | Axis.Range (start, stop) -> resolve_step len (Maybe.Some start) (Maybe.Some stop) 1
    | Axis.From start -> resolve_step len (Maybe.Some start) Maybe.None 1
    | Axis.To stop -> resolve_step len Maybe.None (Maybe.Some stop) 1
    | Axis.Step (start_opt, stop_opt, stride) -> resolve_step len start_opt stop_opt stride
    | Axis.NewAxis -> Resolved.InsertAxis

/// A strict position on one axis of length `n`: `Front i` is `i` (`0` is the first), and
/// `Back k` is `n - 1 - k` (`^k`; `Back 0` is the last). Neither wraps nor clamps; a position
/// outside `[0, n)` traps.
union Pos =
    | Front of i64
    | Back of i64
    deriving (Eq)

/// One endpoint of a strict `Span`: unbounded (the edge of the axis in the step's direction),
/// or a `Pos` that the span includes or excludes.
union Bound =
    | Unbounded
    | Included of Pos
    | Excluded of Pos
    deriving (Eq)

/// A strict selector for one component of a bracket key such as `ref t[i, a..b, ..]`.
union Sel =
    | Item of Pos
    | Span of (Bound * Bound * i64)
    | Whole
    | Rest
    | AddAxis
    deriving (Eq)

/// Expands to as many full-axis `All` selectors as needed to match the input rank (`...` in NumPy).
/// At most one `Rest` may appear in a bracket key.
///
/// ```tsuzuri run=true
/// Slice.rest() == Slice.Sel.Rest
/// ```
pure def rest :: Sel
fn rest = Sel.Rest

private pure def pos_128 :: own i64 -> ref Pos -> i128
fn pos_128 len pos =
    match pos with
    | Pos.Front i -> i as i128
    | Pos.Back k -> (len as i128) - 1i128 - (k as i128)

/// Strictly resolves one `Slice.Sel` against an axis of extent `len >= 0` using the D-66 boundary
/// model without clamping or negative wraparound. `Sel.Rest` must be expanded by the caller first
/// and traps if passed directly.
///
/// ```tsuzuri run=true
/// let sel = Slice.Sel.Span (Slice.Bound.Included (Slice.Pos.Front 1), Slice.Bound.Included (Slice.Pos.Back 1), 1)
/// Slice.resolve_sel 5 (ref sel) == Slice.Resolved.Slice (1, 3, 1)
/// ```
pure def resolve_sel :: own i64 -> ref Sel -> Resolved
fn resolve_sel len sel =
    assert (len >= 0)
    let len128 = len as i128
    match sel with
    | Sel.Item p ->
        let idx = pos_128 len (ref p)
        assert (idx >= 0i128 && idx < len128)
        Resolved.Index (idx as i64)
    | Sel.Span (b_start, b_end, s) ->
        assert (s != 0)
        if s > 0 then
            let lo: i128 =
                match b_start with
                | Bound.Unbounded -> 0i128
                | Bound.Included p -> pos_128 len (ref p)
                | Bound.Excluded p -> pos_128 len (ref p) + 1i128
            let hi: i128 =
                match b_end with
                | Bound.Unbounded -> len128
                | Bound.Included q -> pos_128 len (ref q) + 1i128
                | Bound.Excluded q -> pos_128 len (ref q)
            assert (0i128 <= lo && lo <= hi && hi <= len128)
            if hi == lo then
                Resolved.Slice (lo as i64, 0, s)
            else
                let dist = (hi - lo - 1i128) as i64u
                let count = (dist / (s as i64u) + 1i64u) as i64
                Resolved.Slice (lo as i64, count, s)
        else
            let last128 = len128 - 1i128
            let p: i128 =
                match b_start with
                | Bound.Unbounded -> last128
                | Bound.Included pos -> pos_128 len (ref pos)
                | Bound.Excluded _ ->
                    assert false
                    0i128
            let q: i128 =
                match b_end with
                | Bound.Unbounded -> 0i128
                | Bound.Included pos -> pos_128 len (ref pos)
                | Bound.Excluded _ ->
                    assert false
                    0i128
            assert (p <= last128 && 0i128 <= q && q <= p + 1i128)
            if p < q then
                let start_i64 = if p < 0i128 then 0 else p as i64
                Resolved.Slice (start_i64, 0, s)
            else
                let dist = (p - q) as i64u
                let abs_s = 0i64u - (s as i64u)
                let count = (dist / abs_s + 1i64u) as i64
                Resolved.Slice (p as i64, count, s)
    | Sel.Whole -> Resolved.Slice (0, len, 1)
    | Sel.AddAxis -> Resolved.InsertAxis
    | Sel.Rest ->
        assert false
        Resolved.InsertAxis
