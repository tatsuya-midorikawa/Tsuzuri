record Set<'key> { entries: Vec<'key> }

def empty :: Set<'key>
fn empty = Set { entries: Vec.empty() }

def singleton :: 'key -> Set<'key>
fn singleton key = Set { entries: Vec.push (Vec.empty()) key }

def length :: ref Set<'key> -> i64
fn length set = Vec.length (ref set.entries)

def is_empty :: ref Set<'key> -> bool
fn is_empty set = length set == 0

private def lower_bound :: Ord<'key> => ref Set<'key> -> ref 'key -> i64
fn lower_bound set key =
	assert (Eq.eq key key)
	let mut lower = 0
	let mut upper = length set
	while lower < upper do
		let middle = lower + (upper - lower) / 2
		assert (Eq.eq (ref set.entries[middle]) (ref set.entries[middle]))
		if Ord.lt (ref set.entries[middle]) key then lower = middle + 1 else upper = middle
	lower

private def found :: Ord<'key> => ref Set<'key> -> ref 'key -> i64 -> bool
fn found set key index = index < length set && !(Ord.lt key (ref set.entries[index]))

def contains :: Ord<'key> => ref Set<'key> -> 'key -> bool
fn contains set key = found set (ref key) (lower_bound set (ref key))

def insert :: Ord<'key> => Set<'key> -> 'key -> Set<'key>
fn insert set key =
	let index = lower_bound (ref set) (ref key)
	let count = length (ref set)
	if found (ref set) (ref key) index then set else
		let mut entries = Vec.push set.entries key
		let mut position = count
		while position > index do
			entries = Vec.swap entries position (position - 1)
			position = position - 1
		Set { entries: entries }

def remove :: Ord<'key> => Set<'key> -> 'key -> Set<'key>
fn remove set key =
	let index = lower_bound (ref set) (ref key)
	let count = length (ref set)
	if found (ref set) (ref key) index then
		let mut entries = set.entries
		let mut position = index
		while position < count - 1 do
			entries = Vec.swap entries position (position + 1)
			position = position + 1
		match Vec.pop entries with
		| (remaining, _removed) -> Set { entries: remaining }
	else set

def to_array :: Copy<'key> => ref Set<'key> -> ['key]
fn to_array set = new ['key](length set, index -> set.entries[index])

def fold :: ('state -> ref 'key -> 'state) -> 'state -> ref Set<'key> -> 'state
fn fold folder initial set =
	let mut state = initial
	let mut index = 0
	while index < length set do
		state = folder state (ref set.entries[index])
		index = index + 1
	state

private def compare_keys :: Ord<'key> => ref 'key -> ref 'key -> i64
fn compare_keys left right =
	assert (Eq.eq left left && Eq.eq right right)
	if Ord.lt left right then -1 else if Ord.lt right left then 1 else 0

def union :: Ord<'key> => Set<'key> -> Set<'key> -> Set<'key>
fn union left right =
	let left_count = length (ref left)
	let right_count = length (ref right)
	assert (left_count <= 9223372036854775807 - right_count)
	let mut output = Vec.with_capacity (left_count + right_count)
	let mut left_values = left.entries
	let mut right_values = right.entries
	while Vec.length (ref left_values) > 0 || Vec.length (ref right_values) > 0 do
		let left_length = Vec.length (ref left_values)
		let right_length = Vec.length (ref right_values)
		let order = if left_length == 0 then -1 else if right_length == 0 then 1 else compare_keys (ref left_values[left_length - 1]) (ref right_values[right_length - 1])
		if order >= 0 then
			match Vec.pop left_values with
			| (remaining, value) ->
				left_values = remaining
				let key = Option.get value
				assert (Eq.eq (ref key) (ref key))
				output = Vec.push output key
		else
			match Vec.pop right_values with
			| (remaining, value) ->
				right_values = remaining
				let key = Option.get value
				assert (Eq.eq (ref key) (ref key))
				output = Vec.push output key
		if order == 0 then
			match Vec.pop right_values with
			| (remaining, _duplicate) -> right_values = remaining
	let count = Vec.length (ref output)
	let mut index = 0
	while index < count / 2 do
		output = Vec.swap output index (count - index - 1)
		index = index + 1
	Set { entries: output }

private def select :: (Ord<'key>, Copy<'key>) => ref Set<'key> -> ref Set<'key> -> bool -> Set<'key>
fn select left right include_equal =
	let left_count = length left
	let right_count = length right
	let capacity = if include_equal && right_count < left_count then right_count else left_count
	let mut output = Vec.with_capacity capacity
	let mut left_index = 0
	let mut right_index = 0
	while left_index < left_count do
		assert (Eq.eq (ref left.entries[left_index]) (ref left.entries[left_index]))
		let order = if right_index >= right_count then -1 else compare_keys (ref left.entries[left_index]) (ref right.entries[right_index])
		if order <= 0 then
			if (order == 0) == include_equal then output = Vec.push output left.entries[left_index]
			left_index = left_index + 1
		if order >= 0 then right_index = right_index + 1
	Set { entries: output }

def intersect :: (Ord<'key>, Copy<'key>) => ref Set<'key> -> ref Set<'key> -> Set<'key>
fn intersect left right = select left right true

def difference :: (Ord<'key>, Copy<'key>) => ref Set<'key> -> ref Set<'key> -> Set<'key>
fn difference left right = select left right false

private def rec iter_from :: ref Set<'key> -> i64 -> Seq<ref 'key>
fn rec iter_from set index = Seq.defer (\() ->
	if index < length set then (iter_from set (index + 1), Option.Some (ref set.entries[index]))
	else (Seq.empty(), Option.None))

def iter :: ref Set<'key> -> Seq<ref 'key>
fn iter set = iter_from set 0



